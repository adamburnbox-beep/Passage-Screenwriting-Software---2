<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <link rel="icon" type="image/png" href="favicon.png" />
    <link rel="preload" href="fonts/CourierPrime-Regular.ttf" as="font" type="font/ttf" crossorigin />
    <link rel="preload" href="fonts/CourierPrime-Bold.ttf" as="font" type="font/ttf" crossorigin />
    <link rel="stylesheet" href="lib/codemirror/codemirror.css" />
    <link rel="stylesheet" href="css/app.css" />
    <script>
        // Applied before first paint so a stored light theme does not flash
        // dark on every load. passage.js owns the value from here on.
        try {
            var t = window.localStorage.getItem("passage.theme.v1");
            if (t === "light" || t === "dark") document.documentElement.dataset.theme = t;
        } catch (e) { }
    </script>
    <HeadOutlet @rendermode="InteractiveServer" />
    <title>Passage</title>
</head>

<body>
    <Routes @rendermode="InteractiveServer" />
    <script src="_framework/blazor.web.js"></script>
    <script src="lib/codemirror/codemirror.js"></script>
    <script src="lib/codemirror/placeholder.js"></script>
    <script src="lib/codemirror/searchcursor.js"></script>
    <script src="js/passage.js"></script>
</body>

</html>
