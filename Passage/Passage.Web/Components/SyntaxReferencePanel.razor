@inject IJSRuntime JS

@* Transcribed from Passage.App.Linux/Views/SyntaxQuickReferencePanel.axaml —
   same headings, same order, same wording. The Avalonia file hardcodes the
   dark-theme hex for each marker (#4FC3F7, #FFB74D, #81C784); here they go
   through the syntax tokens so the panel follows the light theme too. *@

<aside class="syntax-panel">
    <div class="syntax-panel-head">
        <div>
            <h2>Syntax Quick Reference</h2>
            <p class="syntax-panel-sub">Keep Fountain structure markers close while writing.</p>
        </div>
        <button class="icon-btn" title="Close (F1)" @onclick="OnClose">✕</button>
    </div>

    <div class="syntax-panel-body">
        @foreach (var card in Cards)
        {
            <section class="syntax-card">
                <h3>@card.Title</h3>
                <p>@card.Blurb</p>
                @foreach (var entry in card.Entries)
                {
                    <div class="syntax-row">
                        <span class="syntax-token @entry.ColourClass">@entry.Token</span>
                        <span class="syntax-desc">@entry.Description</span>
                        <button class="icon-btn" title="Copy @entry.Token"
                                @onclick="() => CopyAsync(entry.Token)">📋</button>
                    </div>
                }
            </section>
        }

        <section class="syntax-card">
            <h3>Colours</h3>
            <p>Choose how markers are coloured here, in the editor and in the outline. Remembered by this browser.</p>
            <label class="syntax-scheme-pick">
                <span class="syntax-desc">Scheme</span>
                <select value="@Scheme.Preset" @onchange="OnPresetChangedAsync">
                    @foreach (var preset in SyntaxSchemes.Presets)
                    {
                        <option value="@preset.Id">@preset.Name</option>
                    }
                    <option value="@SyntaxSchemes.CustomId">Custom</option>
                </select>
            </label>
            @if (IsCustom)
            {
                var palette = CustomPalette;
                <p>Editing the @Theme theme's colours. Switch theme to set the other set.</p>
                @foreach (var (token, label, sample) in SyntaxSchemes.Tokens)
                {
                    <label class="syntax-row">
                        <input type="color" value="@palette[token]" title="@label colour"
                               @onchange="e => OnColourChangedAsync(token, e)" />
                        <span class="syntax-token" style="color: @palette[token]">@sample</span>
                        <span class="syntax-desc">@label</span>
                    </label>
                }
                <div class="syntax-row">
                    <button class="btn" @onclick="ResetCustomAsync">Reset to Classic</button>
                </div>
            }
        </section>
    </div>

    @if (_copyStatus.Length > 0)
    {
        <div class="syntax-panel-foot">@_copyStatus</div>
    }
</aside>

@code {
    [Parameter]
    public EventCallback OnClose { get; set; }

    [Parameter]
    public SyntaxSchemeState Scheme { get; set; } = new();

    [Parameter]
    public EventCallback<SyntaxSchemeState> SchemeChanged { get; set; }

    /// <summary>"dark" or "light" — which custom palette the pickers edit.</summary>
    [Parameter]
    public string Theme { get; set; } = "dark";

    private bool IsCustom => Scheme.Preset == SyntaxSchemes.CustomId;

    private bool EditingLight => Theme == "light";

    // The pickers show the resolved palette so a token the user has not set
    // yet still shows the colour that is actually painted.
    private IReadOnlyDictionary<string, string> CustomPalette
    {
        get
        {
            var (dark, light) = SyntaxSchemes.Resolve(Scheme);
            return EditingLight ? light : dark;
        }
    }

    private async Task OnPresetChangedAsync(ChangeEventArgs e)
    {
        var id = e.Value?.ToString() ?? SyntaxSchemes.Classic.Id;
        var next = new SyntaxSchemeState
        {
            Preset = id,
            CustomDark = Scheme.CustomDark,
            CustomLight = Scheme.CustomLight
        };

        // First visit to Custom starts from whatever was showing, so the
        // pickers do not all jump to Classic.
        if (id == SyntaxSchemes.CustomId && next.CustomDark is null && next.CustomLight is null)
        {
            var (dark, light) = SyntaxSchemes.Resolve(Scheme);
            next.CustomDark = new Dictionary<string, string>(dark);
            next.CustomLight = new Dictionary<string, string>(light);
        }

        await SchemeChanged.InvokeAsync(next);
    }

    private async Task OnColourChangedAsync(string token, ChangeEventArgs e)
    {
        var value = e.Value?.ToString();
        if (!SyntaxSchemes.IsValidColour(value))
        {
            return;
        }

        var (dark, light) = SyntaxSchemes.Resolve(Scheme);
        var next = new SyntaxSchemeState
        {
            Preset = SyntaxSchemes.CustomId,
            CustomDark = new Dictionary<string, string>(dark),
            CustomLight = new Dictionary<string, string>(light)
        };
        (EditingLight ? next.CustomLight : next.CustomDark)[token] = value!;
        await SchemeChanged.InvokeAsync(next);
    }

    private async Task ResetCustomAsync()
    {
        var next = new SyntaxSchemeState
        {
            Preset = SyntaxSchemes.CustomId,
            CustomDark = new Dictionary<string, string>(SyntaxSchemes.Classic.Dark),
            CustomLight = new Dictionary<string, string>(SyntaxSchemes.Classic.Light)
        };
        await SchemeChanged.InvokeAsync(next);
    }

    private string _copyStatus = string.Empty;

    private sealed record Entry(string Token, string Description, string ColourClass);

    private sealed record Card(string Title, string Blurb, Entry[] Entries);

    private static readonly Card[] Cards =
    {
        new("Sections",
            "Use section markers to organize Acts, Sequences, and Scenes. These markers are for structure only and do not print in the screenplay output.",
            new[]
            {
                new Entry("#", "Act heading", "t-section"),
                new Entry("##", "Sequence heading", "t-section"),
                new Entry("###", "Scene grouping marker", "t-section")
            }),
        new("Synopses",
            "Use a synopsis line to add a short summary beneath the current section or scene.",
            new[]
            {
                new Entry("=", "Summary for the section or scene below it.", "t-synopsis")
            }),
        new("Notes",
            "Use Fountain notes for private comments, reminders, or production details that should stay internal.",
            new[]
            {
                new Entry("[[ Your Note ]]", "Internal comment that stays out of the printed script.", "t-note")
            })
    };

    private async Task CopyAsync(string token)
    {
        bool copied;
        try
        {
            copied = await JS.InvokeAsync<bool>("passage.copyText", token);
        }
        catch (JSException)
        {
            copied = false;
        }

        // The Avalonia panel swallows clipboard failures silently. On the web a
        // failure is likely enough — no secure context, permission denied — that
        // staying quiet would just look broken (rule 12).
        _copyStatus = copied ? $"Copied {token}" : "Could not copy — select the marker and copy manually.";
    }
}
