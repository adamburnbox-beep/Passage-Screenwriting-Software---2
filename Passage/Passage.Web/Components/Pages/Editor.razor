@page "/"
@using Passage.Core.Goals
@using Passage.Export
@using Passage.Parser
@inject ScriptLibrary Library
@inject ExportService Exports
@inject GoalSettingsStore GoalStore
@inject IJSRuntime JS
@implements IDisposable

<div class="app-shell">
    <header class="topbar">
        <span class="brand">PASSAGE</span>
        <span class="file-pill" title="@DisplayName">
            @DisplayName
            @if (_isDirty)
            {
                <span class="dirty-dot">*</span>
            }
        </span>

        <nav class="view-tabs">
            <button class="@(_mainViewIndex == 0 ? "active" : null)" @onclick="() => SetMainView(0)">SCRIPT</button>
            <button class="@(_mainViewIndex == 1 ? "active" : null)" @onclick="() => SetMainView(1)">BOARD</button>
            <button class="@(_mainViewIndex == 2 ? "active" : null)" @onclick="() => SetMainView(2)">PREVIEW</button>
        </nav>

        <div class="topbar-actions">
            <button class="btn theme-toggle" @onclick="ToggleThemeAsync"
                    title="@(_theme == "light" ? "Switch to dark theme" : "Switch to light theme")">
                @(_theme == "light" ? "☾" : "☀")
            </button>
            <label class="toggle" title="Save automatically shortly after you stop typing">
                <input type="checkbox" @bind="_autosaveEnabled" /> AUTOSAVE
            </label>
            <button class="btn" @onclick="RequestNewFile">New</button>
            <button class="btn primary" @onclick="SaveAsync">Save</button>
            <details class="menu">
                <summary class="btn">Export ▾</summary>
                <div class="menu-items">
                    <button @onclick='() => ExportAsync("pdf")'>PDF (.pdf)</button>
                    <button @onclick='() => ExportAsync("txt")'>Plain text (.txt)</button>
                    <button @onclick='() => ExportAsync("fountain")'>Fountain source (.fountain)</button>
                </div>
            </details>
        </div>
    </header>

    <div class="main-area">
        <aside class="sidebar">
            <div class="sidebar-tabs">
                <button class="@(_sidebarTab == 0 ? "active" : null)" @onclick="() => _sidebarTab = 0">FILES</button>
                <button class="@(_sidebarTab == 1 ? "active" : null)" @onclick="() => _sidebarTab = 1">OUTLINE</button>
                <button class="@(_sidebarTab == 2 ? "active" : null)" @onclick="() => _sidebarTab = 2">NOTES</button>
                <button class="@(_sidebarTab == 3 ? "active" : null)" @onclick="() => _sidebarTab = 3">GOALS</button>
            </div>
            <div class="sidebar-body">
                @if (_sidebarTab == 0)
                {
                    @if (_files.Count == 0)
                    {
                        <div class="sidebar-empty">No scripts yet.
Click New to start one — files are stored on the server volume.</div>
                    }
                    @if (_recentFiles.Count > 0)
                    {
                        <div class="sidebar-heading">RECENT</div>
                        @foreach (var name in _recentFiles)
                        {
                            <div class="file-row @(name == _fileName ? "active" : null)"
                                 @onclick="() => RequestOpenRecentAsync(name)">
                                <span class="file-name">@name</span>
                            </div>
                        }
                        <div class="sidebar-heading">ALL SCRIPTS</div>
                    }
                    @foreach (var file in _files)
                    {
                        <div class="file-row @(file.Name == _fileName ? "active" : null)" @onclick="() => RequestOpenFile(file.Name)">
                            <span class="file-name">@file.Name</span>
                            <span class="file-meta">@FormatTimestamp(file.LastModifiedUtc)</span>
                            <button class="icon-btn" title="Delete @file.Name"
                                    @onclick="() => RequestDeleteFile(file.Name)" @onclick:stopPropagation="true">✕</button>
                        </div>
                    }
                }
                else if (_sidebarTab == 1)
                {
                    @if (_analysis.Outline.Count == 0)
                    {
                        <div class="sidebar-empty">@OutlineEmptyMessage</div>
                    }
                    @foreach (var node in _analysis.Outline)
                    {
                        @RenderOutlineNode(node)
                    }
                }
                else if (_sidebarTab == 2)
                {
                    @if (_analysis.Notes.Count == 0)
                    {
                        <div class="sidebar-empty">No [[notes]] in this script yet.</div>
                    }
                    @foreach (var note in _analysis.Notes)
                    {
                        <div class="outline-label" @onclick="() => JumpToLineAsync(note.LineNumber)">
                            <span class="outline-kind k-note">Note</span>
                            <span>@note.Text</span>
                        </div>
                    }
                }
                else
                {
                    <div class="goal-panel">
                        <div class="goal-card">
                            <div class="goal-card-title">SESSION</div>
                            <label class="goal-field">
                                <span>GOAL TYPE</span>
                                <select @bind="SessionGoalTypeString">
                                    <option value="WordCount">Word count</option>
                                    <option value="PageCount">Page count</option>
                                    <option value="Timer">Timer</option>
                                </select>
                            </label>
                            <label class="goal-field">
                                <span>@(IsTimerSession ? "TARGET (MINUTES)" : "TARGET")</span>
                                <input type="number" min="1" max="100000" @bind="SessionTargetValue" />
                            </label>

                            <div class="goal-dash">
                                <div class="goal-ring-wrap">
                                    <svg class="goal-ring" viewBox="0 0 110 110">
                                        <circle class="ring-track" cx="55" cy="55" r="48" />
                                        <circle class="ring-progress @(SessionComplete ? "done" : null)" cx="55" cy="55" r="48"
                                                style="stroke-dasharray:@RingDash(SessionPercent)" />
                                    </svg>
                                    <div class="goal-ring-center">
                                        @if (IsTimerSession)
                                        {
                                            <span class="ring-big">@FormatClock(TimerRemaining)</span>
                                        }
                                        else
                                        {
                                            <span class="ring-big">@((int)Math.Round(SessionPercent))%</span>
                                        }
                                    </div>
                                </div>
                                <div class="goal-stats">
                                    <div class="goal-stat-big">@SessionCurrentDisplay</div>
                                    <div class="goal-stat-label">CURRENT</div>
                                    <div class="goal-stat-mid">@SessionTargetDisplay</div>
                                    <div class="goal-stat-label">TARGET</div>
                                </div>
                            </div>

                            @if (IsTimerSession)
                            {
                                <div class="goal-actions">
                                    @if (_timerState is TimerGoalState.Idle)
                                    {
                                        <button class="btn primary" @onclick="StartTimer">Start</button>
                                    }
                                    else if (_timerState is TimerGoalState.Running)
                                    {
                                        <button class="btn" @onclick="PauseTimer">Pause</button>
                                    }
                                    else if (_timerState is TimerGoalState.Paused)
                                    {
                                        <button class="btn primary" @onclick="StartTimer">Resume</button>
                                    }
                                    <button class="btn" @onclick="ResetTimer">Reset</button>
                                </div>
                                <div class="goal-timer-row">
                                    <span>Elapsed @FormatClock(TimerElapsed)</span>
                                    <span>Remaining @FormatClock(TimerRemaining)</span>
                                </div>
                            }
                            <div class="goal-state @(SessionComplete ? "done" : null)">@(SessionComplete ? "Complete" : "In progress")</div>
                            <button class="btn goal-reset" @onclick="ResetSession">Reset session</button>
                        </div>

                        <div class="goal-card">
                            <div class="goal-card-title">DOCUMENT</div>
                            <label class="goal-field">
                                <span>GOAL TYPE</span>
                                <select @bind="DocumentGoalTypeString">
                                    <option value="WordCount">Word count</option>
                                    <option value="PageCount">Page count</option>
                                </select>
                            </label>
                            <label class="goal-field">
                                <span>TARGET</span>
                                <input type="number" min="1" max="1000000" @bind="DocumentTargetValue" />
                            </label>
                            <div class="goal-bar-track">
                                <div class="goal-bar-fill @(DocumentComplete ? "done" : null)" style="width:@(Math.Min(100, DocumentPercent).ToString("0.#", System.Globalization.CultureInfo.InvariantCulture))%"></div>
                            </div>
                            <div class="goal-timer-row">
                                <span>@DocumentCurrentDisplay</span>
                                <span>of @DocumentTargetDisplay</span>
                            </div>
                            <div class="goal-state @(DocumentComplete ? "done" : null)">@(DocumentComplete ? "Complete" : "In progress")</div>
                        </div>
                    </div>
                }
            </div>
        </aside>

        <main class="center-pane">
            <div class="editor-surface" hidden="@(_mainViewIndex != 0)">
                <div class="editor-stack" style="--editor-font-size:@(_editorFontPx)px">
                    <div id="editor-host"></div>
                </div>
            </div>

            @if (_mainViewIndex == 1)
            {
                @if (!IsScreenplayMode)
                {
                    <div class="board-empty">The Beat Board works in Screenplay mode.
Open a .fountain file to see nested index cards here.</div>
                }
                else if (_analysis.BoardLanes.Count == 0)
                {
                    <div class="board-empty">The board mirrors your script's structure.
Add Acts (#), Sequences (##), and Scenes to see nested index cards here.</div>
                }
                else
                {
                    <div class="board-surface">
                        @foreach (var lane in _analysis.BoardLanes)
                        {
                            <div class="board-lane">
                                <div class="board-lane-title">@lane.Heading</div>
                                @if (lane.Description.Length > 0)
                                {
                                    <div class="board-lane-synopsis">@lane.Description</div>
                                }
                                @foreach (var card in lane.Children)
                                {
                                    @RenderBoardCard(card)
                                }
                            </div>
                        }
                    </div>
                }
            }
            else if (_mainViewIndex == 2)
            {
                @if (!IsScreenplayMode)
                {
                    <div class="preview-empty">Page preview works in Screenplay mode.
Open a .fountain file to see formatted pages.</div>
                }
                else
                {
                    <div class="preview-toolbar">
                        <span>@_analysis.PageCount page@(_analysis.PageCount == 1 ? "" : "s")</span>
                        <button class="btn" @onclick="() => AdjustPreviewZoom(-0.15)">−</button>
                        <span>@((int)Math.Round(_previewZoom * 100))%</span>
                        <button class="btn" @onclick="() => AdjustPreviewZoom(+0.15)">+</button>
                    </div>
                    <div class="preview-surface">
                        @foreach (var page in _analysis.PreviewPages)
                        {
                            <div class="preview-page" style="font-size:@(PreviewFontPx)px">
                                <div class="preview-page-number">
                                    @if (!page.IsTitlePage && page.PageNumber > 1)
                                    {
                                        <span>@(page.PageNumber).</span>
                                    }
                                </div>
                                <div class="preview-body">
                                    @foreach (var line in page.Lines)
                                    {
                                        <div class="pl @StyleClass(line.Style)" style="@IndentStyle(line)">@(line.Text.Length == 0 ? " " : line.Text)</div>
                                    }
                                </div>
                            </div>
                        }
                    </div>
                }
            }
        </main>
    </div>

    <footer class="statusbar">
        <span>@ModeStatusText</span>
        <span>Ln @_caretLine</span>
        <span>@_caretElementLabel</span>
        <span>~@_analysis.PageCount page@(_analysis.PageCount == 1 ? "" : "s")</span>
        <span>@_analysis.WordCount.ToString("N0") words</span>
        <span class="spacer"></span>
        <button class="icon-btn" title="Undo (Ctrl+Z)" @onclick="UndoAsync">↶</button>
        <button class="icon-btn" title="Redo (Ctrl+Y)" @onclick="RedoAsync">↷</button>
        <button class="icon-btn" title="Smaller editor text" @onclick="() => AdjustEditorFont(-1)">A−</button>
        <button class="icon-btn" title="Larger editor text" @onclick="() => AdjustEditorFont(+1)">A+</button>
        <span class="status-message">@_statusMessage</span>
    </footer>
</div>

@if (_saveAsOpen)
{
    <div class="modal-backdrop">
        <div class="modal">
            <h3>Save script</h3>
            <p>Name this script. It is stored on the server's data volume. “.fountain” is added when no extension is given.</p>
            <input type="text" @bind="_saveAsName" @bind:event="oninput" placeholder="my-screenplay.fountain"
                   @onkeydown="OnSaveAsKeyDown" />
            @if (_saveAsError.Length > 0)
            {
                <div class="modal-error">@_saveAsError</div>
            }
            <div class="modal-actions">
                <button class="btn" @onclick="CloseSaveAs">Cancel</button>
                <button class="btn primary" @onclick="ConfirmSaveAsAsync">Save</button>
            </div>
        </div>
    </div>
}

@if (_pendingAction != PendingAction.None)
{
    <div class="modal-backdrop">
        <div class="modal">
            <h3>Unsaved changes</h3>
            <p>“@DisplayName” has unsaved changes. Discard them and continue?</p>
            <div class="modal-actions">
                <button class="btn" @onclick="CancelPendingAction">Cancel</button>
                <button class="btn primary" @onclick="ConfirmPendingActionAsync">Discard changes</button>
            </div>
        </div>
    </div>
}

@if (_recoveryPrompt is not null)
{
    <div class="modal-backdrop">
        <div class="modal">
            <h3>Recover Document</h3>
            <p>A recovered unsaved document was found. Would you like to restore it?</p>
            <div class="modal-actions">
                <button class="btn" @onclick="DiscardRecoveryAsync">Discard</button>
                <button class="btn primary" @onclick="RestoreRecoveryAsync">Restore</button>
            </div>
        </div>
    </div>
}

@if (_deleteTarget is not null)
{
    <div class="modal-backdrop">
        <div class="modal">
            <h3>Delete script</h3>
            <p>Delete “@_deleteTarget” from the server? This cannot be undone.</p>
            <div class="modal-actions">
                <button class="btn" @onclick="() => _deleteTarget = null">Cancel</button>
                <button class="btn primary" @onclick="ConfirmDeleteAsync">Delete</button>
            </div>
        </div>
    </div>
}

@code {
    private enum PendingAction { None, NewFile, OpenFile }

    private readonly DocumentAnalyzer _analyzer = new();
    private DotNetObjectReference<Editor>? _selfRef;
    private CancellationTokenSource? _autosaveCts;

    private DocumentAnalysis _analysis = new(
        Array.Empty<string>(), Array.Empty<OutlineNode>(), Array.Empty<NoteEntry>(),
        Array.Empty<PreviewPage>(), Array.Empty<BoardCard>(), 0, 0, Array.Empty<TitlePageEntry>());

    private IReadOnlyList<ScriptFileEntry> _files = Array.Empty<ScriptFileEntry>();
    private string _fileName = string.Empty;
    private string _content = string.Empty;
    private bool _isDirty;
    private bool _autosaveEnabled;
    private int _mainViewIndex;
    private int _sidebarTab;
    private int _caretLine = 1;
    private string _caretElementLabel = "Action";
    private string _statusMessage = "Ready";
    private const int MinEditorFontPx = 11;
    private const int MaxEditorFontPx = 28;
    private const double MinPreviewZoom = 0.55;
    private const double MaxPreviewZoom = 2.5;

    private int _editorFontPx = 15;
    private double _previewZoom = 1.25;

    private string _saveAsName = string.Empty;
    private string _saveAsError = string.Empty;
    private bool _saveAsOpen;
    private PendingAction _pendingAction = PendingAction.None;
    private string _pendingOpenName = string.Empty;
    private string? _deleteTarget;

    private string DisplayName => _fileName.Length == 0 ? "Untitled" : _fileName;
    private bool IsScreenplayMode => !_fileName.EndsWith(".md", StringComparison.OrdinalIgnoreCase);
    private string ModeStatusText => IsScreenplayMode ? "MODE: SCREENPLAY" : "MODE: MARKDOWN";
    private int PreviewFontPx => (int)Math.Round(12 * _previewZoom);
    private string OutlineEmptyMessage => IsScreenplayMode
        ? "Structure appears as you write.\nUse # Act, ## Sequence, and INT./EXT. scene headings."
        : "Markdown headings (#, ##, …) appear here.";

    protected override void OnInitialized()
    {
        _files = Library.List();
        _goals = GoalStore.Load();
        RunAnalysis();
        CaptureSessionBaseline();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _selfRef = DotNetObjectReference.Create(this);
            await JS.InvokeVoidAsync("passage.init", _selfRef);
            await SyncThemeAsync();
            await RestoreSessionAsync();
            await CheckForRecoveryAsync();
        }
    }

    // The theme is applied by an inline script in App.razor before first paint,
    // so the server only needs to read back which one is showing to label the
    // toggle. Persisting is passage.js's job.
    private string _theme = "dark";

    private async Task SyncThemeAsync()
    {
        try
        {
            _theme = await JS.InvokeAsync<string>("passage.getTheme");
        }
        catch (JSException)
        {
            return;
        }

        StateHasChanged();
    }

    private async Task ToggleThemeAsync()
    {
        var next = _theme == "light" ? "dark" : "light";
        try
        {
            _theme = await JS.InvokeAsync<string>("passage.setTheme", next);
        }
        catch (JSException)
        {
        }
    }

    // Crash recovery. Separate from the file autosave below, which writes the
    // real file: this offers back unsaved work after the server or the browser
    // died. Snapshots are written client-side by passage.js — see the comment
    // there for why they are not kept on the server.
    private sealed record RecoverySnapshot
    {
        public string Text { get; init; } = string.Empty;

        public string? FileName { get; init; }

        public DateTimeOffset SavedAtUtc { get; init; }
    }

    private RecoverySnapshot? _recoveryPrompt;

    private async Task CheckForRecoveryAsync()
    {
        RecoverySnapshot? snapshot;
        try
        {
            snapshot = await JS.InvokeAsync<RecoverySnapshot?>("passage.readRecoverySnapshot");
        }
        catch (JSException)
        {
            return;
        }

        if (snapshot is null || snapshot.Text.Length == 0)
        {
            return;
        }

        // Only offer work the saved file does not already contain. An untitled
        // snapshot has no file to compare against, so it always counts as newer.
        var name = snapshot.FileName;
        if (!string.IsNullOrEmpty(name))
        {
            var entry = _files.FirstOrDefault(file => file.Name == name);
            if (entry is not null && snapshot.SavedAtUtc.UtcDateTime <= entry.LastModifiedUtc)
            {
                await JS.InvokeVoidAsync("passage.clearRecoverySnapshot");
                return;
            }
        }

        _recoveryPrompt = snapshot;
        StateHasChanged();
    }

    private async Task RestoreRecoveryAsync()
    {
        var snapshot = _recoveryPrompt;
        _recoveryPrompt = null;
        if (snapshot is null)
        {
            return;
        }

        _content = snapshot.Text;
        _fileName = snapshot.FileName ?? string.Empty;
        _mainViewIndex = 0;
        _caretLine = 1;
        RunAnalysis();
        UpdateCaretElementLabel();
        await ReplaceEditorContentAsync();

        // The recovered text is by definition not what is on disk, so the
        // buffer stays dirty and keeps snapshotting until it is saved.
        _isDirty = true;
        await JS.InvokeVoidAsync("passage.setDirty", true);
        CaptureSessionBaseline();
        await PersistSessionAsync();
        _statusMessage = "Recovered unsaved work";
        StateHasChanged();
    }

    private async Task DiscardRecoveryAsync()
    {
        _recoveryPrompt = null;
        try
        {
            await JS.InvokeVoidAsync("passage.clearRecoverySnapshot");
        }
        catch (JSException)
        {
        }

        _statusMessage = "Discarded recovered document";
        StateHasChanged();
    }

    // Per-browser session state. Held in localStorage by passage.js rather than
    // in Passage.Core's SessionStorage, which writes one file under the server's
    // LocalApplicationData — shared by every client, so two browsers would
    // overwrite each other's "last document".
    private sealed record SessionSnapshot
    {
        public string? FileName { get; init; }

        public int CaretLine { get; init; } = 1;

        public int EditorFontPx { get; init; } = 15;

        public double PreviewZoom { get; init; } = 1.25;

        public IReadOnlyList<string>? RecentFiles { get; init; }
    }

    // Matches the Linux MaxRecentFiles.
    private const int MaxRecentFiles = 8;

    private readonly List<string> _recentFiles = new();

    private void AddRecentFile(string name)
    {
        if (string.IsNullOrWhiteSpace(name))
        {
            return;
        }

        _recentFiles.Remove(name);
        _recentFiles.Insert(0, name);
        while (_recentFiles.Count > MaxRecentFiles)
        {
            _recentFiles.RemoveAt(_recentFiles.Count - 1);
        }
    }

    private async Task RequestOpenRecentAsync(string name)
    {
        if (name == _fileName)
        {
            return;
        }

        // Another client may have deleted it since this list was written.
        // Mirrors the Linux OpenRecent: drop the entry, say so, do not throw.
        if (!Library.Exists(name))
        {
            _recentFiles.Remove(name);
            _files = Library.List();
            _statusMessage = $"File not found: {name}";
            await PersistSessionAsync();
            return;
        }

        RequestOpenFile(name);
    }

    private async Task RestoreSessionAsync()
    {
        SessionSnapshot? snapshot;
        try
        {
            snapshot = await JS.InvokeAsync<SessionSnapshot?>("passage.loadSession");
        }
        catch (JSException)
        {
            return;
        }

        if (snapshot is null)
        {
            return;
        }

        _editorFontPx = Math.Clamp(snapshot.EditorFontPx, MinEditorFontPx, MaxEditorFontPx);
        _previewZoom = Math.Clamp(snapshot.PreviewZoom, MinPreviewZoom, MaxPreviewZoom);

        // Prune entries the server no longer has rather than erroring on click.
        _recentFiles.Clear();
        if (snapshot.RecentFiles is not null)
        {
            var present = _files.Select(file => file.Name).ToHashSet(StringComparer.Ordinal);
            _recentFiles.AddRange(snapshot.RecentFiles
                .Where(name => !string.IsNullOrWhiteSpace(name) && present.Contains(name))
                .Distinct(StringComparer.Ordinal)
                .Take(MaxRecentFiles));
        }

        var name = snapshot.FileName;
        if (!string.IsNullOrEmpty(name))
        {
            if (_files.Any(file => file.Name == name))
            {
                await OpenFileAsync(name);
                await JS.InvokeVoidAsync("passage.scrollToLine", Math.Max(1, snapshot.CaretLine));
            }
            else
            {
                // The file was deleted from the library by another client, or
                // by this one in an earlier session. Start blank rather than
                // erroring, and let the next save drop the stale name.
                _statusMessage = $"{name} is no longer in the library";
            }
        }

        await PersistSessionAsync();
        StateHasChanged();
    }

    private async Task PersistSessionAsync()
    {
        try
        {
            await JS.InvokeVoidAsync(
                "passage.setSessionDocument", _fileName, _editorFontPx, _previewZoom, _recentFiles);
        }
        catch (JSException)
        {
        }
    }

    // ---- JS callbacks ----

    [JSInvokable]
    public async Task OnEditorChanged(string text, int version, int caretLine)
    {
        _content = text;
        _isDirty = true;
        _caretLine = caretLine;
        RunAnalysis();
        UpdateCaretElementLabel();
        await JS.InvokeVoidAsync("passage.applyHighlights", version, _analysis.LineClasses);
        ScheduleAutosave();
        StateHasChanged();
    }

    [JSInvokable]
    public void OnCaretMoved(int line)
    {
        _caretLine = line;
        UpdateCaretElementLabel();
        StateHasChanged();
    }

    [JSInvokable]
    public async Task OnSaveShortcut()
    {
        await SaveAsync();
        StateHasChanged();
    }

    [JSInvokable]
    public async Task OnZoomShortcut(int delta)
    {
        await AdjustEditorFont(delta);
        StateHasChanged();
    }

    // ---- File actions ----

    private async Task SaveAsync()
    {
        if (_fileName.Length == 0)
        {
            _saveAsName = string.Empty;
            _saveAsError = string.Empty;
            _saveAsOpen = true;
            return;
        }

        Library.Save(_fileName, _content);
        _isDirty = false;
        _files = Library.List();
        _statusMessage = $"Saved {DateTime.Now:HH:mm:ss}";
        await JS.InvokeVoidAsync("passage.setDirty", false);
    }

    private async Task ConfirmSaveAsAsync()
    {
        if (!ScriptLibrary.TryValidateName(_saveAsName, out var validated))
        {
            _saveAsError = "Enter a valid file name (no path separators).";
            return;
        }

        if (Library.Exists(validated) && _saveAsError != OverwriteWarning(validated))
        {
            _saveAsError = OverwriteWarning(validated);
            return;
        }

        _fileName = validated;
        _saveAsOpen = false;
        _saveAsError = string.Empty;
        AddRecentFile(validated);
        await PersistSessionAsync();
        await SaveAsync();

        // Only the name changed. The extension can flip screenplay/markdown
        // mode, so the classification is refreshed — but the document is left
        // alone, or a rename would cost the user their undo stack and caret.
        RunAnalysis();
        UpdateCaretElementLabel();
        await JS.InvokeVoidAsync("passage.refreshHighlights", _analysis.LineClasses);
    }

    private static string OverwriteWarning(string name) =>
        $"“{name}” already exists — click Save again to overwrite it.";

    private void OnSaveAsKeyDown(KeyboardEventArgs args)
    {
        if (args.Key == "Enter")
        {
            _ = ConfirmSaveAsAsync();
        }
        else if (args.Key == "Escape")
        {
            CloseSaveAs();
        }
    }

    private void CloseSaveAs()
    {
        _saveAsOpen = false;
        _saveAsError = string.Empty;
    }

    private void RequestNewFile()
    {
        if (_isDirty)
        {
            _pendingAction = PendingAction.NewFile;
            return;
        }

        _ = StartNewFileAsync();
    }

    private void RequestOpenFile(string name)
    {
        if (name == _fileName)
        {
            return;
        }

        if (_isDirty)
        {
            _pendingAction = PendingAction.OpenFile;
            _pendingOpenName = name;
            return;
        }

        _ = OpenFileAsync(name);
    }

    private void CancelPendingAction()
    {
        _pendingAction = PendingAction.None;
        _pendingOpenName = string.Empty;
    }

    private async Task ConfirmPendingActionAsync()
    {
        var action = _pendingAction;
        var openName = _pendingOpenName;
        CancelPendingAction();

        if (action == PendingAction.NewFile)
        {
            await StartNewFileAsync();
        }
        else if (action == PendingAction.OpenFile)
        {
            await OpenFileAsync(openName);
        }
    }

    private async Task StartNewFileAsync()
    {
        _fileName = string.Empty;
        _content = string.Empty;
        _isDirty = false;
        _statusMessage = "New script";
        await ResetEditorAsync();
        CaptureSessionBaseline();
        await PersistSessionAsync();
    }

    private async Task OpenFileAsync(string name)
    {
        try
        {
            _content = Library.Load(name);
        }
        catch (Exception exception) when (exception is IOException or ArgumentException or UnauthorizedAccessException)
        {
            _statusMessage = $"Could not open {name}: {exception.Message}";
            return;
        }

        _fileName = name;
        _isDirty = false;
        _statusMessage = $"Opened {name}";
        AddRecentFile(name);
        await ResetEditorAsync();
        CaptureSessionBaseline();
        await PersistSessionAsync();
    }

    private async Task ResetEditorAsync()
    {
        _mainViewIndex = 0;
        _caretLine = 1;
        RunAnalysis();
        UpdateCaretElementLabel();
        var version = await JS.InvokeAsync<int>("passage.setContent", _content);
        await JS.InvokeVoidAsync("passage.applyHighlights", version, _analysis.LineClasses);
        StateHasChanged();
    }

    private void RequestDeleteFile(string name)
    {
        _deleteTarget = name;
    }

    private async Task ConfirmDeleteAsync()
    {
        var target = _deleteTarget;
        _deleteTarget = null;
        if (target is null)
        {
            return;
        }

        try
        {
            Library.Delete(target);
        }
        catch (Exception exception) when (exception is IOException or ArgumentException or UnauthorizedAccessException)
        {
            _statusMessage = $"Could not delete {target}: {exception.Message}";
            return;
        }

        _files = Library.List();
        _recentFiles.Remove(target);
        await PersistSessionAsync();
        if (target == _fileName)
        {
            // The open buffer survives as an unsaved Untitled document.
            _fileName = string.Empty;
            _isDirty = true;
            await JS.InvokeVoidAsync("passage.setDirty", true);
            await PersistSessionAsync();
        }

        _statusMessage = $"Deleted {target}";
    }

    private async Task ExportAsync(string format)
    {
        await JS.InvokeVoidAsync("passage.exportDocument", format, DisplayName);
        _statusMessage = $"Exported {format.ToUpperInvariant()}";
    }

    // ---- Autosave ----

    private void ScheduleAutosave()
    {
        if (!_autosaveEnabled || _fileName.Length == 0)
        {
            return;
        }

        _autosaveCts?.Cancel();
        _autosaveCts = new CancellationTokenSource();
        var token = _autosaveCts.Token;
        _ = Task.Run(async () =>
        {
            try
            {
                await Task.Delay(1500, token);
                await InvokeAsync(async () =>
                {
                    if (_isDirty && _fileName.Length > 0)
                    {
                        await SaveAsync();
                        StateHasChanged();
                    }
                });
            }
            catch (TaskCanceledException)
            {
                // Superseded by a newer edit.
            }
        }, CancellationToken.None);
    }

    // ---- Analysis / rendering helpers ----

    private void RunAnalysis()
    {
        _analysis = IsScreenplayMode ? _analyzer.Analyze(_content) : DocumentAnalyzer.AnalyzeMarkdown(_content);
    }

    // Replaces the whole document: clears CodeMirror's undo stack and resets
    // the caret. Only correct when the text really is different.
    private async Task ReplaceEditorContentAsync()
    {
        var version = await JS.InvokeAsync<int>("passage.setContent", _content);
        await JS.InvokeVoidAsync("passage.applyHighlights", version, _analysis.LineClasses);
    }

    private void UpdateCaretElementLabel()
    {
        var index = _caretLine - 1;
        var cssClass = index >= 0 && index < _analysis.LineClasses.Length ? _analysis.LineClasses[index] : string.Empty;
        _caretElementLabel = cssClass switch
        {
            "sx-scene" => "Scene Heading",
            "sx-character" => "Character",
            "sx-dialogue" => "Dialogue",
            "sx-paren" => "Parenthetical",
            "sx-transition" => "Transition",
            "sx-section" => "Section",
            "sx-synopsis" => "Synopsis",
            "sx-note" => "Note",
            "sx-boneyard" => "Boneyard",
            "sx-centered" => "Centered",
            "sx-lyrics" => "Lyrics",
            "sx-titlepage" => "Title Page",
            "md-heading" => "Heading",
            _ => IsScreenplayMode ? "Action" : "Text"
        };
    }

    private void SetMainView(int index)
    {
        _mainViewIndex = index;
        if (index == 0)
        {
            _ = JS.InvokeVoidAsync("passage.focusEditor");
        }
    }

    private async Task JumpToLineAsync(int lineNumber)
    {
        _mainViewIndex = 0;
        await JS.InvokeVoidAsync("passage.scrollToLine", lineNumber);
    }

    // CodeMirror owns the undo stack; these just drive it and hand focus back.
    private async Task UndoAsync() => await JS.InvokeVoidAsync("passage.undo");

    private async Task RedoAsync() => await JS.InvokeVoidAsync("passage.redo");

    private async Task AdjustPreviewZoom(double delta)
    {
        _previewZoom = Math.Clamp(_previewZoom + delta, MinPreviewZoom, MaxPreviewZoom);
        await PersistSessionAsync();
    }

    private async Task AdjustEditorFont(int delta)
    {
        _editorFontPx = Math.Clamp(_editorFontPx + delta, MinEditorFontPx, MaxEditorFontPx);
        await PersistSessionAsync();
    }

    private static string StyleClass(LayoutTextStyle style) => style switch
    {
        LayoutTextStyle.LeftBold => "st-bold",
        LayoutTextStyle.CenterWithinBody => "st-center",
        LayoutTextStyle.CenterWithinBodyBold => "st-center st-bold",
        LayoutTextStyle.RightWithinBody => "st-right",
        _ => string.Empty
    };

    private static string IndentStyle(PreviewLine line)
    {
        if (line.Style is LayoutTextStyle.Left or LayoutTextStyle.LeftBold && line.IndentChars > 0)
        {
            return $"padding-left:{line.IndentChars:0.##}ch";
        }

        return string.Empty;
    }

    private static string KindClass(string kind) => kind switch
    {
        "Act" or "Sequence" or "Beat" => "k-act",
        "Scene" => "k-scene",
        "Synopsis" => "k-synopsis",
        "Note" => "k-note",
        _ => "k-act"
    };

    private static string FormatTimestamp(DateTime utc)
    {
        var local = utc.ToLocalTime();
        return local.Date == DateTime.Now.Date ? local.ToString("HH:mm") : local.ToString("d MMM");
    }

    private RenderFragment<OutlineNode> RenderOutlineNode => node => __builder =>
    {
        <div class="outline-node">
            <div class="outline-label" @onclick="() => JumpToLineAsync(node.LineNumber)">
                <span class="outline-kind @KindClass(node.Kind)">@node.Kind</span>
                <span>@node.Label</span>
            </div>
            @if (node.Children.Count > 0)
            {
                <div class="outline-children">
                    @foreach (var child in node.Children)
                    {
                        @RenderOutlineNode(child)
                    }
                </div>
            }
        </div>
    };

    private RenderFragment<BoardCard> RenderBoardCard => card => __builder =>
    {
        <div class="board-card" @onclick="() => JumpToLineAsync(card.LineNumber)" @onclick:stopPropagation="true">
            <span class="card-kind">@card.Kind</span>
            <div class="card-heading">@card.Heading</div>
            @if (card.Description.Length > 0)
            {
                <div class="card-body">@card.Description</div>
            }
            @foreach (var child in card.Children)
            {
                @RenderBoardCard(child)
            }
        </div>
    };

    // ---- Goals ----

    private GoalSettings _goals = new();
    private int _sessionWordBaseline;
    private int _sessionPageBaseline;
    private TimerGoalState _timerState = TimerGoalState.Idle;
    private TimeSpan _timerAccumulated = TimeSpan.Zero;
    private DateTime? _timerRunningSince;
    private System.Timers.Timer? _timerTick;

    private bool IsTimerSession => _goals.SessionType == GoalType.Timer;
    private TimeSpan TimerTarget => TimeSpan.FromMinutes(Math.Max(1, _goals.SessionTimerMinutes));

    private TimeSpan TimerElapsed
    {
        get
        {
            var elapsed = _timerAccumulated;
            if (_timerRunningSince is { } since)
            {
                elapsed += DateTime.UtcNow - since;
            }

            return elapsed > TimerTarget ? TimerTarget : elapsed;
        }
    }

    private TimeSpan TimerRemaining => TimerTarget - TimerElapsed;

    private string SessionGoalTypeString
    {
        get => _goals.SessionType.ToString();
        set
        {
            if (Enum.TryParse<GoalType>(value, out var parsed) && parsed != _goals.SessionType)
            {
                _goals.SessionType = parsed;
                GoalStore.Save(_goals);
            }
        }
    }

    private string DocumentGoalTypeString
    {
        get => _goals.DocumentType.ToString();
        set
        {
            if (Enum.TryParse<GoalType>(value, out var parsed) && parsed != _goals.DocumentType
                && parsed != GoalType.Timer)
            {
                _goals.DocumentType = parsed;
                GoalStore.Save(_goals);
            }
        }
    }

    private int SessionTargetValue
    {
        get => _goals.SessionType switch
        {
            GoalType.PageCount => _goals.SessionPageTarget,
            GoalType.Timer => _goals.SessionTimerMinutes,
            _ => _goals.SessionWordTarget
        };
        set
        {
            var clamped = Math.Clamp(value, 1, 1_000_000);
            switch (_goals.SessionType)
            {
                case GoalType.PageCount:
                    _goals.SessionPageTarget = clamped;
                    break;
                case GoalType.Timer:
                    if (_goals.SessionTimerMinutes != clamped)
                    {
                        _goals.SessionTimerMinutes = clamped;
                        ResetTimer();
                    }
                    break;
                default:
                    _goals.SessionWordTarget = clamped;
                    break;
            }

            GoalStore.Save(_goals);
        }
    }

    private int DocumentTargetValue
    {
        get => _goals.DocumentType == GoalType.PageCount ? _goals.DocumentPageTarget : _goals.DocumentWordTarget;
        set
        {
            var clamped = Math.Clamp(value, 1, 1_000_000);
            if (_goals.DocumentType == GoalType.PageCount)
            {
                _goals.DocumentPageTarget = clamped;
            }
            else
            {
                _goals.DocumentWordTarget = clamped;
            }

            GoalStore.Save(_goals);
        }
    }

    private int SessionCurrent => _goals.SessionType switch
    {
        GoalType.PageCount => Math.Max(0, _analysis.PageCount - _sessionPageBaseline),
        GoalType.Timer => (int)TimerElapsed.TotalSeconds,
        _ => Math.Max(0, _analysis.WordCount - _sessionWordBaseline)
    };

    private int SessionTarget => _goals.SessionType == GoalType.Timer
        ? (int)TimerTarget.TotalSeconds
        : SessionTargetValue;

    private double SessionPercent => SessionTarget <= 0 ? 0 : Math.Min(100.0, SessionCurrent * 100.0 / SessionTarget);
    private bool SessionComplete => IsTimerSession ? _timerState == TimerGoalState.Completed : SessionCurrent >= SessionTarget;

    private int DocumentCurrent => _goals.DocumentType == GoalType.PageCount ? _analysis.PageCount : _analysis.WordCount;
    private double DocumentPercent => DocumentTargetValue <= 0 ? 0 : Math.Min(100.0, DocumentCurrent * 100.0 / DocumentTargetValue);
    private bool DocumentComplete => DocumentCurrent >= DocumentTargetValue;

    private string SessionCurrentDisplay => _goals.SessionType switch
    {
        GoalType.PageCount => FormatUnit(SessionCurrent, "page"),
        GoalType.Timer => FormatClock(TimerElapsed),
        _ => FormatUnit(SessionCurrent, "word")
    };

    private string SessionTargetDisplay => _goals.SessionType switch
    {
        GoalType.PageCount => FormatUnit(SessionTargetValue, "page"),
        GoalType.Timer => FormatClock(TimerTarget),
        _ => FormatUnit(SessionTargetValue, "word")
    };

    private string DocumentCurrentDisplay => FormatUnit(DocumentCurrent, _goals.DocumentType == GoalType.PageCount ? "page" : "word");
    private string DocumentTargetDisplay => FormatUnit(DocumentTargetValue, _goals.DocumentType == GoalType.PageCount ? "page" : "word");

    private static string FormatUnit(int value, string unit) => $"{value:N0} {unit}{(value == 1 ? "" : "s")}";

    private static string FormatClock(TimeSpan span)
    {
        if (span < TimeSpan.Zero) span = TimeSpan.Zero;
        return span.TotalHours >= 1
            ? $"{(int)span.TotalHours}:{span.Minutes:00}:{span.Seconds:00}"
            : $"{span.Minutes:00}:{span.Seconds:00}";
    }

    // Circumference of the r=48 progress ring; the dash pair draws pct of it.
    private static string RingDash(double percent)
    {
        const double circumference = 2 * Math.PI * 48;
        var filled = Math.Clamp(percent, 0, 100) / 100.0 * circumference;
        return $"{filled.ToString("0.#", System.Globalization.CultureInfo.InvariantCulture)} {circumference.ToString("0.#", System.Globalization.CultureInfo.InvariantCulture)}";
    }

    private void CaptureSessionBaseline()
    {
        _sessionWordBaseline = _analysis.WordCount;
        _sessionPageBaseline = _analysis.PageCount;
    }

    private void ResetSession()
    {
        CaptureSessionBaseline();
        ResetTimer();
        _statusMessage = "Session goal reset";
    }

    private void StartTimer()
    {
        if (_timerState is TimerGoalState.Completed or TimerGoalState.Running)
        {
            return;
        }

        _timerRunningSince = DateTime.UtcNow;
        _timerState = TimerGoalState.Running;
        EnsureTimerTick();
    }

    private void PauseTimer()
    {
        if (_timerState != TimerGoalState.Running)
        {
            return;
        }

        _timerAccumulated = TimerElapsed;
        _timerRunningSince = null;
        _timerState = _timerAccumulated >= TimerTarget ? TimerGoalState.Completed : TimerGoalState.Paused;
        _timerTick?.Stop();
    }

    private void ResetTimer()
    {
        _timerAccumulated = TimeSpan.Zero;
        _timerRunningSince = null;
        _timerState = TimerGoalState.Idle;
        _timerTick?.Stop();
    }

    private void EnsureTimerTick()
    {
        if (_timerTick is null)
        {
            _timerTick = new System.Timers.Timer(500);
            _timerTick.Elapsed += (_, _) => _ = InvokeAsync(OnTimerTick);
        }

        _timerTick.Start();
    }

    private void OnTimerTick()
    {
        if (_timerState == TimerGoalState.Running && TimerElapsed >= TimerTarget)
        {
            _timerAccumulated = TimerTarget;
            _timerRunningSince = null;
            _timerState = TimerGoalState.Completed;
            _timerTick?.Stop();
            _statusMessage = "Session timer complete";
        }

        StateHasChanged();
    }

    public void Dispose()
    {
        _autosaveCts?.Cancel();
        _timerTick?.Stop();
        _timerTick?.Dispose();
        _selfRef?.Dispose();
    }
}
