        public bool HasScript => _editor._fileName.Length > 0;
        public void Save() => _editor.SaveSlate();
        // The dock's own events re-render the dock only; the status bar belongs to the page.
        public void SetStatus(string message)
        {
            _editor._statusMessage = message;
            _editor.StateHasChanged();
        }

        public IReadOnlyList<CharacterChoice> Cast => ProjectContext.Cast(_editor._analysis.Characters, _editor._slate.Characters);
        public IReadOnlyList<SceneChoice> Scenes => ProjectContext.Scenes(_editor._analysis.Elements);
        public SceneChoice? SceneUnderCaret => ProjectContext.SceneAt(Scenes, _editor._caretLine);
        public IReadOnlyList<string> SpeakersOf(SceneChoice scene) =>
            ProjectContext.SpeakersOf(scene, StoryFilter.SceneSpeakers(_editor._analysis.Elements), Cast);
        public SceneChoice? ResolveScene(Anchor anchor) => ProjectContext.Resolve(Scenes, anchor);
        public IReadOnlyList<string> SpeakersFor(Anchor anchor) => _editor.AnchorScene(anchor) is { } scene ? SpeakersOf(scene) : Array.Empty<string>();
        public IReadOnlyList<BracketChoice> Brackets => ProjectContext.Brackets(_editor._analysis.Brackets, _editor._slate.IgnoredBrackets);
        public Anchor? HandBracket() => _editor.HandBracketAnchor();
        public async Task OpenBracketAsync(string text)
        {
            await _editor.OpenBracketRunAsync(text);
            _editor.StateHasChanged();
        }

        public async Task NextBracketAsync()
