    private async Task ToggleCardKeyAsync(BoardCard card)
    {
        if (IsCardKey(card))
        {
            StoryItems.SetKey(_slate.Story, card.Id, StoryItems.CardKind, card.Heading, false);
            SaveSlate();
            return;
        }

        var id = await EnsureCardIdAsync(card);
        if (id is null)
        {
            return;
        }

        StoryItems.SetKey(_slate.Story, id.Value, StoryItems.CardKind, card.Heading, true);
        SaveSlate();
    }

    /// <summary>Returns the card's stable id, stamping [[id:…]] onto its heading
    /// line first if it has none or shares one with an earlier heading. One
    /// replaceInLine edit, so one undo step; the line is appended to, never
    /// rebuilt, so a scene number survives (decision A2).</summary>
    private async Task<Guid?> EnsureCardIdAsync(BoardCard card, string verb = "star")
    {
        var lines = _content.Replace("\r\n", "\n").Split('\n');
        var index = card.LineNumber - 1;
        if (index < 0 || index >= lines.Length)
        {
            _statusMessage = $"Could not {verb}: that heading is no longer in the script.";
            return null;
        }

        var duplicate = IsDuplicateCard(card);
        if (!StoryItems.NeedsStamp(lines[index], duplicate) && card.Id != Guid.Empty)
        {
            return card.Id;
        }

        var id = Guid.NewGuid();
        var wanted = StoryItems.StampLine(lines[index], id);
        bool replaced;
        try
        {
            replaced = await JS.InvokeAsync<bool>("passage.replaceInLine", index, lines[index], wanted);
        }
        catch (JSException)
        {
            replaced = false;
        }

        if (!replaced)
        {
            _statusMessage = $"Could not {verb}: the script changed under the card. Try again.";
            return null;
        }

        lines[index] = wanted;
        _content = string.Join('\n', lines);
        _isDirty = true;
        RunAnalysis();
        UpdateCaretElementLabel();
        _statusMessage = duplicate
            ? "That heading shared an id with an earlier card (a copy), so it was given a fresh one."
            : "Card marked with an id so its star and tags can follow it.";
        return id;
    }

    private void ToggleBeatKey(Beat beat)
    {
