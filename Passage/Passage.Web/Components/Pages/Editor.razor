    /// <summary>Called on Enter in the tag popover. Returns the id the item is
    /// now known by (a card is stamped first if it has none), or empty when
    /// nothing was tagged.</summary>
    [JSInvokable]
    public async Task<string> OnTagToggled(string targetId, string itemKind, string key)
    {
        Guid id;
        string label;
        if (itemKind == StoryItems.BeatKind)
        {
            var beat = Guid.TryParse(targetId, out var beatId) ? _slate.Beats.FirstOrDefault(entry => entry.Id == beatId) : null;
            if (beat is null)
            {
                _statusMessage = "Could not tag: that beat no longer exists.";
                StateHasChanged();
                return string.Empty;
            }

            id = beat.Id;
            label = beat.Title;
        }
        else
        {
            var line = targetId.StartsWith("line:", StringComparison.Ordinal) && int.TryParse(targetId[5..], out var number) ? number : 0;
            var live = _analysis.Elements
                .Where(element => element is SectionElement or SceneHeadingElement)
                .FirstOrDefault(element => line > 0
                    ? element.LineNumber == line
                    : Guid.TryParse(targetId, out var wanted) && element.Id == wanted && _analysis.DuplicateIdLines?.Contains(element.LineNumber) != true && StampedLines().Contains(element.LineNumber));
            if (live is null)
            {
                _statusMessage = "Could not tag: that heading is no longer in the script.";
                StateHasChanged();
                return string.Empty;
            }

            var heading = live is SectionElement section ? section.Heading : ((SceneHeadingElement)live).Heading;
            var stamped = await EnsureCardIdAsync(new BoardCard(heading, string.Empty, string.Empty, live.LineNumber, new List<BoardCard>(), live.Id), "tag");
            if (stamped is null)
            {
                StateHasChanged();
                return string.Empty;
            }

            id = stamped.Value;
            label = heading;
        }

        StoryItems.ToggleTag(_slate.Story, id, itemKind, label, key);
        SaveSlate();
        StateHasChanged();
        return id.ToString();
    }

