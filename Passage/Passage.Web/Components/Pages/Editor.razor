                <summary class="btn @(filter.Storylines.Count > 0 ? "active" : null)">Storylines@(filter.Storylines.Count > 0 ? $" ({filter.Storylines.Count})" : "")</summary>
                <div class="filter-pop">
                    @foreach (var line in _slate.Story.Storylines)
