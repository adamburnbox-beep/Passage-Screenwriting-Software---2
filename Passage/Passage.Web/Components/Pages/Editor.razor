    private static string ArcX(ArcChart chart, int x) =>
        ArcNumber(ArcLeft + (x - chart.XMin) / (double)Math.Max(1, chart.XMax - chart.XMin) * (ArcWidth - ArcLeft - ArcRight));

    // Razor reserves <text>, so the SVG labels are built as markup. Only
    // numbers and fixed strings go in.
    private static MarkupString ArcLabel(string x, string y, string anchor, string text) =>
