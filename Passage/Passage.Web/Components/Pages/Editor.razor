    // the carry with it. Chains are kept by what they are about (the seed
    // line), never listed by when they were run (rule 0.3).

    private ChainPath _chainPath;
    private ChainRun? _chain;
    private bool _burstRunning;

    private const int BurstReadInSeconds = 5;
    private const string ChainSlotsId = "chain-slots";
    private const string BridgeSlotsId = "bridge-slots";

