    private Dictionary<Guid, string> CardLabels()
    {
        var labels = new Dictionary<Guid, string>();
        foreach (var element in _analysis.Elements)
        {
            switch (element)
            {
                case SectionElement section:
                    labels.TryAdd(section.Id, section.Heading);
                    break;
                case SceneHeadingElement scene:
                    labels.TryAdd(scene.Id, scene.Heading);
                    break;
            }
        }

        return labels;
    }

    private RenderFragment<BoardCard> RenderCardStar => card => __builder =>
    {
        @if (card.Id != Guid.Empty)
        {
            var on = IsCardKey(card);
            <button class="icon-btn key-star @(on ? "on" : null)" title="Key beat"
                    @onclick="() => ToggleCardKeyAsync(card)" @onclick:stopPropagation="true">@(on ? "★" : "☆")</button>
        }
    };

    private async Task ToggleCardKeyAsync(BoardCard card)
    {
        if (IsCardKey(card))
        {
            StoryItems.SetKey(_slate.Story, card.Id, StoryItems.CardKind, card.Heading, false);
            SaveSlate();
            return;
        }

        var id = await EnsureCardIdAsync(card);
        if (id is null)
        {
            return;
        }

        StoryItems.SetKey(_slate.Story, id.Value, StoryItems.CardKind, card.Heading, true);
        SaveSlate();
    }

    /// <summary>Returns the card's stable id, stamping [[id:…]] onto its heading
    /// line first if it has none or shares one with an earlier heading. One
    /// replaceInLine edit, so one undo step; the line is appended to, never
    /// rebuilt, so a scene number survives (decision A2).</summary>
    private async Task<Guid?> EnsureCardIdAsync(BoardCard card, string verb = "star")
    {
        var lines = _content.Replace("\r\n", "\n").Split('\n');
        var index = card.LineNumber - 1;
        if (index < 0 || index >= lines.Length)
        {
            _statusMessage = $"Could not {verb}: that heading is no longer in the script.";
            return null;
        }

        var duplicate = IsDuplicateCard(card);
        if (!StoryItems.NeedsStamp(lines[index], duplicate) && card.Id != Guid.Empty)
        {
            return card.Id;
        }

        var id = Guid.NewGuid();
        var wanted = StoryItems.StampLine(lines[index], id);
        bool replaced;
        try
        {
            replaced = await JS.InvokeAsync<bool>("passage.replaceInLine", index, lines[index], wanted);
        }
        catch (JSException)
        {
            replaced = false;
        }

        if (!replaced)
        {
            _statusMessage = $"Could not {verb}: the script changed under the card. Try again.";
            return null;
        }

        lines[index] = wanted;
        _content = string.Join('\n', lines);
        _isDirty = true;
        RunAnalysis();
        UpdateCaretElementLabel();
        _statusMessage = duplicate
            ? "That heading shared an id with an earlier card (a copy), so it was given a fresh one."
            : "Card marked with an id so its star and tags can follow it.";
        return id;
    }

    private void ToggleBeatKey(Beat beat)
    {
        StoryItems.SetKey(_slate.Story, beat.Id, StoryItems.BeatKind, beat.Title, !StoryItems.IsKey(_slate.Story, beat.Id));
        SaveSlate();
    }

    // ---- Tagging (docs/STORY-PLAN.md S1.4) ----
    //
    // Selection and the popover's filtering live in passage.js (decision D);
    // the server hears only about Enter. The client is pushed the tag targets
    // and each item's tags, but only when they change.

    private string _lastTagPush = string.Empty;

    // The parser gives an unmarked heading a random id on every parse, so a
    // card only has a stable id once its heading line carries [[id:…]] (A2).
    private DocumentAnalysis? _stampedFor;
    private HashSet<int> _stampedLines = new();

    private HashSet<int> StampedLines()
    {
        if (!ReferenceEquals(_stampedFor, _analysis))
        {
            _stampedFor = _analysis;
            var lines = _content.Replace("\r\n", "\n").Split('\n');
            _stampedLines = Enumerable.Range(0, lines.Length)
                .Where(index => StoryItems.HasIdMarker(lines[index]))
                .Select(index => index + 1)
                .ToHashSet();
        }

        return _stampedLines;
    }

    private bool IsStampedCard(BoardCard card)
    {
        return card.Id != Guid.Empty && !IsDuplicateCard(card) && StampedLines().Contains(card.LineNumber);
    }

    private string? StorylineColourOf(Guid id) =>
        _slate.Story.Storylines.FirstOrDefault(line => line.Id == id) is { } line ? StoryItems.StorylineColour(line.Colour) : null;

    private string TagCharacterColour(string name) =>
        Characters.Palette.Contains(CharacterColour(name)) ? CharacterColour(name) : string.Empty;

    private async Task PushTagStateAsync()
    {
        var targets = new List<object>();
        foreach (var line in _slate.Story.Storylines)
        {
            targets.Add(new { kind = "storyline", key = "storyline:" + line.Id, label = line.Name.Length > 0 ? line.Name : "Unnamed storyline", colour = StoryItems.StorylineColour(line.Colour) });
        }

        foreach (var stat in _analysis.Characters)
        {
            targets.Add(new { kind = "character", key = "character:" + stat.Name, label = stat.Name, colour = TagCharacterColour(stat.Name) });
        }

        foreach (var place in _analysis.Locations ?? Array.Empty<LocationEntry>())
        {
            targets.Add(new { kind = "location", key = "location:" + place.Name, label = place.Name, colour = LocationColour(place.Name) });
        }

        var items = _slate.Story.Items
            .Where(item => !item.IsEmpty)
            .ToDictionary(item => item.TargetId.ToString(), StoryItems.TagKeys);
        var json = System.Text.Json.JsonSerializer.Serialize(new { targets, items });
        if (json == _lastTagPush)
        {
            return;
        }

        _lastTagPush = json;
        try
        {
            await JS.InvokeVoidAsync("passage.setTagTargets", targets, items);
        }
        catch (JSException)
        {
            _lastTagPush = string.Empty;
        }
    }

    private ItemTags? TagsOf(Guid id) =>
        id == Guid.Empty ? null : _slate.Story.Items.FirstOrDefault(item => item.TargetId == id);

    private RenderFragment<Guid> RenderTagBars => id => __builder =>
    {
        var tags = TagsOf(id);
        @if (tags is { Storylines.Count: > 0 })
        {
            <div class="tag-bars">
                @foreach (var lineId in tags.Storylines)
                {
                    var line = _slate.Story.Storylines.FirstOrDefault(entry => entry.Id == lineId);
                    @if (line is not null)
                    {
                        <span class="tag-bar" style="background:@(StorylineColourOf(lineId) is { Length: > 0 } colour ? colour : "var(--muted-text)")"
                              title="@(line.Name.Length > 0 ? line.Name : "Unnamed storyline")"></span>
                    }
                }
            </div>
        }
    };

    private RenderFragment<Guid> RenderTagMarks => id => __builder =>
    {
        var tags = TagsOf(id);
        @if (tags is { Characters.Count: > 0 } or { Locations.Count: > 0 })
        {
            <div class="tag-marks">
                @foreach (var name in tags.Characters)
                {
                    var colour = TagCharacterColour(name);
                    <span class="tag-dot @(colour.Length == 0 ? "neutral" : null)" style="@(colour.Length > 0 ? "background:" + colour : null)"
                          title="@(colour.Length == 0 ? name + " — no Cast colour" : name)"></span>
                }
                @foreach (var place in tags.Locations)
                {
                    <span class="tag-chip" style="@(LocationColour(place) is { Length: > 0 } colour ? "border-color:" + colour : null)">@place</span>
                }
            </div>
        }
    };

    /// <summary>Called on Enter in the tag popover. Returns the id the item is
    /// now known by (a card is stamped first if it has none), or empty when
    /// nothing was tagged.</summary>
    [JSInvokable]
    public async Task<string> OnTagToggled(string targetId, string itemKind, string key)
    {
        Guid id;
        string label;
        if (itemKind == StoryItems.BeatKind)
        {
            var beat = Guid.TryParse(targetId, out var beatId) ? _slate.Beats.FirstOrDefault(entry => entry.Id == beatId) : null;
            if (beat is null)
            {
                _statusMessage = "Could not tag: that beat no longer exists.";
                StateHasChanged();
                return string.Empty;
            }

            id = beat.Id;
            label = beat.Title;
        }
        else
        {
            var line = targetId.StartsWith("line:", StringComparison.Ordinal) && int.TryParse(targetId[5..], out var number) ? number : 0;
            var live = _analysis.Elements
                .Where(element => element is SectionElement or SceneHeadingElement)
                .FirstOrDefault(element => line > 0
                    ? element.LineNumber == line
                    : Guid.TryParse(targetId, out var wanted) && element.Id == wanted && _analysis.DuplicateIdLines?.Contains(element.LineNumber) != true && StampedLines().Contains(element.LineNumber));
            if (live is null)
            {
                _statusMessage = "Could not tag: that heading is no longer in the script.";
                StateHasChanged();
                return string.Empty;
            }

            var heading = live is SectionElement section ? section.Heading : ((SceneHeadingElement)live).Heading;
            var stamped = await EnsureCardIdAsync(new BoardCard(heading, string.Empty, string.Empty, live.LineNumber, new List<BoardCard>(), live.Id), "tag");
            if (stamped is null)
            {
                StateHasChanged();
                return string.Empty;
            }

            id = stamped.Value;
            label = heading;
        }

        StoryItems.ToggleTag(_slate.Story, id, itemKind, label, key);
        SaveSlate();
        StateHasChanged();
        return id.ToString();
    }

    [JSInvokable]
    public void OnBeatActivated(string id)
    {
        if (Guid.TryParse(id, out var beatId) && _slate.Beats.FirstOrDefault(entry => entry.Id == beatId) is { } beat)
        {
            StartBeatEdit(beat);
            StateHasChanged();
        }
    }

    private void DiscardDetached(ItemTags item)
    {
        _slate.Story.Items.Remove(item);
        SaveSlate();
        _statusMessage = $"Discarded story data for \"{item.Label}\"";
    }

    private void DiscardAllDetached()
    {
        _confirmDiscardAll = false;
        var detached = DetachedItems;
        _slate.Story.Items.RemoveAll(detached.Contains);
        SaveSlate();
        _statusMessage = $"Discarded story data for {detached.Count} detached card{(detached.Count == 1 ? "" : "s")}";
    }

    private void ConfirmDeleteBeat()
    {
        var beat = _deleteBeat;
        _deleteBeat = null;
        if (beat is null || !_slate.Beats.Remove(beat))
        {
            return;
        }

        if (_editingBeat == beat)
        {
            _editingBeat = null;
        }

        StoryItems.RemoveBeat(_slate.Story, beat.Id);
        SaveSlate();
        _statusMessage = $"Deleted beat \"{(beat.Title.Length > 0 ? beat.Title : "Untitled beat")}\"";
    }

    // ---- Beat Sheet: drag-move and resize ----
    //
    // The gesture runs in passage.js (trap 4); these receive only the result.
    // The browser clamps the same way, but the server's clamp is the truth.

    [JSInvokable]
    public void OnBeatMoved(Guid id, int page)
    {
        if (FindBeat(id) is not { } beat)
        {
            return;
        }

        if (page <= 0)
        {
            // Into the tray, at the end of it, keeping its span for when it
            // goes back on the grid.
            beat.Page = 0;
            _slate.Beats.Remove(beat);
            _slate.Beats.Add(beat);
        }
        else
        {
            (beat.Page, beat.Span) = BeatSheet.ClampMove(page, beat.Span, BeatColumns);
        }

        SaveSlate();
        StateHasChanged();
    }

    [JSInvokable]
    public void OnBeatResized(Guid id, int span)
    {
        if (FindBeat(id) is not { Page: > 0 } beat)
        {
            return;
        }

        (beat.Page, beat.Span) = BeatSheet.Clamp(beat.Page, span, BeatColumns);
        SaveSlate();
        StateHasChanged();
    }

    private Beat? FindBeat(Guid id)
    {
        var beat = _slate.Beats.FirstOrDefault(candidate => candidate.Id == id);
        if (beat is null)
        {
            _statusMessage = "That beat is no longer on the beat sheet";
            StateHasChanged();
        }

        return beat;
    }

    private void SetBeatTarget()
    {
        _slate.BeatSheetPages = Math.Clamp(_slate.BeatSheetPages, 1, BeatSheet.MaxTargetPages);
        SaveSlate();
    }

    // ---- Beat Board: drag to reorder ----
    //
    // Ports the pointer handlers plus MoveBeatBoardCardText. The desktop decides
    // before/after from the horizontal midpoint of the target; the web board
    // stacks cards vertically, so this uses the vertical midpoint instead —
    // a horizontal split would be meaningless in a column.
    //
    // The move is applied as one contiguous splice (see TryPlanMove), so a drag
    // is a single undo step and does not disturb the rest of the document.

    private Guid _dragCardId = Guid.Empty;
    private Guid _dragOverCardId = Guid.Empty;

    private void OnCardDragStart(BoardCard card)
    {
        // Never start a drag from a card that is open for editing.
        if (_editingCardId == card.Id)
        {
            return;
        }

        _dragCardId = card.Id;
    }

    private void OnCardDragEnd()
    {
        _dragCardId = Guid.Empty;
        _dragOverCardId = Guid.Empty;
    }

    private void OnCardDragOver(BoardCard card)
    {
        if (_dragCardId == Guid.Empty || _dragCardId == card.Id)
        {
            _dragOverCardId = Guid.Empty;
            return;
        }

        // Which side the drop lands on is decided in the browser, which is the
        // only place the card's real height is known; this just marks the target.
        _dragOverCardId = card.Id;
    }

    private async Task OnCardDropAsync(BoardCard target)
    {
        var sourceId = _dragCardId;
        var insertAfter = false;
        try
        {
            insertAfter = await JS.InvokeAsync<bool>("passage.dropIsAfter");
        }
        catch (JSException)
        {
        }

        _dragCardId = Guid.Empty;
        _dragOverCardId = Guid.Empty;

        if (sourceId == Guid.Empty || sourceId == target.Id || target.Id == Guid.Empty)
        {
            return;
        }

        var source = BeatBoardText.GetCardLineRange(
            _analysis.Elements, sourceId, _analysis.LineCount, includeNestedBlock: true);
        var destination = BeatBoardText.GetCardLineRange(
            _analysis.Elements, target.Id, _analysis.LineCount, includeNestedBlock: true);

        var lines = _content.Replace("\r\n", "\n").Split('\n');

        if (!BeatBoardText.TryPlanMove(lines, source, destination, insertAfter,
                out var splice, out var replacement))
        {
            _statusMessage = "That card cannot be moved there";
            return;
        }

        try
        {
            await JS.InvokeAsync<bool>(
                "passage.replaceLineRange",
                splice.StartLineIndex,
                splice.EndLineIndex,
                string.Join("\n", replacement));
        }
        catch (JSException)
        {
            return;
        }

        _statusMessage = "Moved card";
    }

    // ---- Beat Board: delete a card ----
    //
    // Ports DeleteCard. A Note takes only its own lines; anything else takes its
    // whole block, nested content included — which is why this always confirms,
    // and why the prompt states the line count.

    private BoardCard? _deleteCard;
    private string _deleteCardScope = string.Empty;
    private int _deleteCardLines;
    private BeatBoardText.LineRange _deleteCardRange;

    private void RequestDeleteCard(BoardCard card)
    {
        if (card.Id == Guid.Empty)
        {
            return;
        }

        var range = BeatBoardText.GetCardLineRange(
            _analysis.Elements, card.Id, _analysis.LineCount,
            includeNestedBlock: card.Kind != "Note");

        if (!range.IsFound)
        {
            _cardEditError = "That card is no longer in the script.";
            return;
        }

        _deleteCard = card;
        _deleteCardRange = range;
        _deleteCardLines = range.LineCount;
        _deleteCardScope = card.Kind is "Act" or "Sequence"
            ? $"the {card.Kind.ToLowerInvariant()} \"{card.Heading}\" and everything nested inside it"
            : $"\"{card.Heading}\" and its contents";
    }

    private async Task ConfirmDeleteCardAsync()
    {
        var card = _deleteCard;
        var range = _deleteCardRange;
        _deleteCard = null;
        if (card is null || !range.IsFound)
        {
            return;
        }

        try
        {
            await JS.InvokeVoidAsync(
                "passage.deleteLineRange", range.StartLineIndex, range.EndLineIndex);
        }
        catch (JSException)
        {
            return;
        }

        _editingCardId = Guid.Empty;
        _cardEditError = string.Empty;
        _statusMessage = $"Deleted {card.Kind.ToLowerInvariant()} \"{card.Heading}\"";
    }

    // ---- Beat Board: add a scene ----
    //
    // Ports AddSceneToBlock. The new scene goes after the container's *whole*
    // block — nested content included — so adding to an act lands at the end of
    // that act, not immediately under its heading.

    private async Task AddSceneToBlockAsync(BoardCard? container)
    {
        var insertAt = _analysis.LineCount;

        if (container is not null && container.Id != Guid.Empty)
        {
            var range = BeatBoardText.GetCardLineRange(
                _analysis.Elements, container.Id, _analysis.LineCount, includeNestedBlock: true);

            if (range.IsFound)
            {
                insertAt = Math.Min(range.EndLineIndex + 1, _analysis.LineCount);
            }
        }

        var newId = Guid.NewGuid();
        var lines = string.Join("\n", new[]
        {
            string.Empty,
            $". NEW SCENE [[id:{newId}]]",
            "= Click Edit to describe this scene."
        });

        try
        {
            await JS.InvokeVoidAsync("passage.insertLinesAt", insertAt, lines);
        }
        catch (JSException)
        {
            return;
        }

        _statusMessage = "Added scene";
    }

    // ---- Beat Board card editing ----
    //
    // Write-back goes through BeatBoardText (shared with the desktop app) to
    // work out the card's own line range and build its replacement lines, then
    // splices just that range in CodeMirror. Deliberately not a whole-document
    // rewrite: that is what clears the undo stack, which is the trap 3.1 and
    // FUTURE_IMPROVEMENTS 1 both warn about.

    private Guid _editingCardId = Guid.Empty;
    private string _editHeading = string.Empty;
    private string _editDescription = string.Empty;
    private string _editType = "Scene";
    private string _cardEditError = string.Empty;

    private void StartCardEdit(BoardCard card)
    {
        _editingCardId = card.Id;
        _editHeading = card.Heading;
        _editDescription = card.Description;
        _editType = card.Kind;
        _cardEditError = string.Empty;
    }

    private void CancelCardEdit()
    {
        _editingCardId = Guid.Empty;
        _cardEditError = string.Empty;
    }

    private async Task SaveCardAsync()
    {
        if (_editingCardId == Guid.Empty)
        {
            return;
        }

        if (string.IsNullOrWhiteSpace(_editHeading))
        {
            _cardEditError = "A card needs a heading.";
            return;
        }

        var range = BeatBoardText.GetCardLineRange(
            _analysis.Elements, _editingCardId, _analysis.LineCount, includeNestedBlock: false);

        if (!range.IsFound)
        {
            // The document moved on under the card — a reparse will have
            // rebuilt the board, so ask the user to try again rather than
            // splicing at a stale offset.
            _cardEditError = "That card is no longer in the script. Close and reopen the editor.";
            return;
        }

        var lines = BeatBoardText.BuildCardLines(
            _editType, _editHeading, _editDescription, _editingCardId);

        bool replaced;
        try
        {
            replaced = await JS.InvokeAsync<bool>(
                "passage.replaceLineRange",
                range.StartLineIndex,
                range.EndLineIndex,
                string.Join("\n", lines));
        }
        catch (JSException)
        {
            return;
        }

        if (!replaced)
        {
            _cardEditError = "Could not update the script.";
            return;
        }

        _editingCardId = Guid.Empty;
        _cardEditError = string.Empty;
        _statusMessage = "Card updated";
    }

    private async Task OnCardEditKeyDown(KeyboardEventArgs args)
    {
        if (args.Key == "Enter")
        {
            await SaveCardAsync();
        }
        else if (args.Key == "Escape")
        {
            CancelCardEdit();
        }
    }

    // ---- Beat Board ----
    //
    // Lanes and groups are rebuilt from scratch on every parse, so collapsed
    // state has to survive the rebuild — the same thing RebuildBeatBoardLanes
    // does with its collapsed-id sets. Keyed by heading rather than the Linux
    // card Id, because line numbers move on every keystroke and the web has no
    // stable card identity to hang onto.
    private readonly HashSet<string> _collapsedLanes = new(StringComparer.Ordinal);
    private readonly HashSet<string> _collapsedGroups = new(StringComparer.Ordinal);

    private static string LaneKey(BoardLane lane) => lane.ActCard?.Heading ?? "\u0000lane";

    private static string GroupKey(BoardGroup group) => group.SequenceCard?.Heading ?? "\u0000group";

    private void ToggleLane(string key)
    {
        if (!_collapsedLanes.Remove(key))
        {
            _collapsedLanes.Add(key);
        }
    }

    private void ToggleGroup(string key)
    {
        if (!_collapsedGroups.Remove(key))
        {
            _collapsedGroups.Add(key);
        }
    }

    // ---- Title page ----
    //
    // The Fountain title page is key/value lines at the head of the document,
    // so editing it means splicing lines 0..BodyStart. Field order below is the
    // order EditTitlePage writes them in — Author before Credit, Contact and
    // Notes last — so a document round-trips identically between the two apps
    // and exports match.

    private bool _titlePageOpen;
    private bool _hasTitlePage;
    private ElementReference _titlePageInput;
    private bool _focusTitlePage;

    private string _tpTitle = string.Empty;
    private string _tpEpisode = string.Empty;
    private string _tpCredit = "written by";
    private string _tpAuthor = string.Empty;
    private string _tpSource = string.Empty;
    private string _tpContact = string.Empty;
    private string _tpDraftDate = string.Empty;
    private string _tpRevision = string.Empty;
    private string _tpNotes = string.Empty;

    private void OpenTitlePage()
    {
        _tpTitle = _tpEpisode = _tpAuthor = _tpSource = string.Empty;
        _tpContact = _tpDraftDate = _tpRevision = _tpNotes = string.Empty;
        _tpCredit = "written by";

        foreach (var entry in _analysis.TitlePage)
        {
            switch (entry.FieldType)
            {
                case TitlePageFieldType.Title: _tpTitle = entry.Value; break;
                case TitlePageFieldType.Episode: _tpEpisode = entry.Value; break;
                case TitlePageFieldType.Credit: _tpCredit = entry.Value; break;
                case TitlePageFieldType.Author: _tpAuthor = entry.Value; break;
                case TitlePageFieldType.Source: _tpSource = entry.Value; break;
                case TitlePageFieldType.Contact: _tpContact = entry.Value; break;
                case TitlePageFieldType.DraftDate: _tpDraftDate = entry.Value; break;
                case TitlePageFieldType.Revision: _tpRevision = entry.Value; break;
                case TitlePageFieldType.Notes: _tpNotes = entry.Value; break;
            }
        }

        _hasTitlePage = _analysis.TitlePage.Count > 0;
        _titlePageOpen = true;
        _focusTitlePage = true;
    }

    private static void AppendBlock(System.Text.StringBuilder builder, string label, string value)
    {
        if (string.IsNullOrWhiteSpace(value))
        {
            return;
        }

        builder.Append(label).Append(':').Append('\n');
        foreach (var line in value.Replace("\r\n", "\n").Split('\n'))
        {
            builder.Append("    ").Append(line.Trim()).Append('\n');
        }
    }

    private string BuildTitlePageHeader()
    {
        var builder = new System.Text.StringBuilder();
        void Field(string label, string value)
        {
            if (!string.IsNullOrWhiteSpace(value))
            {
                builder.Append(label).Append(": ").Append(value).Append('\n');
            }
        }

        Field("Title", _tpTitle);
        Field("Episode", _tpEpisode);
        Field("Author", _tpAuthor);
        Field("Credit", _tpCredit);
        Field("Source", _tpSource);
        Field("Draft date", _tpDraftDate);
        Field("Revision", _tpRevision);
        AppendBlock(builder, "Contact", _tpContact);
        AppendBlock(builder, "Notes", _tpNotes);

        return builder.ToString().TrimEnd();
    }

    private async Task ApplyTitlePageAsync() => await ReplaceTitlePageAsync(BuildTitlePageHeader());

    private async Task DeleteTitlePageAsync() => await ReplaceTitlePageAsync(string.Empty);

    private async Task ReplaceTitlePageAsync(string header)
    {
        var lines = _content.Replace("\r\n", "\n").Split('\n').ToList();
        var bodyStart = _analysis.TitlePageBodyStart;
        if (bodyStart > 0 && bodyStart <= lines.Count)
        {
            lines.RemoveRange(0, bodyStart);
        }

        if (header.Length > 0)
        {
            lines.Insert(0, string.Empty);
            lines.Insert(0, header);
        }

        _titlePageOpen = false;
        _content = string.Join("\n", lines);
        _isDirty = true;
        _statusMessage = header.Length > 0 ? "Title page updated" : "Title page removed";

        // Whole-document rewrite, so the undo stack goes with it — the same
        // trade-off EditTitlePage makes by assigning EditorContent outright.
        RunAnalysis();
        UpdateCaretElementLabel();
        await ReplaceEditorContentAsync();
        await JS.InvokeVoidAsync("passage.setDirty", true);
        StateHasChanged();
    }

    // ---- Find / Replace ----
    //
    // A docked bar rather than Avalonia's floating window: a modal dialog would
    // take focus away from the editor it is searching, and the web app has no
    // separate window to put it in. Same option set and same buttons.

    private bool _findOpen;
    private bool _replaceShown;
    private string _findTerm = string.Empty;
    private string _replaceTerm = string.Empty;
    private bool _matchCase;
    private bool _wholeWord;
    private string _findStatus = string.Empty;
    private ElementReference _findInput;
    private bool _focusFind;

    [JSInvokable]
    public async Task OnFindShortcut(bool showReplace)
    {
        _findOpen = true;
        _replaceShown = _replaceShown || showReplace;
        _findStatus = string.Empty;
        _focusFind = true;

        // Seed from the selection, the way an editor's find normally behaves.
        try
        {
            var selected = await JS.InvokeAsync<string>("passage.selectedText");
            if (!string.IsNullOrEmpty(selected) && !selected.Contains('\n'))
            {
                _findTerm = selected;
            }
        }
        catch (JSException)
        {
        }

        StateHasChanged();
    }

    private void CloseFind()
    {
        _findOpen = false;
        _findStatus = string.Empty;
    }

    private async Task FindAsync(bool forward)
    {
        if (_findTerm.Length == 0)
        {
            _findStatus = string.Empty;
            return;
        }

        bool found;
        try
        {
            found = await JS.InvokeAsync<bool>(
                forward ? "passage.findNext" : "passage.findPrevious",
                _findTerm, _matchCase, _wholeWord);
        }
        catch (JSException)
        {
            return;
        }

        _findStatus = found ? string.Empty : "No matches";
    }

    private sealed record ReplaceOutcome
    {
        public int Replaced { get; init; }

        public bool Found { get; init; }
    }

    private async Task ReplaceCurrentAsync()
    {
        if (_findTerm.Length == 0)
        {
            return;
        }

        ReplaceOutcome outcome;
        try
        {
            outcome = await JS.InvokeAsync<ReplaceOutcome>(
                "passage.replaceCurrent", _findTerm, _replaceTerm, _matchCase, _wholeWord);
        }
        catch (JSException)
        {
            return;
        }

        _findStatus = outcome.Replaced > 0
            ? "Replaced 1"
            : (outcome.Found ? string.Empty : "No matches");
    }

    private async Task ReplaceAllAsync()
    {
        if (_findTerm.Length == 0)
        {
            return;
        }

        ReplaceOutcome outcome;
        try
        {
            outcome = await JS.InvokeAsync<ReplaceOutcome>(
                "passage.replaceAll", _findTerm, _replaceTerm, _matchCase, _wholeWord);
        }
        catch (JSException)
        {
            return;
        }

        _findStatus = outcome.Replaced == 0
            ? "No matches"
            : $"Replaced {outcome.Replaced}";
    }

    private async Task OnFindKeyDown(KeyboardEventArgs args)
    {
        if (args.Key == "Enter")
        {
            await FindAsync(!args.ShiftKey);
        }
        else if (args.Key == "Escape")
        {
            CloseFind();
        }
    }

    // ---- Scene numbers (HIGHLAND-PLAN H1.3) ----

    private sealed record LinesOutcome(int Applied, int Skipped);

    // Applies line edits in the editor as one undo step and mirrors the ones
    // that landed into _content. Null when the editor did not respond.
    private async Task<LinesOutcome?> ApplyLineEditsAsync(IReadOnlyList<SceneNumbers.LineEdit> edits)
    {
        LinesOutcome outcome;
        try
        {
            outcome = await JS.InvokeAsync<LinesOutcome>("passage.replaceLines", edits);
        }
        catch (JSException)
        {
            return null;
        }

        if (outcome.Applied > 0)
        {
            var lines = _content.Split('\n');
            foreach (var edit in edits.Where(e => lines[e.LineIndex] == e.Expected))
            {
                lines[edit.LineIndex] = edit.Replacement;
            }

            _content = string.Join('\n', lines);
            _isDirty = true;
            RunAnalysis();
            UpdateCaretElementLabel();
        }

        return outcome;
    }

