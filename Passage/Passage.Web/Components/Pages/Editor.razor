    private CharacterSettings? CharacterSetting(string name) =>
        _slate.Characters.FirstOrDefault(entry => entry.Name == name);

    private string CharacterColour(string name) => CharacterSetting(name)?.Colour ?? string.Empty;

    private Dictionary<string, string> CharacterGenders() => _slate.Characters
        .GroupBy(entry => entry.Name)
        .ToDictionary(group => group.Key, group => group.First().Gender);

    private void ToggleColourPicker(string name) =>
        _colourPickerFor = _colourPickerFor == name ? null : name;

    // Gets or adds the character's settings, applies the change, and drops
    // the entry again once it holds nothing.
    private void UpdateCharacterSetting(string name, Action<CharacterSettings> change)
    {
        var settings = CharacterSetting(name);
        if (settings is null)
        {
            settings = new CharacterSettings { Name = name };
            _slate.Characters.Add(settings);
        }

        change(settings);
        if (settings.Colour.Length == 0 && settings.Gender.Length == 0)
        {
            _slate.Characters.Remove(settings);
        }

        SaveSlate();
    }

    private async Task SetCharacterColourAsync(string name, string colour)
    {
        UpdateCharacterSetting(name, settings => settings.Colour = Characters.Palette.Contains(colour) ? colour : string.Empty);
        _colourPickerFor = null;
        await PushCharacterHighlightsAsync();
    }

    // Unspecified → Female → Male → Unspecified.
    private void CycleGender(string name) => UpdateCharacterSetting(name, settings =>
        settings.Gender = Characters.Tag(settings.Gender) switch
        {
            "Unspecified" => "Female",
            "Female" => "Male",
            _ => string.Empty,
        });

    private void StartRename(string name)
    {
        _renamingCharacter = name;
        _renameText = name;
        _focusRename = true;
        _mergeTarget = null;
        _colourPickerFor = null;
    }

    private void CancelRename()
    {
        _renamingCharacter = null;
        _mergeTarget = null;
    }

    private async Task OnRenameKeyDown(KeyboardEventArgs args)
    {
        if (args.Key == "Enter")
        {
            await RenameCharacterAsync();
        }
        else if (args.Key == "Escape")
        {
            CancelRename();
        }
    }

    private async Task RenameCharacterAsync()
    {
        if (_renamingCharacter is not { } oldName)
        {
            return;
        }

        var newName = _renameText.Trim();
        var newKey = Characters.BareName(newName);
        if (newKey.Length == 0)
        {
            _statusMessage = "A character needs a name";
            return;
        }

        // Renaming onto someone already in the script merges the two, so it
        // takes a second Enter, as Save As does before overwriting.
        if (newKey != oldName && _analysis.Characters.Any(stat => stat.Name == newKey) && _mergeTarget != newKey)
        {
            _mergeTarget = newKey;
            _statusMessage = $"{newKey} is already in the script — press Enter again to merge {oldName} into them";
            return;
        }

        var edits = Characters.Rename(_content, _analysis.Elements, oldName, newName);
        if (edits.Count == 0)
        {
            CancelRename();
            return;
        }

        var outcome = await ApplyLineEditsAsync(edits);
        if (outcome is null)
        {
            _statusMessage = $"{oldName} was not renamed: the editor did not respond";
            return;
        }

        // The colour and gender are copied to the new name, not moved, so
        // undoing the rename brings them back. A merge keeps the target's.
        var settings = _slate.Characters.FirstOrDefault(entry => entry.Name == oldName);
        if (outcome.Applied > 0 && settings is not null && _slate.Characters.All(entry => entry.Name != newKey))
        {
            _slate.Characters.Add(new CharacterSettings { Name = newKey, Colour = settings.Colour, Gender = settings.Gender });
            SaveSlate();
        }

        if (outcome.Applied > 0 && newKey != oldName && StoryItems.RenameCharacter(_slate.Story, oldName, newKey) > 0)
        {
            SaveSlate();
        }

        CancelRename();
        await PushCharacterHighlightsAsync();
        _statusMessage = $"Renamed {oldName} to {newKey} on {outcome.Applied} cue{(outcome.Applied == 1 ? "" : "s")}"
            + (outcome.Skipped > 0 ? $"; skipped {outcome.Skipped} that changed while renaming — try again" : string.Empty);
    }

    // Pushed once per parse; the client lays the marks (trap 4).
    private async Task PushCharacterHighlightsAsync()
    {
        var colours = _slate.Characters
            .Where(entry => Characters.Palette.Contains(entry.Colour))
            .GroupBy(entry => entry.Name)
            .ToDictionary(group => group.Key, group => group.First().Colour);
        try
        {
            await JS.InvokeVoidAsync("passage.setCharacterHighlights", _analysis.LineSpeakers, colours);
        }
        catch (JSException)
        {
        }
    }

    private Task AddSceneNumbersAsync() => ApplySceneNumberEditsAsync(SceneNumbers.Add(_content), "Numbered", "every scene already has a number");

    private Task RemoveSceneNumbersAsync() => ApplySceneNumberEditsAsync(SceneNumbers.Remove(_content), "Removed numbers from", "no scene numbers to remove");

    private async Task ApplySceneNumberEditsAsync(IReadOnlyList<SceneNumbers.LineEdit> edits, string verb, string nothingToDo)
    {
        if (edits.Count == 0)
        {
            _statusMessage = char.ToUpperInvariant(nothingToDo[0]) + nothingToDo[1..];
            return;
        }

        var outcome = await ApplyLineEditsAsync(edits);
        if (outcome is null)
        {
            _statusMessage = "Scene numbers were not changed: the editor did not respond";
            return;
        }

        _statusMessage = $"{verb} {outcome.Applied} scene{(outcome.Applied == 1 ? "" : "s")}"
            + (outcome.Skipped > 0 ? $"; skipped {outcome.Skipped} that changed while numbering — try again" : string.Empty);
    }

    // ---- Go to Scene ----

    private sealed record SceneJump(int LineNumber, string Text);

    private bool _goToSceneOpen;
    private string _sceneFilter = string.Empty;
    private int _sceneSelectedIndex;
    private ElementReference _sceneFilterInput;
    private bool _focusSceneFilter;
    private List<SceneJump> _scenes = new();

    // Typing narrows the list, so the selection has to be pulled back inside it
    // or Jump would fire on an index that no longer exists.
    private string SceneFilter
    {
        get => _sceneFilter;
        set
        {
            _sceneFilter = value;
            var count = FilteredScenes.Count;
            _sceneSelectedIndex = count == 0 ? 0 : Math.Clamp(_sceneSelectedIndex, 0, count - 1);
        }
    }

    private List<SceneJump> FilteredScenes => _sceneFilter.Trim().Length == 0
        ? _scenes
        : _scenes
            .Where(scene => scene.Text.Contains(_sceneFilter.Trim(), StringComparison.OrdinalIgnoreCase))
            .ToList();

    [JSInvokable]
    public void OnGoToSceneShortcut()
    {
        OpenGoToScene();
        StateHasChanged();
    }

    private void OpenGoToScene()
    {
        // The OUTLINE panel already has this data; flatten it rather than
        // reparsing, matching the Linux FlattenScenes over OutlineRoots.
        _scenes = new List<SceneJump>();
        CollectScenes(_analysis.Outline, _scenes);
        _sceneFilter = string.Empty;
        _sceneSelectedIndex = 0;
        _goToSceneOpen = true;
        _focusSceneFilter = true;
    }

    private static void CollectScenes(IEnumerable<OutlineNode> nodes, List<SceneJump> into)
    {
        foreach (var node in nodes)
        {
            if (string.Equals(node.Kind, "Scene", StringComparison.Ordinal))
            {
                into.Add(new SceneJump(node.LineNumber, node.Label));
            }

            CollectScenes(node.Children, into);
        }
    }

    private void CloseGoToScene() => _goToSceneOpen = false;

    private async Task JumpToSelectedSceneAsync()
    {
        var scenes = FilteredScenes;
        if (_sceneSelectedIndex < 0 || _sceneSelectedIndex >= scenes.Count)
        {
            return;
        }

        var target = scenes[_sceneSelectedIndex];
        _goToSceneOpen = false;
        await JumpToLineAsync(target.LineNumber);
    }

    private async Task OnGoToSceneKeyDown(KeyboardEventArgs args)
    {
        var count = FilteredScenes.Count;
        switch (args.Key)
        {
            case "Enter":
                await JumpToSelectedSceneAsync();
                break;
            case "Escape":
                CloseGoToScene();
                break;
            case "ArrowDown" when count > 0:
                _sceneSelectedIndex = Math.Min(_sceneSelectedIndex + 1, count - 1);
                await ScrollSelectedSceneIntoViewAsync();
                break;
            case "ArrowUp" when count > 0:
                _sceneSelectedIndex = Math.Max(_sceneSelectedIndex - 1, 0);
                await ScrollSelectedSceneIntoViewAsync();
                break;
        }
    }

    private async Task ScrollSelectedSceneIntoViewAsync()
    {
        // Blazor has to render the moved selection before the browser can
        // scroll to it.
        await InvokeAsync(StateHasChanged);
        try
        {
            await JS.InvokeVoidAsync("passage.scrollIntoView", ".scene-row.active");
        }
        catch (JSException)
        {
        }
    }

