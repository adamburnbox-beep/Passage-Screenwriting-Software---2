    // ---- Inbox beat -> Board card (docs/STORY-PLAN.md S2.1, decision E) ----
    //
    // The gesture runs in passage.js and calls OnInboxBeatPlaced once, on
    // release. The script is the truth afterwards: the beat is deleted and its
    // tags and star move to the new card. CodeMirror undo removes the card but
    // does not restore the beat, so its tags then show as Detached.

    private Beat? _sendBeat;

    private string DropId(BoardCard? card) =>
        card is not null && IsStampedCard(card) ? card.Id.ToString() : string.Empty;

    [JSInvokable]
    public async Task OnInboxBeatPlaced(Guid beatId, Guid targetId, bool after)
    {
        if (FindBeat(beatId) is not { } beat)
        {
            _statusMessage = "That beat is no longer in the inbox, so nothing was placed.";
            StateHasChanged();
            return;
        }

        await ConvertBeatToCardAsync(beat, targetId, after);
        StateHasChanged();
    }

    private void RequestSendToBoard(Beat beat)
    {
        // The editor's text is a buffer until Save; send what is on screen.
        if (_editingBeat == beat)
        {
            SaveBeatEdit();
        }

        if (beat.Page > 0)
        {
            _sendBeat = beat;
            return;
        }

        _ = SendToBoardAsync(beat);
    }

    // A beat Position is filing under a turn's sequence, waiting on the page-plan confirm.
    private (Guid Card, string Turn)? _sendBeatTarget;

    private void CancelSendToBoard()
    {
        _sendBeat = null;
        _sendBeatTarget = null;
    }

    private async Task ConfirmSendToBoard()
    {
        var beat = _sendBeat;
        var target = _sendBeatTarget;
        _sendBeat = null;
        _sendBeatTarget = null;
        if (beat is null)
        {
            return;
        }

        if (target is { } under)
        {
            if (await ConvertBeatToCardAsync(beat, under.Card, true))
            {
                _statusMessage += $", under {under.Turn}";
            }

            StateHasChanged();
            return;
        }

        await SendToBoardAsync(beat);
    }

    private async Task SendToBoardAsync(Beat beat)
    {
        await ConvertBeatToCardAsync(beat, null, true);
        StateHasChanged();
    }

    // targetId null puts the scene at the end of the script.
    private async Task<bool> ConvertBeatToCardAsync(Beat beat, Guid? targetId, bool after)
    {
        var cardId = Guid.NewGuid();
        var lines = BeatInbox.SceneLines(beat, cardId);
        var scriptLines = _content.Replace("\r\n", "\n").Split('\n');
        int insertAt;
        string text;
        if (targetId is { } target)
        {
            if (!BeatInbox.TryPlan(_analysis.Elements, scriptLines, target, after, lines, out insertAt, out text))
            {
                _statusMessage = "That card is no longer in the script, so the beat stays in the inbox.";
                return false;
            }
        }
        else
        {
            insertAt = scriptLines.Length;
            text = BeatInbox.TextAtEnd(scriptLines, lines);
        }

        bool inserted;
        try
        {
            inserted = await JS.InvokeAsync<bool>("passage.insertLinesAt", insertAt, text);
        }
        catch (JSException)
        {
            inserted = false;
        }

        if (!inserted)
        {
            _statusMessage = "Could not write the scene into the script, so the beat stays where it was.";
            return false;
        }

        // Mirror the insert so the next write sees it now, not after the editor's debounced change callback.
        MirrorInsert(insertAt, text);
        BeatInbox.MoveTags(_slate.Story, beat.Id, cardId, BeatInbox.Heading(beat));
        _slate.Beats.Remove(beat);
        if (_editingBeat == beat)
        {
            _editingBeat = null;
        }

        SaveSlate();
        _statusMessage = $"Sent \"{BeatInbox.Heading(beat)}\" to the Board as a scene";
        return true;
    }

    // After a successful ranged insert: the same lines in _content, re-analysed, so a second write in a row
    // (a second link, a beat filed straight after) plans from what the editor holds.
    private void MirrorInsert(int insertAt, string text)
    {
        var mirrored = _content.Split('\n').ToList();
        mirrored.Insert(Math.Min(insertAt, mirrored.Count), text);
        _content = string.Join('\n', mirrored);
        _isDirty = true;
        RunAnalysis();
        UpdateCaretElementLabel();
    }

    private Beat? FindBeat(Guid id)
    {
        var beat = _slate.Beats.FirstOrDefault(candidate => candidate.Id == id);
        if (beat is null)
        {
            _statusMessage = "That beat is no longer in the inbox";
            StateHasChanged();
        }

        return beat;
    }

    // ---- Beat Board: drag to reorder ----
    //
    // Ports the pointer handlers plus MoveBeatBoardCardText. The desktop decides
    // before/after from the horizontal midpoint of the target; the web board
    // stacks cards vertically, so this uses the vertical midpoint instead —
    // a horizontal split would be meaningless in a column.
    //
    // The move is applied as one contiguous splice (see TryPlanMove), so a drag
    // is a single undo step and does not disturb the rest of the document.

    private Guid _dragCardId = Guid.Empty;
    private Guid _dragOverCardId = Guid.Empty;

    private void OnCardDragStart(BoardCard card)
    {
        // Never start a drag from a card that is open for editing.
        if (_editingCardId == card.Id)
        {
            return;
        }

        _dragCardId = card.Id;
    }

    private void OnCardDragEnd()
    {
        _dragCardId = Guid.Empty;
        _dragOverCardId = Guid.Empty;
    }

    private void OnCardDragOver(BoardCard card)
    {
        if (_dragCardId == Guid.Empty || _dragCardId == card.Id)
        {
            _dragOverCardId = Guid.Empty;
            return;
        }

        // Which side the drop lands on is decided in the browser, which is the
        // only place the card's real height is known; this just marks the target.
        _dragOverCardId = card.Id;
    }

    private async Task OnCardDropAsync(BoardCard target)
    {
        var sourceId = _dragCardId;
        var insertAfter = false;
        try
        {
            insertAfter = await JS.InvokeAsync<bool>("passage.dropIsAfter");
        }
        catch (JSException)
        {
        }

        _dragCardId = Guid.Empty;
        _dragOverCardId = Guid.Empty;

        if (sourceId == Guid.Empty || sourceId == target.Id || target.Id == Guid.Empty)
        {
            return;
        }

        var source = BeatBoardText.GetCardLineRange(
            _analysis.Elements, sourceId, _analysis.LineCount, includeNestedBlock: true);
        var destination = BeatBoardText.GetCardLineRange(
            _analysis.Elements, target.Id, _analysis.LineCount, includeNestedBlock: true);

        var lines = _content.Replace("\r\n", "\n").Split('\n');

        if (!BeatBoardText.TryPlanMove(lines, source, destination, insertAfter,
                out var splice, out var replacement))
        {
            _statusMessage = "That card cannot be moved there";
            return;
        }

        try
        {
            await JS.InvokeAsync<bool>(
                "passage.replaceLineRange",
                splice.StartLineIndex,
                splice.EndLineIndex,
                string.Join("\n", replacement));
        }
        catch (JSException)
        {
            return;
        }

        _statusMessage = "Moved card";
    }

    // ---- Beat Board: delete a card ----
    //
    // Ports DeleteCard. A Note takes only its own lines; anything else takes its
    // whole block, nested content included — which is why this always confirms,
    // and why the prompt states the line count.

    private BoardCard? _deleteCard;
    private string _deleteCardScope = string.Empty;
    private int _deleteCardLines;
    private BeatBoardText.LineRange _deleteCardRange;

    private void RequestDeleteCard(BoardCard card)
    {
        if (card.Id == Guid.Empty)
        {
            return;
        }

        var range = BeatBoardText.GetCardLineRange(
            _analysis.Elements, card.Id, _analysis.LineCount,
            includeNestedBlock: card.Kind != "Note");

        if (!range.IsFound)
        {
            _cardEditError = "That card is no longer in the script.";
            return;
        }

        _deleteCard = card;
        _deleteCardRange = range;
        _deleteCardLines = range.LineCount;
        _deleteCardScope = card.Kind is "Act" or "Sequence"
            ? $"the {card.Kind.ToLowerInvariant()} \"{card.Heading}\" and everything nested inside it"
            : $"\"{card.Heading}\" and its contents";
    }

    private async Task ConfirmDeleteCardAsync()
    {
        var card = _deleteCard;
        var range = _deleteCardRange;
        _deleteCard = null;
        if (card is null || !range.IsFound)
        {
            return;
        }

        try
        {
            await JS.InvokeVoidAsync(
                "passage.deleteLineRange", range.StartLineIndex, range.EndLineIndex);
        }
        catch (JSException)
        {
            return;
        }

        _editingCardId = Guid.Empty;
        _cardEditError = string.Empty;
        _statusMessage = $"Deleted {card.Kind.ToLowerInvariant()} \"{card.Heading}\"";
    }

    // ---- Beat Board: add a scene ----
    //
    // Ports AddSceneToBlock. The new scene goes after the container's *whole*
    // block — nested content included — so adding to an act lands at the end of
    // that act, not immediately under its heading.

    private async Task AddSceneToBlockAsync(BoardCard? container)
    {
        var insertAt = _analysis.LineCount;

        if (container is not null && container.Id != Guid.Empty)
        {
            var range = BeatBoardText.GetCardLineRange(
                _analysis.Elements, container.Id, _analysis.LineCount, includeNestedBlock: true);

            if (range.IsFound)
            {
                insertAt = Math.Min(range.EndLineIndex + 1, _analysis.LineCount);
            }
        }

        var newId = Guid.NewGuid();
        var lines = string.Join("\n", new[]
        {
            string.Empty,
            $". NEW SCENE [[id:{newId}]]",
            "= Click Edit to describe this scene."
        });

        try
        {
            await JS.InvokeVoidAsync("passage.insertLinesAt", insertAt, lines);
        }
        catch (JSException)
        {
            return;
        }

        _statusMessage = "Added scene";
    }

    // ---- Beat Board card editing ----
    //
    // Write-back goes through BeatBoardText (shared with the desktop app) to
    // work out the card's own line range and build its replacement lines, then
    // splices just that range in CodeMirror. Deliberately not a whole-document
    // rewrite: that is what clears the undo stack, which is the trap 3.1 and
    // FUTURE_IMPROVEMENTS 1 both warn about.

    private Guid _editingCardId = Guid.Empty;
    private string _editHeading = string.Empty;
    private string _editDescription = string.Empty;
    private string _editType = "Scene";
    private string _cardEditError = string.Empty;

    private void StartCardEdit(BoardCard card)
    {
        _editingCardId = card.Id;
        _editHeading = card.Heading;
        _editDescription = card.Description;
        _editType = card.Kind;
        _cardEditError = string.Empty;
    }

    private void CancelCardEdit()
    {
        _editingCardId = Guid.Empty;
        _cardEditError = string.Empty;
    }

    private async Task SaveCardAsync()
    {
        if (_editingCardId == Guid.Empty)
        {
            return;
        }

        if (string.IsNullOrWhiteSpace(_editHeading))
        {
            _cardEditError = "A card needs a heading.";
            return;
        }

        var range = BeatBoardText.GetCardLineRange(
            _analysis.Elements, _editingCardId, _analysis.LineCount, includeNestedBlock: false);

        if (!range.IsFound)
        {
            // The document moved on under the card — a reparse will have
            // rebuilt the board, so ask the user to try again rather than
            // splicing at a stale offset.
            _cardEditError = "That card is no longer in the script. Close and reopen the editor.";
            return;
        }

        var lines = BeatBoardText.BuildCardLines(
            _editType, _editHeading, _editDescription, _editingCardId);

        bool replaced;
        try
        {
            replaced = await JS.InvokeAsync<bool>(
                "passage.replaceLineRange",
                range.StartLineIndex,
                range.EndLineIndex,
                string.Join("\n", lines));
        }
        catch (JSException)
        {
            return;
        }

        if (!replaced)
        {
            _cardEditError = "Could not update the script.";
            return;
        }

        _editingCardId = Guid.Empty;
        _cardEditError = string.Empty;
        _statusMessage = "Card updated";
    }

    private async Task OnCardEditKeyDown(KeyboardEventArgs args)
    {
        if (args.Key == "Enter")
        {
            await SaveCardAsync();
        }
        else if (args.Key == "Escape")
        {
            CancelCardEdit();
        }
    }

    // ---- Beat Board ----
    //
    // Lanes and groups are rebuilt from scratch on every parse, so collapsed
    // state has to survive the rebuild — the same thing RebuildBeatBoardLanes
    // does with its collapsed-id sets. Keyed by heading rather than the Linux
    // card Id, because line numbers move on every keystroke and the web has no
    // stable card identity to hang onto.
    private readonly HashSet<string> _collapsedLanes = new(StringComparer.Ordinal);
    private readonly HashSet<string> _collapsedGroups = new(StringComparer.Ordinal);

    private static string LaneKey(BoardLane lane) => BoardCollapse.LaneKey(lane);

    private bool _boardDescriptions = true;

    private bool BoardAllCollapsed =>
        _analysis.BoardLanes.Count > 0 && BoardCollapse.AllKeys(_analysis.BoardLanes) is var (lanes, groups)
            && lanes.IsSubsetOf(_collapsedLanes) && groups.IsSubsetOf(_collapsedGroups);

    private void ToggleCollapseAll()
    {
        if (BoardAllCollapsed)
        {
            _collapsedLanes.Clear();
            _collapsedGroups.Clear();
            return;
        }

        var (lanes, groups) = BoardCollapse.AllKeys(_analysis.BoardLanes);
        _collapsedLanes.UnionWith(lanes);
        _collapsedGroups.UnionWith(groups);
    }

