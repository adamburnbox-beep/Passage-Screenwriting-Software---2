    private bool TemplatesAvailable => !StructureTemplates.HasStructure(_content.Split('\n'));

    private bool ScriptHasHeadings => StructureTemplates.ReadNodes(_content.Split('\n')).Count > 0;

    private IEnumerable<StructureTemplate> AllTemplates => StructureTemplates.BuiltIns.Concat(_customTemplates);

    private void OpenTemplates()
    {
        try
        {
            _customTemplates = Slate.LoadTemplates()?.Templates ?? new List<StructureTemplate>();
        }
        catch (JsonException)
        {
            _customTemplates = new List<StructureTemplate>();
            _statusMessage = "Your saved templates could not be read, so they are not listed";
        }

        _saveTemplateName = string.Empty;
        _renamingTemplate = null;
        _templatesOpen = true;
    }

    private bool PersistTemplates()
    {
        try
        {
            var document = Slate.LoadTemplates() ?? new TemplatesDocument();
            document.Templates = _customTemplates;
            Slate.SaveTemplates(document);
            return true;
        }
        catch (Exception ex) when (ex is IOException or JsonException)
        {
            _statusMessage = $"Could not save templates: {ex.Message}";
            return false;
        }
    }

    private async Task ApplyTemplateAsync(StructureTemplate template)
    {
        if (!TemplatesAvailable)
        {
            return;
        }

        var insertAt = await InsertStructureAsync(StructureTemplates.BuildLines(template), template.Name);
        if (insertAt < 0)
        {
            return;
        }

        var message = $"Wrote {template.Name} from line {insertAt + 1} — see BOARD";
        _statusMessage = message;
        _templatesOpen = false;
    }

    private void SaveAsTemplate()
    {
        var name = _saveTemplateName.Trim();
        if (name.Length == 0)
        {
            return;
        }

        var template = StructureTemplates.FromScript(name, _content.Split('\n'));
        if (template.Nodes.Count == 0)
        {
            _statusMessage = "No headings to save";
            return;
        }

        _customTemplates.Add(template);
        if (PersistTemplates())
        {
            _statusMessage = $"Saved \"{name}\" as a template";
            _saveTemplateName = string.Empty;
        }
        else
        {
            _customTemplates.Remove(template);
        }
    }

    private void StartTemplateRename(StructureTemplate template)
    {
        _renamingTemplate = template.Id;
        _renameTemplateName = template.Name;
    }

    private void CommitTemplateRename()
    {
        var template = _customTemplates.FirstOrDefault(entry => entry.Id == _renamingTemplate);
        var name = _renameTemplateName.Trim();
        if (template is not null && name.Length > 0 && name != template.Name)
        {
            var old = template.Name;
            template.Name = name;
            if (!PersistTemplates())
            {
                template.Name = old;
            }
        }

        _renamingTemplate = null;
    }

    private void DeleteTemplate(StructureTemplate template)
    {
        if (_customTemplates.Remove(template) && !PersistTemplates())
        {
            _customTemplates.Add(template);
        }
    }

