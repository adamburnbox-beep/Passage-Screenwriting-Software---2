@page "/"
@using Passage.Core.Extensibility
@using Passage.Web.Components.Tools
@using Passage.Web.Services.Tools
@using Passage.Core.Goals
@using Passage.Export
@using Passage.Parser
@using System.Text
@using System.Text.Json
@inject ScriptLibrary Library
@inject ExportService Exports
@inject GoalSettingsStore GoalStore
@inject SlateStore Slate
@inject IJSRuntime JS
@implements IDisposable

<div class="app-shell">
    <header class="topbar">
        <span class="brand">PASSAGE</span>
        <details class="menu script-menu">
            <summary class="file-pill" title="@DisplayName — open a script">
                <span class="file-pill-name">@DisplayName</span>
                @if (_isDirty)
                {
                    <span class="dirty-dot">*</span>
                }
                <span class="file-pill-caret">▾</span>
            </summary>
            <div class="menu-items script-list">
                @if (_files.Count == 0)
                {
                    <div class="sidebar-empty">No scripts yet.
Click New to start one — files are stored on the server volume.</div>
                }
                @if (_recentFiles.Count > 0)
                {
                    <div class="sidebar-heading">RECENT</div>
                    @foreach (var name in _recentFiles)
                    {
                        <div class="file-row @(name == _fileName ? "active" : null)"
                             @onclick="() => RequestOpenRecentAsync(name)">
                            <span class="file-name">@name</span>
                        </div>
                    }
                    <div class="sidebar-heading">ALL SCRIPTS</div>
                }
                @foreach (var file in _files)
                {
                    <div class="file-row @(file.Name == _fileName ? "active" : null)" @onclick="() => RequestOpenFile(file.Name)">
                        <span class="file-name">@file.Name</span>
                        <span class="file-meta">@FormatTimestamp(file.LastModifiedUtc)</span>
                        <button class="icon-btn" title="Delete @file.Name"
                                @onclick="() => RequestDeleteFile(file.Name)" @onclick:stopPropagation="true">✕</button>
                    </div>
                }
                <div class="menu-divider"></div>
                <label class="menu-file-item" title="Copy a .fountain, .md, .txt or .highland file from this device into the library and open it">
                    Open from this device…
                    <InputFile @key="_importKey" OnChange="ImportFileAsync" accept=".fountain,.md,.txt,.highland" />
                </label>
                <button @onclick="OpenTitlePage">Title Page…</button>
                <button @onclick="AddSceneNumbersAsync">Add Scene Numbers</button>
                <button @onclick="RemoveSceneNumbersAsync">Remove Scene Numbers</button>
            </div>
        </details>

        <nav class="view-tabs">
            <button class="@(_mainViewIndex == 0 ? "active" : null)" @onclick="() => SetMainView(0)">SCRIPT</button>
            <button class="@(_mainViewIndex == 1 ? "active" : null)" @onclick="() => SetMainView(1)">BOARD</button>
            <button class="@(_mainViewIndex == 2 ? "active" : null)" @onclick="() => SetMainView(2)">ARC</button>
            <button class="@(_mainViewIndex == 3 ? "active" : null)" @onclick="() => SetMainView(3)">PREVIEW</button>
        </nav>

        <div class="topbar-actions">
            <button class="btn theme-toggle" @onclick="ToggleThemeAsync"
                    title="@(_theme == "light" ? "Switch to dark theme" : "Switch to light theme")">
                @(_theme == "light" ? "☾" : "☀")
            </button>
            @if (_mainViewIndex == 0)
            {
                <button class="btn @(_besideOpen ? "on" : null)"
                        title="Show the Board beside the script" @onclick="ToggleBesideAsync">Beside</button>
            }
            <button class="btn theme-toggle @(_syntaxPanelOpen ? "on" : null)"
                    title="Syntax reference (F1)" @onclick="ToggleSyntaxPanel">?</button>
            <button class="btn theme-toggle @(_workshopOpen ? "on" : null)"
                    title="Writer's tools" @onclick="ToggleWorkshopAsync">TOOLS</button>
            <label class="toggle" title="Save automatically shortly after you stop typing">
                <input type="checkbox" @bind="_autosaveEnabled" /> AUTOSAVE
            </label>
            <label class="toggle" title="Offer (CONT'D) when the same character speaks again after action">
                <input type="checkbox" @bind="_autoContdEnabled" @bind:after="ApplyAutoContdAsync" /> CONT'D
            </label>
            <label class="toggle" title="Keep the line you are typing on centred in the editor">
                <input type="checkbox" @bind="_typewriterScrolling" @bind:after="ApplyTypewriterScrollingAsync" /> TYPEWRITER
            </label>
            <label class="toggle" title="Highlight the line the caret is on">
                <input type="checkbox" @bind="_focusLine" @bind:after="ApplyFocusLineAsync" /> FOCUS
            </label>
            <button class="btn" @onclick="RequestNewFile">New</button>
            <button class="btn primary" @onclick="SaveAsync">Save</button>
            <details class="menu">
                <summary class="btn">Export ▾</summary>
                <div class="menu-items">
                    <button @onclick='() => ExportAsync("pdf")'>PDF (.pdf)</button>
                    <button @onclick='() => ExportAsync("txt")'>Plain text (.txt)</button>
                    <button @onclick='() => ExportAsync("fountain")'>Fountain source (.fountain)</button>
                    <button @onclick='() => ExportAsync("highland")'>Highland 2 (.highland)</button>
                    <button @onclick='() => ExportAsync("fdx")'>Final Draft (.fdx)</button>
                    <button @onclick="() => _outlineExportOpen = true">Export outline…</button>
                </div>
            </details>
            <details class="menu">
                <summary class="btn" title="Cast colours and balance, storylines and locations">Cast &amp; Elements ▾</summary>
                <div class="menu-items">
                    <button @onclick="() => OpenLibrary(0)">Cast…</button>
                    <button @onclick="() => OpenLibrary(1)">Elements…</button>
                </div>
            </details>
        </div>
    </header>

    @if (_findOpen)
    {
        <div class="find-bar">
            <div class="find-fields">
                <label class="find-field">
                    <span>Find:</span>
                    <input type="text" @ref="_findInput" @bind="_findTerm" @bind:event="oninput"
                           placeholder="Text to find..." @onkeydown="OnFindKeyDown" />
                </label>
                @if (_replaceShown)
                {
                    <label class="find-field">
                        <span>Replace with:</span>
                        <input type="text" @bind="_replaceTerm" @bind:event="oninput"
                               placeholder="Replacement text..." @onkeydown="OnFindKeyDown" />
                    </label>
                }
            </div>
            <div class="find-options">
                <label class="toggle"><input type="checkbox" @bind="_matchCase" /> Match case</label>
                <label class="toggle"><input type="checkbox" @bind="_wholeWord" /> Whole word</label>
            </div>
            <div class="find-actions">
                <button class="btn" @onclick="() => FindAsync(false)">Previous</button>
                <button class="btn primary" @onclick="() => FindAsync(true)">Find Next</button>
                @if (_replaceShown)
                {
                    <button class="btn" @onclick="ReplaceCurrentAsync">Replace</button>
                    <button class="btn" @onclick="ReplaceAllAsync">Replace All</button>
                }
                else
                {
                    <button class="btn" @onclick="() => { _replaceShown = true; }">Replace…</button>
                }
                <span class="find-status">@_findStatus</span>
                <button class="icon-btn" title="Close (Esc)" @onclick="CloseFind">✕</button>
            </div>
        </div>
    }

    <div class="main-area">
        <aside class="sidebar">
            <div class="sidebar-tabs">
                <button class="@(_sidebarTab == 0 ? "active" : null)" @onclick="() => _sidebarTab = 0">OUTLINE</button>
                <button class="@(_sidebarTab == 1 ? "active" : null)" @onclick="() => _sidebarTab = 1">NOTES</button>
                <button class="@(_sidebarTab == 2 ? "active" : null)" @onclick="() => _sidebarTab = 2">GOALS</button>
            </div>
            <div class="sidebar-body">
                @if (_sidebarTab == 0)
                {
                    var visibleOutline = _outlineFilters.Apply(_analysis.Outline);
                    <div class="outline-filters">
                        <label><input type="checkbox" checked="@_outlineFilters.Sections" @onchange="e => SetOutlineFiltersAsync(_outlineFilters with { Sections = IsChecked(e) })" /> Sections</label>
                        <label><input type="checkbox" checked="@_outlineFilters.Scenes" @onchange="e => SetOutlineFiltersAsync(_outlineFilters with { Scenes = IsChecked(e) })" /> Scenes</label>
                        <label><input type="checkbox" checked="@_outlineFilters.Synopses" @onchange="e => SetOutlineFiltersAsync(_outlineFilters with { Synopses = IsChecked(e) })" /> Synopses</label>
                        <label><input type="checkbox" checked="@_outlineFilters.Notes" @onchange="e => SetOutlineFiltersAsync(_outlineFilters with { Notes = IsChecked(e) })" /> Notes</label>
                        <label><input type="checkbox" checked="@_outlineFilters.Markers" @onchange="e => SetOutlineFiltersAsync(_outlineFilters with { Markers = IsChecked(e) })" /> Markers</label>
                    </div>
                    @if (_analysis.Outline.Count == 0)
                    {
                        <div class="sidebar-empty">@OutlineEmptyMessage</div>
                    }
                    else if (visibleOutline.Count == 0)
                    {
                        <div class="sidebar-empty">Everything in the outline is filtered out.</div>
                    }
                    @foreach (var node in visibleOutline)
                    {
                        @RenderOutlineNode(node)
                    }
                }
                else if (_sidebarTab == 1)
                {
                    @if (_analysis.Notes.Count == 0)
                    {
                        <div class="sidebar-empty">No [[notes]] in this script yet.</div>
                    }
                    @foreach (var note in _analysis.Notes)
                    {
                        <div class="outline-label" @onclick="() => JumpToLineAsync(note.LineNumber)">
                            <span class="outline-kind k-note">Note</span>
                            <span>@note.Text</span>
                        </div>
                    }
                    <div class="project-notes">
                        <div class="project-notes-head">PROJECT NOTES</div>
                        @if (_fileName.Length == 0)
                        {
                            <div class="sidebar-empty">Save the script first; project notes are kept with it.</div>
                        }
                        else
                        {
                            @if (_slate.Story.Notes.Count == 0)
                            {
                                <div class="sidebar-empty">No project notes yet. Start one from a template or blank.</div>
                            }
                            @foreach (var page in _slate.Story.Notes)
                            {
                                <div class="outline-label" @onclick="() => OpenNote(page)">
                                    <span class="outline-kind k-note">Page</span>
                                    <span>@(page.Title.Length == 0 ? "Untitled" : page.Title)</span>
                                </div>
                            }
                            <div class="project-notes-new">
                                <select class="workshop-select" @bind="_newNoteTemplate">
                                    <option value="">Blank page</option>
                                    @foreach (var template in AllNoteTemplates)
                                    {
                                        <option value="@template.Id">@template.Name@(template.BuiltIn ? "" : " (mine)")</option>
                                    }
                                </select>
                                <button class="btn" @onclick="NewNote">New page</button>
                                @if (_slate.Story.Notes.Count > 0)
                                {
                                    <button class="btn" @onclick="DownloadAllNotesAsync">Download all</button>
                                }
                            </div>
                        }
                    </div>
                }
                else
                {
                    <div class="goal-panel">
                        <div class="goal-card">
                            <div class="goal-card-title">SESSION</div>
                            <label class="goal-field">
                                <span>GOAL TYPE</span>
                                <select @bind="SessionGoalTypeString">
                                    <option value="WordCount">Word count</option>
                                    <option value="PageCount">Page count</option>
                                    <option value="Timer">Timer</option>
                                </select>
                            </label>
                            <label class="goal-field">
                                <span>@(IsTimerSession ? "TARGET (MINUTES)" : "TARGET")</span>
                                <input type="number" min="1" max="100000" @bind="SessionTargetValue" />
                            </label>

                            <div class="goal-dash">
                                <div class="goal-ring-wrap">
                                    <svg class="goal-ring" viewBox="0 0 110 110">
                                        <circle class="ring-track" cx="55" cy="55" r="48" />
                                        <circle class="ring-progress @(SessionComplete ? "done" : null)" cx="55" cy="55" r="48"
                                                style="stroke-dasharray:@RingDash(SessionPercent)" />
                                    </svg>
                                    <div class="goal-ring-center">
                                        @if (IsTimerSession)
                                        {
                                            <span class="ring-big">@FormatClock(TimerRemaining)</span>
                                        }
                                        else
                                        {
                                            <span class="ring-big">@((int)Math.Round(SessionPercent))%</span>
                                        }
                                    </div>
                                </div>
                                <div class="goal-stats">
                                    <div class="goal-stat-big">@SessionCurrentDisplay</div>
                                    <div class="goal-stat-label">CURRENT</div>
                                    <div class="goal-stat-mid">@SessionTargetDisplay</div>
                                    <div class="goal-stat-label">TARGET</div>
                                </div>
                            </div>

                            @if (IsTimerSession)
                            {
                                <div class="goal-actions">
                                    @if (_timerState is TimerGoalState.Idle)
                                    {
                                        <button class="btn primary" @onclick="StartTimer">Start</button>
                                    }
                                    else if (_timerState is TimerGoalState.Running)
                                    {
                                        <button class="btn" @onclick="PauseTimer">Pause</button>
                                    }
                                    else if (_timerState is TimerGoalState.Paused)
                                    {
                                        <button class="btn primary" @onclick="StartTimer">Resume</button>
                                    }
                                    <button class="btn" @onclick="ResetTimer">Reset</button>
                                </div>
                                <div class="goal-timer-row">
                                    <span>Elapsed @FormatClock(TimerElapsed)</span>
                                    <span>Remaining @FormatClock(TimerRemaining)</span>
                                </div>
                            }
                            <div class="goal-state @(SessionComplete ? "done" : null)">@(SessionComplete ? "Complete" : "In progress")</div>
                            <button class="btn goal-reset" @onclick="ResetSession">Reset session</button>
                        </div>

                        <div class="goal-card">
                            <div class="goal-card-title">DOCUMENT</div>
                            <label class="goal-field">
                                <span>GOAL TYPE</span>
                                <select @bind="DocumentGoalTypeString">
                                    <option value="WordCount">Word count</option>
                                    <option value="PageCount">Page count</option>
                                </select>
                            </label>
                            <label class="goal-field">
                                <span>TARGET</span>
                                <input type="number" min="1" max="1000000" @bind="DocumentTargetValue" />
                            </label>
                            <div class="goal-bar-track">
                                <div class="goal-bar-fill @(DocumentComplete ? "done" : null)" style="width:@(Math.Min(100, DocumentPercent).ToString("0.#", System.Globalization.CultureInfo.InvariantCulture))%"></div>
                            </div>
                            <div class="goal-timer-row">
                                <span>@DocumentCurrentDisplay</span>
                                <span>of @DocumentTargetDisplay</span>
                            </div>
                            <div class="goal-state @(DocumentComplete ? "done" : null)">@(DocumentComplete ? "Complete" : "In progress")</div>
                        </div>
                    </div>
                }
            </div>
        </aside>

        <main class="center-pane">
            <div class="editor-surface" hidden="@(_mainViewIndex != 0)">
                <div class="editor-stack" style="--editor-font-size:@(_editorFontPx)px">
                    <div id="editor-host"></div>
                </div>
            </div>

            @if (_mainViewIndex == 1)
            {
                @if (IsScreenplayMode)
                {
                    var detachedItems = DetachedItems;
                    <div class="preview-toolbar beats-toolbar board-toolbar">
                        @RenderFilterBar
                        <button class="btn" @onclick="ToggleBoardDescriptionsAsync">Descriptions: @(_boardDescriptions ? "hide" : "show")</button>
                        <button class="btn" @onclick="ToggleCollapseAll">@(BoardAllCollapsed ? "Expand all" : "Collapse all")</button>
                        <button class="btn" title="@(TemplatesAvailable ? "Write a structure into the script" : "Available only while the script has no # or ## heading")" @onclick="OpenTemplates">Start from a template…</button>
                        @if (detachedItems.Count > 0)
                        {
                            <button class="btn" @onclick="() => _showDetached = !_showDetached">Detached (@detachedItems.Count)</button>
                        }
                    </div>
                    @if (_showDetached && detachedItems.Count > 0)
                    {
                        <div class="detached-list">
                            <div class="detached-note">These are no longer in the script. They come back by themselves if the heading returns (Ctrl+Z, paste).</div>
                            @foreach (var item in detachedItems)
                            {
                                <div class="detached-item">
                                    <span class="detached-label">@(item.Label.Length > 0 ? item.Label : "(no heading)")</span>
                                    <span class="detached-carries">@(item.Key ? "★ key" : "")</span>
                                    <button class="btn" @onclick="() => DiscardDetached(item)">Discard</button>
                                </div>
                            }
                            <button class="btn" @onclick="() => _confirmDiscardAll = true">Discard all</button>
                        </div>
                    }
                    @if (_editingBeat is not null)
                    {
                        @RenderBeatEditor(_editingBeat)
                    }
                    <div class="beats-tray board-inbox" title="Double-click to jot down an unassigned beat. Drag a beat onto a card to turn it into a scene."
                         @ondblclick="() => AddBeat()">
                        @foreach (var beat in _slate.Beats)
                        {
                            @RenderBeat(beat)
                        }
                        @if (_slate.Beats.Count == 0)
                        {
                            <span class="beats-tray-hint">Inbox: double-click to jot a beat, drag it onto a card to make it a scene</span>
                        }
                    </div>
                }
                @if (!IsScreenplayMode)
                {
                    <div class="board-empty">The Beat Board works in Screenplay mode.
Open a .fountain file to see nested index cards here.</div>
                }
                else if (_analysis.BoardLanes.Count == 0)
                {
                    <div class="board-empty">The board mirrors your script's structure.
Add Acts (#), Sequences (##), and Scenes to see nested index cards here.</div>
                }
                else
                {
                    <div class="board-surface @(_boardDescriptions ? null : "no-descriptions")">
                        @foreach (var lane in _analysis.BoardLanes)
                        {
                            var laneKey = LaneKey(lane);
                            var laneOpen = !_collapsedLanes.Contains(laneKey);
                            <div class="board-lane">
                                @if (lane.ActCard is not null && _editingCardId == lane.ActCard.Id && lane.ActCard.Id != Guid.Empty)
                                {
                                    @RenderCardEditor(lane.ActCard)
                                }
                                else
                                {
                                    <div class="board-lane-head" data-drop-id="@DropId(lane.ActCard)">
                                        <span class="board-twisty" @onclick="() => ToggleLane(laneKey)">@(laneOpen ? "▾" : "▸")</span>
                                        <span class="board-lane-title @DimLane(lane)" @onclick="() => ToggleLane(laneKey)">@(lane.ActCard?.Heading ?? "Script")</span>
                                        @if (lane.ActCard is not null && lane.ActCard.Id != Guid.Empty)
                                        {
                                            @RenderCardStar(lane.ActCard)
                                            <button class="icon-btn board-add" title="Edit act"
                                                    @onclick="() => StartCardEdit(lane.ActCard)">✎</button>
                                        }
                                        <button class="icon-btn board-add" title="Add a scene to this act"
                                                @onclick="() => AddSceneToBlockAsync(lane.ActCard)">+</button>
                                    </div>
                                }
                                @if (lane.ActCard is { Description.Length: > 0 })
                                {
                                    <div class="board-lane-synopsis">@lane.ActCard.Description</div>
                                }
                                @if (laneOpen)
                                {
                                    @foreach (var group in lane.Groups)
                                    {
                                        var groupKey = BoardCollapse.GroupKey(laneKey, group);
                                        var groupOpen = !_collapsedGroups.Contains(groupKey);
                                        <div class="board-group">
                                            @if (group.SequenceCard is not null)
                                            {
                                                @if (_editingCardId == group.SequenceCard.Id && group.SequenceCard.Id != Guid.Empty)
                                                {
                                                    @RenderCardEditor(group.SequenceCard)
                                                }
                                                else
                                                {
                                                    <div class="board-group-head" data-drop-id="@DropId(group.SequenceCard)">
                                                        <span class="board-twisty" @onclick="() => ToggleGroup(groupKey)">@(groupOpen ? "▾" : "▸")</span>
                                                        <span class="board-group-title @DimGroup(group)" @onclick="() => ToggleGroup(groupKey)">@group.SequenceCard.Heading</span>
                                                        @RenderCardStar(group.SequenceCard)
                                                        <button class="icon-btn board-add" title="Edit sequence"
                                                                @onclick="() => StartCardEdit(group.SequenceCard)">✎</button>
                                                        <button class="icon-btn board-add" title="Add a scene to this sequence"
                                                                @onclick="() => AddSceneToBlockAsync(group.SequenceCard)">+</button>
                                                    </div>
                                                }
                                                @if (group.SequenceCard.Description.Length > 0)
                                                {
                                                    <div class="board-group-synopsis">@group.SequenceCard.Description</div>
                                                }
                                            }
                                            @if (groupOpen)
                                            {
                                                @foreach (var card in group.Cards)
                                                {
                                                    @RenderBoardCard(card)
                                                }
                                            }
                                        </div>
                                    }
                                }
                            </div>
                        }
                    </div>
                }
            }
            else if (_mainViewIndex == 2)
            {
                @if (!IsScreenplayMode)
                {
                    <div class="board-empty">The Arc works in Screenplay mode.
Open a .fountain file to chart storylines against its scenes.</div>
                }
                else
                {
                    var arc = ArcChartData;
                    var arcFilter = _boardFilter;
                    <div class="arc-view">
                    <div class="preview-toolbar beats-toolbar">
                        <span>X axis</span>
                        <button class="btn @(_arcPages ? null : "active")" @onclick="() => SetArcModeAsync(false)">Board order</button>
                        <button class="btn @(_arcPages ? "active" : null)" @onclick="() => SetArcModeAsync(true)">Pages</button>
                        @RenderFilterBar
                        <span>Drag a point up or down. Hollow points are untouched (50).</span>
                    </div>
                    @if (_slate.Story.Storylines.Count == 0)
                    {
                        <div class="board-empty">No storylines yet. Add them in ELEMENTS, then tag scenes with #.</div>
                    }
                    else
                    {
                        <div class="arc-legend">
                            @foreach (var line in _slate.Story.Storylines)
                            {
                                <span class="arc-legend-item @ArcLineDim(arcFilter, line)" style="--c:@ArcColour(line)">
                                    <span class="arc-swatch"></span>@(line.Name.Length > 0 ? line.Name : "Untitled storyline")
                                    <span class="arc-axis-name">@(string.IsNullOrWhiteSpace(line.ArcAxis) ? "Tension" : line.ArcAxis) 0–100</span>
                                </span>
                            }
                        </div>
                        <svg class="arc-chart" viewBox="0 0 @ArcWidth @ArcHeight" data-top="@ArcTop" data-height="@ArcPlotHeight">
                            @foreach (var tick in new[] { 0, 25, 50, 75, 100 })
                            {
                                <line class="arc-grid" x1="@ArcLeft" x2="@(ArcWidth - ArcRight)" y1="@ArcY(tick)" y2="@ArcY(tick)" />
                                @if (tick % 50 == 0)
                                {
                                    @ArcLabel(ArcNumber(ArcLeft - 8), ArcY(tick), "end", tick.ToString())
                                }
                            }
                            @if (_arcPages)
                            {
                                var step = Math.Max(1, (int)Math.Ceiling((arc.XMax - arc.XMin) / 12.0));
                                @for (var page = arc.XMin; page <= arc.XMax; page += step)
                                {
                                    @ArcLabel(ArcX(arc, page), ArcNumber(ArcTop + ArcPlotHeight + 20), "middle", page.ToString())
                                }
                            }
                            else
                            {
                                @ArcLabel(ArcX(arc, arc.XMin), ArcNumber(ArcTop + ArcPlotHeight + 20), "start", "script order →")
                            }
                            @foreach (var line in _slate.Story.Storylines)
                            {
                                var points = arc.Lines.GetValueOrDefault(line.Id) ?? new List<ArcPlotPoint>();
                                var dim = ArcLineDim(arcFilter, line);
                                <polyline class="arc-line @dim" data-line="@line.Id" style="--c:@ArcColour(line)" fill="none"
                                          points="@string.Join(" ", points.Select(point => ArcX(arc, point.X) + "," + ArcY(point.Value)))" />
                            }
                            @foreach (var line in _slate.Story.Storylines)
                            {
                                var dimLine = ArcLineDim(arcFilter, line);
                                @foreach (var point in arc.Lines.GetValueOrDefault(line.Id) ?? new List<ArcPlotPoint>())
                                {
                                    <circle class="arc-point @(point.Touched ? null : "untouched") @(dimLine ?? ArcPointDim(arcFilter, point))" r="7"
                                            data-line="@line.Id" data-target="@point.TargetId" style="--c:@ArcColour(line)"
                                            cx="@ArcX(arc, point.X)" cy="@ArcY(point.Value)">
                                        <title>@point.Label — @(string.IsNullOrWhiteSpace(line.ArcAxis) ? "Tension" : line.ArcAxis) @point.Value</title>
                                    </circle>
                                }
                            }
                        </svg>
                        @if (arc.Lines.Values.All(points => points.Count == 0))
                        {
                            <div class="arc-note">No tagged scenes on a line yet. Tag a card or beat with a storyline to give it a point.</div>
                        }
                        @if (arc.Unplaced.Count > 0)
                        {
                            <div class="arc-note">
                                <strong>@(_arcPages ? "Not on a page" : "Not on the Board") (@arc.Unplaced.Count)</strong>
                                @foreach (var item in arc.Unplaced)
                                {
                                    <div>@(item.Kind == "beat" ? "Beat" : "Card"): @item.Label</div>
                                }
                            </div>
                        }
                        @if (arc.Detached.Count > 0)
                        {
                            <div class="arc-note">
                                <strong>Detached (@arc.Detached.Count)</strong> — the card is no longer in the script; its value is kept.
                                @foreach (var item in arc.Detached)
                                {
                                    <div>@item.Label — @(_slate.Story.Storylines.FirstOrDefault(line => line.Id == item.StorylineId)?.Name) @item.Value</div>
                                }
                            </div>
                        }
                    }
                    </div>
                }
            }
            else if (_mainViewIndex == 3)
            {
                @if (!IsScreenplayMode)
                {
                    <div class="preview-empty">Page preview works in Screenplay mode.
Open a .fountain file to see formatted pages.</div>
                }
                else
                {
                    <div class="preview-toolbar">
                        <span>@_analysis.PageCount page@(_analysis.PageCount == 1 ? "" : "s")</span>
                        <button class="btn" @onclick="() => AdjustPreviewZoom(-0.15)">−</button>
                        <span>@((int)Math.Round(_previewZoom * 100))%</span>
                        <button class="btn" @onclick="() => AdjustPreviewZoom(+0.15)">+</button>
                    </div>
                    <div class="preview-surface">
                        @foreach (var page in _analysis.PreviewPages)
                        {
                            <div class="preview-page" style="font-size:@(PreviewFontPx)px">
                                @if (page.Header is { } header)
                                {
                                    <div class="preview-page-number preview-slots">
                                        <span>@header.Left</span><span>@header.Center</span><span>@header.Right</span>
                                    </div>
                                }
                                else
                                {
                                    <div class="preview-page-number">
                                        @if (!page.IsTitlePage && page.PageNumber > 1)
                                        {
                                            <span>@(page.PageNumber).</span>
                                        }
                                    </div>
                                }
                                <div class="preview-body">
                                    @foreach (var line in page.Lines)
                                    {
                                        <div class="pl @StyleClass(line.Style)" style="@IndentStyle(line)">@(line.Text.Length == 0 ? " " : line.Text)@if (line.SceneNumber is { } sceneNumber)
                                        {<span class="scene-no scene-no-left">@sceneNumber</span><span class="scene-no scene-no-right">@sceneNumber</span>}</div>
                                    }
                                </div>
                                @if (page.Footer is { } footer)
                                {
                                    <div class="preview-footer preview-slots">
                                        <span>@footer.Left</span><span>@footer.Center</span><span>@footer.Right</span>
                                    </div>
                                }
                            </div>
                        }
                    </div>
                }
            }
        </main>
        @{ var besideShown = _besideOpen && _mainViewIndex == 0; }
        <aside class="beside" hidden="@(!besideShown)">
            <div id="beside-resize" class="beside-resize" title="Drag to resize"></div>
            @if (besideShown)
            {
                <div class="beside-body">
                    @if (!IsScreenplayMode)
                    {
                        <div class="beside-empty">The Board works in Screenplay mode.</div>
                    }
                    else
                    {
                        var rows = BesideRows;
                        var current = BesideList.RowAt(rows, _caretLine);
                        @if (rows.Count == 0)
                        {
                            <div class="beside-empty">Add Acts (#), Sequences (##) and Scenes to see cards here.</div>
                        }
                        @for (var i = 0; i < rows.Count; i++)
                        {
                            var row = rows[i];
                            var line = row.Line;
                            <div class="beside-row @row.Role @(i == current ? "current" : null) @(line == 0 ? "inert" : null) @(row.Card is not null ? DimClass(row.Card) : null)"
                                 style="padding-left:@(6 + row.Depth * 10)px" title="@row.Text"
                                 @onclick="() => JumpBesideAsync(line)">
                                @if (row.Card is { } card && IsStampedCard(card))
                                {
                                    @RenderTagBars(card.Id)
                                }
                                <span class="beside-text">@row.Text</span>
                                @if (row.Card is { } starred && IsCardKey(starred))
                                {
                                    <span class="beside-star">★</span>
                                }
                                @if (row.Card is { } marked && IsStampedCard(marked))
                                {
                                    @RenderTagMarks(marked.Id)
                                }
                            </div>
                        }
                    }
                </div>
            }
        </aside>
        @if (_syntaxPanelOpen)
        {
            <SyntaxReferencePanel OnClose="CloseSyntaxPanel" Theme="@_theme"
                                  Scheme="_syntaxScheme" SchemeChanged="ApplySyntaxSchemeAsync" />
        }
        <aside class="workshop" hidden="@(!_workshopOpen)">
            <div id="workshop-resize" class="workshop-resize" title="Drag to resize"></div>
            <div class="workshop-head">
                <h2>WRITER'S TOOLS</h2>
                <button class="btn" title="Close (keeps everything as it is)" @onclick="ToggleWorkshopAsync">×</button>
            </div>
            <div class="workshop-body">
                @if (_workshopView == WorkshopView.Tools)
                {
                    <ToolsDock Host="_toolHost" OpenRunId="@_toolRunId" OpenRunIdChanged="SetToolRunAsync" OnOpenClassic="OpenClassicToolAsync" />
                }
                else if (_workshopView == WorkshopView.Revisions)
                {
                    <div class="workshop-nav">
                        <button class="btn" title="Back" @onclick="() => _workshopView = WorkshopView.Tools">←</button>
                        <span class="sidebar-heading">PUSH/PULL AND LENS</span>
                    </div>
                    <p class="tool-note">For a finished (or finished-enough) scene, sequence or draft that's gone dead or flat. Six checks find why; a Lens rewrites only the part that's flagged.</p>
                    <button class="btn primary workshop-hand" @onclick="StartRevisionAsync">Start a new one</button>
                    @if (_slate.Revisions.Count > 0)
                    {
                        <div class="sidebar-heading">KEPT FOR THIS SCRIPT</div>
                        @foreach (var revision in _slate.Revisions)
                        {
                            <div class="bracket-row">
                                <button class="bracket-text chain-seed" title="Open — everything is as you left it" @onclick="() => OpenRevisionAsync(revision)">@(string.IsNullOrWhiteSpace(revision.Scene) ? "(no scene named yet)" : revision.Scene)</button>
                                <button class="icon-btn" title="Remove this run and its working-out" @onclick="() => RemoveRevision(revision)">×</button>
                            </div>
                        }
                    }
                }
                else if (_revision is not null && _workshopView == WorkshopView.Revise)
                {
                    <div class="workshop-nav">
                        <button class="btn" title="Back — keeps what you've written" @onclick="CloseRevisionAsync">←</button>
                        <span class="sidebar-heading">PUSH/PULL AND LENS</span>
                    </div>
                    @if (_fileName.Length == 0)
                    {
                        <div class="fill-meta">Untitled — the working-out is kept once the script has a name.</div>
                    }
                    <p class="tool-note">For a finished (or finished-enough) scene, sequence or draft that's gone dead or flat. This is one of the few worksheets where judging quality out loud is the point, not a distraction: closure beats quality on pass one, but a read-back and crit is the payout.</p>

                    <div class="rung-label">Setup</div>
                    <label class="fill-field">
                        <span class="fill-label">Scene / sequence</span>
                        <textarea rows="2" @bind="_revision.Scene" @bind:after="SaveSlate"></textarea>
                    </label>
                    <div class="fill-actions">
                        <button class="btn" title="Names the scene or section heading nearest above the caret" @onclick="UseSceneUnderCaret">Use the scene under the caret</button>
                    </div>
                    <div class="fill-hint">For a whole sequence rather than one scene, name the stretch and run the six checks against it as a whole — you're checking whether the sequence itself has the shape, not auditing every scene individually.</div>
                    <label class="fill-field">
                        <span class="fill-label">What it's supposed to do in the story</span>
                        <textarea rows="2" @bind="_revision.Purpose" @bind:after="SaveSlate"></textarea>
                    </label>

                    <div class="rung-label">Checks, in priority order</div>
                    <p class="tool-note">Run them one at a time, top to bottom, or skip straight to whichever you already suspect is the problem. Stop after any single check — a clean or flagged check is a complete session. Clean checks don't get punished with more work; only a flagged one owes you a Lens.</p>
                    <div class="chain-round">
                        <div class="chain-round-label">0. GSU — goal, stakes, urgency</div>
                        <div class="fill-hint">Checks 1–6 test whether the scene <em>works</em>. This one tests whether it <em>plays</em>. One line per character in the scene, not just the protagonist:</div>
                        @foreach (var row in _revision.Gsu)
                        {
                            <div class="belief-cut gsu-row">
                                <label class="fill-field">
                                    <span class="fill-label">Character</span>
                                    <textarea rows="1" @bind="row.Character" @bind:after="SaveSlate"></textarea>
                                </label>
                                <label class="fill-field">
                                    <span class="fill-label">Goal — what they want out of this scene, right now</span>
                                    <textarea rows="2" @bind="row.Goal" @bind:after="SaveSlate"></textarea>
                                </label>
                                <label class="fill-field">
                                    <span class="fill-label">Stakes — what happens if they don't get it</span>
                                    <textarea rows="2" @bind="row.Stakes" @bind:after="SaveSlate"></textarea>
                                </label>
                                <label class="fill-field">
                                    <span class="fill-label">Urgency — why it has to be now</span>
                                    <textarea rows="2" @bind="row.Urgency" @bind:after="SaveSlate"></textarea>
                                </label>
                            </div>
                        }
                        <div class="fill-actions">
                            <button class="btn" @onclick="AddGsuRow">Another character</button>
                        </div>
                        <div class="fill-hint">Flag it if anyone in the room wants nothing, or nothing happens if they fail, or it could just as easily happen next week.</div>
                        <div class="stress-row">
                            <span class="fill-hint">Flag</span>
                            <AliveFlat Left="Y" Right="N" @bind-Value="_revision.GsuFlag" @bind-Value:after="SaveSlate" />
                        </div>
                        @if (_revision.GsuFlag == "Y")
                        {
                            <div class="stop-callout">If this one flags, don't reach for a Lens. Roll a Scene Dial instead (opposed wants · pre-agitator · agitator · hidden thing · wrong room · collision ahead).</div>
                            <div class="rung-label">What each one means</div>
                            @foreach (var dial in SceneDials)
                            {
                                <div class="fill-hint"><strong>@dial.Name</strong> — @dial.Do</div>
                            }
                        }
                    </div>
                    @for (var c = 0; c < ReviseRun.CheckNames.Length; c++)
                    {
                        var checkIndex = c;
                        var check = _revision.Check(ReviseRun.CheckNames[checkIndex]);
                        var lensRootId = $"lens-slot-{checkIndex}";
                        <div class="chain-round">
                            <div class="chain-round-label">@(checkIndex + 1). @check.Name</div>
                            <label class="fill-field">
                                <span class="fill-hint">@CheckQuestions[checkIndex]</span>
                                <textarea rows="2" @bind="check.Answer" @bind:after="SaveSlate"></textarea>
                            </label>
                            <div class="stress-row">
                                <span class="fill-hint">Flag</span>
                                <AliveFlat Left="Y" Right="N" @bind-Value="check.Flag" @bind-Value:after="SaveSlate" />
                            </div>
                            @if (check.Flag == "Y")
                            {
                                <div class="belief-cut lens-block" id="@lensRootId">
                                    <div class="rung-label">Lens — on the flagged thing only, not the whole scene</div>
                                    <label class="fill-field">
                                        <span class="fill-label">Pick one</span>
                                        <select class="workshop-select" @bind="check.Lens" @bind:after="SaveSlate">
                                            <option value="">—</option>
                                            @foreach (var lens in Lenses)
                                            {
                                                <option value="@lens.Name">@lens.Name</option>
                                            }
                                        </select>
                                        @if (LensDo(check.Lens) is { } lensDo)
                                        {
                                            <span class="fill-hint">What you actually do: @lensDo</span>
                                        }
                                    </label>
                                    <div class="burst-row">
                                        <span class="fill-hint">Apply it timed —</span>
                                        <input type="number" class="burst-seconds" min="1" max="30" @bind="_slate.Burst.LensMinutes" @bind:after="SaveSlate" />
                                        <span class="fill-meta">minutes</span>
                                        @if (_burstRunning)
                                        {
                                            <button class="btn" @onclick="StopBurstAsync">Stop</button>
                                        }
                                        else
                                        {
                                            <button class="btn primary" title="Puts the caret in the fragment and starts the clock" @onclick="() => StartLensAsync(lensRootId)">Go</button>
                                        }
                                        <span class="burst-display" data-burst-display></span>
                                    </div>
                                    <label class="fill-field">
                                        <span class="fill-label">Rewrite / fragment</span>
                                        <textarea rows="5" data-slot data-slot-multiline @bind="check.Fragment" @bind:after="SaveSlate"></textarea>
                                    </label>
                                    <div class="stress-row">
                                        <span class="fill-hint">Did it move the flagged problem?</span>
                                        <AliveFlat Left="Y" Right="N" @bind-Value="check.Moved" @bind-Value:after="SaveSlate" />
                                    </div>
                                    <label class="fill-field">
                                        <span class="fill-label">One line why</span>
                                        <textarea rows="2" @bind="check.MovedWhy" @bind:after="SaveSlate"></textarea>
                                    </label>
                                </div>
                            }
                        </div>
                    }
                    <div class="stop-callout">That's a complete session, whether it was one check or all six.</div>

                    @if (!_reviseDeeper && !_revision.HasDiagnostic)
                    {
                        <button class="btn" @onclick="() => _reviseDeeper = true">Going deeper still — check the belief arc already on the page</button>
                    }
                    else
                    {
                        <div class="rung-label">Going deeper still — Belief Split, diagnostic</div>
                        <p class="tool-note">Not building a new arc — checking whether the one already on the page actually holds.</p>
                        <label class="fill-field">
                            <span class="fill-label">Point A — the Lie, stable/wrong at the start of this stretch</span>
                            <textarea rows="2" @bind="_revision.DiagA" @bind:after="SaveSlate"></textarea>
                        </label>
                        <label class="fill-field">
                            <span class="fill-label">Point Z — where the protagonist's belief lands by the end</span>
                            <textarea rows="2" @bind="_revision.DiagZ" @bind:after="SaveSlate"></textarea>
                        </label>
                        <label class="fill-field">
                            <span class="fill-label">Which named shape does A→Z actually match?</span>
                            <select class="workshop-select" @bind="_revision.DiagShape" @bind:after="SaveSlate">
                                <option value="">—</option>
                                @foreach (var shape in BeliefShapes)
                                {
                                    <option value="@shape.Name">@shape.Name — @shape.A → @shape.Z</option>
                                }
                            </select>
                        </label>
                        <label class="fill-field">
                            <span class="fill-label">Does it match cleanly, or is it muddled between two?</span>
                            <textarea rows="2" @bind="_revision.DiagMatch" @bind:after="SaveSlate"></textarea>
                        </label>
                        <label class="fill-field">
                            <span class="fill-label">If muddled — which two, and where's the seam</span>
                            <textarea rows="2" @bind="_revision.DiagSeam" @bind:after="SaveSlate"></textarea>
                        </label>
                        <div class="belief-cut lens-block" id="lens-slot-seam">
                            <div class="rung-label">If muddled — a Lens on the scene at the seam, not the whole stretch</div>
                            <label class="fill-field">
                                <span class="fill-label">Lens</span>
                                <select class="workshop-select" @bind="_revision.DiagLens" @bind:after="SaveSlate">
                                    <option value="">—</option>
                                    @foreach (var lens in Lenses)
                                    {
                                        <option value="@lens.Name">@lens.Name</option>
                                    }
                                </select>
                                @if (LensDo(_revision.DiagLens) is { } seamDo)
                                {
                                    <span class="fill-hint">What you actually do: @seamDo</span>
                                }
                            </label>
                            <div class="burst-row">
                                <span class="fill-hint">Apply it timed —</span>
                                <input type="number" class="burst-seconds" min="1" max="30" @bind="_slate.Burst.LensMinutes" @bind:after="SaveSlate" />
                                <span class="fill-meta">minutes</span>
                                @if (_burstRunning)
                                {
                                    <button class="btn" @onclick="StopBurstAsync">Stop</button>
                                }
                                else
                                {
                                    <button class="btn primary" title="Puts the caret in the fragment and starts the clock" @onclick="() => StartLensAsync(SeamLensId)">Go</button>
                                }
                                <span class="burst-display" data-burst-display></span>
                            </div>
                            <label class="fill-field">
                                <span class="fill-label">Fragment</span>
                                <textarea rows="5" data-slot data-slot-multiline @bind="_revision.DiagFragment" @bind:after="SaveSlate"></textarea>
                            </label>
                        </div>
                    }

                    @if (!_reviseReadBack && !_revision.HasReadBack)
                    {
                        <button class="btn" @onclick="() => _reviseReadBack = true">Ready to close for real — read it back</button>
                    }
                    else
                    {
                        <div class="rung-label">Read-back and crit</div>
                        <p class="tool-note">Read the stretch back once, out loud if you can. This is not a chore — a read-back and crit is Slate's actual payout, the reason the diagnosis and the Lens work happened at all.</p>
                        <label class="fill-field">
                            <span class="fill-label">What's working — one line, no hedging</span>
                            <textarea rows="2" @bind="_revision.Working" @bind:after="SaveSlate"></textarea>
                        </label>
                        <label class="fill-field">
                            <span class="fill-label">What still doesn't sit right, even after the Lens passes above</span>
                            <textarea rows="2" @bind="_revision.NotSitting" @bind:after="SaveSlate"></textarea>
                        </label>
                        <label class="fill-field">
                            <span class="fill-label">Is this ready to move to Fill / Treatment, or does it need to sit another day?</span>
                            <textarea rows="2" @bind="_revision.Ready" @bind:after="SaveSlate"></textarea>
                        </label>
                    }
                }
            </div>
        </aside>
    </div>

    <footer class="statusbar">
        <span>@ModeStatusText</span>
        <button class="status-link" title="Go to line (Ctrl+G)" @onclick="OpenGoToLine">Ln @_caretLine</button>
        <span>@_caretElementLabel</span>
        <span>~@_analysis.PageCount page@(_analysis.PageCount == 1 ? "" : "s")</span>
        <span>@_analysis.WordCount.ToString("N0") words</span>
        <span title="@ReadingTimeTitle">@ReadingTimeDisplay</span>
        @if (!IsScreenplayMode)
        {
            <label class="status-wpm" title="Reading speed, words per minute">
                <input type="number" min="@MinWordsPerMinute" max="@MaxWordsPerMinute" step="10"
                       @bind="_wordsPerMinute" @bind:after="ApplyWordsPerMinuteAsync" /> wpm
            </label>
        }
        @if (ShapeLine.Derive(_analysis.BoardLanes) is { } shapeLine)
        {
            <span class="shape-line" title="@ShapeLine.Legend">@shapeLine</span>
        }
        <span class="spacer"></span>
        <button class="icon-btn" title="Undo (Ctrl+Z)" @onclick="UndoAsync">↶</button>
        <button class="icon-btn" title="Redo (Ctrl+Y)" @onclick="RedoAsync">↷</button>
        <button class="icon-btn" title="Smaller editor text" @onclick="() => AdjustEditorFont(-1)">A−</button>
        <button class="icon-btn" title="Larger editor text" @onclick="() => AdjustEditorFont(+1)">A+</button>
        <span class="status-message">@_statusMessage</span>
    </footer>
</div>

@if (_ideationOpen && _ideation is not null)
{
    <div class="ideation-overlay">
        <div class="ideation-page">
            <div class="workshop-nav">
                <button class="btn" title="Close — keeps the sitting as it is" @onclick="CloseIdeationAsync">×</button>
                <span class="sidebar-heading">IDEATION BURST</span>
            </div>
            @if (_ideationLoadError is not null)
            {
                <div class="fill-meta">@_ideationLoadError — nothing here will be saved until it is fixed.</div>
            }
            @if (_ideation.Current is null)
            {
                <p class="tool-note">Rapid-fire, throwaway writing from a prompt. Nothing here is about your script — invented material, or something borrowed from a film you don't much like, never your own characters. One round is a complete session. Keep rolling new rounds for as long as you want more.</p>
                <div class="rung-label">Pick your lane (10 seconds)</div>
                <p class="tool-note">Roll a die, pick a number at random, or just pick one. Don't deliberate — deliberating isn't the drill. Stay on the same lane for the whole sitting; re-roll only when you come back another time.</p>
                <button class="btn primary workshop-hand" @onclick="RollLane">Roll</button>
                <div class="tool-paths">
                    @for (var i = 0; i < Lanes.Length; i++)
                    {
                        var laneIndex = i;
                        <button class="workshop-tool" @onclick="() => StartSitting(laneIndex + 1)">
                            <span class="tool-name">@(laneIndex + 1). @Lanes[laneIndex].Name</span>
                        </button>
                    }
                </div>
                @if (_ideation.Kept.Count > 0)
                {
                    <div class="rung-label">Lines kept</div>
                    @foreach (var line in _ideation.Kept.ToList())
                    {
                        <div class="bracket-row">
                            <span class="bracket-text chain-seed kept-line">@line</span>
                            <button class="icon-btn" title="Let it go" @onclick="() => DropKeptLine(line)">×</button>
                        </div>
                    }
                }
            }
            else
            {
                var sitting = _ideation.Current;
                var lane = Lanes[Math.Clamp(sitting.Lane, 1, Lanes.Length) - 1];
                <div class="rung-label">Lane @sitting.Lane — @lane.Name</div>
                <p class="tool-note">@lane.Prompt</p>
                @if (sitting.Lane == Lanes.Length)
                {
                    <div class="fill-hint">Three steps is enough for a round here — the full eight-question chain is the Character Flaw Brainstorm in Writer's Tools, if you want to take this one further.</div>
                }
                <div class="fill-hint">Read it once, then start the round — don't re-read mid-round.</div>
                <div class="stop-callout">The only failure state is silence.</div>

                <div class="burst-row">
                    <span class="fill-hint">Rounds of</span>
                    <input type="number" class="burst-seconds" min="10" max="600" @bind="_ideation.RoundSeconds" @bind:after="SaveIdeation" />
                    <span class="fill-meta">seconds</span>
                </div>
                <p class="tool-note">The input is dealt for you, so there's nothing to think up — deal another if it lands flat, or type over it if you've got one of your own. Work it for the round, move on whether or not it feels finished.</p>
                @for (var r = 0; r < sitting.Rounds.Count; r++)
                {
                    var roundIndex = r;
                    var round = sitting.Rounds[roundIndex];
                    var roundId = $"ideation-round-{roundIndex}";
                    <div class="chain-round" id="@roundId">
                        <div class="chain-round-label">Round @(roundIndex + 1)</div>
                        <label class="fill-field">
                            <span class="fill-label">Input</span>
                            <textarea rows="2" @bind="round.Input" @bind:after="SaveIdeation"></textarea>
                        </label>
                        <div class="fill-actions">
                            <button class="btn" title="Replaces the input with a fresh one for this lane" disabled="@_burstRunning" @onclick="() => DealRound(round)">Deal another</button>
                        </div>
                        <div class="burst-row">
                            @if (_burstRunning)
                            {
                                <button class="btn" @onclick="StopBurstAsync">Stop</button>
                            }
                            else
                            {
                                <button class="btn primary" title="Puts the caret in the output and starts the round" @onclick="() => StartRoundAsync(roundId)">Start the round</button>
                            }
                            <span class="burst-display" data-burst-display></span>
                        </div>
                        <label class="fill-field">
                            <span class="fill-label">Output</span>
                            <textarea rows="5" data-slot data-slot-multiline @bind="round.Output" @bind:after="SaveIdeation"></textarea>
                        </label>
                        @if (!string.IsNullOrWhiteSpace(round.Output))
                        {
                            <div class="fill-actions">
                                <button class="btn" title="Copies this output into the kept line below" @onclick="() => KeepFromRound(round)">Keep a line from this</button>
                            </div>
                        }
                    </div>
                }
                <button class="btn" @onclick="AddIdeationRound">Next round</button>
                <div class="fill-meta">No limit.</div>

                <div class="rung-label">Stopping, any round</div>
                <p class="tool-note">Circle one line above worth keeping. Just one. You don't have to know why yet. That's a complete session, whether it was one round or fifteen.</p>
                <label class="fill-field">
                    <span class="fill-label">Kept line</span>
                    <textarea rows="2" @bind="sitting.KeptLine" @bind:after="SaveIdeation"></textarea>
                </label>
                <div class="fill-actions">
                    <button class="btn primary" title="Files the kept line and clears the rounds" @onclick="FinishSittingAsync">Done for this sitting</button>
                </div>
                <div class="stop-callout">Thirty seconds, on your phone, in a queue at Woolworths. That is a real session and it counts. One round of that is enough on its own.</div>
            }
        </div>
    </div>
}

@if (_saveAsOpen)
{
    <div class="modal-backdrop">
        <div class="modal">
            <h3>Save script</h3>
            <p>Name this script. It is stored on the server's data volume. “.fountain” is added when no extension is given.</p>
            <input type="text" @bind="_saveAsName" @bind:event="oninput" placeholder="my-screenplay.fountain"
                   @onkeydown="OnSaveAsKeyDown" />
            @if (_saveAsError.Length > 0)
            {
                <div class="modal-error">@_saveAsError</div>
            }
            <div class="modal-actions">
                <button class="btn" @onclick="CloseSaveAs">Cancel</button>
                <button class="btn primary" @onclick="ConfirmSaveAsAsync">Save</button>
            </div>
        </div>
    </div>
}

@if (_pendingAction != PendingAction.None)
{
    <div class="modal-backdrop">
        <div class="modal">
            <h3>Unsaved changes</h3>
            <p>“@DisplayName” has unsaved changes. Discard them and continue?</p>
            <div class="modal-actions">
                <button class="btn" @onclick="CancelPendingAction">Cancel</button>
                <button class="btn primary" @onclick="ConfirmPendingActionAsync">Discard changes</button>
            </div>
        </div>
    </div>
}

@if (_deleteCard is not null)
{
    <div class="modal-backdrop">
        <div class="modal">
            <h3>Delete Card</h3>
            <p>This removes @_deleteCardScope from the script (@_deleteCardLines line@(_deleteCardLines == 1 ? "" : "s")). Continue?</p>
            <div class="modal-actions">
                <button class="btn" @onclick="() => _deleteCard = null">Cancel</button>
                <button class="btn primary" @onclick="ConfirmDeleteCardAsync">Delete</button>
            </div>
        </div>
    </div>
}

@if (_libraryOpen)
{
    <div class="modal-backdrop" @onclick="() => _libraryOpen = false">
        <div class="modal library-modal" @onclick:stopPropagation="true">
            <div class="sidebar-tabs">
                <button class="@(_libraryTab == 0 ? "active" : null)" @onclick="() => _libraryTab = 0">CAST</button>
                <button class="@(_libraryTab == 1 ? "active" : null)" @onclick="() => _libraryTab = 1">ELEMENTS</button>
            </div>
            <div class="sidebar-body">
                @if (_libraryTab == 0)
                {
                    @if (_analysis.Characters.Count == 0)
                    {
                        <div class="sidebar-empty">No characters in this script yet.</div>
                    }
                    else
                    {
                        <div class="character-view-toggle">
                            <button class="@(_showGenderReport ? null : "active")" @onclick="() => _showGenderReport = false">LIST</button>
                            <button class="@(_showGenderReport ? "active" : null)" @onclick="() => _showGenderReport = true">BALANCE</button>
                        </div>
                    }
                    @if (_showGenderReport && _analysis.Characters.Count > 0)
                    {
                        var report = Characters.Report(_analysis.Elements, _analysis.Characters, CharacterGenders());
                        <div class="goal-panel">
                            @foreach (var (title, value) in GenderMetrics)
                            {
                                var total = report.Totals.Sum(value);
                                <div class="goal-card">
                                    <div class="goal-card-title">@title</div>
                                    <div class="gender-bar">
                                        @foreach (var tagTotal in report.Totals.Where(t => value(t) > 0))
                                        {
                                            <span class="gender-@tagTotal.Tag.ToLowerInvariant()" style="flex-grow:@value(tagTotal)"></span>
                                        }
                                    </div>
                                    @foreach (var tagTotal in report.Totals)
                                    {
                                        <div class="gender-line">
                                            <span class="gender-dot gender-@tagTotal.Tag.ToLowerInvariant()"></span>
                                            <span>@tagTotal.Tag</span>
                                            <span class="character-count">@value(tagTotal)</span>
                                            <span class="character-count">@(total == 0 ? "–" : $"{Math.Round(100.0 * value(tagTotal) / total)}%")</span>
                                        </div>
                                    }
                                </div>
                            }
                            <div class="goal-card">
                                <div class="goal-card-title">SCENES SHARED</div>
                                @foreach (var pair in report.Pairs)
                                {
                                    <div class="gender-line gender-pair">
                                        <span><span class="gender-dot gender-@pair.First.ToLowerInvariant()"></span><span class="gender-dot gender-@pair.Second.ToLowerInvariant()"></span></span>
                                        <span>@pair.First + @pair.Second</span>
                                        <span class="character-count">@pair.Scenes</span>
                                    </div>
                                }
                            </div>
                            <div class="goal-card">
                                <div class="goal-card-title">BY CHARACTER</div>
                                @foreach (var row in report.Rows)
                                {
                                    <div class="gender-line">
                                        <span class="gender-dot gender-@row.Tag.ToLowerInvariant()" title="@row.Tag"></span>
                                        <span class="character-name">@row.Name</span>
                                        <span class="character-count">@row.Lines</span>
                                        <span class="character-count">@row.Words</span>
                                    </div>
                                }
                            </div>
                        </div>
                    }
                    else if (_analysis.Characters.Count > 0)
                    {
                        <div class="character-row character-head">
                            <span class="character-name">NAME</span>
                            <span class="character-count">LINES</span>
                            <span class="character-count">WORDS</span>
                            <span class="character-actions"></span>
                        </div>
                    }
                    @foreach (var character in _showGenderReport ? Array.Empty<CharacterStat>() : _analysis.Characters)
                    {
                        var colour = CharacterColour(character.Name);
                        var gender = Characters.Tag(CharacterSetting(character.Name)?.Gender);
                        <div class="character-row">
                            <button class="character-swatch @(colour.Length == 0 ? "none" : null)"
                                    style="@(colour.Length > 0 ? $"background:{colour}" : null)"
                                    title="Highlight colour"
                                    @onclick="() => ToggleColourPicker(character.Name)"></button>
                            <button class="character-gender gender-text-@gender.ToLowerInvariant()" title="@gender — click to change"
                                    @onclick="() => CycleGender(character.Name)">@(gender == "Unspecified" ? "–" : gender[..1])</button>
                            @if (_renamingCharacter == character.Name)
                            {
                                <input class="character-rename" @ref="_renameInput" @bind="_renameText" @bind:event="oninput"
                                       @onkeydown="OnRenameKeyDown" />
                            }
                            else
                            {
                                <span class="character-name">@character.Name</span>
                                <span class="character-count">@character.Lines</span>
                                <span class="character-count">@character.Words</span>
                                <button class="icon-btn character-actions" title="Rename everywhere"
                                        @onclick="() => StartRename(character.Name)">✎</button>
                                <button class="icon-btn character-tools" title="Writer's tools for @character.Name"
                                        aria-expanded="@CastMenuOpen(character.Name)"
                                        @onclick="() => ToggleCastMenu(character.Name)">Tools</button>
                            }
                        </div>
                        @if (CastMenuOpen(character.Name))
                        {
                            <div class="tool-menu" role="menu">
                                @foreach (var exercise in ExerciseCatalog.All.Where(entry => entry.Anchor == AnchorKind.Character))
                                {
                                    <button class="btn" role="menuitem" @onclick="() => StartCastToolAsync(exercise.Id, character.Name)">@exercise.Name</button>
                                }
                            </div>
                        }
                        @if (_colourPickerFor == character.Name)
                        {
                            <div class="character-palette">
                                @foreach (var swatch in Characters.Palette)
                                {
                                    <button class="character-swatch @(swatch == colour ? "picked" : null)" style="background:@swatch"
                                            title="@swatch" @onclick="() => SetCharacterColourAsync(character.Name, swatch)"></button>
                                }
                                <button class="character-swatch none @(colour.Length == 0 ? "picked" : null)" title="No highlight"
                                        @onclick="() => SetCharacterColourAsync(character.Name, string.Empty)"></button>
                            </div>
                        }
                    }
                }
                else
                {
                    <div class="elements-section">
                        <div class="elements-head">
                            <span class="goal-card-title">STORYLINES</span>
                            <button class="btn" @onclick="AddStoryline">+ Add</button>
                        </div>
                        @if (_slate.Story.Storylines.Count == 0)
                        {
                            <div class="sidebar-empty">No storylines yet. Try "A Story", "B Story" or "Runner".</div>
                        }
                        @foreach (var line in _slate.Story.Storylines)
                        {
                            @if (_editingStoryline == line)
                            {
                                <div class="storyline-edit">
                                    <input class="character-rename" @ref="_storylineNameInput" @bind="_storylineEditName" @bind:event="oninput"
                                           placeholder="@StorylineHint(line)" @onkeydown="OnStorylineKeyDown" />
                                    <input class="character-rename" @bind="_storylineEditAxis" @bind:event="oninput"
                                           placeholder="Arc axis, e.g. Tension" title="What the Arc's vertical axis measures for this storyline" />
                                    <textarea class="card-body-input" rows="3" placeholder="What is this storyline about?"
                                              @bind="_storylineEditDescription" @bind:event="oninput"></textarea>
                                    <div class="character-palette">
                                        @foreach (var swatch in Characters.Palette)
                                        {
                                            <button class="character-swatch @(swatch == _storylineEditColour ? "picked" : null)" style="background:@swatch"
                                                    title="@swatch" @onclick="() => _storylineEditColour = swatch"></button>
                                        }
                                        <button class="character-swatch none @(_storylineEditColour.Length == 0 ? "picked" : null)" title="No colour"
                                                @onclick="() => _storylineEditColour = string.Empty"></button>
                                    </div>
                                    <div class="modal-actions">
                                        <button class="btn" @onclick="() => RequestDeleteStoryline(line)">Delete</button>
                                        <button class="btn" @onclick="CancelStorylineEdit">Cancel</button>
                                        <button class="btn primary" @onclick="SaveStorylineEdit">Save</button>
                                    </div>
                                </div>
                            }
                            else
                            {
                                <div class="character-row storyline-row">
                                    <span class="character-swatch @(line.Colour.Length == 0 ? "none" : null)"
                                          style="@(line.Colour.Length > 0 ? $"background:{line.Colour}" : null)"></span>
                                    <span class="character-name" title="@line.Description">@(line.Name.Length > 0 ? line.Name : "Untitled storyline")</span>
                                    <button class="icon-btn character-actions" title="Edit storyline"
                                            @onclick="() => StartStorylineEdit(line)">✎</button>
                                </div>
                                @if (line.Description.Length > 0)
                                {
                                    <div class="storyline-description">@line.Description</div>
                                }
                            }
                        }
                    </div>
                    <div class="elements-section">
                        <div class="elements-head"><span class="goal-card-title">LOCATIONS</span></div>
                        @{
                            var locations = _analysis.Locations ?? Array.Empty<LocationEntry>();
                            var missing = _slate.Story.Locations.Where(saved => !locations.Any(place => place.Name == saved.Name)).ToList();
                        }
                        @if (locations.Count == 0)
                        {
                            <div class="sidebar-empty">No locations yet. They come from your scene headings.</div>
                        }
                        @foreach (var place in locations)
                        {
                            var placeColour = LocationColour(place.Name);
                            <div class="character-row storyline-row">
                                <button class="character-swatch @(placeColour.Length == 0 ? "none" : null)"
                                        style="@(placeColour.Length > 0 ? $"background:{placeColour}" : null)"
                                        title="Set colour" @onclick="() => _locationPickerFor = _locationPickerFor == place.Name ? null : place.Name"></button>
                                <button class="location-name" title="Show scenes"
                                        @onclick="() => ToggleLocation(place.Name)">@place.Name</button>
                                <span class="character-count">@place.Scenes.Count</span>
                            </div>
                            @if (_locationPickerFor == place.Name)
                            {
                                <div class="character-palette">
                                    @foreach (var swatch in Characters.Palette)
                                    {
                                        <button class="character-swatch @(swatch == placeColour ? "picked" : null)" style="background:@swatch"
                                                title="@swatch" @onclick="() => SetLocationColour(place.Name, swatch)"></button>
                                    }
                                    <button class="character-swatch none @(placeColour.Length == 0 ? "picked" : null)" title="No colour"
                                            @onclick="() => SetLocationColour(place.Name, string.Empty)"></button>
                                </div>
                            }
                            @if (_expandedLocations.Contains(place.Name))
                            {
                                @foreach (var scene in place.Scenes)
                                {
                                    <button class="location-scene" title="Line @scene.LineNumber"
                                            @onclick="() => JumpToLineAsync(scene.LineNumber)">@scene.Heading</button>
                                }
                            }
                        }
                        @if (missing.Count > 0)
                        {
                            <div class="goal-card-title">NOT IN THE SCRIPT</div>
                            @foreach (var gone in missing)
                            {
                                <div class="character-row storyline-row location-gone">
                                    <span class="character-swatch" style="background:@gone.Colour"></span>
                                    <span class="character-name">@gone.Name</span>
                                    <button class="btn" title="Forget this colour" @onclick="() => DiscardLocation(gone)">Discard</button>
                                </div>
                            }
                        }
                    </div>
                    <div class="elements-section">
                        <button class="btn" @onclick="() => _libraryTab = 0">Characters: colours are set in Cast →</button>
                    </div>
                }
            </div>
            <div class="modal-actions">
                <button class="btn" @onclick="() => _libraryOpen = false">Close</button>
            </div>
        </div>
    </div>
}

@if (_outlineExportOpen)
{
    <div class="modal-backdrop">
        <div class="modal">
            <h3>Export outline</h3>
            <p class="tool-note">Headings are always written. Fountain keeps tags as [[notes]], so it re-opens here as an outline.</p>
            <label class="key-only-toggle"><input type="checkbox" @bind="_outlineOptions.Synopses" /> Synopses</label>
            <label class="key-only-toggle"><input type="checkbox" @bind="_outlineOptions.Storylines" /> Storylines</label>
            <label class="key-only-toggle"><input type="checkbox" @bind="_outlineOptions.Characters" /> Characters</label>
            <label class="key-only-toggle"><input type="checkbox" @bind="_outlineOptions.Locations" /> Locations</label>
            <label class="key-only-toggle"><input type="checkbox" @bind="_outlineOptions.KeyOnly" /> Key beats only</label>
            <label class="key-only-toggle"><input type="checkbox" @bind="_outlineOptions.BeatSheet" /> Include the Board inbox beats</label>
            @if (DetachedItems.Count > 0)
            {
                <p class="detached-note">@DetachedItems.Count detached item@(DetachedItems.Count == 1 ? "" : "s") (tags whose heading is gone) will not be exported.</p>
            }
            <div class="modal-actions">
                <button class="btn" @onclick="() => _outlineExportOpen = false">Cancel</button>
                <button class="btn" @onclick="ExportOutlinePdfAsync">PDF</button>
                <button class="btn" @onclick='() => ExportOutlineAsync(OutlineFormat.Text)'>Plain text</button>
                <button class="btn primary" @onclick='() => ExportOutlineAsync(OutlineFormat.Fountain)'>Fountain</button>
            </div>
        </div>
    </div>
}

@if (_templatesOpen)
{
    <div class="modal-backdrop">
        <div class="modal templates-modal">
            <h3>Start from a template</h3>
            @if (!TemplatesAvailable)
            {
                <p class="tool-note warn">Templates can't be applied here: this script already has a # or ## heading, and a template would have to merge with it. Use one in a script that has no structure yet.</p>
            }
            else
            {
                <p class="tool-note">Writes headings and prompts only, nothing that prints, so the page count does not change.</p>
            }
            @foreach (var template in AllTemplates)
            {
                <div class="template-item">
                    @if (_renamingTemplate == template.Id)
                    {
                        <input @bind="_renameTemplateName" @bind:event="oninput" />
                        <button class="btn" @onclick="CommitTemplateRename">Save</button>
                        <button class="btn" @onclick="() => _renamingTemplate = null">Cancel</button>
                    }
                    else
                    {
                        <div class="template-name">@template.Name</div>
                        <div class="detached-note">@(template.Description.Length > 0 ? template.Description : $"{template.Nodes.Count} headings")</div>
                        <div class="modal-actions">
                            <button class="btn primary" disabled="@(!TemplatesAvailable)" @onclick="() => ApplyTemplateAsync(template)">Use</button>
                            @if (!template.BuiltIn)
                            {
                                <button class="btn" @onclick="() => StartTemplateRename(template)">Rename</button>
                                <button class="btn" @onclick="() => DeleteTemplate(template)">Delete</button>
                            }
                        </div>
                    }
                </div>
            }
            <div class="template-item">
                <div class="template-name">Save this structure as a template</div>
                @if (ScriptHasHeadings)
                {
                    <div class="detached-note">Keeps the script's headings and = lines. Scenes are left out.</div>
                    <input placeholder="Template name" @bind="_saveTemplateName" @bind:event="oninput" />
                    <button class="btn" disabled="@(_saveTemplateName.Trim().Length == 0)" @onclick="SaveAsTemplate">Save</button>
                }
                else
                {
                    <div class="detached-note">The script has no headings to save yet.</div>
                }
            </div>
            <div class="modal-actions">
                <button class="btn" @onclick="() => _templatesOpen = false">Close</button>
            </div>
        </div>
    </div>
}

@if (_openNote is not null)
{
    <div class="modal-backdrop">
        <div class="modal note-modal">
            <h3>Project note</h3>
            <input class="note-title" placeholder="Title" @bind="_openNote.Title" @bind:event="oninput" @bind:after="QueueNoteSave" />
            <textarea class="note-body" rows="18" spellcheck="true" @bind="_openNote.Body" @bind:event="oninput" @bind:after="QueueNoteSave"></textarea>
            <div class="note-template-save">
                <input placeholder="Template name" @bind="_saveNoteTemplateName" @bind:event="oninput" />
                <button class="btn" disabled="@(_saveNoteTemplateName.Trim().Length == 0)" @onclick="SaveNoteAsTemplate">Save as template</button>
            </div>
            <div class="modal-actions">
                <button class="btn" @onclick="DownloadNoteAsync">Download .md</button>
                <button class="btn" @onclick="() => _deleteNote = _openNote">Delete…</button>
                <button class="btn primary" @onclick="CloseNote">Close</button>
            </div>
        </div>
    </div>
}

@if (_deleteNote is not null)
{
    <div class="modal-backdrop">
        <div class="modal">
            <h3>Delete project note</h3>
            <p>Delete "@(_deleteNote.Title.Length == 0 ? "Untitled" : _deleteNote.Title)"? It is kept only in this script's Slate data, so this cannot be undone.</p>
            <div class="modal-actions">
                <button class="btn" @onclick="() => _deleteNote = null">Cancel</button>
                <button class="btn primary" @onclick="ConfirmDeleteNote">Delete</button>
            </div>
        </div>
    </div>
}

@if (_confirmDiscardAll)
{
    <div class="modal-backdrop">
        <div class="modal">
            <h3>Discard detached items</h3>
            <p>This permanently removes the story data on @DetachedItems.Count detached card@(DetachedItems.Count == 1 ? "" : "s"). The script is not changed. Continue?</p>
            <div class="modal-actions">
                <button class="btn" @onclick="() => _confirmDiscardAll = false">Cancel</button>
                <button class="btn primary" @onclick="DiscardAllDetached">Discard all</button>
            </div>
        </div>
    </div>
}

@if (_deleteStoryline is not null)
{
