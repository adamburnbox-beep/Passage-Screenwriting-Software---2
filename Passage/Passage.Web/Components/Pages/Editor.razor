    // ---- Writer's tools dock (the Slate engines; docs/SLATE-PLAN.md) ----

    private async Task ToggleWorkshopAsync()
    {
        _workshopOpen = !_workshopOpen;
        if (_workshopOpen)
        {
            _toolsRotation++;
        }

        await PersistSessionAsync();
    }

    private enum WorkshopView { Tools, Revisions, Revise }

    private WorkshopView _workshopView;
    private SlateDocument _slate = new();
    private string? _slateLoadError;

    // "Hand me one" walks the ranked, non-ignored brackets from the top. The
    // cursor only advances when a handed bracket is put back unfilled, and
    // resets whenever the queue changes, so the top of the queue is always
    // what comes next after a fill.
    private int _handCursor;

    private IEnumerable<Bracket> EligibleBrackets => _analysis.Brackets.Where(bracket => !IsIgnored(bracket));

    private bool IsIgnored(Bracket bracket) => _slate.IgnoredBrackets.Contains(bracket.Text, StringComparer.Ordinal);

    private void LoadSlate()
    {
        _slate = new SlateDocument();
        _slateLoadError = null;
        _openNote = null;
        _deleteNote = null;
        _noteSaveCts?.Cancel();
        LoadCustomNoteTemplates();
        _editingBeat = null;
        _deleteBeat = null;
        _renamingCharacter = null;
        _colourPickerFor = null;
        _handCursor = 0;

        // The open exercise belongs to the script it was started in.
        _toolRunId = null;

        _revision = null;
        if (_workshopView == WorkshopView.Revise)
        {
            _workshopView = WorkshopView.Revisions;
        }

        if (_burstRunning)
        {
            _burstRunning = false;
            _ = StopBurstAsync();
        }

        if (_fileName.Length == 0)
        {
            return;
        }

        try
        {
            _slate = Slate.Load(_fileName) ?? new SlateDocument();
        }
        catch (Exception exception) when (exception is IOException or JsonException or UnauthorizedAccessException)
        {
            // Left on disk untouched: overwriting it would destroy whatever
            // working-out it holds, so saves are refused until it is fixed.
            _slateLoadError = $"Slate data for {_fileName} could not be read: {exception.Message}";
            _statusMessage = _slateLoadError;
        }
    }

    private void SaveSlate()
    {
        _slate.Exercises.RemoveAll(run => run.Id != _toolRunId && run.IsEmpty);
        _slate.Revisions.RemoveAll(revision => revision != _revision && revision.IsEmpty);
        StoryItems.RefreshLabels(_slate.Story, CardLabels());
        if (_fileName.Length == 0)
        {
            return;
        }

        if (_slateLoadError is not null)
        {
            _statusMessage = "Not saving Slate data — " + _slateLoadError;
            return;
        }

        try
        {
            Slate.Save(_fileName, _slate);
        }
        catch (Exception exception) when (exception is IOException or UnauthorizedAccessException)
        {
            _statusMessage = $"Could not save Slate data: {exception.Message}";
        }
    }

    // ---- Fill: brackets handed over one at a time ----

    private static Anchor BracketAnchor(string text) => new() { Kind = AnchorKind.Bracket, Text = text };

    // The bracket "hand me one" offers: the top of the ranked queue at the cursor.
    private Anchor? HandBracketAnchor()
    {
        var eligible = EligibleBrackets.ToList();
        return eligible.Count == 0 ? null : BracketAnchor(eligible[_handCursor % eligible.Count].Text);
    }

    private ExerciseRun? FillRunFor(string text) =>
        _slate.Exercises.FirstOrDefault(run => run.ExerciseId == SlateMigration.FillId && run.Anchor.Kind == AnchorKind.Bracket && run.Anchor.Text == text);

    // The run kept for this bracket, or a new one. Opened without taking focus
    // from the runner: the script scrolls to the bracket, the writer types in the dock.
    private async Task OpenBracketRunAsync(string text)
    {
        var run = FillRunFor(text);
        if (run is null)
        {
            run = new ExerciseRun { ExerciseId = SlateMigration.FillId, Anchor = BracketAnchor(text) };
            _slate.Exercises.Add(run);
        }

        _workshopView = WorkshopView.Tools;
        _mainViewIndex = 0;
        if (!_workshopOpen)
        {
            _workshopOpen = true;
            await PersistSessionAsync();
        }

        await SetToolRunAsync(run.Id);
        if (_analysis.Brackets.FirstOrDefault(bracket => bracket.Text == text) is { } bracket)
        {
            try
            {
                await JS.InvokeVoidAsync("passage.scrollToLine", bracket.LineNumber, false);
            }
            catch (JSException)
            {
            }
        }
    }

    // Hands on the next bracket, or back to the launcher when none is left.
    // True when one was handed.
    private async Task<bool> HandNextBracketAsync()
    {
        if (HandBracketAnchor() is { } next)
        {
            await OpenBracketRunAsync(next.Text);
            return true;
        }

        await SetToolRunAsync(null);
        return false;
    }

    // The old "put it back unfilled": only now does the cursor move on, so the
    // next bracket handed is a different one.
    private async Task NextBracketAsync()
    {
        _handCursor++;
        if (!await HandNextBracketAsync())
        {
            _statusMessage = "No [brackets] in this script";
        }
    }

    private async Task IgnoreBracketAsync(string text)
    {
        if (!_slate.IgnoredBrackets.Contains(text, StringComparer.Ordinal))
        {
            _slate.IgnoredBrackets.Add(text);
        }

        _slate.Exercises.RemoveAll(run => run.ExerciseId == SlateMigration.FillId && run.Anchor.Text == text);
        _handCursor = 0;
        SaveSlate();
        _statusMessage = $"Left {text} out — it's treated as prose now";
        await HandNextBracketAsync();
    }

    private void RestoreBracket(string text)
    {
        _slate.IgnoredBrackets.Remove(text);
        _handCursor = 0;
        SaveSlate();
    }

    // Accepting a fill: a ranged replacement of the bracket by its text on the
    // line the parse said (passage.replaceInLine returns false if it is gone),
    // so undo restores it exactly. Then the next bracket, straight away.
    private async Task<bool> FillBracketAsync(ToolSend send)
    {
        var text = send.Anchor.Text;
        var bracket = _analysis.Brackets.FirstOrDefault(entry => entry.Text == text);
        if (bracket is null)
        {
            // The script changed underneath the runner. The run is kept.
            _statusMessage = $"{text} is no longer in the script — nothing changed";
            return false;
        }

        // A bracket sits inside one line, so the answer is one line too.
        var answer = string.Join(' ', send.Text.Split('\n', StringSplitOptions.RemoveEmptyEntries).Select(part => part.Trim()).Where(part => part.Length > 0));
        bool replaced;
        try
        {
            replaced = await JS.InvokeAsync<bool>("passage.replaceInLine", bracket.LineIndex, bracket.Text, answer);
        }
        catch (JSException)
        {
            replaced = false;
        }

        if (!replaced)
        {
            _statusMessage = $"{bracket.Text} is no longer on line {bracket.LineNumber} — nothing changed";
            return false;
        }

        // Mirror the edit here so the next bracket handed sees the filled line
        // now rather than after the editor's debounced change callback.
        var lines = _content.Split('\n');
        if (bracket.LineIndex < lines.Length)
        {
            var at = lines[bracket.LineIndex].IndexOf(bracket.Text, StringComparison.Ordinal);
            if (at >= 0)
            {
                lines[bracket.LineIndex] = lines[bracket.LineIndex].Remove(at, bracket.Text.Length).Insert(at, answer);
                _content = string.Join('\n', lines);
            }
        }

        _isDirty = true;
        // The filled line is the truth and nothing could retrieve the run (rule 0.3).
        _slate.Exercises.RemoveAll(run => ReferenceEquals(run.Anchor, send.Anchor));
        _handCursor = 0;
        SaveSlate();
        RunAnalysis();
        UpdateCaretElementLabel();
        var filled = $"Filled line {bracket.LineNumber}";

        // Chaining: the next one, straight away. Stopping is the writer's call.
        _statusMessage = await HandNextBracketAsync() ? filled : filled + " — that was the last bracket";
        return true;
    }

    // ---- Burst timer and synopsis promotion (shared by the runners) ----

    private bool _burstRunning;

    private const int BurstReadInSeconds = 5;

    // The dock body is one scroll container, so a runner opened from the
    // bottom of the tool list would otherwise open at its own bottom. The
    // scroll happens after the render that shows the new view.
    private bool _scrollWorkshopToTop;

    private Task ScrollWorkshopToTopAsync()
    {
        _scrollWorkshopToTop = true;
        return Task.CompletedTask;
    }

    private async Task BurstSettingChangedAsync()
    {
        if (!_slate.Burst.Enabled)
        {
            await StopBurstAsync();
        }

        SaveSlate();
    }

    // The timer itself lives in passage.js (decision E, trap 4): focus, read-in,
    // countdown and advance are all client-side. The server hears only that it
    // ended, and gets each answer through the ordinary change events.
    private async Task StartBurstAsync(string rootId)
    {
        var seconds = Math.Clamp(_slate.Burst.Seconds, 5, 600);
        try
        {
            _burstRunning = await JS.InvokeAsync<bool>("passage.startBurst", rootId, BurstReadInSeconds, seconds);
        }
        catch (JSException)
        {
            _burstRunning = false;
        }
    }

    private async Task StopBurstAsync()
    {
        _burstRunning = false;
        try
        {
            await JS.InvokeVoidAsync("passage.stopBurst");
        }
        catch (JSException)
        {
        }
    }

    [JSInvokable]
    public void OnBurstEnded()
    {
        _burstRunning = false;
        StateHasChanged();
    }

    private (int InsertAt, int HeadingIndex) PromotionTarget => SynopsisPlacement.Find(_analysis.LineClasses, _caretLine - 1);

    private string PromotionTargetLabel
    {
        get
        {
            var (insertAt, headingIndex) = PromotionTarget;
            if (headingIndex < 0)
            {
                return $"Goes in as a = synopsis line at the caret (line {insertAt + 1}) — there's no section or scene heading above it.";
            }

            return $"Goes in as a = synopsis line under {LineText(headingIndex)} (line {headingIndex + 1}).";
        }
    }

    private string LineText(int index)
    {
        var lines = _content.Split('\n');
        return index >= 0 && index < lines.Length ? lines[index].Trim() : string.Empty;
    }

    // Promotion: the one line goes into the script as a synopsis under the
    // anchored scene (or the current heading, when the run names none), by
    // ranged insert so undo survives. The run stays in the sidecar; the script
    // now holds the result and the sidecar the working-out (decision B).
    private async Task<bool> PutSynopsisAsync(string text, Anchor? anchor)
    {
        var line = ToolTargets.SynopsisLine(text);
        var target = PromotionTarget;
        if (anchor is { } named && (HasSceneAnchor(named) || named.Kind == AnchorKind.Bracket))
        {
            if (AnchorScene(named) is not { } scene)
            {
                _statusMessage = $"{SceneAnchorName(named)} is no longer in the script — nothing inserted";
                return false;
            }

            target = SynopsisPlacement.Find(_analysis.LineClasses, scene.LineNumber - 1);
        }

        var (insertAt, headingIndex) = target;
        var heading = headingIndex >= 0 ? LineText(headingIndex) : null;
        bool inserted;
        try
        {
            inserted = await JS.InvokeAsync<bool>("passage.insertLinesAt", insertAt, line);
        }
        catch (JSException)
        {
            inserted = false;
        }

        if (!inserted)
        {
            _statusMessage = "Could not add the line — nothing changed";
            return false;
        }

        // Mirror the edit so the next promotion targets the right line now,
        // rather than after the editor's debounced change callback.
        var lines = _content.Split('\n').ToList();
        lines.Insert(Math.Min(insertAt, lines.Count), line);
        _content = string.Join('\n', lines);
        _isDirty = true;
        RunAnalysis();
        UpdateCaretElementLabel();
        _statusMessage = heading is null
            ? $"Added a synopsis at line {insertAt + 1}"
            : $"Added a synopsis under {heading} (line {insertAt + 1})";
        return true;
    }

    // The scene an anchor is about: the scene itself, the one a character is named in, or the one a
    // bracket sits in. Null when the anchor names none or it is gone.
    private SceneChoice? AnchorScene(Anchor anchor)
    {
        var scenes = ProjectContext.Scenes(_analysis.Elements);
        if (HasSceneAnchor(anchor))
        {
            return ProjectContext.Resolve(scenes, anchor);
        }

        return anchor.Kind == AnchorKind.Bracket && _analysis.Brackets.FirstOrDefault(entry => entry.Text == anchor.Text) is { } bracket
            ? ProjectContext.SceneAt(scenes, bracket.LineNumber)
            : null;
    }

    private static bool HasSceneAnchor(Anchor anchor) => anchor.SceneId is not null || anchor.SceneText.Length > 0;

    private static string SceneAnchorName(Anchor anchor) => anchor.SceneText.Length > 0 ? anchor.SceneText
        : anchor.Kind == AnchorKind.Bracket && anchor.Text.Length > 0 ? anchor.Text : "That scene";

    // ---- The tools dock host (docs/SLATE-REDO-PLAN.md R-D) ----

    private IToolHost _toolHost = default!;
    private string? _toolRunId;

    private sealed class EditorToolHost : IToolHost
    {
