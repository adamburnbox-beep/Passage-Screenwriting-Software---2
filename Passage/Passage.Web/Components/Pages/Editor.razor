    // ---- Writer's tools dock (the Slate engines; docs/SLATE-PLAN.md) ----

    private async Task ToggleWorkshopAsync()
    {
        _workshopOpen = !_workshopOpen;
        await PersistSessionAsync();
    }

    private enum WorkshopView { Tools, Brackets, Fill, Chains, Chain, Split, Belief, Extend, Bridges, Bridge, Positions, Position, Revisions, Revise }

    private WorkshopView _workshopView;
    private SlateDocument _slate = new();
    private string? _slateLoadError;
    private Bracket? _fillBracket;
    private FillRun? _fillRun;

    // "Hand me one" walks the ranked, non-ignored brackets from the top. The
    // cursor only advances when a handed bracket is put back unfilled, and
    // resets whenever the queue changes, so the top of the queue is always
    // what comes next after a fill.
    private int _handCursor;

    private IEnumerable<Bracket> EligibleBrackets => _analysis.Brackets.Where(bracket => !IsIgnored(bracket));

    private bool IsIgnored(Bracket bracket) => _slate.IgnoredBrackets.Contains(bracket.Text, StringComparer.Ordinal);

    private void LoadSlate()
    {
        _slate = new SlateDocument();
        _slateLoadError = null;
        _editingBeat = null;
        _deleteBeat = null;
        _renamingCharacter = null;
        _colourPickerFor = null;
        _handCursor = 0;
        _fillBracket = null;
        _fillRun = null;
        if (_workshopView == WorkshopView.Fill)
        {
            _workshopView = WorkshopView.Brackets;
        }

        _chain = null;
        if (_workshopView == WorkshopView.Chain)
        {
            _workshopView = WorkshopView.Chains;
        }

        // The Split family is one run per script, so a different script means
        // a different run; back to the list rather than showing the wrong one.
        if (_workshopView is WorkshopView.Split or WorkshopView.Belief or WorkshopView.Extend)
        {
            _workshopView = WorkshopView.Tools;
        }

        _bridge = null;
        _position = null;
        if (_workshopView == WorkshopView.Bridge)
        {
            _workshopView = WorkshopView.Bridges;
        }

        if (_workshopView == WorkshopView.Position)
        {
            _workshopView = WorkshopView.Positions;
        }

        _revision = null;
        if (_workshopView == WorkshopView.Revise)
        {
            _workshopView = WorkshopView.Revisions;
        }

        if (_burstRunning)
        {
            _burstRunning = false;
            _ = StopBurstAsync();
        }

        if (_fileName.Length == 0)
        {
            return;
        }

        try
        {
            _slate = Slate.Load(_fileName) ?? new SlateDocument();
        }
        catch (Exception exception) when (exception is IOException or JsonException or UnauthorizedAccessException)
        {
            // Left on disk untouched: overwriting it would destroy whatever
            // working-out it holds, so saves are refused until it is fixed.
            _slateLoadError = $"Slate data for {_fileName} could not be read: {exception.Message}";
            _statusMessage = _slateLoadError;
        }
    }

    private void SaveSlate()
    {
        _slate.Fills.RemoveAll(run => run != _fillRun && IsEmpty(run));
        _slate.Chains.RemoveAll(chain => chain != _chain && chain.IsEmpty);
        _slate.Bridges.RemoveAll(bridge => bridge != _bridge && bridge.IsEmpty);
        _slate.Positions.RemoveAll(position => position != _position && position.IsEmpty);
        _slate.Revisions.RemoveAll(revision => revision != _revision && revision.IsEmpty);
        StoryItems.RefreshLabels(_slate.Story, CardLabels());
        if (_fileName.Length == 0)
        {
            return;
        }

        if (_slateLoadError is not null)
        {
            _statusMessage = "Not saving Slate data — " + _slateLoadError;
            return;
        }

        try
        {
            Slate.Save(_fileName, _slate);
        }
        catch (Exception exception) when (exception is IOException or UnauthorizedAccessException)
        {
            _statusMessage = $"Could not save Slate data: {exception.Message}";
        }
    }

    private static bool IsEmpty(FillRun run) =>
        string.IsNullOrWhiteSpace(run.PointsTo) && string.IsNullOrWhiteSpace(run.Answer)
        && run.Options.All(option => string.IsNullOrWhiteSpace(option.Text) && string.IsNullOrWhiteSpace(option.WhyWrong));

    private async Task HandMeOneAsync()
    {
        var eligible = EligibleBrackets.ToList();
        if (eligible.Count == 0)
        {
            _workshopView = WorkshopView.Brackets;
            return;
        }

        await OpenFillAsync(eligible[_handCursor % eligible.Count]);
    }

    private async Task OpenFillAsync(Bracket bracket)
    {
        _fillBracket = bracket;
        _fillRun = _slate.Fills.FirstOrDefault(run => run.Bracket == bracket.Text);
        if (_fillRun is null)
        {
            _fillRun = new FillRun { Bracket = bracket.Text };
            _slate.Fills.Add(_fillRun);
        }

        while (_fillRun.Options.Count < 3)
        {
            _fillRun.Options.Add(new FillOption());
        }

        _workshopView = WorkshopView.Fill;
        _mainViewIndex = 0;
        // Reveal the line without taking focus: the writer is about to type in
        // the runner, and on a phone the editor is underneath it.
        await JS.InvokeVoidAsync("passage.scrollToLine", bracket.LineNumber, false);
    }

    // Closing keeps everything as it is (rule 0); the run was saved on every
    // change. Only the hand-me-one cursor moves on, so pressing it again offers
    // a different bracket.
    private void CloseFill()
    {
        _handCursor++;
        _fillBracket = null;
        _fillRun = null;
        _workshopView = WorkshopView.Brackets;
        SaveSlate();
    }

    private async Task IgnoreBracketAsync(Bracket bracket)
    {
        if (!IsIgnored(bracket))
        {
            _slate.IgnoredBrackets.Add(bracket.Text);
        }

        _slate.Fills.RemoveAll(run => run.Bracket == bracket.Text);
        _handCursor = 0;
        if (_workshopView == WorkshopView.Fill)
        {
            _fillBracket = null;
            _fillRun = null;
            SaveSlate();
            await HandMeOneAsync();
            return;
        }

        SaveSlate();
    }

    private void RestoreBracket(Bracket bracket)
    {
        _slate.IgnoredBrackets.Remove(bracket.Text);
        _handCursor = 0;
        SaveSlate();
    }

    private async Task AcceptFillAsync()
    {
        if (_fillBracket is null || _fillRun is null)
        {
            return;
        }

        // Not a disabled button: the answer's change event and the tap arrive
        // together, and a button disabled until the change lands swallows
        // the tap (see the chain runner's promote button).
        if (string.IsNullOrWhiteSpace(_fillRun.Answer))
        {
            _statusMessage = "Nothing to fill it with yet — write the real answer first";
            return;
        }

        var bracket = _fillBracket;
        var answer = _fillRun.Answer.Trim();
        bool replaced;
        try
        {
            replaced = await JS.InvokeAsync<bool>("passage.replaceInLine", bracket.LineIndex, bracket.Text, answer);
        }
        catch (JSException)
        {
            replaced = false;
        }

        if (!replaced)
        {
            // The script changed underneath the runner. Keep the run; the
            // bracket list re-derives on the next parse.
            _statusMessage = $"{bracket.Text} is no longer on line {bracket.LineNumber} — nothing changed";
            _fillBracket = null;
            _fillRun = null;
            _workshopView = WorkshopView.Brackets;
            return;
        }

        // Mirror the edit here so the next hand-me-one sees the filled line
        // now rather than after the editor's debounced change callback.
        var lines = _content.Split('\n');
        if (bracket.LineIndex < lines.Length)
        {
            var at = lines[bracket.LineIndex].IndexOf(bracket.Text, StringComparison.Ordinal);
            if (at >= 0)
            {
                lines[bracket.LineIndex] = lines[bracket.LineIndex].Remove(at, bracket.Text.Length).Insert(at, answer);
                _content = string.Join('\n', lines);
            }
        }

        _isDirty = true;
        _slate.Fills.Remove(_fillRun);
        _fillBracket = null;
        _fillRun = null;
        _handCursor = 0;
        SaveSlate();
        RunAnalysis();
        UpdateCaretElementLabel();
        _statusMessage = $"Filled line {bracket.LineNumber}";

        // Chaining: the next one, straight away. Stopping is the writer's call.
        await HandMeOneAsync();
    }

    // ---- Forward chain: WOAC and Character Flaw Brainstorm (Phase 2) ----
    //
    // One runner, two paths. A WOAC round's Want is the previous round's
