    private async Task SetToolRunAsync(string? id)
    {
        if (id is null)
        {
            await StopBurstAsync();
            // Closing a bracket's run puts it back unfilled, so "hand me one" offers a different one next.
            if (_toolRunId is not null && _slate.Exercises.FirstOrDefault(run => run.Id == _toolRunId) is { } closing
                && closing.ExerciseId == SlateMigration.FillId)
            {
                _handCursor++;
            }
        }

        _toolRunId = id;
        SaveSlate();
        await ScrollWorkshopToTopAsync();
    }

    // Opens the dock (if closed) straight into a new run with the anchor set —
    // the Cast row, a Board card and Right now all come through here.
    private async Task StartToolAsync(string exerciseId, Anchor anchor)
    {
        if (ExerciseCatalog.Find(exerciseId) is null)
        {
            return;
        }

        var run = new ExerciseRun { ExerciseId = exerciseId, Anchor = anchor };
        _slate.Exercises.Add(run);
        _workshopView = WorkshopView.Tools;
        _toolMenuFor = null;
        // Started from the Cast dialog: close it so the dock is what the writer sees.
        _libraryOpen = false;
        if (!_workshopOpen)
        {
            _workshopOpen = true;
            await PersistSessionAsync();
        }

        await SetToolRunAsync(run.Id);
    }

    // Which Cast row or Board card has its Tools menu open ("cast:NAME" / "card:LINE").
    private string? _toolMenuFor;

    private void ToggleToolMenu(string key) => _toolMenuFor = _toolMenuFor == key ? null : key;

    private bool CastMenuOpen(string name) => _toolMenuFor == "cast:" + name;

    private void ToggleCastMenu(string name) => ToggleToolMenu("cast:" + name);

    private bool CardMenuOpen(BoardCard card) => _toolMenuFor == "card:" + card.LineNumber;

    private void ToggleCardMenu(BoardCard card) => ToggleToolMenu("card:" + card.LineNumber);

    // "Position this" on an inbox beat (the BEATS tray and the BOARD strip): the run kept for the beat, or a
    // new one, opened with the beat as its anchor.
    private async Task PositionBeatAsync(Beat beat)
    {
        var run = _slate.Exercises.FirstOrDefault(entry => entry.ExerciseId == SlateMigration.PositionId
            && entry.Anchor.Kind == AnchorKind.InboxBeat && entry.Anchor.TargetId == beat.Id);
        if (run is not null)
        {
            _workshopView = WorkshopView.Tools;
            _toolMenuFor = null;
            if (!_workshopOpen)
            {
                _workshopOpen = true;
                await PersistSessionAsync();
            }

            await SetToolRunAsync(run.Id);
            return;
        }

        await StartToolAsync(SlateMigration.PositionId,
            new Anchor { Kind = AnchorKind.InboxBeat, TargetId = beat.Id, Text = beat.Title.Length > 0 ? beat.Title : "Untitled beat" });
    }

    private Task StartCastToolAsync(string exerciseId, string character) =>
        StartToolAsync(exerciseId, new Anchor { Kind = AnchorKind.Character, Text = character });

    // A Board scene card: the scene is the anchor for exercises that take one,
    // and the character defaults to whoever speaks most in it.
    private Task StartCardToolAsync(string exerciseId, BoardCard card)
    {
        var host = _toolHost;
        var scene = host.Scenes.FirstOrDefault(entry => entry.LineNumber == card.LineNumber);
        if (scene is not null && ExerciseCatalog.Find(exerciseId)?.Anchor == AnchorKind.Scene)
        {
            return StartToolAsync(exerciseId, new Anchor { Kind = AnchorKind.Scene, TargetId = scene.Id, Text = scene.Heading, SceneId = scene.Id, SceneText = scene.Heading });
        }

        // Extend backward from a scene: the Shape's end exercise, with this scene named.
        if (scene is not null && ExerciseCatalog.Find(exerciseId) is { Anchor: AnchorKind.Shape, SceneToo: true })
        {
            return StartToolAsync(exerciseId, new Anchor { Kind = AnchorKind.Shape, SceneId = scene.Id, SceneText = scene.Heading });
        }

        // Bridge from a card: this scene is A; Z is picked in the strip.
        if (scene is not null && ExerciseCatalog.Find(exerciseId)?.Anchor == AnchorKind.TwoPoints)
        {
            return StartToolAsync(exerciseId, new Anchor { Kind = AnchorKind.TwoPoints, TargetId = scene.Id, Text = scene.Heading + " → ?", SceneId = scene.Id, SceneText = scene.Heading });
        }

        var speaker = scene is null ? string.Empty : host.SpeakersOf(scene).FirstOrDefault() ?? string.Empty;
        var anchor = new Anchor { Kind = AnchorKind.Character, Text = speaker };
        if (scene is not null && ExerciseCatalog.Find(exerciseId)?.SceneToo == true)
        {
            anchor.SceneId = scene.Id;
            anchor.SceneText = scene.Heading;
        }

        return StartToolAsync(exerciseId, anchor);
    }

    private int _toolsRotation;

    private IReadOnlyList<RightNowSuggestion> ToolRightNow()
    {
        var cast = ProjectContext.Cast(_analysis.Characters, _slate.Characters);
        var scene = ProjectContext.SceneAt(ProjectContext.Scenes(_analysis.Elements), _caretLine);
        var speakers = scene is null
            ? new List<string>()
            : ProjectContext.SpeakersOf(scene, StoryFilter.SceneSpeakers(_analysis.Elements), cast);
        var input = new RightNowInput
        {
            BracketUnderCaret = _analysis.Brackets.FirstOrDefault(bracket => bracket.LineNumber == _caretLine && !IsIgnored(bracket))?.Text,
            SceneUnderCaret = scene,
            SceneSpeakers = speakers,
            NewestInboxBeat = _slate.Beats.LastOrDefault(beat => beat.Page == 0),
            NoStructure = ShapeLine.Derive(_analysis.BoardLanes) is null
                && !_analysis.Elements.OfType<SectionElement>().Any(section => section.SectionDepth <= 2),
            CastWithoutNote = cast.Where(character => ProjectContext.NoteFor(_slate.Story, character.Name) is null).ToList(),
            Rotation = _toolsRotation
        };
        return RightNow.Suggest(input, ExerciseCatalog.All.Select(exercise => exercise.Id).ToHashSet());
    }

    private string SynopsisLabelFor(Anchor anchor)
    {
        if (!HasSceneAnchor(anchor) && anchor.Kind != AnchorKind.Bracket)
        {
            return PromotionTargetLabel;
        }

        return AnchorScene(anchor) is { } scene
            ? $"Goes in as a = synopsis line under {scene.Heading} (line {scene.LineNumber})."
            : $"{SceneAnchorName(anchor)} is no longer in the script — nothing will be inserted.";
    }

    private async Task<bool> SendToolAsync(TargetKind target, ToolSend send)
    {
        if (target == TargetKind.Board)
        {
            return await SendBeatUnderTurnAsync(send);
        }

        var text = send.Text.Trim();
        if (text.Length == 0)
        {
            _statusMessage = "Nothing to send yet — write the answer first";
            return false;
        }

        var character = send.Anchor.Kind == AnchorKind.Character ? send.Anchor.Text.Trim() : string.Empty;
        switch (target)
        {
            case TargetKind.Bracket:
                return await FillBracketAsync(send with { Text = text });
            case TargetKind.Synopsis:
                return await PutSynopsisAsync(text, send.Anchor);
            case TargetKind.InboxBeat:
                var beat = ToolTargets.BuildBeat(text);
                _slate.Beats.Add(beat);
                if (character.Length > 0)
                {
                    ToolTargets.TagBeat(_slate.Story, beat, character);
                }

                SaveSlate();
                _statusMessage = character.Length > 0
                    ? $"Added to the Inbox, tagged {Characters.BareName(character)}"
                    : "Added to the Inbox";
                return true;
            case TargetKind.SceneCard:
                return await SendSceneCardBetweenAsync(send with { Text = text });
            case TargetKind.NotePage:
                if (character.Length == 0)
                {
                    _statusMessage = "Name a character first — the note page is theirs";
                    return false;
                }

                var (page, created) = ToolTargets.AppendToNote(_slate.Story, character, send.Exercise, send.Label, text);
                SaveSlate();
                _statusMessage = created
                    ? $"Started {page.Title}'s note page from the Character template and added it"
                    : $"Added to {page.Title}'s note page";
                return true;
            case TargetKind.Copy:
                bool copied;
                try
                {
                    copied = await JS.InvokeAsync<bool>("passage.copyText", text);
                }
                catch (JSException)
                {
                    copied = false;
                }

                _statusMessage = copied ? "Copied" : "Could not copy — select the text and copy it by hand";
                return copied;
            default:
                _statusMessage = "That target isn't available from here yet";
                return false;
        }
    }

    // Position's target: the inbox beat becomes a scene card under the sequence its chosen turn sits on,
    // through the same path as Send to Board (a beat still on the page plan asks first). send.Text is the turn.
    private async Task<bool> SendBeatUnderTurnAsync(ToolSend send)
    {
        var turn = send.Text.Trim();
        if (turn.Length == 0)
        {
            _statusMessage = "Pick which turn it goes in first — nothing sent";
            return false;
        }

        if (send.Anchor.Kind != AnchorKind.InboxBeat || _slate.Beats.FirstOrDefault(entry => entry.Id == send.Anchor.TargetId) is not { } beat)
        {
            _statusMessage = "That beat is no longer in the inbox — nothing sent";
            return false;
        }

        if (ToolTargets.SequenceForTurn(ScriptSequences, turn) is not { } sequence)
        {
            _statusMessage = $"No sequence in the script has {turn} — write the shape first (A→Z→Split). Nothing sent";
            return false;
        }

        if (beat.Page > 0)
        {
            // Same confirm as Send to Board: the page plan is dropped.
            _sendBeat = beat;
            _sendBeatTarget = (sequence.Id, turn);
            return false;
        }

        if (!await ConvertBeatToCardAsync(beat, sequence.Id, true))
        {
            return false;
        }

        _statusMessage += $", under {turn}";
        return true;
    }

    // Bridge's optional target: a scene card between A and Z, in order, so each link sent lands after the last. It
    // goes just before Z (or just after A when Z isn't named), by ranged insert so undo restores it exactly.
    private async Task<bool> SendSceneCardBetweenAsync(ToolSend send)
    {
        var anchor = send.Anchor;
        var scenes = ProjectContext.Scenes(_analysis.Elements);
        var start = ProjectContext.Resolve(scenes, anchor);
        var end = ProjectContext.ResolveEnd(scenes, anchor);
        var namedStart = HasSceneAnchor(anchor);
        var namedEnd = anchor.EndSceneId is not null || anchor.EndSceneText.Length > 0;
        if (!namedStart && !namedEnd)
        {
            _statusMessage = "Name the two cards first — nothing inserted";
            return false;
        }

        if (namedStart && start is null || namedEnd && end is null)
        {
            _statusMessage = $"{(namedStart && start is null ? "A" : "Z")} is no longer in the script — nothing inserted";
            return false;
        }

        if (start is not null && end is not null && start.LineNumber >= end.LineNumber)
        {
            _statusMessage = "A doesn't come before Z in the script — nothing inserted";
            return false;
        }

        var (anchorScene, after) = end is not null ? (end, false) : (start!, true);
        var headings = _analysis.Elements.OfType<SceneHeadingElement>();
        if (headings.FirstOrDefault(heading => heading.LineNumber == anchorScene.LineNumber) is not { } element)
        {
            _statusMessage = $"{anchorScene.Heading} is no longer in the script — nothing inserted";
            return false;
        }

        var beat = ToolTargets.BuildBeat(send.Text);
        var cardId = Guid.NewGuid();
        var cardLines = BeatInbox.SceneLines(beat, cardId);
        var scriptLines = _content.Replace("\r\n", "\n").Split('\n');
        if (!BeatInbox.TryPlan(_analysis.Elements, scriptLines, element.Id, after, cardLines, out var insertAt, out var text))
        {
            _statusMessage = $"{anchorScene.Heading} is no longer in the script — nothing inserted";
            return false;
        }

        bool inserted;
        try
        {
            inserted = await JS.InvokeAsync<bool>("passage.insertLinesAt", insertAt, text);
        }
        catch (JSException)
        {
            inserted = false;
        }

        if (!inserted)
        {
            _statusMessage = "Could not add the scene card — nothing changed";
            return false;
        }

        MirrorInsert(insertAt, text);
        _statusMessage = $"Added a scene card \"{BeatInbox.Heading(beat)}\" {(after ? "after" : "before")} {anchorScene.Heading}";
        return true;
    }

    private async Task JumpToToolAnchorAsync(Anchor anchor)
    {
        int? line = null;
        if (anchor.Kind == AnchorKind.Bracket)
        {
            line = _analysis.Brackets.FirstOrDefault(entry => entry.Text == anchor.Text)?.LineNumber;
        }
        else if (HasSceneAnchor(anchor))
        {
            line = ProjectContext.Resolve(ProjectContext.Scenes(_analysis.Elements), anchor)?.LineNumber;
        }
        else if (anchor.Kind == AnchorKind.Shape)
        {
            line = ScriptSequences.FirstOrDefault()?.LineNumber;
        }
        else if (anchor.Kind == AnchorKind.Character && anchor.Text.Length > 0)
        {
            var name = Characters.BareName(anchor.Text);
            line = _analysis.Elements.OfType<CharacterElement>()
                .FirstOrDefault(cue => Characters.BareName(cue.CharacterName) == name)?.LineNumber;
        }

        if (line is null)
        {
            _statusMessage = "That isn't in the script right now";
            return;
        }

        try
        {
            await JS.InvokeVoidAsync("passage.scrollToLine", line.Value, false);
        }
        catch (JSException)
        {
        }
    }

