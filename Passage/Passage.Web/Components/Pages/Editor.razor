@page "/"
@using Passage.Core.Goals
@using Passage.Export
@using Passage.Parser
@using System.Text.Json
@inject ScriptLibrary Library
@inject ExportService Exports
@inject GoalSettingsStore GoalStore
@inject SlateStore Slate
@inject IJSRuntime JS
@implements IDisposable

<div class="app-shell">
    <header class="topbar">
        <span class="brand">PASSAGE</span>
        <details class="menu script-menu">
            <summary class="file-pill" title="@DisplayName — open a script">
                <span class="file-pill-name">@DisplayName</span>
                @if (_isDirty)
                {
                    <span class="dirty-dot">*</span>
                }
                <span class="file-pill-caret">▾</span>
            </summary>
            <div class="menu-items script-list">
                @if (_files.Count == 0)
                {
                    <div class="sidebar-empty">No scripts yet.
Click New to start one — files are stored on the server volume.</div>
                }
                @if (_recentFiles.Count > 0)
                {
                    <div class="sidebar-heading">RECENT</div>
                    @foreach (var name in _recentFiles)
                    {
                        <div class="file-row @(name == _fileName ? "active" : null)"
                             @onclick="() => RequestOpenRecentAsync(name)">
                            <span class="file-name">@name</span>
                        </div>
                    }
                    <div class="sidebar-heading">ALL SCRIPTS</div>
                }
                @foreach (var file in _files)
                {
                    <div class="file-row @(file.Name == _fileName ? "active" : null)" @onclick="() => RequestOpenFile(file.Name)">
                        <span class="file-name">@file.Name</span>
                        <span class="file-meta">@FormatTimestamp(file.LastModifiedUtc)</span>
                        <button class="icon-btn" title="Delete @file.Name"
                                @onclick="() => RequestDeleteFile(file.Name)" @onclick:stopPropagation="true">✕</button>
                    </div>
                }
            </div>
        </details>

        <nav class="view-tabs">
            <button class="@(_mainViewIndex == 0 ? "active" : null)" @onclick="() => SetMainView(0)">SCRIPT</button>
            <button class="@(_mainViewIndex == 1 ? "active" : null)" @onclick="() => SetMainView(1)">BOARD</button>
            <button class="@(_mainViewIndex == 2 ? "active" : null)" @onclick="() => SetMainView(2)">PREVIEW</button>
        </nav>

        <div class="topbar-actions">
            <button class="btn theme-toggle" @onclick="ToggleThemeAsync"
                    title="@(_theme == "light" ? "Switch to dark theme" : "Switch to light theme")">
                @(_theme == "light" ? "☾" : "☀")
            </button>
            <button class="btn theme-toggle @(_syntaxPanelOpen ? "on" : null)"
                    title="Syntax reference (F1)" @onclick="ToggleSyntaxPanel">?</button>
            <button class="btn theme-toggle @(_workshopOpen ? "on" : null)"
                    title="Writer's tools" @onclick="ToggleWorkshopAsync">TOOLS</button>
            <label class="toggle" title="Save automatically shortly after you stop typing">
                <input type="checkbox" @bind="_autosaveEnabled" /> AUTOSAVE
            </label>
            <button class="btn" @onclick="RequestNewFile">New</button>
            <button class="btn primary" @onclick="SaveAsync">Save</button>
            <details class="menu">
                <summary class="btn">Document ▾</summary>
                <div class="menu-items">
                    <button @onclick="OpenTitlePage">Title Page…</button>
                    <button @onclick='() => ExportAsync("pdf")'>PDF (.pdf)</button>
                    <button @onclick='() => ExportAsync("txt")'>Plain text (.txt)</button>
                    <button @onclick='() => ExportAsync("fountain")'>Fountain source (.fountain)</button>
                </div>
            </details>
        </div>
    </header>

    @if (_findOpen)
    {
        <div class="find-bar">
            <div class="find-fields">
                <label class="find-field">
                    <span>Find:</span>
                    <input type="text" @ref="_findInput" @bind="_findTerm" @bind:event="oninput"
                           placeholder="Text to find..." @onkeydown="OnFindKeyDown" />
                </label>
                @if (_replaceShown)
                {
                    <label class="find-field">
                        <span>Replace with:</span>
                        <input type="text" @bind="_replaceTerm" @bind:event="oninput"
                               placeholder="Replacement text..." @onkeydown="OnFindKeyDown" />
                    </label>
                }
            </div>
            <div class="find-options">
                <label class="toggle"><input type="checkbox" @bind="_matchCase" /> Match case</label>
                <label class="toggle"><input type="checkbox" @bind="_wholeWord" /> Whole word</label>
            </div>
            <div class="find-actions">
                <button class="btn" @onclick="() => FindAsync(false)">Previous</button>
                <button class="btn primary" @onclick="() => FindAsync(true)">Find Next</button>
                @if (_replaceShown)
                {
                    <button class="btn" @onclick="ReplaceCurrentAsync">Replace</button>
                    <button class="btn" @onclick="ReplaceAllAsync">Replace All</button>
                }
                else
                {
                    <button class="btn" @onclick="() => { _replaceShown = true; }">Replace…</button>
                }
                <span class="find-status">@_findStatus</span>
                <button class="icon-btn" title="Close (Esc)" @onclick="CloseFind">✕</button>
            </div>
        </div>
    }

    <div class="main-area">
        <aside class="sidebar">
            <div class="sidebar-tabs">
                <button class="@(_sidebarTab == 0 ? "active" : null)" @onclick="() => _sidebarTab = 0">OUTLINE</button>
                <button class="@(_sidebarTab == 1 ? "active" : null)" @onclick="() => _sidebarTab = 1">NOTES</button>
                <button class="@(_sidebarTab == 2 ? "active" : null)" @onclick="() => _sidebarTab = 2">GOALS</button>
            </div>
            <div class="sidebar-body">
                @if (_sidebarTab == 0)
                {
                    @if (_analysis.Outline.Count == 0)
                    {
                        <div class="sidebar-empty">@OutlineEmptyMessage</div>
                    }
                    @foreach (var node in _analysis.Outline)
                    {
                        @RenderOutlineNode(node)
                    }
                }
                else if (_sidebarTab == 1)
                {
                    @if (_analysis.Notes.Count == 0)
                    {
                        <div class="sidebar-empty">No [[notes]] in this script yet.</div>
                    }
                    @foreach (var note in _analysis.Notes)
                    {
                        <div class="outline-label" @onclick="() => JumpToLineAsync(note.LineNumber)">
                            <span class="outline-kind k-note">Note</span>
                            <span>@note.Text</span>
                        </div>
                    }
                }
                else
                {
                    <div class="goal-panel">
                        <div class="goal-card">
                            <div class="goal-card-title">SESSION</div>
                            <label class="goal-field">
                                <span>GOAL TYPE</span>
                                <select @bind="SessionGoalTypeString">
                                    <option value="WordCount">Word count</option>
                                    <option value="PageCount">Page count</option>
                                    <option value="Timer">Timer</option>
                                </select>
                            </label>
                            <label class="goal-field">
                                <span>@(IsTimerSession ? "TARGET (MINUTES)" : "TARGET")</span>
                                <input type="number" min="1" max="100000" @bind="SessionTargetValue" />
                            </label>

                            <div class="goal-dash">
                                <div class="goal-ring-wrap">
                                    <svg class="goal-ring" viewBox="0 0 110 110">
                                        <circle class="ring-track" cx="55" cy="55" r="48" />
                                        <circle class="ring-progress @(SessionComplete ? "done" : null)" cx="55" cy="55" r="48"
                                                style="stroke-dasharray:@RingDash(SessionPercent)" />
                                    </svg>
                                    <div class="goal-ring-center">
                                        @if (IsTimerSession)
                                        {
                                            <span class="ring-big">@FormatClock(TimerRemaining)</span>
                                        }
                                        else
                                        {
                                            <span class="ring-big">@((int)Math.Round(SessionPercent))%</span>
                                        }
                                    </div>
                                </div>
                                <div class="goal-stats">
                                    <div class="goal-stat-big">@SessionCurrentDisplay</div>
                                    <div class="goal-stat-label">CURRENT</div>
                                    <div class="goal-stat-mid">@SessionTargetDisplay</div>
                                    <div class="goal-stat-label">TARGET</div>
                                </div>
                            </div>

                            @if (IsTimerSession)
                            {
                                <div class="goal-actions">
                                    @if (_timerState is TimerGoalState.Idle)
                                    {
                                        <button class="btn primary" @onclick="StartTimer">Start</button>
                                    }
                                    else if (_timerState is TimerGoalState.Running)
                                    {
                                        <button class="btn" @onclick="PauseTimer">Pause</button>
                                    }
                                    else if (_timerState is TimerGoalState.Paused)
                                    {
                                        <button class="btn primary" @onclick="StartTimer">Resume</button>
                                    }
                                    <button class="btn" @onclick="ResetTimer">Reset</button>
                                </div>
                                <div class="goal-timer-row">
                                    <span>Elapsed @FormatClock(TimerElapsed)</span>
                                    <span>Remaining @FormatClock(TimerRemaining)</span>
                                </div>
                            }
                            <div class="goal-state @(SessionComplete ? "done" : null)">@(SessionComplete ? "Complete" : "In progress")</div>
                            <button class="btn goal-reset" @onclick="ResetSession">Reset session</button>
                        </div>

                        <div class="goal-card">
                            <div class="goal-card-title">DOCUMENT</div>
                            <label class="goal-field">
                                <span>GOAL TYPE</span>
                                <select @bind="DocumentGoalTypeString">
                                    <option value="WordCount">Word count</option>
                                    <option value="PageCount">Page count</option>
                                </select>
                            </label>
                            <label class="goal-field">
                                <span>TARGET</span>
                                <input type="number" min="1" max="1000000" @bind="DocumentTargetValue" />
                            </label>
                            <div class="goal-bar-track">
                                <div class="goal-bar-fill @(DocumentComplete ? "done" : null)" style="width:@(Math.Min(100, DocumentPercent).ToString("0.#", System.Globalization.CultureInfo.InvariantCulture))%"></div>
                            </div>
                            <div class="goal-timer-row">
                                <span>@DocumentCurrentDisplay</span>
                                <span>of @DocumentTargetDisplay</span>
                            </div>
                            <div class="goal-state @(DocumentComplete ? "done" : null)">@(DocumentComplete ? "Complete" : "In progress")</div>
                        </div>
                    </div>
                }
            </div>
        </aside>

        <main class="center-pane">
            <div class="editor-surface" hidden="@(_mainViewIndex != 0)">
                <div class="editor-stack" style="--editor-font-size:@(_editorFontPx)px">
                    <div id="editor-host"></div>
                </div>
            </div>

            @if (_mainViewIndex == 1)
            {
                @if (!IsScreenplayMode)
                {
                    <div class="board-empty">The Beat Board works in Screenplay mode.
Open a .fountain file to see nested index cards here.</div>
                }
                else if (_analysis.BoardLanes.Count == 0)
                {
                    <div class="board-empty">The board mirrors your script's structure.
Add Acts (#), Sequences (##), and Scenes to see nested index cards here.</div>
                }
                else
                {
                    <div class="board-surface">
                        @foreach (var lane in _analysis.BoardLanes)
                        {
                            var laneKey = LaneKey(lane);
                            var laneOpen = !_collapsedLanes.Contains(laneKey);
                            <div class="board-lane">
                                @if (lane.ActCard is not null && _editingCardId == lane.ActCard.Id && lane.ActCard.Id != Guid.Empty)
                                {
                                    @RenderCardEditor(lane.ActCard)
                                }
                                else
                                {
                                    <div class="board-lane-head">
                                        <span class="board-twisty" @onclick="() => ToggleLane(laneKey)">@(laneOpen ? "▾" : "▸")</span>
                                        <span class="board-lane-title" @onclick="() => ToggleLane(laneKey)">@(lane.ActCard?.Heading ?? "Script")</span>
                                        @if (lane.ActCard is not null && lane.ActCard.Id != Guid.Empty)
                                        {
                                            <button class="icon-btn board-add" title="Edit act"
                                                    @onclick="() => StartCardEdit(lane.ActCard)">✎</button>
                                        }
                                        <button class="icon-btn board-add" title="Add a scene to this act"
                                                @onclick="() => AddSceneToBlockAsync(lane.ActCard)">+</button>
                                    </div>
                                }
                                @if (lane.ActCard is { Description.Length: > 0 })
                                {
                                    <div class="board-lane-synopsis">@lane.ActCard.Description</div>
                                }
                                @if (laneOpen)
                                {
                                    @foreach (var group in lane.Groups)
                                    {
                                        var groupKey = laneKey + "/" + GroupKey(group);
                                        var groupOpen = !_collapsedGroups.Contains(groupKey);
                                        <div class="board-group">
                                            @if (group.SequenceCard is not null)
                                            {
                                                @if (_editingCardId == group.SequenceCard.Id && group.SequenceCard.Id != Guid.Empty)
                                                {
                                                    @RenderCardEditor(group.SequenceCard)
                                                }
                                                else
                                                {
                                                    <div class="board-group-head">
                                                        <span class="board-twisty" @onclick="() => ToggleGroup(groupKey)">@(groupOpen ? "▾" : "▸")</span>
                                                        <span class="board-group-title" @onclick="() => ToggleGroup(groupKey)">@group.SequenceCard.Heading</span>
                                                        <button class="icon-btn board-add" title="Edit sequence"
                                                                @onclick="() => StartCardEdit(group.SequenceCard)">✎</button>
                                                        <button class="icon-btn board-add" title="Add a scene to this sequence"
                                                                @onclick="() => AddSceneToBlockAsync(group.SequenceCard)">+</button>
                                                    </div>
                                                }
                                                @if (group.SequenceCard.Description.Length > 0)
                                                {
                                                    <div class="board-group-synopsis">@group.SequenceCard.Description</div>
                                                }
                                            }
                                            @if (groupOpen)
                                            {
                                                @foreach (var card in group.Cards)
                                                {
                                                    @RenderBoardCard(card)
                                                }
                                            }
                                        </div>
                                    }
                                }
                            </div>
                        }
                    </div>
                }
            }
            else if (_mainViewIndex == 2)
            {
                @if (!IsScreenplayMode)
                {
                    <div class="preview-empty">Page preview works in Screenplay mode.
Open a .fountain file to see formatted pages.</div>
                }
                else
                {
                    <div class="preview-toolbar">
                        <span>@_analysis.PageCount page@(_analysis.PageCount == 1 ? "" : "s")</span>
                        <button class="btn" @onclick="() => AdjustPreviewZoom(-0.15)">−</button>
                        <span>@((int)Math.Round(_previewZoom * 100))%</span>
                        <button class="btn" @onclick="() => AdjustPreviewZoom(+0.15)">+</button>
                    </div>
                    <div class="preview-surface">
                        @foreach (var page in _analysis.PreviewPages)
                        {
                            <div class="preview-page" style="font-size:@(PreviewFontPx)px">
                                <div class="preview-page-number">
                                    @if (!page.IsTitlePage && page.PageNumber > 1)
                                    {
                                        <span>@(page.PageNumber).</span>
                                    }
                                </div>
                                <div class="preview-body">
                                    @foreach (var line in page.Lines)
                                    {
                                        <div class="pl @StyleClass(line.Style)" style="@IndentStyle(line)">@(line.Text.Length == 0 ? " " : line.Text)</div>
                                    }
                                </div>
                            </div>
                        }
                    </div>
                }
            }
        </main>
        @if (_syntaxPanelOpen)
        {
            <SyntaxReferencePanel OnClose="CloseSyntaxPanel" />
        }
        <aside class="workshop" hidden="@(!_workshopOpen)">
            <div id="workshop-resize" class="workshop-resize" title="Drag to resize"></div>
            <div class="workshop-head">
                <h2>WRITER'S TOOLS</h2>
                <button class="btn" title="Close (keeps everything as it is)" @onclick="ToggleWorkshopAsync">×</button>
            </div>
            <div class="workshop-body">
                @if (_workshopView == WorkshopView.Tools)
                {
                    <p class="tool-note">Tools for when you're stuck. Find the line that matches where you are and open the tool under it. Each one works in small steps — do one step and stop, or keep going.</p>

                    <div class="tool-group">
                        <div class="tool-have">You have nothing yet — no idea, or just a scrap of one</div>
                        <div class="tool-paths">
                            <button class="workshop-tool" @onclick="OpenIdeationAsync">
                                <span class="tool-name">Ideation burst</span>
                                <span class="tool-desc">Short timed rounds of fast, throwaway writing from a random prompt. Nothing has to be good; the point is to get words moving. You keep one line at the end.</span>
                            </button>
                            <button class="workshop-tool" @onclick="OpenBridgesAsync">
                                <span class="tool-name">Bridge</span>
                                <span class="tool-desc">You know two moments that will happen — a start and an end, a setup and its payoff — but not what connects them. Bridge builds the links between them, three guesses at a time.</span>
                            </button>
                        </div>
                    </div>

                    <div class="tool-group">
                        <div class="tool-have">You have an ending, a rough shape, or a character — but not the events</div>
                        <div class="tool-paths">
                            <button class="workshop-tool" @onclick="() => OpenGenerateAsync(WorkshopView.Split)">
                                <span class="tool-name">A→Z→Split</span>
                                <span class="tool-desc">Start with your first event and your last. Find the one event in the middle that makes the ending inevitable, then split each half the same way, until you have a story's seven turning points.</span>
                            </button>
                            <button class="workshop-tool" @onclick="() => OpenGenerateAsync(WorkshopView.Belief)">
                                <span class="tool-name">Belief Split</span>
                                <span class="tool-desc">The same idea, run on what a character believes instead of what happens: the false belief they start with, the truth they end with, and the steps in between.</span>
                            </button>
                            <button class="workshop-tool" @onclick="() => OpenGenerateAsync(WorkshopView.Extend)">
                                <span class="tool-name">Extend Backward</span>
                                <span class="tool-desc">You only know how it ends. Work backwards one step at a time — what had to happen right before this? — until you reach a beginning.</span>
                            </button>
                        </div>
                    </div>

                    <div class="tool-group">
                        <div class="tool-have">You have a scene but not where it goes — or a gap where a scene should be</div>
                        <div class="tool-paths">
                            <button class="workshop-tool" @onclick="OpenPositionsAsync">
                                <span class="tool-name">Position</span>
                                <span class="tool-desc">Try a scene you love in each of a story's seven slots and see where it comes alive — what would have to be true before it, and what it would force to happen after.</span>
                            </button>
                            <button class="workshop-tool" @onclick="() => _workshopView = WorkshopView.Brackets">
                                <span class="tool-name">
                                    Fill
                                    @if (_analysis.Brackets.Count > 0)
                                    {
                                        <span class="workshop-count">@_analysis.Brackets.Count in this script</span>
                                    }
                                </span>
                                <span class="tool-desc">When you don't know what happens next, write [SOMETHING happens] in your script and keep going. Fill hands those gaps back to you one at a time and helps you work out the real event.</span>
                            </button>
                        </div>
                    </div>

                    <div class="tool-group">
                        <div class="tool-have">You have a scene in motion and need what happens next</div>
                        <div class="tool-paths">
                            <button class="workshop-tool" @onclick="() => OpenChainsAsync(ChainPath.Woac)">
                                <span class="tool-name">WOAC chain</span>
                                <span class="tool-desc">Four questions on repeat: what does the character want, what's in the way, what do they do about it, what happens as a result. The result becomes the next want, so you never have to invent the next question.</span>
                            </button>
                            <button class="workshop-tool" @onclick="() => OpenChainsAsync(ChainPath.Flaw)">
                                <span class="tool-name">Character Flaw Brainstorm</span>
                                <span class="tool-desc">Eight fixed questions that take one character flaw from the worst situation it causes to a surprising final action.</span>
                            </button>
                        </div>
                    </div>

                    <div class="tool-group">
                        <div class="tool-have">You have a finished scene or draft that feels dead or flat</div>
                        <div class="tool-paths">
                            <button class="workshop-tool" @onclick="OpenRevisionsAsync">
                                <span class="tool-name">Push/Pull and Lens</span>
                                <span class="tool-desc">Six checks that find why a scene isn't working — does it end somewhere different from where it started, does it cause the next beat — and a set of lenses for rewriting only the part that's flagged.</span>
                            </button>
                        </div>
                    </div>
                }
                else if (_workshopView == WorkshopView.Brackets)
                {
                    <div class="workshop-nav">
                        <button class="btn" title="Back" @onclick="() => _workshopView = WorkshopView.Tools">←</button>
                        <span class="sidebar-heading">FILL</span>
                    </div>
                    <p class="tool-note">When you don't know what happens next, don't stop — write it as a placeholder in square brackets, like <code>[SOMETHING forces her to stay]</code>, and keep writing. Each one is a gap to come back to. Filling it means swapping it for the real, concrete event — not a better-worded placeholder.</p>
                    <button class="btn primary workshop-hand" disabled="@(!EligibleBrackets.Any())" @onclick="HandMeOneAsync">Hand me one</button>
                    @if (_analysis.Brackets.Count == 0)
                    {
                        <div class="sidebar-empty">No [brackets] in this script.</div>
                    }
                    else
                    {
                        <div class="sidebar-heading">@_analysis.Brackets.Count IN THE SCRIPT</div>
                        @foreach (var bracket in _analysis.Brackets)
                        {
                            var ignored = IsIgnored(bracket);
                            <div class="bracket-row @(ignored ? "ignored" : null)">
                                <button class="bracket-text" title="Line @bracket.LineNumber" @onclick="() => JumpToLineAsync(bracket.LineNumber)">@bracket.Text</button>
                                @if (ignored)
                                {
                                    <button class="icon-btn" title="Treat as a placeholder again" @onclick="() => RestoreBracket(bracket)">↩</button>
                                }
                                else
                                {
                                    <button class="icon-btn" title="Fill this one" @onclick="() => OpenFillAsync(bracket)">Fill</button>
                                    <button class="icon-btn" title="Prose, not a placeholder — leave it out" @onclick="() => IgnoreBracketAsync(bracket)">×</button>
                                }
                            </div>
                        }
                    }
                }
                else if (_fillBracket is not null && _fillRun is not null)
                {
                    <div class="workshop-nav">
                        <button class="btn" title="Back — keeps what you've written" @onclick="CloseFill">←</button>
                        <span class="sidebar-heading">FILL</span>
                    </div>
                    <button class="bracket-text fill-bracket" title="Line @_fillBracket.LineNumber" @onclick="() => JumpToLineAsync(_fillBracket.LineNumber)">@_fillBracket.Text</button>
                    <div class="fill-meta">Line @_fillBracket.LineNumber@(_fillBracket.Rank == 1 ? " · reads like prose" : "")</div>
                    @if (_fileName.Length == 0)
                    {
                        <div class="fill-meta">Untitled — the working-out is kept once the script has a name.</div>
                    }
                    <p class="tool-note">Invent three candidate events for the bracket, each one you expect to be wrong, and for each write why it's wrong. The reasons are the actual work — together they narrow down what the real answer has to do, before you know what it is. Most of the time the real answer shows up before the third candidate; when it does, stop and write it down. You don't owe the table anything else.</p>
                    <div class="fill-options">
                        <span class="fill-label">Candidate — what could happen here</span>
                        <span class="fill-label">Why it's probably wrong (one line)</span>
                        @foreach (var option in _fillRun.Options)
                        {
                            <textarea rows="2" @bind="option.Text" @bind:after="SaveSlate"></textarea>
                            <textarea rows="2" @bind="option.WhyWrong" @bind:after="SaveSlate"></textarea>
                        }
                    </div>
                    <label class="fill-field">
                        <span class="fill-label">What the wrongness points to</span>
                        <span class="fill-hint">Read your "why it's wrong" answers together. What do they agree the real event needs to do, or needs to avoid?</span>
                        <textarea rows="3" @bind="_fillRun.PointsTo" @bind:after="SaveSlate"></textarea>
                    </label>
                    <label class="fill-field">
                        <span class="fill-label">Landed on the real answer before finishing the table? Write it here and stop.</span>
                        <span class="fill-hint">The real, concrete, filmable event — <em>[SOMETHING forces her to stay]</em> becomes <em>her car won't start, and the last bus already left</em>.</span>
                        <textarea rows="3" @bind="_fillRun.Answer" @bind:after="SaveSlate"></textarea>
                    </label>
                    <div class="fill-actions">
                        <button class="btn primary" title="Swap the bracket in the script for this" @onclick="AcceptFillAsync">Fill it</button>
                        <button class="btn" title="Prose, not a placeholder — leave it out" @onclick="() => IgnoreBracketAsync(_fillBracket)">Not a bracket</button>
                    </div>
                    <div class="fill-meta">Filled it? The next bracket comes straight away. There's no built-in stopping point — the stop is yours to call.</div>
                }
                else if (_workshopView == WorkshopView.Chains)
                {
                    <div class="workshop-nav">
                        <button class="btn" title="Back" @onclick="() => _workshopView = WorkshopView.Tools">←</button>
                        <span class="sidebar-heading">@ChainTitle</span>
                    </div>
                    <p class="tool-note">@ChainNote</p>
                    <button class="btn primary workshop-hand" @onclick="StartChainAsync">Start a new one</button>
                    @if (ChainsOnPath.Any())
                    {
                        <div class="sidebar-heading">KEPT FOR THIS SCRIPT</div>
                        @foreach (var chain in ChainsOnPath)
                        {
                            <div class="bracket-row">
                                <button class="bracket-text chain-seed" title="Open — everything is as you left it" @onclick="() => OpenChainAsync(chain)">@(string.IsNullOrWhiteSpace(chain.Seed) ? "(no character named yet)" : chain.Seed)</button>
                                <button class="icon-btn" title="Remove this chain and its working-out" @onclick="() => RemoveChain(chain)">×</button>
                            </div>
                        }
                    }
                }
                else if (_chain is not null)
                {
                    <div class="workshop-nav">
                        <button class="btn" title="Back — keeps what you've written" @onclick="CloseChainAsync">←</button>
                        <span class="sidebar-heading">@ChainTitle</span>
                    </div>
                    @if (_fileName.Length == 0)
                    {
                        <div class="fill-meta">Untitled — the working-out is kept once the script has a name.</div>
                    }
                    <p class="tool-note">@ChainNote</p>
                    <div class="burst-row">
                        <label class="burst-toggle"><input type="checkbox" @bind="_slate.Burst.Enabled" @bind:after="BurstSettingChangedAsync" /> Time each answer</label>
                        @if (_slate.Burst.Enabled)
                        {
                            <input type="number" class="burst-seconds" min="5" max="600" @bind="_slate.Burst.Seconds" @bind:after="SaveSlate" />
                            <span class="fill-meta">seconds</span>
                            @if (_burstRunning)
                            {
                                <button class="btn" @onclick="StopBurstAsync">Stop</button>
                            }
                            else
                            {
                                <button class="btn primary" title="Starts at the first empty answer" @onclick="() => StartBurstAsync(ChainSlotsId)">Go</button>
                            }
                            <span class="burst-display" data-burst-display></span>
                        }
                    </div>
                    @if (_slate.Burst.Enabled)
                    {
                        <div class="fill-hint">Five seconds to read the question, then the clock. Enter moves to the next answer; so does the clock running out. Whatever is there when it moves on counts, and you can still go back and add to it.</div>
                    }
                    <div id="@ChainSlotsId" class="chain-slots">
                        <label class="fill-field">
                            <span class="fill-label">@(_chain.Path == ChainPath.Woac ? "Character + starting want" : "Character + the flaw")</span>
                            <textarea rows="2" @bind="_chain.Seed" @bind:after="SaveSlate"></textarea>
                        </label>
                        @if (_chain.Path == ChainPath.Woac)
                        {
                            @for (var i = 0; i < _chain.Rounds.Count; i++)
                            {
                                var index = i;
                                var round = _chain.Rounds[index];
                                <div class="chain-round">
                                    <div class="chain-round-label">Round @(index + 1)</div>
                                    @if (index == 0)
                                    {
                                        <label class="fill-field">
                                            <span class="fill-label">Want — what does the character want right now?</span>
                                            <textarea rows="2" data-slot @bind="round.Want" @bind:after="SaveSlate"></textarea>
                                        </label>
                                    }
                                    else
                                    {
                                        var carried = _chain.Rounds[index - 1].Consequence;
                                        <div class="fill-field">
                                            <span class="fill-label">Want (= round @index consequence)</span>
                                            <div class="chain-carried @(string.IsNullOrWhiteSpace(carried) ? "empty" : null)">@(string.IsNullOrWhiteSpace(carried) ? "Carried down from the consequence above once it's written." : carried)</div>
                                        </div>
                                    }
                                    <label class="fill-field">
                                        <span class="fill-label">Obstacle — what's in their way?</span>
                                        <textarea rows="2" data-slot @bind="round.Obstacle" @bind:after="SaveSlate"></textarea>
                                    </label>
                                    <label class="fill-field">
                                        <span class="fill-label">Action — what do they do about it?</span>
                                        <textarea rows="2" data-slot @bind="round.Action" @bind:after="SaveSlate"></textarea>
                                    </label>
                                    <label class="fill-field">
                                        <span class="fill-label">Consequence — what happens as a result?</span>
                                        <textarea rows="2" data-slot @bind="round.Consequence" @bind:after="() => ConsequenceChanged(round)"></textarea>
                                    </label>
                                </div>
                            }
                            <div class="fill-meta">Write a consequence and the next round appears with it as the want. No limit. A scene usually finds its shape somewhere around 5–7 rounds, but that's a pattern, not a rule.</div>
                        }
                        else
                        {
                            @for (var i = 0; i < ChainRun.FlawQuestionCount; i++)
                            {
                                var index = i;
                                <label class="fill-field">
                                    <span class="fill-label">@(index + 1). @FlawQuestions[index]</span>
                                    <textarea rows="2" data-slot @bind="_chain.Answers[index]" @bind:after="SaveSlate"></textarea>
                                </label>
                            }
                            <div class="fill-meta">You can stop after any question — a partial chain is still real material — but the eight are designed to land on a shape together, so if you're mid-flow, finishing the set in one sitting is worth more here than with WOAC's open-ended rounds.</div>
                        }
                    </div>
                    <label class="fill-field chain-readback">
                        <span class="fill-label">Read it back — what's the scene now, in one line?</span>
                        <textarea rows="2" @bind="_chain.ReadBack" @bind:after="SaveSlate"></textarea>
                    </label>
                    <div class="fill-actions">
                        <button class="btn primary" title="Adds it to the script as a synopsis line" @onclick="PromoteReadBackAsync">Put it in the script</button>
                    </div>
                    <div class="fill-meta">@PromotionTargetLabel</div>
                }
                else if (_workshopView == WorkshopView.Bridges)
                {
                    <div class="workshop-nav">
                        <button class="btn" title="Back" @onclick="() => _workshopView = WorkshopView.Tools">←</button>
                        <span class="sidebar-heading">BRIDGE</span>
                    </div>
                    <p class="tool-note">Two fixed points — a planted detail and its payoff, an opening image and the climax, two characters who haven't met yet but will — and nothing between them. Bridge fixes both ends before anything else; that's the whole trick.</p>
                    <button class="btn primary workshop-hand" @onclick="StartBridgeAsync">Start a new one</button>
                    @if (_slate.Bridges.Count > 0)
                    {
                        <div class="sidebar-heading">KEPT FOR THIS SCRIPT</div>
                        @foreach (var bridge in _slate.Bridges)
                        {
                            <div class="bracket-row">
                                <button class="bracket-text chain-seed" title="Open — everything is as you left it" @onclick="() => OpenBridgeAsync(bridge)">@BridgeLabel(bridge)</button>
                                <button class="icon-btn" title="Remove this bridge and its working-out" @onclick="() => RemoveBridge(bridge)">×</button>
                            </div>
                        }
                    }
                }
                else if (_bridge is not null && _workshopView == WorkshopView.Bridge)
                {
                    <div class="workshop-nav">
                        <button class="btn" title="Back — keeps what you've written" @onclick="CloseBridgeAsync">←</button>
                        <span class="sidebar-heading">BRIDGE</span>
                    </div>
                    @if (_fileName.Length == 0)
                    {
                        <div class="fill-meta">Untitled — the working-out is kept once the script has a name.</div>
                    }
                    <p class="tool-note">Fix both ends first, then rounds of three candidate links between them. Stop after any round — a picked or half-picked link is a complete session.</p>

                    <div class="rung-label">Fix the ends — don't skip this, the whole tool depends on it</div>
                    <label class="fill-field">
                        <span class="fill-label">A — the point you're starting from</span>
                        <textarea rows="2" @bind="_bridge.A" @bind:after="SaveSlate"></textarea>
                    </label>
                    <label class="fill-field">
                        <span class="fill-label">Z — the point you're building to</span>
                        <textarea rows="2" @bind="_bridge.Z" @bind:after="SaveSlate"></textarea>
                    </label>

                    <div class="rung-label">Rounds — three candidates each</div>
                    <p class="tool-note">Write three candidate links, then either pick the one that works, or half-pick one that's close but not quite right. Move to the next round only if the gap still needs more than one link.</p>
                    <div class="burst-row">
                        <label class="burst-toggle"><input type="checkbox" @bind="_slate.Burst.Enabled" @bind:after="BurstSettingChangedAsync" /> Time each candidate</label>
                        @if (_slate.Burst.Enabled)
                        {
                            <input type="number" class="burst-seconds" min="5" max="600" @bind="_slate.Burst.Seconds" @bind:after="SaveSlate" />
                            <span class="fill-meta">seconds</span>
                            @if (_burstRunning)
                            {
                                <button class="btn" @onclick="StopBurstAsync">Stop</button>
                            }
                            else
                            {
                                <button class="btn primary" title="Starts at the first empty candidate" @onclick="() => StartBurstAsync(BridgeSlotsId)">Go</button>
                            }
                            <span class="burst-display" data-burst-display></span>
                        }
                    </div>
                    @if (_slate.Burst.Enabled)
                    {
                        <div class="fill-hint">The worksheet gives a round 30 seconds for its three candidates — about 10 each. Five seconds to read, then the clock; Enter moves to the next candidate, and so does the clock running out. Whatever is there counts.</div>
                    }
                    <div id="@BridgeSlotsId">
                        @for (var r = 0; r < _bridge.Rounds.Count; r++)
                        {
                            var roundIndex = r;
                            var round = _bridge.Rounds[roundIndex];
                            <div class="chain-round">
                                <div class="chain-round-label">Round @(roundIndex + 1)</div>
                                @for (var c = 0; c < round.Candidates.Count; c++)
                                {
                                    var candidateIndex = c;
                                    <label class="fill-field">
                                        <span class="fill-label">Candidate @(candidateIndex + 1)</span>
                                        <textarea rows="2" data-slot @bind="round.Candidates[candidateIndex]" @bind:after="SaveSlate"></textarea>
                                    </label>
                                }
                                <label class="fill-field">
                                    <span class="fill-label">Picked / half-picked</span>
                                    <textarea rows="2" @bind="round.Picked" @bind:after="SaveSlate"></textarea>
                                </label>
                            </div>
                        }
                    </div>
                    <button class="btn" @onclick="AddBridgeRound">Another round — the gap still needs more than one link</button>
                    <div class="fill-meta">No limit — but a gap that needs more than three or four links is probably a whole story's gap, not a scene-to-scene one.</div>

                    <div class="rung-label">Close, whenever you stop</div>
                    @if (_bridge.Rounds.Any(round => !string.IsNullOrWhiteSpace(round.Picked)))
                    {
                        <ol class="chain-forward">
                            @if (!string.IsNullOrWhiteSpace(_bridge.A))
                            {
                                <li class="chain-z">@_bridge.A</li>
                            }
                            @foreach (var round in _bridge.Rounds.Where(round => !string.IsNullOrWhiteSpace(round.Picked)))
                            {
                                <li>@round.Picked</li>
                            }
                            @if (!string.IsNullOrWhiteSpace(_bridge.Z))
                            {
                                <li class="chain-z">@_bridge.Z</li>
                            }
                        </ol>
                    }
                    <label class="fill-field">
                        <span class="fill-label">The wire, read start to finish</span>
                        <textarea rows="3" @bind="_bridge.Wire" @bind:after="SaveSlate"></textarea>
                    </label>
                    <div class="stop-callout">If it's a whole story's gap rather than a scene-to-scene one, this burst version isn't the right tool — that's the slower card version, which is Treatment-stage work, and it isn't built here. A→Z→Split is the tool for a whole story's shape.</div>
                }
                else if (_workshopView == WorkshopView.Positions)
                {
                    <div class="workshop-nav">
                        <button class="btn" title="Back" @onclick="() => _workshopView = WorkshopView.Tools">←</button>
                        <span class="sidebar-heading">POSITION</span>
                    </div>
                    <p class="tool-note">A scene, image or line you already have and love, with nowhere to put it yet. Try it in each of the story's seven slots and see where it comes alive.</p>
                    <button class="btn primary workshop-hand" @onclick="StartPositionAsync">Start a new one</button>
                    @if (_slate.Positions.Count > 0)
                    {
                        <div class="sidebar-heading">KEPT FOR THIS SCRIPT</div>
                        @foreach (var position in _slate.Positions)
                        {
                            <div class="bracket-row">
                                <button class="bracket-text chain-seed" title="Open — everything is as you left it" @onclick="() => OpenPositionAsync(position)">@(string.IsNullOrWhiteSpace(position.Moment) ? "(no moment written yet)" : position.Moment)</button>
                                <button class="icon-btn" title="Remove this run and its working-out" @onclick="() => RemovePosition(position)">×</button>
                            </div>
                        }
                    }
                }
                else if (_position is not null && _workshopView == WorkshopView.Position)
                {
                    <div class="workshop-nav">
                        <button class="btn" title="Back — keeps what you've written" @onclick="ClosePositionAsync">←</button>
                        <span class="sidebar-heading">POSITION</span>
                    </div>
                    @if (_fileName.Length == 0)
                    {
                        <div class="fill-meta">Untitled — the working-out is kept once the script has a name.</div>
                    }
                    <p class="tool-note">Runs one turn at a time. Seven candidate slots exist — the story's seven turns. Do as few or as many as you want: stop after one, or work through all seven in a sitting.</p>
                    <label class="fill-field">
                        <span class="fill-label">The moment — the scene, image or line you already have and love, with nowhere to put it yet</span>
                        <textarea rows="2" @bind="_position.Moment" @bind:after="SaveSlate"></textarea>
                    </label>
                    <p class="tool-note">Each turn: pick one of the seven slots and ask, <em>if this moment sat right here, what would it need to be true right before it, and what would it force to happen right after?</em> If an answer comes easily and feels like it belongs, that's alive. If you have to force it, or nothing comes, that's flat — not a failure, just proof this isn't the slot.</p>
                    @for (var t = 0; t < _position.Turns.Count; t++)
                    {
                        var turnIndex = t;
                        var turn = _position.Turns[turnIndex];
                        <div class="chain-round">
                            <div class="chain-round-label">Turn @(turnIndex + 1)</div>
                            <label class="fill-field">
                                <span class="fill-label">Slot</span>
                                <select class="workshop-select" @bind="turn.Slot" @bind:after="SaveSlate">
                                    <option value="">—</option>
                                    @foreach (var slot in SplitScript.Turns)
                                    {
                                        <option value="@slot.Label">@slot.Label@(_position.Turns.Any(other => other != turn && other.Slot == slot.Label) ? " (tried)" : "")</option>
                                    }
                                </select>
                                @if (ScriptTurnHintFor(turn.Slot) is { } inScript)
                                {
                                    <span class="fill-hint">In the script: @inScript</span>
                                }
                            </label>
                            <label class="fill-field">
                                <span class="fill-label">Needs before it</span>
                                <textarea rows="2" @bind="turn.Before" @bind:after="SaveSlate"></textarea>
                            </label>
                            <label class="fill-field">
                                <span class="fill-label">Forces after it</span>
                                <textarea rows="2" @bind="turn.After" @bind:after="SaveSlate"></textarea>
                            </label>
                            <div class="stress-row">
                                <span class="fill-hint">Alive or flat?</span>
                                <AliveFlat @bind-Value="turn.Alive" @bind-Value:after="SaveSlate" />
                            </div>
                        </div>
                    }
                    @if (_position.Turns.Count < PositionRun.SlotCount)
                    {
                        <button class="btn" @onclick="AddPositionTurn">Another turn</button>
                        <div class="fill-meta">There are only seven slots, so this is the one place in Slate where "keep going" has a natural ceiling.</div>
                    }
                    else
                    {
                        <div class="fill-meta">All seven slots tried — the one place in Slate where "keep going" has a natural ceiling.</div>
                    }
                    <div class="stop-callout">Flat is information — wrong slot, not a wasted turn. More than one alive isn't a problem either — it means you've found candidates, not committed to an answer.</div>

                    <div class="rung-label">Stopping, any turn</div>
                    <p class="tool-note">Shortlist the strongest one or two alive answers and stop there — Split or Fill picks the winner another day, not this worksheet.</p>
                    @if (AliveSlots(_position) is { Count: > 0 } alive)
                    {
                        <div class="fill-hint">Alive so far: @string.Join(", ", alive)</div>
                    }
                    @for (var i = 0; i < _position.Shortlist.Count; i++)
                    {
                        var shortlistIndex = i;
                        <label class="fill-field">
                            <span class="fill-label">Shortlist @(shortlistIndex + 1)</span>
                            <textarea rows="2" @bind="_position.Shortlist[shortlistIndex]" @bind:after="SaveSlate"></textarea>
                        </label>
                    }
                }
                else if (_workshopView == WorkshopView.Revisions)
                {
                    <div class="workshop-nav">
                        <button class="btn" title="Back" @onclick="() => _workshopView = WorkshopView.Tools">←</button>
                        <span class="sidebar-heading">PUSH/PULL AND LENS</span>
                    </div>
                    <p class="tool-note">For a finished (or finished-enough) scene, sequence or draft that's gone dead or flat. Six checks find why; a Lens rewrites only the part that's flagged.</p>
                    <button class="btn primary workshop-hand" @onclick="StartRevisionAsync">Start a new one</button>
                    @if (_slate.Revisions.Count > 0)
                    {
                        <div class="sidebar-heading">KEPT FOR THIS SCRIPT</div>
                        @foreach (var revision in _slate.Revisions)
                        {
                            <div class="bracket-row">
                                <button class="bracket-text chain-seed" title="Open — everything is as you left it" @onclick="() => OpenRevisionAsync(revision)">@(string.IsNullOrWhiteSpace(revision.Scene) ? "(no scene named yet)" : revision.Scene)</button>
                                <button class="icon-btn" title="Remove this run and its working-out" @onclick="() => RemoveRevision(revision)">×</button>
                            </div>
                        }
                    }
                }
                else if (_revision is not null && _workshopView == WorkshopView.Revise)
                {
                    <div class="workshop-nav">
                        <button class="btn" title="Back — keeps what you've written" @onclick="CloseRevisionAsync">←</button>
                        <span class="sidebar-heading">PUSH/PULL AND LENS</span>
                    </div>
                    @if (_fileName.Length == 0)
                    {
                        <div class="fill-meta">Untitled — the working-out is kept once the script has a name.</div>
                    }
                    <p class="tool-note">For a finished (or finished-enough) scene, sequence or draft that's gone dead or flat. This is one of the few worksheets where judging quality out loud is the point, not a distraction: closure beats quality on pass one, but a read-back and crit is the payout.</p>

                    <div class="rung-label">Setup</div>
                    <label class="fill-field">
                        <span class="fill-label">Scene / sequence</span>
                        <textarea rows="2" @bind="_revision.Scene" @bind:after="SaveSlate"></textarea>
                    </label>
                    <div class="fill-actions">
                        <button class="btn" title="Names the scene or section heading nearest above the caret" @onclick="UseSceneUnderCaret">Use the scene under the caret</button>
                    </div>
                    <div class="fill-hint">For a whole sequence rather than one scene, name the stretch and run the six checks against it as a whole — you're checking whether the sequence itself has the shape, not auditing every scene individually.</div>
                    <label class="fill-field">
                        <span class="fill-label">What it's supposed to do in the story</span>
                        <textarea rows="2" @bind="_revision.Purpose" @bind:after="SaveSlate"></textarea>
                    </label>

                    <div class="rung-label">Checks, in priority order</div>
                    <p class="tool-note">Run them one at a time, top to bottom, or skip straight to whichever you already suspect is the problem. Stop after any single check — a clean or flagged check is a complete session. Clean checks don't get punished with more work; only a flagged one owes you a Lens.</p>
                    @for (var c = 0; c < ReviseRun.CheckNames.Length; c++)
                    {
                        var checkIndex = c;
                        var check = _revision.Check(ReviseRun.CheckNames[checkIndex]);
                        var lensRootId = $"lens-slot-{checkIndex}";
                        <div class="chain-round">
                            <div class="chain-round-label">@(checkIndex + 1). @check.Name</div>
                            <label class="fill-field">
                                <span class="fill-hint">@CheckQuestions[checkIndex]</span>
                                <textarea rows="2" @bind="check.Answer" @bind:after="SaveSlate"></textarea>
                            </label>
                            <div class="stress-row">
                                <span class="fill-hint">Flag</span>
                                <AliveFlat Left="Y" Right="N" @bind-Value="check.Flag" @bind-Value:after="SaveSlate" />
                            </div>
                            @if (check.Flag == "Y")
                            {
                                <div class="belief-cut lens-block" id="@lensRootId">
                                    <div class="rung-label">Lens — on the flagged thing only, not the whole scene</div>
                                    <label class="fill-field">
                                        <span class="fill-label">Pick one</span>
                                        <select class="workshop-select" @bind="check.Lens" @bind:after="SaveSlate">
                                            <option value="">—</option>
                                            @foreach (var lens in Lenses)
                                            {
                                                <option value="@lens.Name">@lens.Name</option>
                                            }
                                        </select>
                                        @if (LensDo(check.Lens) is { } lensDo)
                                        {
                                            <span class="fill-hint">What you actually do: @lensDo</span>
                                        }
                                    </label>
                                    <div class="burst-row">
                                        <span class="fill-hint">Apply it timed —</span>
                                        <input type="number" class="burst-seconds" min="1" max="30" @bind="_slate.Burst.LensMinutes" @bind:after="SaveSlate" />
                                        <span class="fill-meta">minutes</span>
                                        @if (_burstRunning)
                                        {
                                            <button class="btn" @onclick="StopBurstAsync">Stop</button>
                                        }
                                        else
                                        {
                                            <button class="btn primary" title="Puts the caret in the fragment and starts the clock" @onclick="() => StartLensAsync(lensRootId)">Go</button>
                                        }
                                        <span class="burst-display" data-burst-display></span>
                                    </div>
                                    <label class="fill-field">
                                        <span class="fill-label">Rewrite / fragment</span>
                                        <textarea rows="5" data-slot data-slot-multiline @bind="check.Fragment" @bind:after="SaveSlate"></textarea>
                                    </label>
                                    <div class="stress-row">
                                        <span class="fill-hint">Did it move the flagged problem?</span>
                                        <AliveFlat Left="Y" Right="N" @bind-Value="check.Moved" @bind-Value:after="SaveSlate" />
                                    </div>
                                    <label class="fill-field">
                                        <span class="fill-label">One line why</span>
                                        <textarea rows="2" @bind="check.MovedWhy" @bind:after="SaveSlate"></textarea>
                                    </label>
                                </div>
                            }
                        </div>
                    }
                    <div class="stop-callout">That's a complete session, whether it was one check or all six.</div>

                    @if (!_reviseDeeper && !_revision.HasDiagnostic)
                    {
                        <button class="btn" @onclick="() => _reviseDeeper = true">Going deeper still — check the belief arc already on the page</button>
                    }
                    else
                    {
                        <div class="rung-label">Going deeper still — Belief Split, diagnostic</div>
                        <p class="tool-note">Not building a new arc — checking whether the one already on the page actually holds.</p>
                        <label class="fill-field">
                            <span class="fill-label">Point A — the Lie, stable/wrong at the start of this stretch</span>
                            <textarea rows="2" @bind="_revision.DiagA" @bind:after="SaveSlate"></textarea>
                        </label>
                        <label class="fill-field">
                            <span class="fill-label">Point Z — where the protagonist's belief lands by the end</span>
                            <textarea rows="2" @bind="_revision.DiagZ" @bind:after="SaveSlate"></textarea>
                        </label>
                        <label class="fill-field">
                            <span class="fill-label">Which named shape does A→Z actually match?</span>
                            <select class="workshop-select" @bind="_revision.DiagShape" @bind:after="SaveSlate">
                                <option value="">—</option>
                                @foreach (var shape in BeliefShapes)
                                {
                                    <option value="@shape.Name">@shape.Name — @shape.A → @shape.Z</option>
                                }
                            </select>
                        </label>
                        <label class="fill-field">
                            <span class="fill-label">Does it match cleanly, or is it muddled between two?</span>
                            <textarea rows="2" @bind="_revision.DiagMatch" @bind:after="SaveSlate"></textarea>
                        </label>
                        <label class="fill-field">
                            <span class="fill-label">If muddled — which two, and where's the seam</span>
                            <textarea rows="2" @bind="_revision.DiagSeam" @bind:after="SaveSlate"></textarea>
                        </label>
                        <div class="belief-cut lens-block" id="lens-slot-seam">
                            <div class="rung-label">If muddled — a Lens on the scene at the seam, not the whole stretch</div>
                            <label class="fill-field">
                                <span class="fill-label">Lens</span>
                                <select class="workshop-select" @bind="_revision.DiagLens" @bind:after="SaveSlate">
                                    <option value="">—</option>
                                    @foreach (var lens in Lenses)
                                    {
                                        <option value="@lens.Name">@lens.Name</option>
                                    }
                                </select>
                                @if (LensDo(_revision.DiagLens) is { } seamDo)
                                {
                                    <span class="fill-hint">What you actually do: @seamDo</span>
                                }
                            </label>
                            <div class="burst-row">
                                <span class="fill-hint">Apply it timed —</span>
                                <input type="number" class="burst-seconds" min="1" max="30" @bind="_slate.Burst.LensMinutes" @bind:after="SaveSlate" />
                                <span class="fill-meta">minutes</span>
                                @if (_burstRunning)
                                {
                                    <button class="btn" @onclick="StopBurstAsync">Stop</button>
                                }
                                else
                                {
                                    <button class="btn primary" title="Puts the caret in the fragment and starts the clock" @onclick="() => StartLensAsync(SeamLensId)">Go</button>
                                }
                                <span class="burst-display" data-burst-display></span>
                            </div>
                            <label class="fill-field">
                                <span class="fill-label">Fragment</span>
                                <textarea rows="5" data-slot data-slot-multiline @bind="_revision.DiagFragment" @bind:after="SaveSlate"></textarea>
                            </label>
                        </div>
                    }

                    @if (!_reviseReadBack && !_revision.HasReadBack)
                    {
                        <button class="btn" @onclick="() => _reviseReadBack = true">Ready to close for real — read it back</button>
                    }
                    else
                    {
                        <div class="rung-label">Read-back and crit</div>
                        <p class="tool-note">Read the stretch back once, out loud if you can. This is not a chore — a read-back and crit is Slate's actual payout, the reason the diagnosis and the Lens work happened at all.</p>
                        <label class="fill-field">
                            <span class="fill-label">What's working — one line, no hedging</span>
                            <textarea rows="2" @bind="_revision.Working" @bind:after="SaveSlate"></textarea>
                        </label>
                        <label class="fill-field">
                            <span class="fill-label">What still doesn't sit right, even after the Lens passes above</span>
                            <textarea rows="2" @bind="_revision.NotSitting" @bind:after="SaveSlate"></textarea>
                        </label>
                        <label class="fill-field">
                            <span class="fill-label">Is this ready to move to Fill / Treatment, or does it need to sit another day?</span>
                            <textarea rows="2" @bind="_revision.Ready" @bind:after="SaveSlate"></textarea>
                        </label>
                    }
                }
                else if (_workshopView == WorkshopView.Split)
                {
                    var split = _slate.Split;
                    <div class="workshop-nav">
                        <button class="btn" title="Back — keeps what you've written" @onclick="CloseGenerate">←</button>
                        <span class="sidebar-heading">A→Z→SPLIT</span>
                    </div>
                    @if (_fileName.Length == 0)
                    {
                        <div class="fill-meta">Untitled — the working-out is kept once the script has a name.</div>
                    }
                    <p class="tool-note">Never "what happens next". Always: I'm at A, I need Z — what single event makes Z possible that wasn't before? Fix the ends, then do one split at a time. Stop after any one of them — that's a complete session. Keep going and the next rung is right there.</p>

                    <div class="rung-label">Rung 0 — fix the ends</div>
                    <label class="fill-field">
                        <span class="fill-label">A — start event</span>
                        @if (ScriptTurnHint(0) is { } hintA) { <span class="fill-hint">In the script: @hintA</span> }
                        <textarea rows="2" @bind="split.A" @bind:after="SaveSlate"></textarea>
                    </label>
                    <label class="fill-field">
                        <span class="fill-label">Z — end event</span>
                        @if (ScriptTurnHint(8) is { } hintZ) { <span class="fill-hint">In the script: @hintZ</span> }
                        <textarea rows="2" @bind="split.Z" @bind:after="SaveSlate"></textarea>
                    </label>

                    <div class="rung-label">Rung 1 — the midpoint</div>
                    <p class="tool-note">Find the one event that, if it happened, makes the second half inevitable given the first half. Don't look for the <em>best</em> midpoint — the first one that holds.</p>
                    @for (var i = 0; i < 3; i++)
                    {
                        var index = i;
                        <label class="fill-field">
                            <span class="fill-label">Candidate @(index + 1)@(index == 2 ? " (if needed)" : "")</span>
                            <textarea rows="2" @bind="split.Candidates[index]" @bind:after="SaveSlate"></textarea>
                        </label>
                    }
                    <label class="fill-field">
                        <span class="fill-label">Chosen midpoint</span>
                        @if (ScriptTurnHint(4) is { } hintMid) { <span class="fill-hint">In the script: @hintMid</span> }
                        <textarea rows="2" @bind="split.Midpoint" @bind:after="SaveSlate"></textarea>
                    </label>
                    <div class="stress-row">
                        <span class="fill-hint">Stress it: given A, does this feel inevitable or invented? Given the midpoint, does Z?</span>
                        <AliveFlat @bind-Value="split.MidpointAlive" @bind-Value:after="SaveSlate" />
                    </div>
                    @if (split.BeliefLayer)
                    {
                        <label class="fill-field belief-cut">
                            <span class="fill-label">Belief at 50% — what does she believe now, and how has that moved since the last cut?</span>
                            <textarea rows="2" @bind="_slate.Belief.Cut(50).Text" @bind:after="SaveSlate"></textarea>
                        </label>
                    }
                    <label class="burst-toggle"><input type="checkbox" @bind="split.BeliefLayer" @bind:after="SaveSlate" /> Also ask what she believes at each turn</label>
                    @if (split.BeliefLayer)
                    {
                        <div class="fill-hint">A matched belief cut after each plot turn: not just what happens, but what does she believe now, and how has that moved since the last cut. The pinches take the lighter third-rail question instead. These are the same cuts Belief Split fills in.</div>
                    }

                    <div class="stop-callout">Stop here and you've got a real shape — A, midpoint, Z. That's enough to carry into Fill or a later session. Nothing below is owed.</div>
                    @if (_splitRung < 2 && !split.HasRung2 && !split.HasRung3)
                    {
                        <button class="btn" @onclick="() => _splitRung = 2">Keep going — rung 2</button>
                    }
                    else
                    {
                        <div class="rung-label">Rung 2 — split each half</div>
                        <p class="tool-note">Same move, run twice.</p>
                        <label class="fill-field">
                            <span class="fill-label">PP1 — splits A → Midpoint</span>
                            @if (ScriptTurnHint(2) is { } hintPP1) { <span class="fill-hint">In the script: @hintPP1</span> }
                            <textarea rows="2" @bind="split.PP1" @bind:after="SaveSlate"></textarea>
                        </label>
                        @if (split.BeliefLayer)
                        {
                            <label class="fill-field belief-cut">
                                <span class="fill-label">Belief at 25% — what does she believe now, and how has that moved?</span>
                                <textarea rows="2" @bind="_slate.Belief.Cut(25).Text" @bind:after="SaveSlate"></textarea>
                            </label>
                        }
                        <label class="fill-field">
                            <span class="fill-label">Crisis / PP2 — splits Midpoint → Z</span>
                            @if (ScriptTurnHint(6) is { } hintCrisis) { <span class="fill-hint">In the script: @hintCrisis</span> }
                            <textarea rows="2" @bind="split.Crisis" @bind:after="SaveSlate"></textarea>
                        </label>
                        @if (split.BeliefLayer)
                        {
                            <label class="fill-field belief-cut">
                                <span class="fill-label">Belief at 75% — what does she believe now, and how has that moved?</span>
                                <textarea rows="2" @bind="_slate.Belief.Cut(75).Text" @bind:after="SaveSlate"></textarea>
                            </label>
                        }

                        <div class="stop-callout">Stop here and four points are fixed — still a complete, usable shape.</div>
                        @if (_splitRung < 3 && !split.HasRung3)
                        {
                            <button class="btn" @onclick="() => _splitRung = 3">Keep going — rung 3</button>
                        }
                        else
                        {
                            <div class="rung-label">Rung 3 — split the remaining four quarters</div>
                            <label class="fill-field">
                                <span class="fill-label">Inciting incident — splits A → PP1</span>
                                @if (ScriptTurnHint(1) is { } hintInc) { <span class="fill-hint">In the script: @hintInc</span> }
                                <textarea rows="2" @bind="split.Inciting" @bind:after="SaveSlate"></textarea>
                            </label>
                            @if (split.BeliefLayer)
                            {
                                <label class="fill-field belief-cut">
                                    <span class="fill-label">Belief at 12% — what does she believe now, and how has that moved?</span>
                                    <textarea rows="2" @bind="_slate.Belief.Cut(12).Text" @bind:after="SaveSlate"></textarea>
                                </label>
                            }
                            <label class="fill-field">
                                <span class="fill-label">Pinch 1 — splits PP1 → Midpoint</span>
                                @if (ScriptTurnHint(3) is { } hintP1) { <span class="fill-hint">In the script: @hintP1</span> }
                                <textarea rows="2" @bind="split.Pinch1" @bind:after="SaveSlate"></textarea>
                            </label>
                            @if (split.BeliefLayer)
                            {
                                <label class="fill-field belief-cut">
                                    <span class="fill-label">Third rail — what does this mean to her, what does she believe now that she didn't five minutes ago?</span>
                                    <textarea rows="2" @bind="split.Pinch1ThirdRail" @bind:after="SaveSlate"></textarea>
                                </label>
                            }
                            <label class="fill-field">
                                <span class="fill-label">Pinch 2 — splits Midpoint → Crisis/PP2</span>
                                @if (ScriptTurnHint(5) is { } hintP2) { <span class="fill-hint">In the script: @hintP2</span> }
                                <textarea rows="2" @bind="split.Pinch2" @bind:after="SaveSlate"></textarea>
                            </label>
                            @if (split.BeliefLayer)
                            {
                                <label class="fill-field belief-cut">
                                    <span class="fill-label">Third rail — what does this mean to her, what does she believe now that she didn't five minutes ago?</span>
                                    <textarea rows="2" @bind="split.Pinch2ThirdRail" @bind:after="SaveSlate"></textarea>
                                </label>
                            }
                            <label class="fill-field">
                                <span class="fill-label">Last obstacle — splits Crisis/PP2 → Z</span>
                                @if (ScriptTurnHint(7) is { } hintLast) { <span class="fill-hint">In the script: @hintLast</span> }
                                <textarea rows="2" @bind="split.LastObstacle" @bind:after="SaveSlate"></textarea>
                            </label>
                            @if (split.BeliefLayer)
                            {
                                <label class="fill-field belief-cut">
                                    <span class="fill-label">Belief at 88% — what does she believe now, and how has that moved?</span>
                                    <textarea rows="2" @bind="_slate.Belief.Cut(88).Text" @bind:after="SaveSlate"></textarea>
                                </label>
                            }
                            <div class="stop-callout">All seven turns down. That's the full shape; there's no rung 4. If it still doesn't hold, that's Fill and Push/Pull's job, not another rung here.</div>
                        }
                    }

                    <div class="fill-actions">
                        <button class="btn primary" title="Eight sequences on the Board, each turn as its synopsis" @onclick="WriteShapeAsync">@(ScriptHasShape ? "Update the shape in the script" : "Write the shape into the script")</button>
                    </div>
                    <div class="fill-meta">@(ScriptHasShape
                        ? "Fills in any turn the script still has as a bracket. A turn that already has text in the script is left alone — edit it there."
                        : "Goes in at the end of the script as four acts and eight sequences, each turn as a synopsis line. A turn you haven't found yet goes in as a bracket, so Fill hands it back to you.")</div>
                }
                else if (_workshopView == WorkshopView.Belief)
                {
                    var belief = _slate.Belief;
                    <div class="workshop-nav">
                        <button class="btn" title="Back — keeps what you've written" @onclick="CloseGenerate">←</button>
                        <span class="sidebar-heading">BELIEF SPLIT</span>
                    </div>
                    @if (_fileName.Length == 0)
                    {
                        <div class="fill-meta">Untitled — the working-out is kept once the script has a name.</div>
                    }
                    <p class="tool-note">The "Lie" is the false belief the character organises their life around at the start; the "Truth" is what they actually need to believe by the end. Same fix-the-ends move as A→Z→Split, just run on belief instead of plot events.</p>

                    <div class="rung-label">Rung 0 — name the shape and fix the ends</div>
                    <label class="fill-field">
                        <span class="fill-label">Shape</span>
                        <select class="workshop-select" @bind="belief.Shape" @bind:after="SaveSlate">
                            <option value="">—</option>
                            @foreach (var shape in BeliefShapes)
                            {
                                <option value="@shape.Name">@shape.Name — @shape.A → @shape.Z</option>
                            }
                        </select>
                    </label>
                    <label class="fill-field">
                        <span class="fill-label">A — Lie / Truth at start</span>
                        <textarea rows="2" @bind="belief.A" @bind:after="SaveSlate"></textarea>
                    </label>
                    <label class="fill-field">
                        <span class="fill-label">Z — Truth / worse Lie at end</span>
                        <textarea rows="2" @bind="belief.Z" @bind:after="SaveSlate"></textarea>
                    </label>

                    <div class="rung-label">Rung 1 — Ghost</div>
                    <p class="tool-note">What happened before the story that made A feel true?</p>
                    <label class="fill-field">
                        <span class="fill-label">Ghost</span>
                        <textarea rows="2" @bind="belief.Ghost" @bind:after="SaveSlate"></textarea>
                    </label>
                    <div class="stress-row">
                        <label class="burst-toggle">Size it, 1–10 <input type="number" class="burst-seconds" min="1" max="10" @bind="belief.GhostSize" @bind:after="SaveSlate" /></label>
                        <span class="fill-hint">Commensurate with the Lie?</span>
                        <AliveFlat Left="y" Right="n" @bind-Value="belief.GhostCommensurate" @bind-Value:after="SaveSlate" />
                    </div>
                    <label class="fill-field">
                        <span class="fill-label">If no — the Ghost is too small or too big for what it's supposedly justifying</span>
                        <textarea rows="2" @bind="belief.GhostMismatch" @bind:after="SaveSlate"></textarea>
                    </label>
                    <div class="stop-callout">Run this rung once per story, not once per session. After this, every plot turn you fix — in A→Z→Split, or a scene as you draft it — inherits a belief question for free; you don't repeat the Ghost.</div>

                    <div class="rung-label">Rung 2 — the 50% cut (midpoint belief)</div>
                    <p class="tool-note">What does she believe right now — matched to the plot midpoint if you have one — and what's changed since the Ghost.</p>
                    <label class="fill-field">
                        <span class="fill-label">Belief at 50%</span>
                        @if (PlotMatch(50) is { } match50) { <span class="fill-hint">Matched plot turn — midpoint: @match50</span> }
                        <textarea rows="2" @bind="belief.Cut(50).Text" @bind:after="SaveSlate"></textarea>
                    </label>
                    <label class="fill-field">
                        <span class="fill-label">What changed to get here</span>
                        <textarea rows="2" @bind="belief.Cut50Change" @bind:after="SaveSlate"></textarea>
                    </label>
                    <div class="stress-row">
                        <span class="fill-hint">Stress it: does this feel like a real step from A, or a jump?</span>
                        <AliveFlat @bind-Value="belief.Cut(50).Alive" @bind-Value:after="SaveSlate" />
                    </div>
                    <div class="stop-callout">Stop here and you've got A, Ghost, and the midpoint belief — real, usable, enough to carry forward.</div>
                    @if (_beliefRung < 3 && !belief.HasRung3 && !belief.HasRung4)
                    {
                        <button class="btn" @onclick="() => _beliefRung = 3">Keep going — rung 3</button>
                    }
                    else
                    {
                        <div class="rung-label">Rung 3 — the 25% and 75% cuts</div>
                        <p class="tool-note">Matched to PP1 and Crisis/PP2 if you have them.</p>
                        <label class="fill-field">
                            <span class="fill-label">Belief at 25%</span>
                            @if (PlotMatch(25) is { } match25) { <span class="fill-hint">Matched plot turn — PP1: @match25</span> }
                            <textarea rows="2" @bind="belief.Cut(25).Text" @bind:after="SaveSlate"></textarea>
                        </label>
                        <div class="stress-row"><AliveFlat @bind-Value="belief.Cut(25).Alive" @bind-Value:after="SaveSlate" /></div>
                        <label class="fill-field">
                            <span class="fill-label">Belief at 75%</span>
                            @if (PlotMatch(75) is { } match75) { <span class="fill-hint">Matched plot turn — Crisis/PP2: @match75</span> }
                            <textarea rows="2" @bind="belief.Cut(75).Text" @bind:after="SaveSlate"></textarea>
                        </label>
                        <div class="stress-row"><AliveFlat @bind-Value="belief.Cut(75).Alive" @bind-Value:after="SaveSlate" /></div>
                        @if (_beliefRung < 4 && !belief.HasRung4)
                        {
                            <button class="btn" @onclick="() => _beliefRung = 4">Keep going — rung 4</button>
                        }
                        else
                        {
                            <div class="rung-label">Rung 4 — the 12% and 88% cuts</div>
                            <p class="tool-note">Matched to the inciting incident and the last obstacle.</p>
                            <label class="fill-field">
                                <span class="fill-label">Belief at 12%</span>
                                @if (PlotMatch(12) is { } match12) { <span class="fill-hint">Matched plot turn — inciting incident: @match12</span> }
                                <textarea rows="2" @bind="belief.Cut(12).Text" @bind:after="SaveSlate"></textarea>
                            </label>
                            <div class="stress-row"><AliveFlat @bind-Value="belief.Cut(12).Alive" @bind-Value:after="SaveSlate" /></div>
                            <label class="fill-field">
                                <span class="fill-label">Belief at 88%</span>
                                @if (PlotMatch(88) is { } match88) { <span class="fill-hint">Matched plot turn — last obstacle: @match88</span> }
                                <textarea rows="2" @bind="belief.Cut(88).Text" @bind:after="SaveSlate"></textarea>
                            </label>
                            <div class="stress-row"><AliveFlat @bind-Value="belief.Cut(88).Alive" @bind-Value:after="SaveSlate" /></div>
                            <div class="stop-callout">Belief Split only defines these five named cuts — the two pinches take the lighter third-rail question instead, not a sixth or seventh named cut. Manufacturing more precision than that isn't the point.</div>
                        }
                    }
                    <div class="rung-label">Close, at whichever rung you stop</div>
                    <p class="tool-note">Scan the cuts you've got against their matched plot turns, if any. Mark each alive or flat — don't fix flat ones now, just flag them.</p>
                }
                else if (_workshopView == WorkshopView.Extend)
                {
                    var extend = _slate.Extend;
                    <div class="workshop-nav">
                        <button class="btn" title="Back — keeps what you've written" @onclick="CloseGenerate">←</button>
                        <span class="sidebar-heading">EXTEND BACKWARD</span>
                    </div>
                    @if (_fileName.Length == 0)
                    {
                        <div class="fill-meta">Untitled — the working-out is kept once the script has a name.</div>
                    }
                    <p class="tool-note">For when you have an ending — yours, or one you're stealing to reverse-engineer — and nothing that leads to it yet.</p>
                    <label class="fill-field">
                        <span class="fill-label">Z — the one thing you already have: a final image, a last line, an ending</span>
                        <textarea rows="2" @bind="extend.Z" @bind:after="SaveSlate"></textarea>
                    </label>

                    <div class="rung-label">Work backward, one link at a time</div>
                    <p class="tool-note"><em>What had to be true right before this, for this to happen?</em> Answer, then ask the same question of your own answer. No jumping ahead to fill the middle from the front — only the most recent link you wrote is allowed to generate the next one.</p>
                    @for (var i = 0; i < extend.Links.Count; i++)
                    {
                        var index = i;
                        var link = extend.Links[index];
                        var isOpen = index == extend.Links.Count - 1;
                        <label class="fill-field">
                            <span class="fill-label">Link @(index + 1) — right before @(index == 0 ? "Z" : $"link {index}")</span>
                            @if (isOpen)
                            {
                                <span class="fill-hint">@(link.Mystery
                                    ? "Mystery lens: treat it as a crime scene — what would a detective need to find to explain it, rather than what caused it?"
                                    : "What had to be true right before this, for this to happen?")</span>
                            }
                            <textarea rows="2" @bind="link.Text" @bind:after="() => LinkChanged(link)"></textarea>
                        </label>
                        @if (isOpen)
                        {
                            <label class="burst-toggle"><input type="checkbox" @bind="link.Mystery" @bind:after="SaveSlate" /> Mystery lens on this link</label>
                        }
                    }
                    <div class="fill-meta">Keep going until the chain reaches something that can plausibly be a beginning, or until you're done for now. Either is a valid place to stop.</div>

                    <div class="rung-label">Stopping, any link</div>
                    <p class="tool-note">Read the chain forward, start to Z. Does each link earn the next, or did one get invented to patch a gap?</p>
                    @if (extend.Links.Any(link => !string.IsNullOrWhiteSpace(link.Text)))
                    {
                        <ol class="chain-forward">
                            @foreach (var link in Enumerable.Reverse(extend.Links).Where(link => !string.IsNullOrWhiteSpace(link.Text)))
                            {
                                <li>@link.Text</li>
                            }
                            @if (!string.IsNullOrWhiteSpace(extend.Z))
                            {
                                <li class="chain-z">@extend.Z</li>
                            }
                        </ol>
                    }
                    <div class="stress-row">
                        <AliveFlat @bind-Value="extend.ChainAlive" @bind-Value:after="SaveSlate" />
                    </div>
                    <label class="fill-field">
                        <span class="fill-label">If flat, name the weakest link</span>
                        <textarea rows="2" @bind="extend.WeakestLink" @bind:after="SaveSlate"></textarea>
                    </label>
                    <div class="stop-callout">Stuck partway? Try the mystery lens on the next link only: treat Z as a crime scene — what would a detective need to find to explain it, rather than what caused it. Different question, sometimes unsticks the same chain.</div>
                }
            </div>
        </aside>
    </div>

    <footer class="statusbar">
        <span>@ModeStatusText</span>
        <button class="status-link" title="Go to line (Ctrl+G)" @onclick="OpenGoToLine">Ln @_caretLine</button>
        <span>@_caretElementLabel</span>
        <span>~@_analysis.PageCount page@(_analysis.PageCount == 1 ? "" : "s")</span>
        <span>@_analysis.WordCount.ToString("N0") words</span>
        @if (ShapeLine.Derive(_analysis.BoardLanes) is { } shapeLine)
        {
            <span class="shape-line" title="@ShapeLine.Legend">@shapeLine</span>
        }
        <span class="spacer"></span>
        <button class="icon-btn" title="Undo (Ctrl+Z)" @onclick="UndoAsync">↶</button>
        <button class="icon-btn" title="Redo (Ctrl+Y)" @onclick="RedoAsync">↷</button>
        <button class="icon-btn" title="Smaller editor text" @onclick="() => AdjustEditorFont(-1)">A−</button>
        <button class="icon-btn" title="Larger editor text" @onclick="() => AdjustEditorFont(+1)">A+</button>
        <span class="status-message">@_statusMessage</span>
    </footer>
</div>

@if (_ideationOpen && _ideation is not null)
{
    <div class="ideation-overlay">
        <div class="ideation-page">
            <div class="workshop-nav">
                <button class="btn" title="Close — keeps the sitting as it is" @onclick="CloseIdeationAsync">×</button>
                <span class="sidebar-heading">IDEATION BURST</span>
            </div>
            @if (_ideationLoadError is not null)
            {
                <div class="fill-meta">@_ideationLoadError — nothing here will be saved until it is fixed.</div>
            }
            @if (_ideation.Current is null)
            {
                <p class="tool-note">Rapid-fire, throwaway writing from a prompt. Nothing here is about your script — invented material, or something borrowed from a film you don't much like, never your own characters. One round is a complete session. Keep rolling new rounds for as long as you want more.</p>
                <div class="rung-label">Pick your lane (10 seconds)</div>
                <p class="tool-note">Roll a die, pick a number at random, or just pick one. Don't deliberate — deliberating isn't the drill. Stay on the same lane for the whole sitting; re-roll only when you come back another time.</p>
                <button class="btn primary workshop-hand" @onclick="RollLane">Roll</button>
                <div class="tool-paths">
                    @for (var i = 0; i < Lanes.Length; i++)
                    {
                        var laneIndex = i;
                        <button class="workshop-tool" @onclick="() => StartSitting(laneIndex + 1)">
                            <span class="tool-name">@(laneIndex + 1). @Lanes[laneIndex].Name</span>
                        </button>
                    }
                </div>
                @if (_ideation.Kept.Count > 0)
                {
                    <div class="rung-label">Lines kept</div>
                    @foreach (var line in _ideation.Kept.ToList())
                    {
                        <div class="bracket-row">
                            <span class="bracket-text chain-seed kept-line">@line</span>
                            <button class="icon-btn" title="Let it go" @onclick="() => DropKeptLine(line)">×</button>
                        </div>
                    }
                }
            }
            else
            {
                var sitting = _ideation.Current;
                var lane = Lanes[Math.Clamp(sitting.Lane, 1, Lanes.Length) - 1];
                <div class="rung-label">Lane @sitting.Lane — @lane.Name</div>
                <p class="tool-note">@lane.Prompt</p>
                @if (sitting.Lane == Lanes.Length)
                {
                    <div class="fill-hint">Three steps is enough for a round here — the full eight-question chain is the Character Flaw Brainstorm in Writer's Tools, if you want to take this one further.</div>
                }
                <div class="fill-hint">Read it once, then start the round — don't re-read mid-round.</div>
                <div class="stop-callout">The only failure state is silence.</div>

                <div class="burst-row">
                    <span class="fill-hint">Rounds of</span>
                    <input type="number" class="burst-seconds" min="10" max="600" @bind="_ideation.RoundSeconds" @bind:after="SaveIdeation" />
                    <span class="fill-meta">seconds</span>
                </div>
                <p class="tool-note">The input is dealt for you, so there's nothing to think up — deal another if it lands flat, or type over it if you've got one of your own. Work it for the round, move on whether or not it feels finished.</p>
                @for (var r = 0; r < sitting.Rounds.Count; r++)
                {
                    var roundIndex = r;
                    var round = sitting.Rounds[roundIndex];
                    var roundId = $"ideation-round-{roundIndex}";
                    <div class="chain-round" id="@roundId">
                        <div class="chain-round-label">Round @(roundIndex + 1)</div>
                        <label class="fill-field">
                            <span class="fill-label">Input</span>
                            <textarea rows="2" @bind="round.Input" @bind:after="SaveIdeation"></textarea>
                        </label>
                        <div class="fill-actions">
                            <button class="btn" title="Replaces the input with a fresh one for this lane" disabled="@_burstRunning" @onclick="() => DealRound(round)">Deal another</button>
                        </div>
                        <div class="burst-row">
                            @if (_burstRunning)
                            {
                                <button class="btn" @onclick="StopBurstAsync">Stop</button>
                            }
                            else
                            {
                                <button class="btn primary" title="Puts the caret in the output and starts the round" @onclick="() => StartRoundAsync(roundId)">Start the round</button>
                            }
                            <span class="burst-display" data-burst-display></span>
                        </div>
                        <label class="fill-field">
                            <span class="fill-label">Output</span>
                            <textarea rows="5" data-slot data-slot-multiline @bind="round.Output" @bind:after="SaveIdeation"></textarea>
                        </label>
                        @if (!string.IsNullOrWhiteSpace(round.Output))
                        {
                            <div class="fill-actions">
                                <button class="btn" title="Copies this output into the kept line below" @onclick="() => KeepFromRound(round)">Keep a line from this</button>
                            </div>
                        }
                    </div>
                }
                <button class="btn" @onclick="AddIdeationRound">Next round</button>
                <div class="fill-meta">No limit.</div>

                <div class="rung-label">Stopping, any round</div>
                <p class="tool-note">Circle one line above worth keeping. Just one. You don't have to know why yet. That's a complete session, whether it was one round or fifteen.</p>
                <label class="fill-field">
                    <span class="fill-label">Kept line</span>
                    <textarea rows="2" @bind="sitting.KeptLine" @bind:after="SaveIdeation"></textarea>
                </label>
                <div class="fill-actions">
                    <button class="btn primary" title="Files the kept line and clears the rounds" @onclick="FinishSittingAsync">Done for this sitting</button>
                </div>
                <div class="stop-callout">Thirty seconds, on your phone, in a queue at Woolworths. That is a real session and it counts. One round of that is enough on its own.</div>
            }
        </div>
    </div>
}

