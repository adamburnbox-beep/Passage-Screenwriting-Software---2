            _editor.StateHasChanged();
            return wrote;
        }

        public bool BurstRunning => _editor._burstRunning;
        public Task StartBurstAsync(string rootId) => _editor.StartBurstAsync(rootId);
        public Task StopBurstAsync() => _editor.StopBurstAsync();
