@if (_sendBeat is not null)
{
    <div class="modal-backdrop">
        <div class="modal">
            <h3>Send to Board</h3>
            <p>This turns the beat "@(_sendBeat.Title.Length > 0 ? _sendBeat.Title : "Untitled beat")" into a scene @(_sendBeatTarget is null ? "at the end of the script" : $"under {_sendBeatTarget.Value.Turn}"). Its page plan (page @_sendBeat.Page) is dropped and the script track takes over. Continue?</p>
            <div class="modal-actions">
