                <summary class="btn @(filter.Characters.Count > 0 ? "active" : null)">Characters@(filter.Characters.Count > 0 ? $" ({filter.Characters.Count})" : "")</summary>
                <div class="filter-pop">
                    @foreach (var stat in _analysis.Characters)
                    {
                        var name = stat.Name;
                        <label><input type="checkbox" checked="@filter.Characters.Contains(name)" @onchange="() => SetStoryFilterAsync(ActiveFilter.ToggleCharacter(name))" /> @name</label>
                    }
                    @if (_analysis.Characters.Count == 0)
                    {
                        <span class="filter-none">No characters yet</span>
                    }
                </div>
            </details>
            <details class="filter-menu">
                <summary class="btn @(filter.Locations.Count > 0 ? "active" : null)">Locations@(filter.Locations.Count > 0 ? $" ({filter.Locations.Count})" : "")</summary>
                <div class="filter-pop">
                    @foreach (var place in _analysis.Locations ?? Array.Empty<LocationEntry>())
                    {
                        var name = place.Name;
                        <label><input type="checkbox" checked="@filter.Locations.Contains(name)" @onchange="() => SetStoryFilterAsync(ActiveFilter.ToggleLocation(name))" /> @name</label>
