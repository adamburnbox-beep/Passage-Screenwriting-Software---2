            _content = Library.Load(name);
        }
        catch (Exception exception) when (exception is IOException or ArgumentException or UnauthorizedAccessException)
        {
            _statusMessage = $"Could not open {name}: {exception.Message}";
            return;
        }

        _fileName = name;
        _isDirty = false;
        _statusMessage = $"Opened {name}";
        LoadSlate();
        AddRecentFile(name);
        await ResetEditorAsync();
        CaptureSessionBaseline();
        await PersistSessionAsync();
    }

    private async Task ResetEditorAsync()
    {
        _mainViewIndex = 0;
        _caretLine = 1;
        RunAnalysis();
        UpdateCaretElementLabel();
        var version = await JS.InvokeAsync<int>("passage.setContent", _content);
        await JS.InvokeVoidAsync("passage.applyHighlights", version, _analysis.LineClasses);
        await SyncPageRulesAsync();
        await PushSuggestionsAsync();
        StateHasChanged();
    }

    // Page rules are for screenplays only, matching ApplyEditorWriteMode. The
    // web derives its mode from the file extension, so this follows the name.
    // Pushed once per parse, not per keystroke — the client does the matching.
    private async Task PushSuggestionsAsync()
    {
        try
        {
            await JS.InvokeVoidAsync(
                "passage.setSuggestions",
                _analysis.SceneHeadingSuggestions,
                _analysis.CharacterSuggestions,
                _analysis.SuggestionKinds);
        }
        catch (JSException)
        {
        }
    }

    private async Task SyncPageRulesAsync()
    {
        try
        {
            await JS.InvokeVoidAsync("passage.setPageRules", IsScreenplayMode);
        }
        catch (JSException)
        {
        }
    }

    private void RequestDeleteFile(string name)
    {
        _deleteTarget = name;
    }

    private async Task ConfirmDeleteAsync()
    {
        var target = _deleteTarget;
        _deleteTarget = null;
        if (target is null)
        {
            return;
        }

        try
        {
            Library.Delete(target);
            Slate.Delete(target);
        }
        catch (Exception exception) when (exception is IOException or ArgumentException or UnauthorizedAccessException)
        {
            _statusMessage = $"Could not delete {target}: {exception.Message}";
            return;
        }

        _files = Library.List();
        _recentFiles.Remove(target);
        await PersistSessionAsync();
        if (target == _fileName)
        {
            // The open buffer survives as an unsaved Untitled document.
            _fileName = string.Empty;
            _isDirty = true;
            await JS.InvokeVoidAsync("passage.setDirty", true);
            await PersistSessionAsync();
        }

        _statusMessage = $"Deleted {target}";
    }

    private async Task ExportAsync(string format)
    {
        await JS.InvokeVoidAsync("passage.exportDocument", format, DisplayName);
        _statusMessage = $"Exported {format.ToUpperInvariant()}";
    }

    // ---- Autosave ----

    private void ScheduleAutosave()
    {
        if (!_autosaveEnabled || _fileName.Length == 0)
        {
            return;
        }

        _autosaveCts?.Cancel();
        _autosaveCts = new CancellationTokenSource();
        var token = _autosaveCts.Token;
        _ = Task.Run(async () =>
        {
            try
            {
                await Task.Delay(1500, token);
                await InvokeAsync(async () =>
                {
                    if (_isDirty && _fileName.Length > 0)
                    {
                        await SaveAsync();
                        StateHasChanged();
                    }
                });
            }
            catch (TaskCanceledException)
            {
                // Superseded by a newer edit.
            }
        }, CancellationToken.None);
    }

    // ---- Analysis / rendering helpers ----

    // ---- "Classify As" line-type overrides ----
    //
    // Keyed by 1-based line number, the shape the parser takes. The client owns
    // them against CodeMirror line handles, which follow a line as text is
    // inserted or removed above it, and sends the current numbers with every
    // content push. The desktop keeps a plain Dictionary<int, …> and never
    // renumbers it, so an edit above an overridden line silently moves the
    // override onto the wrong one; handles are how the web avoids that.
    private Dictionary<int, ScreenplayElementType> _lineTypeOverrides = new();

    private void SetLineTypeOverrides(Dictionary<string, string>? overrides)
    {
        var map = new Dictionary<int, ScreenplayElementType>();
        if (overrides is not null)
        {
            foreach (var (line, typeName) in overrides)
            {
                if (int.TryParse(line, out var lineNumber) &&
                    Enum.TryParse<ScreenplayElementType>(typeName, out var type))
                {
                    map[lineNumber] = type;
                }
            }
        }

        _lineTypeOverrides = map;
    }

    private void RunAnalysis()
    {
        _analysis = IsScreenplayMode
            ? _analyzer.Analyze(_content, _lineTypeOverrides.Count > 0 ? _lineTypeOverrides : null)
            : DocumentAnalyzer.AnalyzeMarkdown(_content);
    }

    // Replaces the whole document: clears CodeMirror's undo stack and resets
    // the caret. Only correct when the text really is different.
    private async Task ReplaceEditorContentAsync()
    {
        var version = await JS.InvokeAsync<int>("passage.setContent", _content);
        await JS.InvokeVoidAsync("passage.applyHighlights", version, _analysis.LineClasses);
    }

    private void UpdateCaretElementLabel()
    {
        var index = _caretLine - 1;
        var cssClass = index >= 0 && index < _analysis.LineClasses.Length ? _analysis.LineClasses[index] : string.Empty;
        _caretElementLabel = cssClass switch
        {
            "sx-scene" => "Scene Heading",
            "sx-character" => "Character",
            "sx-dialogue" => "Dialogue",
            "sx-paren" => "Parenthetical",
            "sx-transition" => "Transition",
            "sx-section" => "Section",
            "sx-synopsis" => "Synopsis",
            "sx-note" => "Note",
            "sx-boneyard" => "Boneyard",
            "sx-centered" => "Centered",
            "sx-lyrics" => "Lyrics",
            "sx-titlepage" => "Title Page",
            "md-heading" => "Heading",
            _ => IsScreenplayMode ? "Action" : "Text"
        };
    }

    private void SetMainView(int index)
    {
        _mainViewIndex = index;
        if (index == 0)
        {
            _ = JS.InvokeVoidAsync("passage.focusEditor");
        }
    }

    private async Task JumpToLineAsync(int lineNumber)
    {
        _mainViewIndex = 0;
        await JS.InvokeVoidAsync("passage.scrollToLine", lineNumber);
    }

    // ---- Beat Board: drag to reorder ----
    //
    // Ports the pointer handlers plus MoveBeatBoardCardText. The desktop decides
    // before/after from the horizontal midpoint of the target; the web board
    // stacks cards vertically, so this uses the vertical midpoint instead —
    // a horizontal split would be meaningless in a column.
    //
    // The move is applied as one contiguous splice (see TryPlanMove), so a drag
    // is a single undo step and does not disturb the rest of the document.

    private Guid _dragCardId = Guid.Empty;
    private Guid _dragOverCardId = Guid.Empty;

    private void OnCardDragStart(BoardCard card)
    {
        // Never start a drag from a card that is open for editing.
        if (_editingCardId == card.Id)
        {
            return;
        }

        _dragCardId = card.Id;
    }

    private void OnCardDragEnd()
    {
        _dragCardId = Guid.Empty;
        _dragOverCardId = Guid.Empty;
    }

    private void OnCardDragOver(BoardCard card)
    {
        if (_dragCardId == Guid.Empty || _dragCardId == card.Id)
        {
            _dragOverCardId = Guid.Empty;
            return;
        }

        // Which side the drop lands on is decided in the browser, which is the
        // only place the card's real height is known; this just marks the target.
        _dragOverCardId = card.Id;
    }

    private async Task OnCardDropAsync(BoardCard target)
    {
        var sourceId = _dragCardId;
        var insertAfter = false;
        try
        {
            insertAfter = await JS.InvokeAsync<bool>("passage.dropIsAfter");
        }
        catch (JSException)
        {
        }

        _dragCardId = Guid.Empty;
        _dragOverCardId = Guid.Empty;

        if (sourceId == Guid.Empty || sourceId == target.Id || target.Id == Guid.Empty)
        {
            return;
        }

        var source = BeatBoardText.GetCardLineRange(
            _analysis.Elements, sourceId, _analysis.LineCount, includeNestedBlock: true);
        var destination = BeatBoardText.GetCardLineRange(
            _analysis.Elements, target.Id, _analysis.LineCount, includeNestedBlock: true);

        var lines = _content.Replace("\r\n", "\n").Split('\n');

        if (!BeatBoardText.TryPlanMove(lines, source, destination, insertAfter,
                out var splice, out var replacement))
        {
            _statusMessage = "That card cannot be moved there";
            return;
        }

        try
        {
            await JS.InvokeAsync<bool>(
                "passage.replaceLineRange",
                splice.StartLineIndex,
                splice.EndLineIndex,
                string.Join("\n", replacement));
        }
        catch (JSException)
        {
            return;
        }

        _statusMessage = "Moved card";
    }

    // ---- Beat Board: delete a card ----
    //
    // Ports DeleteCard. A Note takes only its own lines; anything else takes its
    // whole block, nested content included — which is why this always confirms,
    // and why the prompt states the line count.

    private BoardCard? _deleteCard;
    private string _deleteCardScope = string.Empty;
    private int _deleteCardLines;
    private BeatBoardText.LineRange _deleteCardRange;

    private void RequestDeleteCard(BoardCard card)
    {
        if (card.Id == Guid.Empty)
        {
            return;
        }

        var range = BeatBoardText.GetCardLineRange(
            _analysis.Elements, card.Id, _analysis.LineCount,
            includeNestedBlock: card.Kind != "Note");

        if (!range.IsFound)
        {
            _cardEditError = "That card is no longer in the script.";
            return;
        }

        _deleteCard = card;
        _deleteCardRange = range;
        _deleteCardLines = range.LineCount;
        _deleteCardScope = card.Kind is "Act" or "Sequence"
            ? $"the {card.Kind.ToLowerInvariant()} \"{card.Heading}\" and everything nested inside it"
            : $"\"{card.Heading}\" and its contents";
    }

    private async Task ConfirmDeleteCardAsync()
    {
        var card = _deleteCard;
        var range = _deleteCardRange;
        _deleteCard = null;
        if (card is null || !range.IsFound)
        {
            return;
        }

        try
        {
            await JS.InvokeVoidAsync(
                "passage.deleteLineRange", range.StartLineIndex, range.EndLineIndex);
        }
        catch (JSException)
        {
            return;
        }

        _editingCardId = Guid.Empty;
        _cardEditError = string.Empty;
        _statusMessage = $"Deleted {card.Kind.ToLowerInvariant()} \"{card.Heading}\"";
    }

    // ---- Beat Board: add a scene ----
    //
    // Ports AddSceneToBlock. The new scene goes after the container's *whole*
    // block — nested content included — so adding to an act lands at the end of
    // that act, not immediately under its heading.

    private async Task AddSceneToBlockAsync(BoardCard? container)
    {
        var insertAt = _analysis.LineCount;

        if (container is not null && container.Id != Guid.Empty)
        {
            var range = BeatBoardText.GetCardLineRange(
                _analysis.Elements, container.Id, _analysis.LineCount, includeNestedBlock: true);

            if (range.IsFound)
            {
                insertAt = Math.Min(range.EndLineIndex + 1, _analysis.LineCount);
            }
        }

        var newId = Guid.NewGuid();
        var lines = string.Join("\n", new[]
        {
            string.Empty,
            $". NEW SCENE [[id:{newId}]]",
            "= Click Edit to describe this scene."
        });

        try
        {
            await JS.InvokeVoidAsync("passage.insertLinesAt", insertAt, lines);
        }
        catch (JSException)
        {
            return;
        }

        _statusMessage = "Added scene";
    }

    // ---- Beat Board card editing ----
    //
    // Write-back goes through BeatBoardText (shared with the desktop app) to
    // work out the card's own line range and build its replacement lines, then
    // splices just that range in CodeMirror. Deliberately not a whole-document
    // rewrite: that is what clears the undo stack, which is the trap 3.1 and
    // FUTURE_IMPROVEMENTS 1 both warn about.

    private Guid _editingCardId = Guid.Empty;
    private string _editHeading = string.Empty;
    private string _editDescription = string.Empty;
    private string _editType = "Scene";
    private string _cardEditError = string.Empty;

    private void StartCardEdit(BoardCard card)
    {
        _editingCardId = card.Id;
        _editHeading = card.Heading;
        _editDescription = card.Description;
        _editType = card.Kind;
        _cardEditError = string.Empty;
    }

    private void CancelCardEdit()
    {
        _editingCardId = Guid.Empty;
        _cardEditError = string.Empty;
    }

    private async Task SaveCardAsync()
    {
        if (_editingCardId == Guid.Empty)
        {
            return;
        }

        if (string.IsNullOrWhiteSpace(_editHeading))
        {
            _cardEditError = "A card needs a heading.";
            return;
        }

        var range = BeatBoardText.GetCardLineRange(
            _analysis.Elements, _editingCardId, _analysis.LineCount, includeNestedBlock: false);

        if (!range.IsFound)
        {
            // The document moved on under the card — a reparse will have
            // rebuilt the board, so ask the user to try again rather than
            // splicing at a stale offset.
            _cardEditError = "That card is no longer in the script. Close and reopen the editor.";
            return;
        }

        var lines = BeatBoardText.BuildCardLines(
            _editType, _editHeading, _editDescription, _editingCardId);

        bool replaced;
        try
        {
            replaced = await JS.InvokeAsync<bool>(
                "passage.replaceLineRange",
                range.StartLineIndex,
                range.EndLineIndex,
                string.Join("\n", lines));
        }
        catch (JSException)
        {
            return;
        }

        if (!replaced)
        {
            _cardEditError = "Could not update the script.";
            return;
        }

        _editingCardId = Guid.Empty;
        _cardEditError = string.Empty;
        _statusMessage = "Card updated";
    }

    private async Task OnCardEditKeyDown(KeyboardEventArgs args)
    {
        if (args.Key == "Enter")
        {
            await SaveCardAsync();
        }
        else if (args.Key == "Escape")
        {
            CancelCardEdit();
        }
    }

    // ---- Beat Board ----
    //
    // Lanes and groups are rebuilt from scratch on every parse, so collapsed
    // state has to survive the rebuild — the same thing RebuildBeatBoardLanes
    // does with its collapsed-id sets. Keyed by heading rather than the Linux
    // card Id, because line numbers move on every keystroke and the web has no
    // stable card identity to hang onto.
    private readonly HashSet<string> _collapsedLanes = new(StringComparer.Ordinal);
    private readonly HashSet<string> _collapsedGroups = new(StringComparer.Ordinal);

    private static string LaneKey(BoardLane lane) => lane.ActCard?.Heading ?? "\u0000lane";

    private static string GroupKey(BoardGroup group) => group.SequenceCard?.Heading ?? "\u0000group";

    private void ToggleLane(string key)
    {
        if (!_collapsedLanes.Remove(key))
        {
            _collapsedLanes.Add(key);
        }
    }

    private void ToggleGroup(string key)
    {
        if (!_collapsedGroups.Remove(key))
        {
            _collapsedGroups.Add(key);
        }
    }

    // ---- Title page ----
    //
    // The Fountain title page is key/value lines at the head of the document,
    // so editing it means splicing lines 0..BodyStart. Field order below is the
    // order EditTitlePage writes them in — Author before Credit, Contact and
    // Notes last — so a document round-trips identically between the two apps
    // and exports match.

    private bool _titlePageOpen;
    private bool _hasTitlePage;
    private ElementReference _titlePageInput;
    private bool _focusTitlePage;

    private string _tpTitle = string.Empty;
    private string _tpEpisode = string.Empty;
    private string _tpCredit = "written by";
    private string _tpAuthor = string.Empty;
    private string _tpSource = string.Empty;
    private string _tpContact = string.Empty;
    private string _tpDraftDate = string.Empty;
    private string _tpRevision = string.Empty;
    private string _tpNotes = string.Empty;

    private void OpenTitlePage()
    {
        _tpTitle = _tpEpisode = _tpAuthor = _tpSource = string.Empty;
        _tpContact = _tpDraftDate = _tpRevision = _tpNotes = string.Empty;
        _tpCredit = "written by";

        foreach (var entry in _analysis.TitlePage)
        {
            switch (entry.FieldType)
            {
                case TitlePageFieldType.Title: _tpTitle = entry.Value; break;
                case TitlePageFieldType.Episode: _tpEpisode = entry.Value; break;
                case TitlePageFieldType.Credit: _tpCredit = entry.Value; break;
                case TitlePageFieldType.Author: _tpAuthor = entry.Value; break;
                case TitlePageFieldType.Source: _tpSource = entry.Value; break;
                case TitlePageFieldType.Contact: _tpContact = entry.Value; break;
                case TitlePageFieldType.DraftDate: _tpDraftDate = entry.Value; break;
                case TitlePageFieldType.Revision: _tpRevision = entry.Value; break;
                case TitlePageFieldType.Notes: _tpNotes = entry.Value; break;
            }
        }

        _hasTitlePage = _analysis.TitlePage.Count > 0;
        _titlePageOpen = true;
        _focusTitlePage = true;
    }

    private static void AppendBlock(System.Text.StringBuilder builder, string label, string value)
    {
        if (string.IsNullOrWhiteSpace(value))
        {
            return;
        }

        builder.Append(label).Append(':').Append('\n');
        foreach (var line in value.Replace("\r\n", "\n").Split('\n'))
        {
            builder.Append("    ").Append(line.Trim()).Append('\n');
        }
    }

    private string BuildTitlePageHeader()
    {
        var builder = new System.Text.StringBuilder();
        void Field(string label, string value)
        {
            if (!string.IsNullOrWhiteSpace(value))
            {
                builder.Append(label).Append(": ").Append(value).Append('\n');
            }
        }

        Field("Title", _tpTitle);
        Field("Episode", _tpEpisode);
        Field("Author", _tpAuthor);
        Field("Credit", _tpCredit);
        Field("Source", _tpSource);
        Field("Draft date", _tpDraftDate);
        Field("Revision", _tpRevision);
        AppendBlock(builder, "Contact", _tpContact);
        AppendBlock(builder, "Notes", _tpNotes);

        return builder.ToString().TrimEnd();
    }

    private async Task ApplyTitlePageAsync() => await ReplaceTitlePageAsync(BuildTitlePageHeader());

    private async Task DeleteTitlePageAsync() => await ReplaceTitlePageAsync(string.Empty);

    private async Task ReplaceTitlePageAsync(string header)
    {
        var lines = _content.Replace("\r\n", "\n").Split('\n').ToList();
        var bodyStart = _analysis.TitlePageBodyStart;
        if (bodyStart > 0 && bodyStart <= lines.Count)
        {
            lines.RemoveRange(0, bodyStart);
        }

        if (header.Length > 0)
        {
            lines.Insert(0, string.Empty);
            lines.Insert(0, header);
        }

        _titlePageOpen = false;
        _content = string.Join("\n", lines);
        _isDirty = true;
        _statusMessage = header.Length > 0 ? "Title page updated" : "Title page removed";

        // Whole-document rewrite, so the undo stack goes with it — the same
        // trade-off EditTitlePage makes by assigning EditorContent outright.
        RunAnalysis();
        UpdateCaretElementLabel();
        await ReplaceEditorContentAsync();
        await JS.InvokeVoidAsync("passage.setDirty", true);
        StateHasChanged();
    }

    // ---- Find / Replace ----
    //
    // A docked bar rather than Avalonia's floating window: a modal dialog would
    // take focus away from the editor it is searching, and the web app has no
    // separate window to put it in. Same option set and same buttons.

    private bool _findOpen;
    private bool _replaceShown;
    private string _findTerm = string.Empty;
    private string _replaceTerm = string.Empty;
    private bool _matchCase;
    private bool _wholeWord;
    private string _findStatus = string.Empty;
    private ElementReference _findInput;
    private bool _focusFind;

    [JSInvokable]
    public async Task OnFindShortcut(bool showReplace)
    {
        _findOpen = true;
        _replaceShown = _replaceShown || showReplace;
        _findStatus = string.Empty;
        _focusFind = true;

        // Seed from the selection, the way an editor's find normally behaves.
        try
        {
            var selected = await JS.InvokeAsync<string>("passage.selectedText");
            if (!string.IsNullOrEmpty(selected) && !selected.Contains('\n'))
            {
                _findTerm = selected;
            }
        }
        catch (JSException)
        {
        }

        StateHasChanged();
    }

    private void CloseFind()
    {
        _findOpen = false;
        _findStatus = string.Empty;
    }

    private async Task FindAsync(bool forward)
    {
        if (_findTerm.Length == 0)
        {
            _findStatus = string.Empty;
            return;
        }

        bool found;
        try
        {
            found = await JS.InvokeAsync<bool>(
                forward ? "passage.findNext" : "passage.findPrevious",
                _findTerm, _matchCase, _wholeWord);
        }
        catch (JSException)
        {
            return;
        }

        _findStatus = found ? string.Empty : "No matches";
    }

    private sealed record ReplaceOutcome
    {
        public int Replaced { get; init; }

        public bool Found { get; init; }
    }

    private async Task ReplaceCurrentAsync()
    {
        if (_findTerm.Length == 0)
        {
            return;
        }

        ReplaceOutcome outcome;
        try
        {
            outcome = await JS.InvokeAsync<ReplaceOutcome>(
                "passage.replaceCurrent", _findTerm, _replaceTerm, _matchCase, _wholeWord);
        }
        catch (JSException)
        {
            return;
        }

        _findStatus = outcome.Replaced > 0
            ? "Replaced 1"
            : (outcome.Found ? string.Empty : "No matches");
    }

    private async Task ReplaceAllAsync()
    {
        if (_findTerm.Length == 0)
        {
            return;
        }

        ReplaceOutcome outcome;
        try
        {
            outcome = await JS.InvokeAsync<ReplaceOutcome>(
                "passage.replaceAll", _findTerm, _replaceTerm, _matchCase, _wholeWord);
        }
        catch (JSException)
        {
            return;
        }

        _findStatus = outcome.Replaced == 0
            ? "No matches"
            : $"Replaced {outcome.Replaced}";
    }

    private async Task OnFindKeyDown(KeyboardEventArgs args)
    {
        if (args.Key == "Enter")
        {
            await FindAsync(!args.ShiftKey);
        }
        else if (args.Key == "Escape")
        {
            CloseFind();
        }
    }

    // ---- Go to Scene ----

    private sealed record SceneJump(int LineNumber, string Text);

    private bool _goToSceneOpen;
    private string _sceneFilter = string.Empty;
    private int _sceneSelectedIndex;
    private ElementReference _sceneFilterInput;
    private bool _focusSceneFilter;
    private List<SceneJump> _scenes = new();

    // Typing narrows the list, so the selection has to be pulled back inside it
    // or Jump would fire on an index that no longer exists.
    private string SceneFilter
    {
        get => _sceneFilter;
        set
        {
            _sceneFilter = value;
            var count = FilteredScenes.Count;
            _sceneSelectedIndex = count == 0 ? 0 : Math.Clamp(_sceneSelectedIndex, 0, count - 1);
        }
    }

    private List<SceneJump> FilteredScenes => _sceneFilter.Trim().Length == 0
        ? _scenes
        : _scenes
            .Where(scene => scene.Text.Contains(_sceneFilter.Trim(), StringComparison.OrdinalIgnoreCase))
            .ToList();

    [JSInvokable]
    public void OnGoToSceneShortcut()
    {
        OpenGoToScene();
        StateHasChanged();
    }

    private void OpenGoToScene()
    {
        // The OUTLINE panel already has this data; flatten it rather than
        // reparsing, matching the Linux FlattenScenes over OutlineRoots.
        _scenes = new List<SceneJump>();
        CollectScenes(_analysis.Outline, _scenes);
        _sceneFilter = string.Empty;
        _sceneSelectedIndex = 0;
        _goToSceneOpen = true;
        _focusSceneFilter = true;
    }

    private static void CollectScenes(IEnumerable<OutlineNode> nodes, List<SceneJump> into)
    {
        foreach (var node in nodes)
        {
            if (string.Equals(node.Kind, "Scene", StringComparison.Ordinal))
            {
                into.Add(new SceneJump(node.LineNumber, node.Label));
            }

            CollectScenes(node.Children, into);
        }
    }

    private void CloseGoToScene() => _goToSceneOpen = false;

    private async Task JumpToSelectedSceneAsync()
    {
        var scenes = FilteredScenes;
        if (_sceneSelectedIndex < 0 || _sceneSelectedIndex >= scenes.Count)
        {
            return;
        }

        var target = scenes[_sceneSelectedIndex];
        _goToSceneOpen = false;
        await JumpToLineAsync(target.LineNumber);
    }

    private async Task OnGoToSceneKeyDown(KeyboardEventArgs args)
    {
        var count = FilteredScenes.Count;
        switch (args.Key)
        {
            case "Enter":
                await JumpToSelectedSceneAsync();
                break;
            case "Escape":
                CloseGoToScene();
                break;
            case "ArrowDown" when count > 0:
                _sceneSelectedIndex = Math.Min(_sceneSelectedIndex + 1, count - 1);
                await ScrollSelectedSceneIntoViewAsync();
                break;
            case "ArrowUp" when count > 0:
                _sceneSelectedIndex = Math.Max(_sceneSelectedIndex - 1, 0);
                await ScrollSelectedSceneIntoViewAsync();
                break;
        }
    }

    private async Task ScrollSelectedSceneIntoViewAsync()
    {
        // Blazor has to render the moved selection before the browser can
        // scroll to it.
        await InvokeAsync(StateHasChanged);
        try
        {
            await JS.InvokeVoidAsync("passage.scrollIntoView", ".scene-row.active");
        }
        catch (JSException)
        {
        }
    }

    // ---- Syntax quick reference ----

    private bool _syntaxPanelOpen;

    [JSInvokable]
    public void OnSyntaxPanelShortcut()
    {
        ToggleSyntaxPanel();
        StateHasChanged();
    }

    private void ToggleSyntaxPanel() => _syntaxPanelOpen = !_syntaxPanelOpen;

    private void CloseSyntaxPanel() => _syntaxPanelOpen = false;

    // ---- Writer's tools dock (the Slate engines; docs/SLATE-PLAN.md) ----

    private async Task ToggleWorkshopAsync()
    {
        _workshopOpen = !_workshopOpen;
        await PersistSessionAsync();
    }

    private enum WorkshopView { Tools, Brackets, Fill, Chains, Chain, Split, Belief, Extend, Bridges, Bridge, Positions, Position, Revisions, Revise }

    private WorkshopView _workshopView;
    private SlateDocument _slate = new();
    private string? _slateLoadError;
    private Bracket? _fillBracket;
    private FillRun? _fillRun;

    // "Hand me one" walks the ranked, non-ignored brackets from the top. The
    // cursor only advances when a handed bracket is put back unfilled, and
    // resets whenever the queue changes, so the top of the queue is always
    // what comes next after a fill.
    private int _handCursor;

    private IEnumerable<Bracket> EligibleBrackets => _analysis.Brackets.Where(bracket => !IsIgnored(bracket));

    private bool IsIgnored(Bracket bracket) => _slate.IgnoredBrackets.Contains(bracket.Text, StringComparer.Ordinal);

    private void LoadSlate()
    {
        _slate = new SlateDocument();
        _slateLoadError = null;
        _handCursor = 0;
        _fillBracket = null;
        _fillRun = null;
        if (_workshopView == WorkshopView.Fill)
        {
            _workshopView = WorkshopView.Brackets;
        }

        _chain = null;
        if (_workshopView == WorkshopView.Chain)
        {
            _workshopView = WorkshopView.Chains;
        }

        // The Split family is one run per script, so a different script means
        // a different run; back to the list rather than showing the wrong one.
        if (_workshopView is WorkshopView.Split or WorkshopView.Belief or WorkshopView.Extend)
        {
            _workshopView = WorkshopView.Tools;
        }

        _bridge = null;
        _position = null;
        if (_workshopView == WorkshopView.Bridge)
        {
            _workshopView = WorkshopView.Bridges;
        }

        if (_workshopView == WorkshopView.Position)
        {
            _workshopView = WorkshopView.Positions;
        }

        _revision = null;
        if (_workshopView == WorkshopView.Revise)
        {
            _workshopView = WorkshopView.Revisions;
        }

        if (_burstRunning)
        {
            _burstRunning = false;
            _ = StopBurstAsync();
        }

        if (_fileName.Length == 0)
        {
            return;
        }

        try
        {
            _slate = Slate.Load(_fileName) ?? new SlateDocument();
        }
        catch (Exception exception) when (exception is IOException or JsonException or UnauthorizedAccessException)
        {
            // Left on disk untouched: overwriting it would destroy whatever
            // working-out it holds, so saves are refused until it is fixed.
            _slateLoadError = $"Slate data for {_fileName} could not be read: {exception.Message}";
            _statusMessage = _slateLoadError;
        }
    }

    private void SaveSlate()
    {
        _slate.Fills.RemoveAll(run => run != _fillRun && IsEmpty(run));
        _slate.Chains.RemoveAll(chain => chain != _chain && chain.IsEmpty);
        _slate.Bridges.RemoveAll(bridge => bridge != _bridge && bridge.IsEmpty);
        _slate.Positions.RemoveAll(position => position != _position && position.IsEmpty);
        _slate.Revisions.RemoveAll(revision => revision != _revision && revision.IsEmpty);
        if (_fileName.Length == 0)
        {
            return;
        }

        if (_slateLoadError is not null)
        {
            _statusMessage = "Not saving Slate data — " + _slateLoadError;
            return;
        }

        try
        {
            Slate.Save(_fileName, _slate);
        }
        catch (Exception exception) when (exception is IOException or UnauthorizedAccessException)
        {
            _statusMessage = $"Could not save Slate data: {exception.Message}";
        }
    }

    private static bool IsEmpty(FillRun run) =>
        string.IsNullOrWhiteSpace(run.PointsTo) && string.IsNullOrWhiteSpace(run.Answer)
        && run.Options.All(option => string.IsNullOrWhiteSpace(option.Text) && string.IsNullOrWhiteSpace(option.WhyWrong));

    private async Task HandMeOneAsync()
    {
        var eligible = EligibleBrackets.ToList();
        if (eligible.Count == 0)
        {
            _workshopView = WorkshopView.Brackets;
            return;
        }

        await OpenFillAsync(eligible[_handCursor % eligible.Count]);
    }

    private async Task OpenFillAsync(Bracket bracket)
    {
        _fillBracket = bracket;
        _fillRun = _slate.Fills.FirstOrDefault(run => run.Bracket == bracket.Text);
        if (_fillRun is null)
        {
            _fillRun = new FillRun { Bracket = bracket.Text };
            _slate.Fills.Add(_fillRun);
        }

        while (_fillRun.Options.Count < 3)
        {
            _fillRun.Options.Add(new FillOption());
        }

        _workshopView = WorkshopView.Fill;
        _mainViewIndex = 0;
        // Reveal the line without taking focus: the writer is about to type in
        // the runner, and on a phone the editor is underneath it.
        await JS.InvokeVoidAsync("passage.scrollToLine", bracket.LineNumber, false);
    }

    // Closing keeps everything as it is (rule 0); the run was saved on every
    // change. Only the hand-me-one cursor moves on, so pressing it again offers
    // a different bracket.
    private void CloseFill()
    {
        _handCursor++;
        _fillBracket = null;
        _fillRun = null;
        _workshopView = WorkshopView.Brackets;
        SaveSlate();
    }

    private async Task IgnoreBracketAsync(Bracket bracket)
    {
        if (!IsIgnored(bracket))
        {
            _slate.IgnoredBrackets.Add(bracket.Text);
        }

        _slate.Fills.RemoveAll(run => run.Bracket == bracket.Text);
        _handCursor = 0;
        if (_workshopView == WorkshopView.Fill)
        {
            _fillBracket = null;
            _fillRun = null;
            SaveSlate();
            await HandMeOneAsync();
            return;
        }

        SaveSlate();
    }

    private void RestoreBracket(Bracket bracket)
    {
        _slate.IgnoredBrackets.Remove(bracket.Text);
        _handCursor = 0;
        SaveSlate();
    }

    private async Task AcceptFillAsync()
    {
        if (_fillBracket is null || _fillRun is null)
        {
            return;
        }

        // Not a disabled button: the answer's change event and the tap arrive
        // together, and a button disabled until the change lands swallows
        // the tap (see the chain runner's promote button).
        if (string.IsNullOrWhiteSpace(_fillRun.Answer))
        {
            _statusMessage = "Nothing to fill it with yet — write the real answer first";
            return;
        }

        var bracket = _fillBracket;
        var answer = _fillRun.Answer.Trim();
        bool replaced;
        try
        {
            replaced = await JS.InvokeAsync<bool>("passage.replaceInLine", bracket.LineIndex, bracket.Text, answer);
        }
        catch (JSException)
        {
            replaced = false;
        }

        if (!replaced)
        {
            // The script changed underneath the runner. Keep the run; the
            // bracket list re-derives on the next parse.
            _statusMessage = $"{bracket.Text} is no longer on line {bracket.LineNumber} — nothing changed";
            _fillBracket = null;
            _fillRun = null;
            _workshopView = WorkshopView.Brackets;
            return;
        }

        // Mirror the edit here so the next hand-me-one sees the filled line
        // now rather than after the editor's debounced change callback.
        var lines = _content.Split('\n');
        if (bracket.LineIndex < lines.Length)
        {
            var at = lines[bracket.LineIndex].IndexOf(bracket.Text, StringComparison.Ordinal);
            if (at >= 0)
            {
                lines[bracket.LineIndex] = lines[bracket.LineIndex].Remove(at, bracket.Text.Length).Insert(at, answer);
                _content = string.Join('\n', lines);
            }
        }

        _isDirty = true;
        _slate.Fills.Remove(_fillRun);
        _fillBracket = null;
        _fillRun = null;
        _handCursor = 0;
        SaveSlate();
        RunAnalysis();
        UpdateCaretElementLabel();
        _statusMessage = $"Filled line {bracket.LineNumber}";

        // Chaining: the next one, straight away. Stopping is the writer's call.
        await HandMeOneAsync();
    }

    // ---- Forward chain: WOAC and Character Flaw Brainstorm (Phase 2) ----
    //
    // One runner, two paths. A WOAC round's Want is the previous round's
    // Consequence read live, never copied, so editing an earlier round moves
    // the carry with it. Chains are kept by what they are about (the seed
    // line), never listed by when they were run (rule 0.3).

    private ChainPath _chainPath;
    private ChainRun? _chain;
    private bool _burstRunning;

    private const int BurstReadInSeconds = 5;
    private const string ChainSlotsId = "chain-slots";
    private const string BridgeSlotsId = "bridge-slots";

    private static readonly string[] FlawQuestions =
    {
        "Worst situation the flaw causes",
        "The character's first (wrong) response",
        "How that backfires",
        "Who unexpectedly helps",
        "The next (also wrong) action",
        "The obstacle that creates",
        "The flaw reframed as a hidden skill",
        "A surprising final action"
    };

    private string ChainTitle => _chainPath == ChainPath.Woac ? "WOAC CHAIN" : "CHARACTER FLAW BRAINSTORM";

    private string ChainNote => _chainPath == ChainPath.Woac
        ? "Want → Obstacle → Action → Consequence. Each round: what does the character want right now, what's in their way, what do they do about it, and what happens as a result? That consequence becomes next round's want automatically — you never have to invent a new question, just carry it down. Do one round or ten, stop whenever, read it back before you close."
        : "Eight fixed questions, same chain grammar as WOAC — but this one is a fixed-length loop, not an open one, each question different from the last rather than the same one recurring.";

    private IEnumerable<ChainRun> ChainsOnPath => _slate.Chains.Where(chain => chain.Path == _chainPath);

    private async Task OpenChainsAsync(ChainPath path)
    {
        _chainPath = path;
        if (!ChainsOnPath.Any())
        {
            await StartChainAsync();
            return;
        }

        _workshopView = WorkshopView.Chains;
        await ScrollWorkshopToTopAsync();
    }

    private async Task StartChainAsync()
    {
        var chain = new ChainRun { Path = _chainPath };
        _slate.Chains.Add(chain);
        await OpenChainAsync(chain);
    }

    // The dock body is one scroll container, so a runner opened from the
    // bottom of the tool list would otherwise open at its own bottom. The
    // scroll happens after the render that shows the new view.
    private bool _scrollWorkshopToTop;

    private Task ScrollWorkshopToTopAsync()
    {
        _scrollWorkshopToTop = true;
        return Task.CompletedTask;
    }

    private async Task OpenChainAsync(ChainRun chain)
    {
        // A sidecar edited by hand can be short a row; the runner always has
        // somewhere to type.
        if (chain.Rounds.Count == 0)
        {
            chain.Rounds.Add(new ChainRound());
        }

        while (chain.Answers.Count < ChainRun.FlawQuestionCount)
        {
            chain.Answers.Add(string.Empty);
        }

        _chain = chain;
        _chainPath = chain.Path;
        _workshopView = WorkshopView.Chain;
        await ScrollWorkshopToTopAsync();
    }

    // Closing keeps everything as it is (rule 0); the chain was saved on every
    // change.
    private async Task CloseChainAsync()
    {
        await StopBurstAsync();
        _chain = null;
        _workshopView = WorkshopView.Chains;
        SaveSlate();
    }

    private void RemoveChain(ChainRun chain)
    {
        _slate.Chains.Remove(chain);
        SaveSlate();
        _statusMessage = "Removed the chain";
    }

    // The carry: a written consequence opens the next round, whose Want reads
    // it live. Nothing is copied.
    private void ConsequenceChanged(ChainRound round)
    {
        if (_chain is not null && round == _chain.Rounds[^1] && !string.IsNullOrWhiteSpace(round.Consequence))
        {
            _chain.Rounds.Add(new ChainRound());
        }

        SaveSlate();
    }

    private async Task BurstSettingChangedAsync()
    {
        if (!_slate.Burst.Enabled)
        {
            await StopBurstAsync();
        }

        SaveSlate();
    }

    // The timer itself lives in passage.js (decision E, trap 4): focus, read-in,
    // countdown and advance are all client-side. The server hears only that it
    // ended, and gets each answer through the ordinary change events.
    private async Task StartBurstAsync(string rootId)
    {
        var seconds = Math.Clamp(_slate.Burst.Seconds, 5, 600);
        try
        {
            _burstRunning = await JS.InvokeAsync<bool>("passage.startBurst", rootId, BurstReadInSeconds, seconds);
        }
        catch (JSException)
        {
            _burstRunning = false;
        }
    }

    private async Task StopBurstAsync()
    {
        _burstRunning = false;
        try
        {
            await JS.InvokeVoidAsync("passage.stopBurst");
        }
        catch (JSException)
        {
        }
    }

    [JSInvokable]
    public void OnBurstEnded()
    {
        _burstRunning = false;
        StateHasChanged();
    }

    private (int InsertAt, int HeadingIndex) PromotionTarget => SynopsisPlacement.Find(_analysis.LineClasses, _caretLine - 1);

    private string PromotionTargetLabel
    {
        get
        {
            var (insertAt, headingIndex) = PromotionTarget;
            if (headingIndex < 0)
            {
                return $"Goes in as a = synopsis line at the caret (line {insertAt + 1}) — there's no section or scene heading above it.";
            }

            return $"Goes in as a = synopsis line under {LineText(headingIndex)} (line {headingIndex + 1}).";
        }
    }

    private string LineText(int index)
    {
        var lines = _content.Split('\n');
        return index >= 0 && index < lines.Length ? lines[index].Trim() : string.Empty;
    }

    // Promotion: the one line goes into the script as a synopsis under the
    // current heading, by ranged insert so undo survives. The chain stays in
    // the sidecar; the script now holds the result and the sidecar the
    // working-out (decision B).
    private async Task PromoteReadBackAsync()
    {
        if (_chain is null)
        {
            return;
        }

        // Not a disabled button: the field's change event and the click arrive
        // on the same tap, and a button disabled until the change lands
        // would swallow that tap.
        if (string.IsNullOrWhiteSpace(_chain.ReadBack))
        {
            _statusMessage = "Nothing to add yet — write the one line first";
            return;
        }

        var line = "= " + string.Join(' ', _chain.ReadBack.Split('\n', StringSplitOptions.RemoveEmptyEntries).Select(part => part.Trim()));
        var (insertAt, headingIndex) = PromotionTarget;
        var heading = headingIndex >= 0 ? LineText(headingIndex) : null;
        bool inserted;
        try
        {
            inserted = await JS.InvokeAsync<bool>("passage.insertLinesAt", insertAt, line);
        }
        catch (JSException)
        {
            inserted = false;
        }

        if (!inserted)
        {
            _statusMessage = "Could not add the line — nothing changed";
            return;
        }

        // Mirror the edit so the next promotion targets the right line now,
        // rather than after the editor's debounced change callback.
        var lines = _content.Split('\n').ToList();
        lines.Insert(Math.Min(insertAt, lines.Count), line);
        _content = string.Join('\n', lines);
        _isDirty = true;
        RunAnalysis();
        UpdateCaretElementLabel();
        _statusMessage = heading is null
            ? $"Added a synopsis at line {insertAt + 1}"
            : $"Added a synopsis under {heading} (line {insertAt + 1})";
    }

    // ---- The Split family: A→Z→Split, Belief Split, Extend Backward (Phase 3) ----
    //
    // One run of each per script — the worksheet runs them once per story —
    // and the five belief cuts are one record shared between Split's optional
    // layer and Belief Split. The stop-callouts are UI text, and the rung
    // below each is behind a button until the writer chooses it or it has
    // text: that is the anti-Woodshed mechanism, not decoration.

    // Rungs the writer has opened past what has content. Session only: a
    // reopened run shows what it holds, nothing about how far it got.
    private int _splitRung;
    private int _beliefRung;

    private static readonly (string Name, string A, string Z)[] BeliefShapes =
    {
        ("Positive Change", "Lie", "Truth"),
        ("Flat", "Truth held", "used to overcome world's Lie"),
        ("Disillusionment", "Lie", "Truth (tragic)"),
        ("Fall", "Lie", "clings, then worse Lie"),
        ("Corruption", "sees Truth", "rejects it, embraces Lie")
    };

    private async Task OpenGenerateAsync(WorkshopView view)
    {
        _splitRung = 0;
        _beliefRung = 0;
        while (_slate.Split.Candidates.Count < 3)
        {
            _slate.Split.Candidates.Add(string.Empty);
        }

        if (_slate.Extend.Links.Count == 0)
        {
            _slate.Extend.Links.Add(new ExtendLink());
        }

        _workshopView = view;
        await ScrollWorkshopToTopAsync();
    }

    private void CloseGenerate()
    {
        _workshopView = WorkshopView.Tools;
        SaveSlate();
    }

    // The plot turn a belief cut is matched to, from the Split run, when it
    // has one.
    private string? PlotMatch(int ratio)
    {
        var split = _slate.Split;
        var turn = ratio switch
        {
            12 => split.Inciting,
            25 => split.PP1,
            50 => split.Midpoint,
            75 => split.Crisis,
            88 => split.LastObstacle,
            _ => string.Empty
        };
        return string.IsNullOrWhiteSpace(turn) ? null : turn.Trim();
    }

    // Only the most recent link opens the next field.
    private void LinkChanged(ExtendLink link)
    {
        var links = _slate.Extend.Links;
        if (link == links[^1] && !string.IsNullOrWhiteSpace(link.Text))
        {
            links.Add(new ExtendLink());
        }

        SaveSlate();
    }

    private IEnumerable<BoardCard> ScriptSequences =>
        _analysis.BoardLanes.SelectMany(lane => lane.Groups).Where(group => group.SequenceCard is not null).Select(group => group.SequenceCard!);

    private bool ScriptHasShape =>
        ScriptSequences.Any(card => card.Description.Split('\n').Any(line => SplitScript.TryParse(line, out _, out _)));

    // What the script holds for a slot, when it is real text — shown under
    // the field so the runner and the script never silently disagree.
    private string? ScriptTurnHint(int slotIndex)
    {
        var slot = SplitScript.Slots[slotIndex];
        foreach (var card in ScriptSequences)
        {
            foreach (var line in card.Description.Split('\n'))
            {
                if (SplitScript.TryParse(line, out var label, out var value) && label == slot.Label)
                {
                    return SplitScript.IsKnown(value) ? value : null;
                }
            }
        }

        return null;
    }

    // Writing the shape: the first time, the whole structure goes in at the
    // end by ranged insert. After that, only turns the script still holds as
    // a bracket are filled in, matched by text; a turn with real text in the
    // script is the script's now (decision B) and is named, not overwritten.
    private async Task WriteShapeAsync()
    {
        var run = _slate.Split;
        var values = SplitScript.Values(run);
        if (!ScriptHasShape)
        {
            var shapeLines = SplitScript.BuildLines(run);
            var empty = string.IsNullOrWhiteSpace(_content);
            if (empty)
            {
                // Nothing to separate from: no leading blank line.
                shapeLines.RemoveAt(0);
            }

            var text = string.Join('\n', shapeLines);
            var insertAt = empty ? 0 : _analysis.LineCount;
            bool inserted;
            try
            {
                inserted = await JS.InvokeAsync<bool>("passage.insertLinesAt", insertAt, text);
            }
            catch (JSException)
            {
                inserted = false;
            }

            if (!inserted)
            {
                _statusMessage = "Could not write the shape — nothing changed";
                return;
            }

            var mirrored = _content.Split('\n').ToList();
            mirrored.Insert(Math.Min(insertAt, mirrored.Count), text);
            _content = string.Join('\n', mirrored);
            _isDirty = true;
            RunAnalysis();
            UpdateCaretElementLabel();
            _statusMessage = $"Wrote four acts and eight sequences from line {insertAt + 1} — see BOARD";
            return;
        }

        var lines = _content.Split('\n');
        var updated = new List<string>();
        var kept = new List<string>();
        var missing = new List<string>();
        for (var i = 0; i < SplitScript.Slots.Length; i++)
        {
            var slot = SplitScript.Slots[i];
            if (string.IsNullOrWhiteSpace(values[i]))
            {
                continue;
            }

            var index = SplitScript.FindLine(lines, slot);
            if (index < 0)
            {
                missing.Add(slot.Label);
                continue;
            }

            SplitScript.TryParse(lines[index], out _, out var current);
            if (SplitScript.IsKnown(current))
            {
                if (current != SplitScript.OneLine(values[i]))
                {
                    kept.Add(slot.Label);
                }

                continue;
            }

            var wanted = SplitScript.Line(slot, values[i]);
            bool replaced;
            try
            {
                replaced = await JS.InvokeAsync<bool>("passage.replaceInLine", index, lines[index], wanted);
            }
            catch (JSException)
            {
                replaced = false;
            }

            if (!replaced)
            {
                missing.Add(slot.Label);
                continue;
            }

            lines[index] = wanted;
            updated.Add(slot.Label);
        }

        if (updated.Count > 0)
        {
            _content = string.Join('\n', lines);
            _isDirty = true;
            RunAnalysis();
            UpdateCaretElementLabel();
        }

        var parts = new List<string>();
        if (updated.Count > 0)
        {
            parts.Add("Filled in " + string.Join(", ", updated));
        }

        if (kept.Count > 0)
        {
            parts.Add(string.Join(", ", kept) + " already " + (kept.Count == 1 ? "has" : "have") + " text in the script — edit there");
        }

        if (missing.Count > 0)
        {
            parts.Add("no line in the script for " + string.Join(", ", missing));
        }

        _statusMessage = parts.Count == 0 ? "The script already has all of this" : string.Join("; ", parts);
    }

    // ---- Bridge and Position (Phase 4) ----
    //
    // Two small runners, kept per script by what they are about, the same
    // shape as the chains. Bridge's candidates are burst slots; Position's
    // seven slots are the script's own seven turns.

    private BridgeRun? _bridge;
    private PositionRun? _position;

    private static string BridgeLabel(BridgeRun bridge)
    {
        var a = string.IsNullOrWhiteSpace(bridge.A) ? "?" : bridge.A.Trim();
        var z = string.IsNullOrWhiteSpace(bridge.Z) ? "?" : bridge.Z.Trim();
        return a == "?" && z == "?" ? "(ends not fixed yet)" : $"{a} → {z}";
    }

    private async Task OpenBridgesAsync()
    {
        if (_slate.Bridges.Count == 0)
        {
            await StartBridgeAsync();
            return;
        }

        _workshopView = WorkshopView.Bridges;
        await ScrollWorkshopToTopAsync();
    }

    private async Task StartBridgeAsync()
    {
        var bridge = new BridgeRun();
        _slate.Bridges.Add(bridge);
        await OpenBridgeAsync(bridge);
    }

    private async Task OpenBridgeAsync(BridgeRun bridge)
    {
        if (bridge.Rounds.Count == 0)
        {
            bridge.Rounds.Add(new BridgeRound());
        }

        foreach (var round in bridge.Rounds)
        {
            while (round.Candidates.Count < 3)
            {
                round.Candidates.Add(string.Empty);
            }
        }

        _bridge = bridge;
        _workshopView = WorkshopView.Bridge;
        await ScrollWorkshopToTopAsync();
    }

    private async Task CloseBridgeAsync()
    {
        await StopBurstAsync();
        _bridge = null;
        _workshopView = WorkshopView.Bridges;
        SaveSlate();
    }

    private void RemoveBridge(BridgeRun bridge)
    {
        _slate.Bridges.Remove(bridge);
        SaveSlate();
        _statusMessage = "Removed the bridge";
    }

    // A round is the writer's call, not the form's: it is added only when the
    // gap still needs more than one link.
    private void AddBridgeRound()
    {
        _bridge?.Rounds.Add(new BridgeRound());
        SaveSlate();
    }

    private async Task OpenPositionsAsync()
    {
        if (_slate.Positions.Count == 0)
        {
            await StartPositionAsync();
            return;
        }

        _workshopView = WorkshopView.Positions;
        await ScrollWorkshopToTopAsync();
    }

    private async Task StartPositionAsync()
    {
        var position = new PositionRun();
        _slate.Positions.Add(position);
        await OpenPositionAsync(position);
    }

    private async Task OpenPositionAsync(PositionRun position)
    {
        if (position.Turns.Count == 0)
        {
            position.Turns.Add(new PositionTurn());
        }

        while (position.Shortlist.Count < 2)
        {
            position.Shortlist.Add(string.Empty);
        }

        _position = position;
        _workshopView = WorkshopView.Position;
        await ScrollWorkshopToTopAsync();
    }

    private Task ClosePositionAsync()
    {
        _position = null;
        _workshopView = WorkshopView.Positions;
        SaveSlate();
        return Task.CompletedTask;
    }

    private void RemovePosition(PositionRun position)
    {
        _slate.Positions.Remove(position);
        SaveSlate();
        _statusMessage = "Removed the run";
    }

    private void AddPositionTurn()
    {
        if (_position is not null && _position.Turns.Count < PositionRun.SlotCount)
        {
            _position.Turns.Add(new PositionTurn());
        }

        SaveSlate();
    }

    private string? ScriptTurnHintFor(string slotLabel)
    {
        var index = Array.FindIndex(SplitScript.Slots, slot => slot.Label == slotLabel);
        return index < 0 ? null : ScriptTurnHint(index);
    }

    private static List<string> AliveSlots(PositionRun position) =>
        position.Turns.Where(turn => turn.Alive == "alive" && !string.IsNullOrWhiteSpace(turn.Slot)).Select(turn => turn.Slot).ToList();

    // ---- Push/Pull and Lens (Phase 5) ----
    //
    // The only independent check in the system. Six checks as their own
    // questions; a flagged one — and only a flagged one — opens a Lens on
    // that thing. Kept per script by the scene or stretch checked.

    private ReviseRun? _revision;
    private bool _reviseDeeper;
    private bool _reviseReadBack;

    private const string SeamLensId = "lens-slot-seam";

    private static readonly string[] CheckQuestions =
    {
        "Does the scene/sequence end in a different charge than it started?",
        "Does it cause the next beat, or is it deletable?",
        "What does the protagonist believe now that she didn't five minutes ago?",
        "Where does the emotional/tactical centre of gravity move — who's in control at the start vs. the end?",
        "Is the stakes/pressure higher at the end than the start, or just different?",
        "External: can this escalate for the whole story, is there a real consequence, a clock? Internal: does it force the internal struggle, does it cost something regardless of outcome?"
    };

    private static readonly (string Name, string Do)[] Lenses =
    {
        ("Role inversion", "Swap protagonist/antagonist, or relabel the hero as the villain."),
        ("Tone swap, minimum edit", "Same scene, opposite tone, fewest possible changes."),
        ("Compression to breaking point", "Cut it to ten words, or half the word count. What survives is what mattered."),
        ("Container swap", "Same content, different form — a fortune cookie, a tabloid headline, a police statement, a personal ad."),
        ("Sequential relanguaging", "Run the material through several tones in a row (e.g. grief, then comedy, then fairy tale), then translate it back to plain. Compare what came home with you."),
        ("Metaphorical-relationship overlay", "Impose a behavioural template on the scene without the characters noticing — play it as noir, or play the roommates like a bickering married couple."),
        ("Expectation inversion", "Name what the genre expects here, on the nose — then do the opposite on purpose.")
    };

    private static string? LensDo(string name) =>
        Lenses.FirstOrDefault(lens => lens.Name == name) is { Name.Length: > 0 } lens ? lens.Do : null;

    private async Task OpenRevisionsAsync()
    {
        if (_slate.Revisions.Count == 0)
        {
            await StartRevisionAsync();
            return;
        }

        _workshopView = WorkshopView.Revisions;
        await ScrollWorkshopToTopAsync();
    }

    private async Task StartRevisionAsync()
    {
        var revision = new ReviseRun();
        _slate.Revisions.Add(revision);
        await OpenRevisionAsync(revision);
    }

    private async Task OpenRevisionAsync(ReviseRun revision)
    {
        _revision = revision;
        _reviseDeeper = false;
        _reviseReadBack = false;
        _workshopView = WorkshopView.Revise;
        await ScrollWorkshopToTopAsync();
    }

    private async Task CloseRevisionAsync()
    {
        await StopBurstAsync();
        _revision = null;
        _workshopView = WorkshopView.Revisions;
        SaveSlate();
    }

    private void RemoveRevision(ReviseRun revision)
    {
        _slate.Revisions.Remove(revision);
        SaveSlate();
        _statusMessage = "Removed the run";
    }

    // "This scene" is whatever heading sits nearest above the caret.
    private void UseSceneUnderCaret()
    {
        if (_revision is null)
        {
            return;
        }

        var (_, headingIndex) = SynopsisPlacement.Find(_analysis.LineClasses, _caretLine - 1);
        if (headingIndex < 0)
        {
            _statusMessage = "No scene or section heading above the caret";
            return;
        }

        _revision.Scene = LineText(headingIndex);
        SaveSlate();
    }

    // A Lens is one slot with a long clock; Enter stays a line break there.
    private async Task StartLensAsync(string rootId)
    {
        var seconds = Math.Clamp(_slate.Burst.LensMinutes, 1, 30) * 60;
        try
        {
            _burstRunning = await JS.InvokeAsync<bool>("passage.startBurst", rootId, BurstReadInSeconds, seconds);
        }
        catch (JSException)
        {
            _burstRunning = false;
        }
    }

    // ---- Ideation burst (Phase 6) ----
    //
    // The one tool that is not about the script: a full-screen overlay with
    // nothing else on it, and its own file under .slate. The rounds are
    // throwaway; the kept line is the output.

    private bool _ideationOpen;
    private IdeationDocument? _ideation;
    private string? _ideationLoadError;

    private static readonly (string Name, string Prompt)[] Lanes =
    {
        ("Noise-seed", "Grab the nearest object, headline, or image within reach. Whatever it is, it forces the premise. \"This is now load-bearing in the story. How?\""),
        ("Grievance-to-premise", "Something that angered or moved you this month. Name it in one line, then: \"A character's whole fight, right now, is this.\""),
        ("Branch-from-catastrophe", "One fixed event. Then five continuations from it — mutually exclusive, all kept alive, none crossed out."),
        ("Situation collision", "Two unrelated fragments — anything, don't cherry-pick for compatibility — forced into one scene."),
        ("Metaphor method", "Pick a noun. List its qualities. Ask what else has those qualities. Splice."),
        ("Adversarial interrogation", "A character who won't open up to a plain question. Write both sides of a confrontation instead — force the answer out of them."),
        ("Voice journal", "Become the character. Talk as them, out loud or typed as if out loud. Don't plan what you'll say, don't stop."),
        ("Stock-character improv", "A random stock type (the villain, the sidekick, the ingenue — pick blind). Ninety seconds in their voice, no editing."),
        ("Cheap champagne", "Two voices talking, no attribution, no punctuation rules. Most of it is expected to be thrown away — that's fine, that's the point."),
        ("Character Flaw Brainstorm", "One fixed character flaw. Run it through: worst situation it causes → their first (wrong) response → how that backfires.")
    };

    private async Task OpenIdeationAsync()
    {
        if (_ideation is null)
        {
            _ideationLoadError = null;
            try
            {
                _ideation = Slate.LoadIdeation() ?? new IdeationDocument();
            }
            catch (Exception exception) when (exception is IOException or JsonException or UnauthorizedAccessException)
            {
                // Left on disk untouched, as with a script's sidecar.
                _ideation = new IdeationDocument();
                _ideationLoadError = $"Ideation data could not be read: {exception.Message}";
            }
        }

        _ideationOpen = true;
        await Task.CompletedTask;
    }

    private async Task CloseIdeationAsync()
    {
        await StopBurstAsync();
        _ideationOpen = false;
        SaveIdeation();
    }

    private void SaveIdeation()
    {
        if (_ideation is null)
        {
            return;
        }

        if (_ideationLoadError is not null)
        {
            _statusMessage = "Not saving ideation data — " + _ideationLoadError;
            return;
        }

        try
        {
            Slate.SaveIdeation(_ideation);
        }
        catch (Exception exception) when (exception is IOException or UnauthorizedAccessException)
        {
            _statusMessage = $"Could not save ideation data: {exception.Message}";
        }
    }

    private void RollLane() => StartSitting(Random.Shared.Next(1, Lanes.Length + 1));

    private void StartSitting(int lane)
    {
        if (_ideation is null)
        {
            return;
        }

        _ideation.Current = new IdeationSitting { Lane = lane };
        DealRound(_ideation.Current.Rounds[0]);
    }

    // The seed is forced on you, not chosen — the worksheet's "pick blind".
    // A writer with something of their own types over it.
    private void DealRound(IdeationRound round)
    {
        if (_ideation?.Current is null)
        {
            return;
        }

        round.Input = IdeationDealer.Deal(_ideation.Current.Lane);
        SaveIdeation();
    }

    private async Task StartRoundAsync(string roundId)
    {
        if (_ideation is null)
        {
            return;
        }

        var seconds = Math.Clamp(_ideation.RoundSeconds, 10, 600);
        try
        {
            _burstRunning = await JS.InvokeAsync<bool>("passage.startBurst", roundId, BurstReadInSeconds, seconds);
        }
        catch (JSException)
        {
            _burstRunning = false;
        }
    }

    private void AddIdeationRound()
    {
        if (_ideation?.Current is null)
        {
            return;
        }

        var round = new IdeationRound();
        _ideation.Current.Rounds.Add(round);
        DealRound(round);
    }

    private void KeepFromRound(IdeationRound round)
    {
        if (_ideation?.Current is null)
        {
            return;
        }

        _ideation.Current.KeptLine = round.Output.Trim();
        SaveIdeation();
    }

    // The sitting ends: the kept line is filed, the rounds are not. Don't
    // review — the worksheet says skim later, not in the same sitting.
    private async Task FinishSittingAsync()
    {
        if (_ideation?.Current is null)
        {
            return;
        }

        await StopBurstAsync();
        var kept = _ideation.Current.KeptLine.Trim();
        if (kept.Length > 0)
        {
            _ideation.Kept.Add(kept);
        }

        _ideation.Current = null;
        SaveIdeation();
    }

    private void DropKeptLine(string line)
    {
        _ideation?.Kept.Remove(line);
        SaveIdeation();
    }

    // Scripts can be deleted from the volume outside the app. A sidecar left
    // behind is dropped on load and said so, the same way stale recent-files
    // entries are — never silently. Runs on the first interactive render, not
    // in OnInitialized: prerendering runs that twice, and the second pass
    // would find nothing to prune and lose the message.
    private void PruneSlateOrphans()
    {
        IReadOnlyList<string> pruned;
        try
        {
            pruned = Slate.PruneOrphans(_files.Select(file => file.Name));
        }
        catch (Exception exception) when (exception is IOException or UnauthorizedAccessException)
        {
            _statusMessage = $"Could not check Slate data: {exception.Message}";
            return;
        }

        if (pruned.Count > 0)
        {
            _statusMessage = $"Removed Slate data for missing script{(pruned.Count == 1 ? "" : "s")}: {string.Join(", ", pruned)}";
        }
    }

    // ---- Go to Line ----

    private bool _goToLineOpen;
    private string _goToLineValue = string.Empty;
    private string _goToLineError = string.Empty;
    private ElementReference _goToLineInput;
    private bool _focusGoToLine;

    [JSInvokable]
    public void OnGoToLineShortcut()
    {
        OpenGoToLine();
        StateHasChanged();
    }

    private void OpenGoToLine()
    {
        _goToLineValue = string.Empty;
        _goToLineError = string.Empty;
        _goToLineOpen = true;
        // Avalonia focuses the dialog's first control for free; the browser
        // does not focus a node that was only just inserted, so ask for it.
        _focusGoToLine = true;
    }

    private void CloseGoToLine()
    {
        _goToLineOpen = false;
        _goToLineError = string.Empty;
    }

    private async Task ConfirmGoToLineAsync()
    {
        if (!int.TryParse(_goToLineValue.Trim(), out var lineNumber) || lineNumber < 1)
        {
            // The Avalonia dialog just refuses to close on bad input, which
            // leaves the user guessing. Say what is wrong instead (rule 12).
            _goToLineError = "Enter a line number of 1 or more.";
            return;
        }

        _goToLineOpen = false;
        _goToLineError = string.Empty;
        // scrollToLine clamps past the end of the document, matching the
        // Linux NavigateToLine.
        await JumpToLineAsync(lineNumber);
    }

    // Awaited, not fire-and-forget: Blazor renders when the handler completes,
    // so a detached task would set the validation error after the only render
    // it could have appeared in.
    private async Task OnGoToLineKeyDown(KeyboardEventArgs args)
    {
        if (args.Key == "Enter")
        {
            await ConfirmGoToLineAsync();
        }
        else if (args.Key == "Escape")
        {
            CloseGoToLine();
        }
    }

    // CodeMirror owns the undo stack; these just drive it and hand focus back.
    private async Task UndoAsync() => await JS.InvokeVoidAsync("passage.undo");

    private async Task RedoAsync() => await JS.InvokeVoidAsync("passage.redo");

    private async Task AdjustPreviewZoom(double delta)
    {
        _previewZoom = Math.Clamp(_previewZoom + delta, MinPreviewZoom, MaxPreviewZoom);
        await PersistSessionAsync();
    }

    private async Task AdjustEditorFont(int delta)
    {
        _editorFontPx = Math.Clamp(_editorFontPx + delta, MinEditorFontPx, MaxEditorFontPx);
        await PersistSessionAsync();
    }

    private static string StyleClass(LayoutTextStyle style) => style switch
    {
        LayoutTextStyle.LeftBold => "st-bold",
        LayoutTextStyle.CenterWithinBody => "st-center",
        LayoutTextStyle.CenterWithinBodyBold => "st-center st-bold",
        LayoutTextStyle.RightWithinBody => "st-right",
        _ => string.Empty
    };

    private static string IndentStyle(PreviewLine line)
    {
        if (line.Style is LayoutTextStyle.Left or LayoutTextStyle.LeftBold && line.IndentChars > 0)
        {
            return $"padding-left:{line.IndentChars:0.##}ch";
        }

        return string.Empty;
    }

    private static string KindClass(string kind) => kind switch
    {
        "Act" or "Sequence" or "Beat" => "k-act",
        "Scene" => "k-scene",
        "Synopsis" => "k-synopsis",
        "Note" => "k-note",
        _ => "k-act"
    };

    private static string FormatTimestamp(DateTime utc)
    {
        var local = utc.ToLocalTime();
        return local.Date == DateTime.Now.Date ? local.ToString("HH:mm") : local.ToString("d MMM");
    }

    private RenderFragment<OutlineNode> RenderOutlineNode => node => __builder =>
    {
        <div class="outline-node">
            <div class="outline-label" @onclick="() => JumpToLineAsync(node.LineNumber)">
                <span class="outline-kind @KindClass(node.Kind)">@node.Kind</span>
                <span>@node.Label</span>
            </div>
            @if (node.Children.Count > 0)
            {
                <div class="outline-children">
                    @foreach (var child in node.Children)
                    {
                        @RenderOutlineNode(child)
                    }
                </div>
            }
        </div>
    };

    // Shared by scene cards and by the act/sequence headers, so an Act can be
    // renamed and deleted the same way a card can — it is a card on the desktop
    // board, just drawn as a lane here.
    private RenderFragment<BoardCard> RenderCardEditor => card => __builder =>
    {
        <div class="board-card editing" @onclick:stopPropagation="true">
            <select class="card-type" @bind="_editType">
                <option value="Act">Act</option>
                <option value="Sequence">Sequence</option>
                <option value="Section">Section</option>
                <option value="Scene">Scene</option>
                <option value="Note">Note</option>
            </select>
            <input class="card-heading-input" @bind="_editHeading" @bind:event="oninput"
                   @onkeydown="OnCardEditKeyDown" placeholder="Heading" />
            <textarea class="card-body-input" rows="2" @bind="_editDescription" @bind:event="oninput"
                      placeholder="Synopsis"></textarea>
            @if (_cardEditError.Length > 0)
            {
                <div class="modal-error">@_cardEditError</div>
            }
            <div class="card-edit-actions">
                <button class="btn" @onclick="() => RequestDeleteCard(card)">Delete</button>
                <button class="btn" @onclick="CancelCardEdit">Cancel</button>
                <button class="btn primary" @onclick="SaveCardAsync">Save</button>
            </div>
        </div>
    };

    private RenderFragment<BoardCard> RenderBoardCard => card => __builder =>
    {
        @if (_editingCardId == card.Id && card.Id != Guid.Empty)
        {
            @RenderCardEditor(card)
        }
        else
        {
            <div class="board-card @(_dragOverCardId == card.Id ? "drop-target" : null)"
                 draggable="@((card.Id != Guid.Empty).ToString().ToLowerInvariant())"
                 @ondragstart="() => OnCardDragStart(card)"
                 @ondragend="OnCardDragEnd"
                 @ondragover="() => OnCardDragOver(card)"
                 @ondragover:preventDefault="true"
                 @ondrop="() => OnCardDropAsync(card)"
                 @ondrop:preventDefault="true"
                 @onclick="() => JumpToLineAsync(card.LineNumber)" @onclick:stopPropagation="true">
                <div class="card-top">
                    <span class="card-kind">@card.Kind</span>
                    @if (card.Id != Guid.Empty)
                    {
                        <button class="icon-btn card-edit-btn" title="Edit card"
                                @onclick="() => StartCardEdit(card)" @onclick:stopPropagation="true">✎</button>
                    }
                </div>
                <div class="card-heading">@card.Heading</div>
                @if (card.Description.Length > 0)
                {
                    <div class="card-body">@card.Description</div>
                }
                @foreach (var child in card.Children)
                {
                    @RenderBoardCard(child)
                }
            </div>
        }
    };

    // ---- Goals ----

    private GoalSettings _goals = new();
    private int _sessionWordBaseline;
    private int _sessionPageBaseline;
    private TimerGoalState _timerState = TimerGoalState.Idle;
    private TimeSpan _timerAccumulated = TimeSpan.Zero;
    private DateTime? _timerRunningSince;
    private System.Timers.Timer? _timerTick;

    private bool IsTimerSession => _goals.SessionType == GoalType.Timer;
    private TimeSpan TimerTarget => TimeSpan.FromMinutes(Math.Max(1, _goals.SessionTimerMinutes));

    private TimeSpan TimerElapsed
    {
        get
        {
            var elapsed = _timerAccumulated;
            if (_timerRunningSince is { } since)
            {
                elapsed += DateTime.UtcNow - since;
            }

            return elapsed > TimerTarget ? TimerTarget : elapsed;
        }
    }

    private TimeSpan TimerRemaining => TimerTarget - TimerElapsed;

    private string SessionGoalTypeString
    {
        get => _goals.SessionType.ToString();
        set
        {
            if (Enum.TryParse<GoalType>(value, out var parsed) && parsed != _goals.SessionType)
            {
                _goals.SessionType = parsed;
                GoalStore.Save(_goals);
            }
        }
    }

    private string DocumentGoalTypeString
    {
        get => _goals.DocumentType.ToString();
        set
        {
            if (Enum.TryParse<GoalType>(value, out var parsed) && parsed != _goals.DocumentType
                && parsed != GoalType.Timer)
            {
                _goals.DocumentType = parsed;
                GoalStore.Save(_goals);
            }
        }
    }

    private int SessionTargetValue
    {
        get => _goals.SessionType switch
        {
            GoalType.PageCount => _goals.SessionPageTarget,
            GoalType.Timer => _goals.SessionTimerMinutes,
            _ => _goals.SessionWordTarget
        };
        set
        {
            var clamped = Math.Clamp(value, 1, 1_000_000);
            switch (_goals.SessionType)
            {
                case GoalType.PageCount:
                    _goals.SessionPageTarget = clamped;
                    break;
                case GoalType.Timer:
                    if (_goals.SessionTimerMinutes != clamped)
                    {
                        _goals.SessionTimerMinutes = clamped;
                        ResetTimer();
                    }
                    break;
                default:
                    _goals.SessionWordTarget = clamped;
                    break;
            }

            GoalStore.Save(_goals);
        }
    }

    private int DocumentTargetValue
    {
        get => _goals.DocumentType == GoalType.PageCount ? _goals.DocumentPageTarget : _goals.DocumentWordTarget;
        set
        {
            var clamped = Math.Clamp(value, 1, 1_000_000);
            if (_goals.DocumentType == GoalType.PageCount)
            {
                _goals.DocumentPageTarget = clamped;
            }
            else
            {
                _goals.DocumentWordTarget = clamped;
            }

            GoalStore.Save(_goals);
        }
    }

    private int SessionCurrent => _goals.SessionType switch
    {
        GoalType.PageCount => Math.Max(0, _analysis.PageCount - _sessionPageBaseline),
        GoalType.Timer => (int)TimerElapsed.TotalSeconds,
        _ => Math.Max(0, _analysis.WordCount - _sessionWordBaseline)
    };

    private int SessionTarget => _goals.SessionType == GoalType.Timer
        ? (int)TimerTarget.TotalSeconds
        : SessionTargetValue;

    private double SessionPercent => SessionTarget <= 0 ? 0 : Math.Min(100.0, SessionCurrent * 100.0 / SessionTarget);
    private bool SessionComplete => IsTimerSession ? _timerState == TimerGoalState.Completed : SessionCurrent >= SessionTarget;

    private int DocumentCurrent => _goals.DocumentType == GoalType.PageCount ? _analysis.PageCount : _analysis.WordCount;
    private double DocumentPercent => DocumentTargetValue <= 0 ? 0 : Math.Min(100.0, DocumentCurrent * 100.0 / DocumentTargetValue);
    private bool DocumentComplete => DocumentCurrent >= DocumentTargetValue;

    private string SessionCurrentDisplay => _goals.SessionType switch
    {
        GoalType.PageCount => FormatUnit(SessionCurrent, "page"),
        GoalType.Timer => FormatClock(TimerElapsed),
        _ => FormatUnit(SessionCurrent, "word")
    };

    private string SessionTargetDisplay => _goals.SessionType switch
    {
        GoalType.PageCount => FormatUnit(SessionTargetValue, "page"),
        GoalType.Timer => FormatClock(TimerTarget),
        _ => FormatUnit(SessionTargetValue, "word")
    };

    private string DocumentCurrentDisplay => FormatUnit(DocumentCurrent, _goals.DocumentType == GoalType.PageCount ? "page" : "word");
    private string DocumentTargetDisplay => FormatUnit(DocumentTargetValue, _goals.DocumentType == GoalType.PageCount ? "page" : "word");

    private static string FormatUnit(int value, string unit) => $"{value:N0} {unit}{(value == 1 ? "" : "s")}";

    private static string FormatClock(TimeSpan span)
    {
        if (span < TimeSpan.Zero) span = TimeSpan.Zero;
        return span.TotalHours >= 1
            ? $"{(int)span.TotalHours}:{span.Minutes:00}:{span.Seconds:00}"
            : $"{span.Minutes:00}:{span.Seconds:00}";
    }

    // Circumference of the r=48 progress ring; the dash pair draws pct of it.
    private static string RingDash(double percent)
    {
        const double circumference = 2 * Math.PI * 48;
        var filled = Math.Clamp(percent, 0, 100) / 100.0 * circumference;
        return $"{filled.ToString("0.#", System.Globalization.CultureInfo.InvariantCulture)} {circumference.ToString("0.#", System.Globalization.CultureInfo.InvariantCulture)}";
    }

    private void CaptureSessionBaseline()
    {
        _sessionWordBaseline = _analysis.WordCount;
        _sessionPageBaseline = _analysis.PageCount;
    }

    private void ResetSession()
    {
        CaptureSessionBaseline();
        ResetTimer();
        _statusMessage = "Session goal reset";
    }

    private void StartTimer()
    {
        if (_timerState is TimerGoalState.Completed or TimerGoalState.Running)
        {
            return;
        }

        _timerRunningSince = DateTime.UtcNow;
        _timerState = TimerGoalState.Running;
        EnsureTimerTick();
    }

    private void PauseTimer()
    {
        if (_timerState != TimerGoalState.Running)
        {
            return;
        }

        _timerAccumulated = TimerElapsed;
        _timerRunningSince = null;
        _timerState = _timerAccumulated >= TimerTarget ? TimerGoalState.Completed : TimerGoalState.Paused;
        _timerTick?.Stop();
    }

    private void ResetTimer()
    {
        _timerAccumulated = TimeSpan.Zero;
        _timerRunningSince = null;
        _timerState = TimerGoalState.Idle;
        _timerTick?.Stop();
    }

    private void EnsureTimerTick()
    {
        if (_timerTick is null)
        {
            _timerTick = new System.Timers.Timer(500);
            _timerTick.Elapsed += (_, _) => _ = InvokeAsync(OnTimerTick);
        }

        _timerTick.Start();
    }

    private void OnTimerTick()
    {
        if (_timerState == TimerGoalState.Running && TimerElapsed >= TimerTarget)
        {
            _timerAccumulated = TimerTarget;
            _timerRunningSince = null;
            _timerState = TimerGoalState.Completed;
            _timerTick?.Stop();
            _statusMessage = "Session timer complete";
        }

        StateHasChanged();
    }

    public void Dispose()
    {
        _autosaveCts?.Cancel();
        _timerTick?.Stop();
        _timerTick?.Dispose();
        _selfRef?.Dispose();
    }
}
