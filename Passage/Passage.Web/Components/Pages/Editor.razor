    }

    private void SaveIdeation()
    {
        if (_ideation is null)
        {
            return;
        }

        if (_ideationLoadError is not null)
        {
            _statusMessage = "Not saving ideation data — " + _ideationLoadError;
            return;
        }

        try
        {
            Slate.SaveIdeation(_ideation);
        }
        catch (Exception exception) when (exception is IOException or UnauthorizedAccessException)
        {
            _statusMessage = $"Could not save ideation data: {exception.Message}";
        }
    }

    private void RollLane() => StartSitting(Random.Shared.Next(1, Lanes.Length + 1));

    private void StartSitting(int lane)
    {
        if (_ideation is null)
        {
            return;
        }

        _ideation.Current = new IdeationSitting { Lane = lane };
        DealRound(_ideation.Current.Rounds[0]);
    }

    // The seed is forced on you, not chosen — the worksheet's "pick blind".
    // A writer with something of their own types over it.
    private void DealRound(IdeationRound round)
    {
        if (_ideation?.Current is null)
        {
            return;
        }

        round.Input = IdeationDealer.Deal(_ideation.Current.Lane);
        SaveIdeation();
    }

    private async Task StartRoundAsync(string roundId)
    {
        if (_ideation is null)
        {
            return;
        }

        var seconds = Math.Clamp(_ideation.RoundSeconds, 10, 600);
        try
        {
            _burstRunning = await JS.InvokeAsync<bool>("passage.startBurst", roundId, BurstReadInSeconds, seconds);
        }
        catch (JSException)
        {
            _burstRunning = false;
        }
    }

    private void AddIdeationRound()
    {
        if (_ideation?.Current is null)
        {
            return;
        }

        var round = new IdeationRound();
        _ideation.Current.Rounds.Add(round);
        DealRound(round);
    }

    private void KeepFromRound(IdeationRound round)
    {
        if (_ideation?.Current is null)
        {
            return;
        }

        _ideation.Current.KeptLine = round.Output.Trim();
        SaveIdeation();
    }

    // The sitting ends: the kept line is filed, the rounds are not. Don't
    // review — the worksheet says skim later, not in the same sitting.
    private async Task FinishSittingAsync()
    {
        if (_ideation?.Current is null)
        {
            return;
        }

        await StopBurstAsync();
        var kept = _ideation.Current.KeptLine.Trim();
        if (kept.Length > 0)
        {
            _ideation.Kept.Add(kept);
        }

        _ideation.Current = null;
        SaveIdeation();
    }

    private void DropKeptLine(string line)
    {
        _ideation?.Kept.Remove(line);
        SaveIdeation();
    }

    // Scripts can be deleted from the volume outside the app. A sidecar left
    // behind is dropped on load and said so, the same way stale recent-files
    // entries are — never silently. Runs on the first interactive render, not
    // in OnInitialized: prerendering runs that twice, and the second pass
    // would find nothing to prune and lose the message.
    private void PruneSlateOrphans()
    {
        IReadOnlyList<string> pruned;
        try
        {
            pruned = Slate.PruneOrphans(_files.Select(file => file.Name));
        }
        catch (Exception exception) when (exception is IOException or UnauthorizedAccessException)
        {
            _statusMessage = $"Could not check Slate data: {exception.Message}";
            return;
        }

        if (pruned.Count > 0)
        {
            _statusMessage = $"Removed Slate data for missing script{(pruned.Count == 1 ? "" : "s")}: {string.Join(", ", pruned)}";
        }
    }

    // ---- The assist seam (Phase 7) ----
    //
    // One ask at a time, keyed by the field it was for, so lines offered
    // for one bracket or round never show under another. The partner only
    // ever offers; a tap on a line puts it in the first empty target, and
    // the writer can take none. With the null partner none of this renders.

    private string _partnerKey = string.Empty;
    private List<string> _partnerLines = new();
    private CancellationTokenSource? _partnerCts;

    private string FillPartnerKey => $"fill:{_fillBracket?.Text}";
    private const string SplitPartnerKey = "split";
    private string BridgePartnerKey => $"bridge:{_bridge?.Rounds.Count}";
    private string ChainPartnerKey => $"chain:{(_chain is null ? -1 : _slate.Chains.IndexOf(_chain))}";
    private string ExtendPartnerKey => $"extend:{_slate.Extend.Links.Count}";

    private IReadOnlyList<string> PartnerLinesFor(string key) => _partnerKey == key ? _partnerLines : Array.Empty<string>();

    private SuggestionRequest? BuildPartnerRequest(string key)
    {
        if (key == FillPartnerKey && _fillRun is not null && _fillBracket is not null)
        {
            var lines = _content.Split('\n');
            var scriptLine = _fillBracket.LineIndex < lines.Length ? lines[_fillBracket.LineIndex] : string.Empty;
            return Suggestions.ForFill(_fillRun, scriptLine);
        }
        if (key == SplitPartnerKey) return Suggestions.ForSplitMidpoint(_slate.Split);
        if (key == BridgePartnerKey && _bridge is not null) return Suggestions.ForBridgeRound(_bridge);
        if (key == ChainPartnerKey && _chain is not null) return Suggestions.ForChain(_chain, FlawQuestions);
        if (key == ExtendPartnerKey) return Suggestions.ForExtendLink(_slate.Extend);
        return null;
    }

    private async Task AskPartnerAsync(string key)
    {
        var request = BuildPartnerRequest(key);
        if (request is null)
        {
            _statusMessage = "Nothing left to ask for here — every answer is written";
            return;
        }

        _partnerCts?.Cancel();
        _partnerCts = new CancellationTokenSource();
        var token = _partnerCts.Token;
        _partnerKey = key;
        _partnerLines = new List<string>();
        _statusMessage = "Asking…";
        try
        {
            var offered = await Partner.SuggestAsync(request, token);
            if (token.IsCancellationRequested) return;
            _partnerLines = offered.Where(line => !string.IsNullOrWhiteSpace(line)).Select(line => line.Trim()).Take(Suggestions.Count).ToList();
            _statusMessage = _partnerLines.Count == 0 ? "Nothing came back" : "Offered — tap one to use it, or none";
        }
        catch (OperationCanceledException)
        {
        }
        catch (Exception ex)
        {
            _partnerLines = new List<string>();
            _statusMessage = $"The partner didn't answer: {ex.Message}";
        }
    }

    private void UsePartnerLine(string line)
    {
        var key = _partnerKey;
        // A chain or extend ask is for one answer; the other lines were for
        // the same answer and go with it. The three-candidate fields keep theirs.
        var oneAnswer = key == ChainPartnerKey || key == ExtendPartnerKey;
        if (!PlacePartnerLine(key, line))
        {
            _statusMessage = "Every answer here is written — clear one to use this";
            return;
        }

        if (oneAnswer) _partnerLines.Clear();
        else _partnerLines.Remove(line);
        SaveSlate();
    }

    // Writes the line into the first empty target of the field the ask was
    // for. False when there is none — the writer filled them in the meantime.
    private bool PlacePartnerLine(string key, string line)
    {
        if (key == FillPartnerKey && _fillRun is not null)
        {
            var option = _fillRun.Options.FirstOrDefault(option => string.IsNullOrWhiteSpace(option.Text));
            if (option is null) return false;
            option.Text = line;
            return true;
        }
        if (key == SplitPartnerKey) return PlaceInFirstEmpty(_slate.Split.Candidates, line);
        if (key == BridgePartnerKey && _bridge is not null) return PlaceInFirstEmpty(_bridge.Rounds[^1].Candidates, line);
        if (key == ChainPartnerKey && _chain is not null)
        {
            if (_chain.Path != ChainPath.Woac) return PlaceInFirstEmpty(_chain.Answers, line);
            var round = _chain.Rounds[^1];
            if (_chain.Rounds.Count == 1 && string.IsNullOrWhiteSpace(round.Want)) round.Want = line;
            else if (string.IsNullOrWhiteSpace(round.Obstacle)) round.Obstacle = line;
            else if (string.IsNullOrWhiteSpace(round.Action)) round.Action = line;
            else if (string.IsNullOrWhiteSpace(round.Consequence))
            {
                round.Consequence = line;
                ConsequenceChanged(round);
            }
            else return false;
            return true;
        }
        if (key == ExtendPartnerKey)
        {
            var link = _slate.Extend.Links[^1];
            if (!string.IsNullOrWhiteSpace(link.Text)) return false;
            link.Text = line;
            LinkChanged(link);
            return true;
        }
        return false;
    }

    private static bool PlaceInFirstEmpty(List<string> targets, string line)
    {
        var index = targets.FindIndex(string.IsNullOrWhiteSpace);
        if (index < 0) return false;
        targets[index] = line;
        return true;
    }

    // ---- Go to Line ----

    private bool _goToLineOpen;
    private string _goToLineValue = string.Empty;
    private string _goToLineError = string.Empty;
    private ElementReference _goToLineInput;
    private bool _focusGoToLine;

    [JSInvokable]
    public void OnGoToLineShortcut()
    {
        OpenGoToLine();
        StateHasChanged();
    }

    private void OpenGoToLine()
    {
        _goToLineValue = string.Empty;
        _goToLineError = string.Empty;
        _goToLineOpen = true;
        // Avalonia focuses the dialog's first control for free; the browser
        // does not focus a node that was only just inserted, so ask for it.
        _focusGoToLine = true;
    }

    private void CloseGoToLine()
    {
        _goToLineOpen = false;
        _goToLineError = string.Empty;
    }

    private async Task ConfirmGoToLineAsync()
    {
        if (!int.TryParse(_goToLineValue.Trim(), out var lineNumber) || lineNumber < 1)
        {
            // The Avalonia dialog just refuses to close on bad input, which
            // leaves the user guessing. Say what is wrong instead (rule 12).
            _goToLineError = "Enter a line number of 1 or more.";
            return;
        }

        _goToLineOpen = false;
        _goToLineError = string.Empty;
        // scrollToLine clamps past the end of the document, matching the
        // Linux NavigateToLine.
        await JumpToLineAsync(lineNumber);
    }

    // Awaited, not fire-and-forget: Blazor renders when the handler completes,
    // so a detached task would set the validation error after the only render
    // it could have appeared in.
    private async Task OnGoToLineKeyDown(KeyboardEventArgs args)
    {
        if (args.Key == "Enter")
        {
            await ConfirmGoToLineAsync();
        }
        else if (args.Key == "Escape")
        {
            CloseGoToLine();
        }
    }

    // CodeMirror owns the undo stack; these just drive it and hand focus back.
    private async Task UndoAsync() => await JS.InvokeVoidAsync("passage.undo");

    private async Task RedoAsync() => await JS.InvokeVoidAsync("passage.redo");

    private async Task AdjustPreviewZoom(double delta)
    {
        _previewZoom = Math.Clamp(_previewZoom + delta, MinPreviewZoom, MaxPreviewZoom);
        await PersistSessionAsync();
    }

    private async Task AdjustEditorFont(int delta)
    {
        _editorFontPx = Math.Clamp(_editorFontPx + delta, MinEditorFontPx, MaxEditorFontPx);
        await PersistSessionAsync();
    }

    private static string StyleClass(LayoutTextStyle style) => style switch
    {
        LayoutTextStyle.LeftBold => "st-bold",
        LayoutTextStyle.CenterWithinBody => "st-center",
        LayoutTextStyle.CenterWithinBodyBold => "st-center st-bold",
        LayoutTextStyle.RightWithinBody => "st-right",
        _ => string.Empty
    };

    private static string IndentStyle(PreviewLine line)
    {
        if (line.Style is LayoutTextStyle.Left or LayoutTextStyle.LeftBold && line.IndentChars > 0)
        {
            return $"padding-left:{line.IndentChars:0.##}ch";
        }

        return string.Empty;
    }

    private static string KindClass(string kind) => kind switch
    {
        "Act" or "Sequence" or "Beat" => "k-act",
        "Scene" => "k-scene",
        "Synopsis" => "k-synopsis",
        "Note" => "k-note",
        "Marker" => "k-marker",
        _ => "k-act"
    };

    private static string FormatTimestamp(DateTime utc)
    {
        var local = utc.ToLocalTime();
        return local.Date == DateTime.Now.Date ? local.ToString("HH:mm") : local.ToString("d MMM");
    }

    // A beat on the grid (Row set) or in the tray (Row null). Placement is
    // CSS grid lines, so the browser can move and resize it without a round
    // trip; only the result is sent back (trap 4).
    private RenderFragment<(Beat Beat, int? Row)> RenderBeat => item => __builder =>
    {
        var beat = item.Beat;
        <div class="beat-card @(_editingBeat == beat ? "selected" : null) @DimBeat(beat)"
             data-beat-id="@beat.Id" data-page="@beat.Page" data-span="@beat.Span"
             data-item-kind="beat" data-item-id="@beat.Id"
             style="@BeatStyle(beat, item.Row)"
             @ondblclick:stopPropagation="true">
            @RenderTagBars(beat.Id)
            <div class="beat-title">
                <button class="icon-btn key-star @(StoryItems.IsKey(_slate.Story, beat.Id) ? "on" : null)" title="Key beat"
                        @onclick="() => ToggleBeatKey(beat)" @onclick:stopPropagation="true" @ondblclick:stopPropagation="true">@(StoryItems.IsKey(_slate.Story, beat.Id) ? "★" : "☆")</button>
                @(beat.Title.Length > 0 ? beat.Title : "Untitled beat")
            </div>
            @RenderTagMarks(beat.Id)
            @if (beat.Description.Length > 0)
            {
                <div class="beat-body">@beat.Description</div>
            }
            @if (item.Row is not null)
