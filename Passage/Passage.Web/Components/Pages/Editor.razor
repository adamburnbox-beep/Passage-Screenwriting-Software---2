    {
        <div class="board-card editing beat-editor">
            <div class="card-kind">@(beat.Page > 0 ? (beat.Span > 1 ? $"Pages {beat.Page}–{beat.Page + beat.Span - 1}" : $"Page {beat.Page}") : "Unassigned")</div>
