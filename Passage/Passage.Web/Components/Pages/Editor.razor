    // "Open from this device…": the browser uploads the file and it is copied
    // into the library under its own name, then opened like any other script.
    // The library is the web app's disk, so this is what "open" means here;
    // nothing is written until the unsaved-changes guard has been passed.
    // A .highland file lands as the .fountain (or .md) text it carries; the
    // status line names every entry in the bundle that was left behind.
    private const long MaxImportBytes = 5 * 1024 * 1024;
    private static readonly string[] ImportExtensions = [".fountain", ".md", ".txt", HighlandBundle.Extension];

    private int _importKey;
    private (string OriginalName, string Content, string Note) _pendingImport;

    private async Task ImportFileAsync(InputFileChangeEventArgs args)
    {
        var file = args.File;
        // A fresh InputFile each time, so re-choosing the same file fires again.
        _importKey++;

        if (!ImportExtensions.Contains(Path.GetExtension(file.Name), StringComparer.OrdinalIgnoreCase))
        {
            _statusMessage = $"Could not open {file.Name}: only .fountain, .md, .txt and .highland files can be opened.";
            return;
        }

        var isHighland = Path.GetExtension(file.Name).Equals(HighlandBundle.Extension, StringComparison.OrdinalIgnoreCase);
        var scriptName = isHighland ? Path.GetFileNameWithoutExtension(file.Name) + ".fountain" : file.Name;
        if (!ScriptLibrary.TryValidateName(scriptName, out _))
        {
            _statusMessage = $"Could not open {file.Name}: not a usable script name.";
            return;
        }

        if (file.Size > MaxImportBytes)
        {
            _statusMessage = $"Could not open {file.Name}: larger than {MaxImportBytes / (1024 * 1024)} MB.";
            return;
        }

        string content;
        var note = string.Empty;
        try
        {
            using var stream = file.OpenReadStream(MaxImportBytes);
            if (isHighland)
            {
                // ZipArchive needs a seekable stream; the browser upload is not one.
                using var buffer = new MemoryStream();
                await stream.CopyToAsync(buffer);
                buffer.Position = 0;
                var bundle = HighlandBundle.Read(buffer);
                content = bundle.Text;
                if (bundle.IsMarkdown)
                {
                    scriptName = Path.ChangeExtension(scriptName, ".md");
                }

                note = bundle.Skipped.Count == 0
                    ? $" (from {file.Name})"
                    : $" (from {file.Name}; skipped {bundle.Skipped.Count} bundle entries Passage does not read: {string.Join(", ", bundle.Skipped)})";
            }
            else
            {
                using var reader = new StreamReader(stream, Encoding.UTF8);
                content = await reader.ReadToEndAsync();
            }
        }
        catch (Exception exception) when (exception is IOException or OperationCanceledException or InvalidDataException)
        {
            _statusMessage = $"Could not read {file.Name}: {exception.Message}";
            return;
        }

        if (_isDirty)
        {
            _pendingAction = PendingAction.ImportFile;
            _pendingImport = (scriptName, content, note);
            return;
        }

        await FinishImportAsync(scriptName, content, note);
    }

    private async Task FinishImportAsync(string originalName, string content, string note)
    {
        ScriptLibrary.TryValidateName(originalName, out var name);
        name = UniqueLibraryName(name);

        try
        {
            Library.Save(name, content);
        }
        catch (Exception exception) when (exception is IOException or ArgumentException or UnauthorizedAccessException)
        {
            _statusMessage = $"Could not open {originalName}: {exception.Message}";
            return;
        }

        _files = Library.List();
        await OpenFileAsync(name);
        _statusMessage = (name == originalName
            ? $"Opened {name}"
            : $"Opened {originalName} as {name} — a script with that name was already in the library") + note;
    }

    // Never overwrite a script that is already in the library: "draft.fountain"
    // lands as "draft-2.fountain" when the name is taken.
    private string UniqueLibraryName(string name)
    {
        if (!Library.Exists(name))
        {
            return name;
        }

        var stem = Path.GetFileNameWithoutExtension(name);
        var extension = Path.GetExtension(name);
        for (var i = 2; ; i++)
        {
            var candidate = $"{stem}-{i}{extension}";
            if (!Library.Exists(candidate))
            {
                return candidate;
            }
        }
    }

    private async Task ConfirmPendingActionAsync()
    {
        var action = _pendingAction;
        var openName = _pendingOpenName;
        var import = _pendingImport;
        CancelPendingAction();

        if (action == PendingAction.NewFile)
        {
            await StartNewFileAsync();
        }
        else if (action == PendingAction.OpenFile)
        {
            await OpenFileAsync(openName);
        }
        else if (action == PendingAction.ImportFile)
        {
            await FinishImportAsync(import.OriginalName, import.Content, import.Note);
        }
    }

    private async Task StartNewFileAsync()
    {
        _fileName = string.Empty;
        _content = string.Empty;
        _isDirty = false;
        _statusMessage = "New script";
        LoadSlate();
        await ResetEditorAsync();
        CaptureSessionBaseline();
        await PersistSessionAsync();
    }

    private async Task OpenFileAsync(string name)
    {
        try
        {
            _content = Library.Load(name);
        }
        catch (Exception exception) when (exception is IOException or ArgumentException or UnauthorizedAccessException)
        {
            _statusMessage = $"Could not open {name}: {exception.Message}";
            return;
        }

        _fileName = name;
        _isDirty = false;
        _statusMessage = $"Opened {name}";
        LoadSlate();
        AddRecentFile(name);
        await ResetEditorAsync();
        CaptureSessionBaseline();
        await PersistSessionAsync();
    }

    private async Task ResetEditorAsync()
    {
        _mainViewIndex = 0;
        _caretLine = 1;
        RunAnalysis();
        UpdateCaretElementLabel();
        var version = await JS.InvokeAsync<int>("passage.setContent", _content);
        await JS.InvokeVoidAsync("passage.applyHighlights", version, _analysis.LineClasses);
        await SyncPageRulesAsync();
        await PushSuggestionsAsync();
        await PushJumpTargetsAsync();
        await PushCharacterHighlightsAsync();
        StateHasChanged();
    }

    // Page rules are for screenplays only, matching ApplyEditorWriteMode. The
    // web derives its mode from the file extension, so this follows the name.
    // Pushed once per parse, not per keystroke — the client does the matching.
    private async Task PushSuggestionsAsync()
    {
        try
        {
            await JS.InvokeVoidAsync(
                "passage.setSuggestions",
                _analysis.SceneHeadingSuggestions,
                _analysis.CharacterSuggestions,
                _analysis.SuggestionKinds);
        }
        catch (JSException)
        {
        }
    }

    // The Jump to palette (Ctrl+J, H4.2) filters in passage.js, so the outline's
    // scenes, sections and named markers go to the client once per parse.
    private async Task PushJumpTargetsAsync()
    {
        var targets = new List<object>();
        void Collect(IEnumerable<OutlineNode> nodes)
        {
            foreach (var node in nodes)
            {
                if (node.Kind is not ("Synopsis" or "Note"))
                {
                    targets.Add(new { label = node.Label, kind = node.Kind, line = node.LineNumber });
                }
                Collect(node.Children);
            }
        }
        Collect(_analysis.Outline);

        try
        {
            await JS.InvokeVoidAsync("passage.setJumpTargets", targets);
        }
        catch (JSException)
        {
        }
    }

    [JSInvokable]
    public async Task OnJumpTarget(int lineNumber)
    {
        await JumpToLineAsync(lineNumber);
        StateHasChanged();
    }

    private async Task SyncPageRulesAsync()
    {
        try
