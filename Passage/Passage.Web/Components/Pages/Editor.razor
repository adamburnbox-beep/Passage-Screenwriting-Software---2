    private StoryFilter _boardFilter = new();
    private StoryFilter _beatFilter = new();
    private StoryFilter ActiveFilter => _mainViewIndex == 2 ? _beatFilter : _boardFilter;

    private async Task SetStoryFilterAsync(StoryFilter filter)
    {
        var view = _mainViewIndex == 2 ? "beats" : "board";
        if (view == "beats") _beatFilter = filter; else _boardFilter = filter;
        try
        {
            await JS.InvokeVoidAsync("passage.setStoryFilter", view, filter);
        }
        catch (JSException)
        {
        }
    }

    private object? _filterFor;
    private Dictionary<int, HashSet<string>> _filterSpeakers = new();
    private Dictionary<int, SceneHeadingElement> _filterScenes = new();

    private void EnsureFilterCaches()
    {
        if (ReferenceEquals(_filterFor, _analysis)) return;
        _filterFor = _analysis;
        _filterSpeakers = StoryFilter.SceneSpeakers(_analysis.Elements);
        _filterScenes = _analysis.Elements.OfType<SceneHeadingElement>().ToDictionary(scene => scene.LineNumber);
    }

    // A scene matches a character by explicit tag or by speaking in it, and a
    // location by its own heading or an explicit tag (decision C).
    private bool ItemMatches(StoryFilter filter, Guid id, string? sceneHeading, int line)
    {
        EnsureFilterCaches();
        var tags = TagsOf(id);
        var characters = new HashSet<string>(tags?.Characters ?? new List<string>());
        var locations = new HashSet<string>(tags?.Locations ?? new List<string>());
        if (sceneHeading is not null)
        {
            if (_filterSpeakers.TryGetValue(line, out var speakers)) characters.UnionWith(speakers);
            var own = Passage.Web.Services.Locations.Normalise(sceneHeading);
            if (own.Length > 0) locations.Add(own);
        }

        return filter.Matches(tags?.Key == true, tags?.Storylines ?? new List<Guid>(), characters, locations);
    }

    private bool CardMatches(StoryFilter filter, BoardCard card) =>
        ItemMatches(filter, IsStampedCard(card) ? card.Id : Guid.Empty, card.Kind == "Scene" ? card.Heading : null, card.LineNumber);

    private bool GroupMatches(StoryFilter filter, BoardGroup group) =>
        StoryFilter.LaneMatches(group.SequenceCard is { } sequence && CardMatches(filter, sequence), group.Cards.Select(card => CardMatches(filter, card)));

    private string? DimClass(BoardCard? card) =>
        ActiveFilter.IsActive && (card is null || !CardMatches(ActiveFilter, card)) ? "dimmed" : null;

    private string? DimGroup(BoardGroup group) =>
        _boardFilter.IsActive && !GroupMatches(_boardFilter, group) ? "dimmed" : null;

    private string? DimLane(BoardLane lane) =>
        _boardFilter.IsActive && !StoryFilter.LaneMatches(lane.ActCard is { } act && CardMatches(_boardFilter, act), lane.Groups.Select(group => GroupMatches(_boardFilter, group))) ? "dimmed" : null;

    private string? DimBeat(Beat beat) =>
        _beatFilter.IsActive && !ItemMatches(_beatFilter, beat.Id, null, 0) ? "dimmed" : null;

    private string? DimScene(ScenePlacement scene)
    {
        if (!_beatFilter.IsActive) return null;
        EnsureFilterCaches();
        if (!_filterScenes.TryGetValue(scene.LineNumber, out var element)) return "dimmed";
        var id = element.Id != Guid.Empty && _analysis.DuplicateIdLines?.Contains(scene.LineNumber) != true ? element.Id : Guid.Empty;
        return ItemMatches(_beatFilter, id, scene.Heading, scene.LineNumber) ? null : "dimmed";
    }

    private RenderFragment RenderFilterBar => __builder =>
    {
