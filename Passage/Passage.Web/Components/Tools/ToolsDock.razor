@* The Writer's Tools dock's top level (docs/SLATE-REDO-PLAN.md §4.1): a grid
   of small cards under one chip row, and the runner once a run is open.
   Exercises in the catalog open in the runner; the Ideation burst is the one
   card that opens a full-screen overlay instead. No counts, ticks or dates
   anywhere (rule 0). *@
@using Passage.Web.Services.Tools
@inject IJSRuntime JS

@if (OpenRun is not null && OpenExercise is not null)
{
    <ExerciseRunner @key="OpenRun.Id" Host="Host" Exercise="OpenExercise" Run="OpenRun" OnClose="CloseRunAsync" />
}
else
{
    @if (_rightNow.Count > 0)
    {
        <div class="right-now" role="group" aria-label="Right now">
            <span class="tools-chips-label">Right now</span>
            @foreach (var suggestion in _rightNow)
            {
                <button class="right-now-item" @onclick="() => StartSuggestionAsync(suggestion)">
                    <span class="right-now-name">@suggestion.Title</span>
                    <span class="right-now-detail">@suggestion.Detail</span>
                </button>
            }
        </div>
    }
    <div class="tools-chips" role="group" aria-label="What have you got?">
        <span class="tools-chips-label">What have you got?</span>
        <button class="tools-chip @(_shelf is null ? "on" : null)" aria-pressed="@(_shelf is null)" @onclick="() => SetShelfAsync(null)">All</button>
        @foreach (var (shelf, label) in Shelves)
        {
            <button class="tools-chip @(_shelf == shelf ? "on" : null)" aria-pressed="@(_shelf == shelf)" @onclick="() => SetShelfAsync(shelf)">@label</button>
        }
    </div>
    <div class="tools-grid">
        @foreach (var card in VisibleCards)
        {
            <div class="tool-card">
                <button class="tool-card-open" @onclick="() => OpenCardAsync(card)">
                    <span class="tool-card-glyph" aria-hidden="true">@card.Glyph</span>
                    <span class="tool-card-name">@card.Name</span>
                    <span class="tool-card-line">@card.Tagline</span>
                </button>
                @foreach (var run in RunsFor(card))
                {
                    <div class="tool-card-run">
                        <button class="tool-card-run-open" title="Open — everything is as you left it" @onclick="() => ResumeRunAsync(run)">@RunLabel(run)</button>
                        <button class="icon-btn" title="Remove this one and its working-out" @onclick="() => RemoveRun(run)">×</button>
                    </div>
                }
            </div>
        }
    </div>
}

@code {
    private sealed record Card(string Id, string Name, string Tagline, Shelf Shelf, string Glyph);

    // The five "what have you got?" rows of the vault's 0 — Which Worksheet.
    private static readonly (Shelf Shelf, string Label)[] Shelves =
    {
        (Shelf.Nothing, "Nothing yet"),
        (Shelf.Ending, "An ending"),
        (Shelf.Moment, "A moment"),
        (Shelf.SceneGoing, "A scene going"),
        (Shelf.DeadScene, "A dead scene")
    };

    // The deck in launcher order: the catalog's exercises, and the Ideation burst overlay.
    private static readonly Card[] Cards =
    {
        new(IdeationId, "Ideation burst", "Loosen up with fast, throwaway lines", Shelf.Nothing, "⚡"),
        new(SlateMigration.BridgeId, "Bridge", "Connect two moments you know", Shelf.Nothing, "⇄"),
        new(SlateMigration.SplitId, "A→Z→Split", "Find the middle of the story", Shelf.Ending, "◇"),
        new(SlateMigration.BeliefId, "Belief Split", "Split on what a character believes", Shelf.Ending, "☺"),
        new(SlateMigration.ExtendId, "Extend Backward", "Work back from the ending", Shelf.Ending, "↶"),
        new(SlateMigration.PositionId, "Position", "Try a scene in each story slot", Shelf.Moment, "◎"),
        new(SlateMigration.FillId, "Fill", "Turn a [BRACKET] into the real event", Shelf.Moment, "[ ]"),
        new(SlateMigration.WoacId, "WOAC chain", "What happens next, round by round", Shelf.SceneGoing, "→"),
        new(SlateMigration.SceneDialsId, "Scene Dials", "The event is right; the scene is dead", Shelf.SceneGoing, "⚂"),
        new(SlateMigration.FlawId, "Flaw Brainstorm", "One flaw, eight questions", Shelf.SceneGoing, "☹"),
        new(SlateMigration.PushPullId, "Push/Pull", "Find why a scene is flat", Shelf.DeadScene, "⇅"),
        new(SlateMigration.UnderstudyId, "Understudy", "The furniture is the hero of its own movie", Shelf.SceneGoing, "🎭")
    };

    public const string IdeationId = "ideation";

    [Parameter, EditorRequired] public IToolHost Host { get; set; } = default!;
    [Parameter] public string? OpenRunId { get; set; }
    [Parameter] public EventCallback<string?> OpenRunIdChanged { get; set; }

    // The Ideation burst is not an exercise: the host opens its overlay.
    [Parameter] public EventCallback OnOpenIdeation { get; set; }

    private Shelf? _shelf;
    private IReadOnlyList<RightNowSuggestion> _rightNow = Array.Empty<RightNowSuggestion>();

    // Worked out when the launcher is drawn, from where the caret is now.
    protected override void OnParametersSet() => _rightNow = OpenRunId is null ? Host.RightNow() : Array.Empty<RightNowSuggestion>();

    private ExerciseRun? OpenRun => OpenRunId is null ? null : Host.Slate.Exercises.FirstOrDefault(run => run.Id == OpenRunId);

    private Exercise? OpenExercise => OpenRun is null ? null : ExerciseCatalog.Find(OpenRun.ExerciseId);

    private IEnumerable<Card> VisibleCards => Cards.Where(card => _shelf is null || card.Shelf == _shelf);

    private IEnumerable<ExerciseRun> RunsFor(Card card) =>
        Host.Slate.Exercises.Where(run => run.ExerciseId == card.Id && !run.IsEmpty);

    private static string RunLabel(ExerciseRun run)
    {
        // By what it is about; an unnamed run falls back to its first answer.
        var about = string.IsNullOrWhiteSpace(run.Anchor.Text)
            ? run.Answers.Values.FirstOrDefault(value => !string.IsNullOrWhiteSpace(value)) ?? string.Empty
            : run.Anchor.Text;
        var text = string.Join(' ', about.Split(new[] { '\n', '\r' }, StringSplitOptions.RemoveEmptyEntries)).Trim();
        if (text.Length == 0)
        {
            return "(not named yet)";
        }

        return text.Length <= 32 ? text : text[..31].TrimEnd() + "…";
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        try
        {
            var stored = await JS.InvokeAsync<string?>("passage.getToolsPref", "shelf");
            if (Enum.TryParse<Shelf>(stored, out var shelf) && Shelves.Any(s => s.Shelf == shelf))
            {
                _shelf = shelf;
                StateHasChanged();
            }
        }
        catch (JSException)
        {
        }
    }

    private async Task SetShelfAsync(Shelf? shelf)
    {
        _shelf = shelf;
        try
        {
            await JS.InvokeVoidAsync("passage.setToolsPref", "shelf", shelf?.ToString() ?? string.Empty);
        }
        catch (JSException)
        {
        }
    }

    private async Task OpenCardAsync(Card card)
    {
        if (ExerciseCatalog.Find(card.Id) is not { } exercise)
        {
            await OnOpenIdeation.InvokeAsync();
            return;
        }

        // One thing, not a menu (rule 0.5): a bracket exercise is handed a bracket, a scene
        // exercise starts on the scene the caret is in. Either can be changed in the strip.
        // One Shape per script: Split and Extend pick up the run already kept rather than start a second.
        if (KeptShapeRun(exercise.Id) is { } kept)
        {
            await OpenRunIdChanged.InvokeAsync(kept.Id);
            return;
        }

        var run = new ExerciseRun { ExerciseId = exercise.Id };
        if (exercise.Anchor == AnchorKind.Bracket && Host.HandBracket() is { } bracket)
        {
            await Host.OpenBracketAsync(bracket.Text);
            return;
        }

        if (exercise.Anchor == AnchorKind.Scene && Host.SceneUnderCaret is { } scene)
        {
            run.Anchor = new Anchor { Kind = AnchorKind.Scene, TargetId = scene.Id, Text = scene.Heading, SceneId = scene.Id, SceneText = scene.Heading };
        }

        Host.Slate.Exercises.Add(run);
        await OpenRunIdChanged.InvokeAsync(run.Id);
    }

    private Task StartSuggestionAsync(RightNowSuggestion suggestion)
    {
        // A bracket picks its kept run back up rather than starting a second one.
        if (suggestion.Anchor.Kind == AnchorKind.Bracket)
        {
            return Host.OpenBracketAsync(suggestion.Anchor.Text);
        }

        if (suggestion.Anchor.Kind == AnchorKind.Shape && KeptShapeRun(suggestion.ExerciseId) is { } kept)
        {
            return OpenRunIdChanged.InvokeAsync(kept.Id);
        }

        // So does an inbox beat: Position on it again resumes the run kept for it.
        if (suggestion.Anchor.Kind == AnchorKind.InboxBeat && Host.Slate.Exercises.LastOrDefault(entry => entry.ExerciseId == suggestion.ExerciseId
                && entry.Anchor.Kind == AnchorKind.InboxBeat && entry.Anchor.TargetId == suggestion.Anchor.TargetId) is { } keptBeat)
        {
            return OpenRunIdChanged.InvokeAsync(keptBeat.Id);
        }

        var run = new ExerciseRun { ExerciseId = suggestion.ExerciseId, Anchor = suggestion.Anchor };
        Host.Slate.Exercises.Add(run);
        return OpenRunIdChanged.InvokeAsync(run.Id);
    }

    // The Shape-anchored run already kept for this exercise, if it is about the script's Shape (not a scene).
    private ExerciseRun? KeptShapeRun(string exerciseId) =>
        ExerciseCatalog.Find(exerciseId)?.Anchor == AnchorKind.Shape
            ? Host.Slate.Exercises.LastOrDefault(run => run.ExerciseId == exerciseId && run.Anchor.SceneId is null && run.Anchor.SceneText.Length == 0)
            : null;

    private Task ResumeRunAsync(ExerciseRun run) => OpenRunIdChanged.InvokeAsync(run.Id);

    private Task CloseRunAsync() => OpenRunIdChanged.InvokeAsync(null);

    private void RemoveRun(ExerciseRun run)
    {
        Host.Slate.Exercises.Remove(run);
        Host.Save();
        Host.SetStatus("Removed it");
    }
}
