@* Renders one step by kind (docs/SLATE-REDO-PLAN.md §4.3). The question
   verbatim, one muted hint, the longer explanation folded behind "Why?". *@
@using Passage.Web.Services.Tools

@{
    var step = Slot.Step;
}
@if (step.Kind == StepKind.Stop)
{
    <div class="step-stop">
        <p class="step-question">@step.Text</p>
        <div class="step-actions">
            <button class="btn" @onclick="OnStopHere">Stop here</button>
            <button class="btn primary" @onclick="() => OnContinue.InvokeAsync(Slot)">Keep going</button>
        </div>
    </div>
}
else
{
    @if (Engine.EchoOf(Run, Slot) is { Length: > 0 } echo)
    {
        <div class="step-echo"><span class="step-echo-label">Right before</span> @echo</div>
    }
    <p class="step-question">@Engine.Question(Run, Slot)</p>
    @if (Engine.Hint(Run, Slot) is { Length: > 0 } hint)
    {
        <div class="step-hint">@hint</div>
    }
    @if (step.ScriptSlot is { } scriptSlot && Host.ScriptShapeValue(scriptSlot) is { } inScript)
    {
        <div class="fill-hint">In the script: @inScript</div>
    }
    @if (step.PlotTurn is { } plotTurn && ShapeAnswers.SplitTurn(Host.Slate, plotTurn) is { } matched)
    {
        <div class="fill-hint">Matched plot turn — @plotTurn: @matched</div>
    }
    @if (step.Why.Length > 0)
    {
        <details class="why" data-why>
            <summary>Why?</summary>
            <p>@step.Why</p>
        </details>
    }
    @switch (step.Kind)
    {
        case StepKind.Text:
            <textarea rows="@(step.Multiline ? 3 : 2)" data-slot data-step-input
                      data-slot-multiline="@(step.Multiline ? "" : null)" data-held="@(Held ? "" : null)"
                      aria-label="@step.Question"
                      value="@Engine.GetAnswer(Run, step.Key, Slot.Round)"
                      @onchange="args => SetAnswerAsync(args.Value?.ToString() ?? string.Empty)"></textarea>
            break;
        case StepKind.Pick:
            var options = Engine.PickOptions(Run, Slot);
            @if (options.Count > 0)
            {
                <div class="pick-options" role="group" aria-label="Options">
                    @foreach (var option in options)
                    {
                        var chosen = option;
                        var on = Engine.IsPicked(Run, Slot, chosen);
                        <button class="pick-option @(on ? "on" : null)" aria-pressed="@on" @onclick="() => PickAsync(chosen)">@chosen</button>
                    }
                </div>
            }
            <textarea rows="2" data-slot data-step-input data-held="@(Held ? "" : null)"
                      aria-label="@step.Question — or write it"
                      value="@Engine.GetAnswer(Run, step.Key, Slot.Round)"
                      @onchange="args => SetAnswerAsync(args.Value?.ToString() ?? string.Empty)"></textarea>
            break;
        case StepKind.YesNo:
            <AliveFlat Left="y" Right="n" Value="@Engine.GetAnswer(Run, step.Key, Slot.Round)" ValueChanged="SetAnswerAsync" />
            break;
        case StepKind.AliveFlat:
            @if (step.ReadForwardKey is not null && Engine.ReadForward(Run, Slot) is { Count: > 0 } chain)
            {
                <ol class="chain-forward">
                    @for (var i = 0; i < chain.Count; i++)
                    {
                        <li class="@(i == chain.Count - 1 ? "chain-z" : null)">@chain[i]</li>
                    }
                </ol>
            }
            <AliveFlat Value="@Engine.GetAnswer(Run, step.Key, Slot.Round)" ValueChanged="SetAnswerAsync" />
            break;
        case StepKind.Lines:
            @for (var i = 0; i < Engine.LineCount(Run, Slot); i++)
            {
                var index = i;
                <textarea rows="1" data-slot data-step-input data-held="@(Held ? "" : null)" aria-label="@step.Question"
                          value="@Engine.GetLine(Run, step.Key, Slot.Round, index)"
                          @onchange="args => SetLineAsync(index, args.Value?.ToString() ?? string.Empty)"></textarea>
            }
            @if (step.Open)
            {
                <button class="btn" @onclick="AnotherAsync">Another</button>
            }
            break;
        case StepKind.Slots:
            var items = Engine.SlotItems(Slot);
            @if (items.Count == 0)
            {
                <div class="step-hint">Nobody speaks in this scene yet — skip this one.</div>
            }
            @foreach (var item in items)
            {
                var name = item;
                <label class="slot-row">
                    <span class="slot-name">@name</span>
                    <textarea rows="1" data-slot data-step-input data-held="@(Held ? "" : null)" aria-label="@name — @step.Question"
                              value="@Engine.GetItem(Run, step.Key, Slot.Round, name)"
                              @onchange="args => SetItemAsync(name, args.Value?.ToString() ?? string.Empty)"></textarea>
                </label>
            }
            break;
        case StepKind.Dice:
            var rolled = Engine.GetAnswer(Run, step.Key, Slot.Round);
            @if (rolled.Length > 0)
            {
                var (dieName, dieDo) = SplitRow(rolled);
                <div class="dice-result" aria-live="polite">
                    <span class="die" aria-hidden="true">@Face(step, rolled)</span>
                    <div><strong>@dieName</strong>@if (dieDo.Length > 0){<span> — @dieDo</span>}</div>
                </div>
            }
            <button class="btn dice-roll" @onclick="RollAsync">@(rolled.Length == 0 ? "Roll" : "Roll again")</button>
            break;
        default:
            <div class="step-hint">This kind of question isn't in the runner yet.</div>
            break;
    }
    @if (step.AltQuestion is not null)
    {
        <label class="burst-toggle"><input type="checkbox" checked="@Engine.IsAlt(Run, Slot)" @onchange="AltToggledAsync" /> @step.AltLabel</label>
    }
    @if ((step.Kind is StepKind.Text or StepKind.Lines) && Exercise.Targets.Count > 0)
    {
        <SendToMenu Targets="Exercise.Targets" Character="@CharacterName" SynopsisLabel="@Host.SynopsisTargetLabel(SendAnchor)" OnSend="SendAsync" />
    }
}

@code {
    [Parameter, EditorRequired] public ExerciseEngine Engine { get; set; } = default!;
    [Parameter, EditorRequired] public ExerciseRun Run { get; set; } = default!;
    [Parameter, EditorRequired] public StepSlot Slot { get; set; }
    [Parameter, EditorRequired] public IToolHost Host { get; set; } = default!;
    [Parameter, EditorRequired] public Exercise Exercise { get; set; } = default!;
    // The card is being held open (reopened from the trail), so Enter ends the
    // hold instead of waiting for a change.
    [Parameter] public bool Held { get; set; }
    [Parameter] public EventCallback<StepSlot> OnChanged { get; set; }
    [Parameter] public EventCallback<StepSlot> OnContinue { get; set; }
    [Parameter] public EventCallback OnStopHere { get; set; }

    private Task SetAnswerAsync(string value)
    {
        if (!Engine.SetAnswer(Run, Slot.Step.Key, Slot.Round, value))
        {
            Host.SetStatus("That one is carried — change the answer it comes from");
            return Task.CompletedTask;
        }

        return OnChanged.InvokeAsync(Slot);
    }

    private Task PickAsync(string option)
    {
        Engine.Pick(Run, Slot, option);
        return OnChanged.InvokeAsync(Slot);
    }

    private Task AltToggledAsync(ChangeEventArgs args)
    {
        Engine.SetAlt(Run, Slot, args.Value is true);
        return OnChanged.InvokeAsync(Slot);
    }

    private Task SetLineAsync(int index, string value)
    {
        Engine.SetLine(Run, Slot.Step.Key, Slot.Round, index, value);
        return OnChanged.InvokeAsync(Slot);
    }

    private Task SetItemAsync(string item, string value)
    {
        Engine.SetItem(Run, Slot.Step.Key, Slot.Round, item, value);
        return OnChanged.InvokeAsync(Slot);
    }

    private Task RollAsync()
    {
        Engine.Roll(Run, Slot, Random.Shared);
        return OnChanged.InvokeAsync(Slot);
    }

    // A dice row reads "Name — what you do".
    private static (string Name, string Do) SplitRow(string row)
    {
        var at = row.IndexOf(" — ", StringComparison.Ordinal);
        return at < 0 ? (row, string.Empty) : (row[..at], row[(at + 3)..]);
    }

    private static string Face(Step step, string row)
    {
        var index = step.Table.ToList().IndexOf(row);
        return index is >= 0 and < 6 ? "⚀⚁⚂⚃⚄⚅"[index].ToString() : "🎲";
    }

    private Task AnotherAsync()
    {
        Engine.SetLine(Run, Slot.Step.Key, Slot.Round, Engine.LineCount(Run, Slot), string.Empty);
        return OnChanged.InvokeAsync(Slot);
    }

    // Whose note page or inbox tag an answer goes to: the run's character, or for a step about someone
    // else (the Cast card) whoever the step's WhoKey names in the same round.
    private Anchor SendAnchor => Slot.Step.WhoKey is { } who
        ? new Anchor { Kind = AnchorKind.Character, Text = Engine.GetAnswer(Run, who, Slot.Round).Trim() }
        : Run.Anchor;

    private string CharacterName => SendAnchor.Kind == AnchorKind.Character ? Characters.BareName(SendAnchor.Text) : string.Empty;

    // The answer as it is now: the field's change event reaches the server
    // before this tap does, so reading the run is enough.
    private string AnswerText() => Slot.Step.Kind == StepKind.Lines
        ? string.Join('\n', Enumerable.Range(0, Engine.LineCount(Run, Slot)).Select(i => Engine.GetLine(Run, Slot.Step.Key, Slot.Round, i)).Where(line => !string.IsNullOrWhiteSpace(line)))
        : Engine.GetAnswer(Run, Slot.Step.Key, Slot.Round);

    private async Task SendAsync(TargetKind target)
    {
        var label = string.IsNullOrWhiteSpace(Slot.Step.Label) ? Slot.Step.Question : Slot.Step.Label;
        var landed = await Host.SendAsync(target, new ToolSend(SendAnchor, Exercise.Name, label, AnswerText()));
        if (landed && !Run.Sent.Any(mark => mark.Key == Slot.Id && mark.Target == target))
        {
            Run.Sent.Add(new SentMark { Key = Slot.Id, Target = target });
        }

        Host.Save();
        await OnChanged.InvokeAsync(Slot);
    }
}
