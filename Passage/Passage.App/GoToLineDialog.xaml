<Window x:Class="Passage.App.GoToLineDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Go To Line"
        Width="320"
        Height="168"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{DynamicResource WindowBackground}">
  <Border Padding="24,20" Background="{DynamicResource WindowBackground}">
    <StackPanel>
      <!-- Dialog header -->
      <TextBlock Text="Go To Line"
                 FontSize="17"
                 FontWeight="SemiBold"
                 Foreground="{DynamicResource HeaderText}"
                 Margin="0,0,0,16" />

      <TextBlock Text="Line number:"
                 Foreground="{DynamicResource SecondaryText}"
                 FontSize="12"
                 Margin="0,0,0,8" />
      <TextBox x:Name="LineTextBox"
               Height="32"
               VerticalContentAlignment="Center"
               PreviewKeyDown="LineTextBox_PreviewKeyDown" />

      <StackPanel Orientation="Horizontal"
                  HorizontalAlignment="Right"
                  Margin="0,18,0,0">
        <Button Content="Go"
                Width="88"
                Margin="0,0,8,0"
                IsDefault="True"
                Click="Go_Click" />
        <Button Content="Cancel"
                Width="88"
                IsCancel="True"
                Click="Cancel_Click" />
      </StackPanel>
    </StackPanel>
  </Border>
</Window>
