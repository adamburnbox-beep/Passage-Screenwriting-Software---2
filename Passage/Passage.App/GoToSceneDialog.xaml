<Window x:Class="Passage.App.GoToSceneDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Go To Scene"
        Width="440"
        Height="540"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBackground}">
  <Border Padding="24,20" Background="{DynamicResource WindowBackground}">
    <DockPanel LastChildFill="True">

      <!-- Dialog header -->
      <StackPanel DockPanel.Dock="Top" Margin="0,0,0,16">
        <TextBlock Text="Go To Scene"
                   FontSize="17"
                   FontWeight="SemiBold"
                   Foreground="{DynamicResource HeaderText}"
                   Margin="0,0,0,4" />
        <TextBlock Text="Select a scene heading to jump to."
                   Foreground="{DynamicResource MutedText}"
                   FontSize="12" />
      </StackPanel>

      <!-- Footer buttons -->
      <StackPanel DockPanel.Dock="Bottom"
                  Orientation="Horizontal"
                  HorizontalAlignment="Right"
                  Margin="0,14,0,0">
        <Button Content="Jump"
                Width="88"
                Margin="0,0,8,0"
                IsDefault="True"
                Click="Jump_Click" />
        <Button Content="Close"
                Width="88"
                IsCancel="True"
                Click="Close_Click" />
      </StackPanel>

      <!-- Divider above buttons -->
      <Border DockPanel.Dock="Bottom"
              Height="1"
              Background="{DynamicResource SurfaceBorder}"
              Margin="0,0,0,0" />

      <!-- Scene list -->
      <ListBox x:Name="SceneListBox"
               DisplayMemberPath="DisplayText"
               PreviewKeyDown="SceneListBox_PreviewKeyDown"
               MouseDoubleClick="SceneListBox_MouseDoubleClick"
               MinHeight="320"
               Background="{DynamicResource SurfaceBackground}"
               BorderBrush="{DynamicResource SurfaceBorder}"
               BorderThickness="1" />

    </DockPanel>
  </Border>
</Window>
