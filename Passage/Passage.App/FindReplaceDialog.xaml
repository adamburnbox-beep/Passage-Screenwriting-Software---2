<Window x:Class="Passage.App.FindReplaceDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Find / Replace"
        Width="540"
        Height="252"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{DynamicResource WindowBackground}">
  <Border Padding="24,20" Background="{DynamicResource WindowBackground}">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <!-- Dialog header -->
      <TextBlock Grid.Row="0"
                 Text="Find / Replace"
                 FontSize="17"
                 FontWeight="SemiBold"
                 Foreground="{DynamicResource HeaderText}"
                 Margin="0,0,0,18" />

      <Grid Grid.Row="1" Margin="0,0,0,12">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="100" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <TextBlock Text="Find what:"
                   VerticalAlignment="Center"
                   Foreground="{DynamicResource SecondaryText}"
                   FontSize="12" />
        <TextBox x:Name="FindTextBox"
                 Grid.Column="1"
                 Height="32"
                 VerticalContentAlignment="Center"
                 TextChanged="FindTextBox_TextChanged" />
      </Grid>

      <Grid Grid.Row="2" Margin="0,0,0,20">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="100" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <TextBlock Text="Replace with:"
                   VerticalAlignment="Center"
                   Foreground="{DynamicResource SecondaryText}"
                   FontSize="12" />
        <TextBox x:Name="ReplaceTextBox"
                 Grid.Column="1"
                 Height="32"
                 VerticalContentAlignment="Center" />
      </Grid>

      <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,0,0,12">
        <Button Content="Find Next" Width="96" Margin="0,0,8,0" Click="FindNext_Click" />
        <Button Content="Find Previous" Width="112" Margin="0,0,8,0" Click="FindPrevious_Click" />
        <Button Content="Replace" Width="88" Margin="0,0,8,0" Click="Replace_Click" />
        <Button Content="Replace All" Width="100" Click="ReplaceAll_Click" />
      </StackPanel>

      <!-- Divider -->
      <Border Grid.Row="3" Height="1" Background="{DynamicResource SurfaceBorder}" Margin="0,0,0,0" VerticalAlignment="Bottom" />

      <DockPanel Grid.Row="4" Margin="0,12,0,0">
        <TextBlock x:Name="StatusTextBlock"
                   Text="Ready"
                   Foreground="{DynamicResource MutedText}"
                   FontSize="11.5"
                   VerticalAlignment="Center" />
        <Button Content="Close"
                Width="88"
                DockPanel.Dock="Right"
                HorizontalAlignment="Right"
                Click="Close_Click" />
      </DockPanel>
    </Grid>
  </Border>
</Window>
