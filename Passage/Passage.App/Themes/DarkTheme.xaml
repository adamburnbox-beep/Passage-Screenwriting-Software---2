  <SolidColorBrush x:Key="BeatBoardSequenceLaneBackground" Color="#06FFFFFF" />

  <SolidColorBrush x:Key="HeaderText" Color="#FFFFFFFF" />
  <SolidColorBrush x:Key="SecondaryText" Color="#FFA3A3A3" />
  <SolidColorBrush x:Key="MutedText" Color="#FF737373" />
