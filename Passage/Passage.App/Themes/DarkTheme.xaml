<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <SolidColorBrush x:Key="{x:Static SystemColors.WindowBrushKey}" Color="#FF1C1C1E" />
  <SolidColorBrush x:Key="{x:Static SystemColors.WindowTextBrushKey}" Color="#FFE8E5DF" />

  <SolidColorBrush x:Key="{x:Static SystemColors.ControlBrushKey}" Color="#FF1E1E22" />
  <SolidColorBrush x:Key="{x:Static SystemColors.ControlTextBrushKey}" Color="#FFE8E5DF" />
  <SolidColorBrush x:Key="{x:Static SystemColors.ControlDarkBrushKey}" Color="#FF4A4745" />
  <SolidColorBrush x:Key="{x:Static SystemColors.ControlDarkDarkBrushKey}" Color="#FF7A7470" />
  <SolidColorBrush x:Key="{x:Static SystemColors.ControlLightBrushKey}" Color="#FF191919" />
  <SolidColorBrush x:Key="{x:Static SystemColors.ControlLightLightBrushKey}" Color="#FF141416" />

  <SolidColorBrush x:Key="{x:Static SystemColors.MenuBrushKey}" Color="#FF141416" />
  <SolidColorBrush x:Key="{x:Static SystemColors.MenuTextBrushKey}" Color="#FFE8E5DF" />
  <SolidColorBrush x:Key="{x:Static SystemColors.InfoBrushKey}" Color="#FF141416" />
  <SolidColorBrush x:Key="{x:Static SystemColors.InfoTextBrushKey}" Color="#FFE8E5DF" />

  <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#FF2C2C30" />
  <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="#FFE8E5DF" />
  <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="#FF28282C" />
  <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}" Color="#FFE8E5DF" />

  <!-- Deep charcoal dark e-reader background -->
  <SolidColorBrush x:Key="WindowBackground" Color="#FF1C1C1E" />
  <SolidColorBrush x:Key="WindowForeground" Color="#FFE8E5DF" />

  <!-- Surfaces: dark hierarchy layers -->
  <SolidColorBrush x:Key="SurfaceBackground" Color="#FF242428" />
  <SolidColorBrush x:Key="SurfaceMutedBackground" Color="#FF2C2C30" />
  <SolidColorBrush x:Key="SurfaceRaisedBackground" Color="#FF141416" />
  <SolidColorBrush x:Key="SurfaceBorder" Color="#FF38383C" />
  <SolidColorBrush x:Key="SurfaceMutedBorder" Color="#FF444448" />

  <!-- Syntax highlight colors — original values from first commit -->
  <SolidColorBrush x:Key="SyntaxBlue" Color="#FF569CD6" />
  <SolidColorBrush x:Key="SyntaxOrange" Color="#FFCE9178" />
  <SolidColorBrush x:Key="SyntaxGreen" Color="#FF4EC9B0" />
  <SolidColorBrush x:Key="ControlPressedBackground" Color="#FFE8E5DF" />
  <SolidColorBrush x:Key="ControlPressedForeground" Color="#FF141416" />

  <SolidColorBrush x:Key="CardBaseBackground" Color="#FF141416" />
  <SolidColorBrush x:Key="CardAlternatingBackground" Color="#FF2C2C30" />
  <SolidColorBrush x:Key="EInkCardPrimaryBackground" Color="#FF141416" />
  <SolidColorBrush x:Key="EInkCardSecondaryBackground" Color="#FF2C2C30" />

  <SolidColorBrush x:Key="ControlBackground" Color="#FF242428" />
  <SolidColorBrush x:Key="ControlForeground" Color="#FFE8E5DF" />
  <SolidColorBrush x:Key="ControlBorder" Color="#FF4A4A50" />
  <SolidColorBrush x:Key="ControlAccent" Color="#FFE8E5DF" />
  <SolidColorBrush x:Key="BeatBoardDividerBrush" Color="#FF444448" />
  <SolidColorBrush x:Key="BeatBoardActDividerBrush" Color="#FF444448" />
  <SolidColorBrush x:Key="BeatBoardLaneGuideBrush" Color="#18FFFFFF" />
  <SolidColorBrush x:Key="BeatBoardActBoundaryBrush" Color="#FF444448" />
  <SolidColorBrush x:Key="BeatBoardSequenceSeparatorBrush" Color="#FF444448" />
  <SolidColorBrush x:Key="BeatBoardLaneSeparator" Color="#28FFFFFF" />
  <SolidColorBrush x:Key="BeatBoardActLaneBackground" Color="#03FFFFFF" />
  <SolidColorBrush x:Key="BeatBoardSequenceLaneBackground" Color="#06FFFFFF" />

  <SolidColorBrush x:Key="HeaderText" Color="#FFE8E5DF" />
  <SolidColorBrush x:Key="SecondaryText" Color="#FFAEABA4" />
  <SolidColorBrush x:Key="MutedText" Color="#FF8D8A83" />
  <SolidColorBrush x:Key="SubtleText" Color="#FF6C6963" />

  <!-- Outline panel — dark surface tones, soft borders -->
  <SolidColorBrush x:Key="OutlineSectionBackground" Color="#FF2C2C30" />
  <SolidColorBrush x:Key="OutlineSectionBorder" Color="#FF444448" />
  <SolidColorBrush x:Key="OutlineSynopsisBackground" Color="#FF1E1E22" />
  <SolidColorBrush x:Key="OutlineSynopsisBorder" Color="#FF38383C" />
  <SolidColorBrush x:Key="OutlineNoteBackground" Color="#FF242428" />
  <SolidColorBrush x:Key="OutlineNoteBorder" Color="#FF38383C" />
  <SolidColorBrush x:Key="OutlineSceneBorder" Color="#FF38383C" />
  <SolidColorBrush x:Key="OutlineCardBorder" Color="#FF38383C" />
  <SolidColorBrush x:Key="BeatBoardActCardBackground" Color="#FF141416" />
  <SolidColorBrush x:Key="BeatBoardOutlineActCardBackground" Color="#12FFFFFF" />
  <SolidColorBrush x:Key="BeatBoardOutlineActCardCollapsedBackground" Color="#0AFFFFFF" />
  <SolidColorBrush x:Key="BeatBoardSequenceCardBackground" Color="#FF141416" />
  <SolidColorBrush x:Key="BeatBoardOutlineSequenceCardBackground" Color="#0AFFFFFF" />
  <SolidColorBrush x:Key="BeatBoardSceneCardBackground" Color="#FF141416" />
  <SolidColorBrush x:Key="BeatBoardSceneCardBorder" Color="#FF38383C" />
  <SolidColorBrush x:Key="BeatBoardSceneCardAccentForeground" Color="#FFE8E5DF" />
  <SolidColorBrush x:Key="BeatBoardOutlineSceneCardBackground" Color="#0AFFFFFF" />
  <SolidColorBrush x:Key="BeatBoardNoteCardBackground" Color="#FF141416" />
  <SolidColorBrush x:Key="BeatBoardNoteCardBorder" Color="#FF38383C" />
  <SolidColorBrush x:Key="BeatBoardNoteCardAccentForeground" Color="#FFE8E5DF" />
  <SolidColorBrush x:Key="BeatBoardNoteCardContentForeground" Color="#FFE8E5DF" />
  <SolidColorBrush x:Key="BeatBoardOutlineNoteCardBackground" Color="#0AFFFFFF" />
  <SolidColorBrush x:Key="BeatBoardDefaultCardBackground" Color="#FF141416" />
  <SolidColorBrush x:Key="BeatBoardDefaultCardBorder" Color="#FF38383C" />
  <SolidColorBrush x:Key="BeatBoardOutlineDefaultCardBackground" Color="#08FFFFFF" />
  <SolidColorBrush x:Key="BeatBoardOutlineDefaultCardBorder" Color="#FF38383C" />
  <SolidColorBrush x:Key="BeatBoardDefaultCardAccentForeground" Color="#FFE8E5DF" />
  <SolidColorBrush x:Key="BeatBoardGhostLayerBackground" Color="#FF2C2C30" />
  <SolidColorBrush x:Key="BeatBoardGhostCardBackground" Color="#FF141416" />
  <SolidColorBrush x:Key="BeatBoardGhostTitleForeground" Color="#FFE8E5DF" />
  <SolidColorBrush x:Key="BeatBoardGhostDescriptionForeground" Color="#FFAEABA4" />

  <!-- Editor: dark page, warm text -->
  <SolidColorBrush x:Key="EditorPageBackground" Color="#FF1E1E22" />
  <SolidColorBrush x:Key="EditorPageBorder" Color="#FF2C2C30" />
  <SolidColorBrush x:Key="EditorPageShadow" Color="#08000000" />
  <SolidColorBrush x:Key="EditorForeground" Color="#FFE8E5DF" />
  <SolidColorBrush x:Key="EditorSelection" Color="#FF2C2C30" />
  <SolidColorBrush x:Key="EditorCaret" Color="#FFE8E5DF" />

  <!-- Goal panel — dark, soft borders -->
  <SolidColorBrush x:Key="GoalSuccessBackground" Color="#FF242428" />
  <SolidColorBrush x:Key="GoalSuccessBorder" Color="#FF38383C" />
  <SolidColorBrush x:Key="GoalSuccessForeground" Color="#FFE8E5DF" />
  <SolidColorBrush x:Key="GoalValueText" Color="#FFE8E5DF" />
  <SolidColorBrush x:Key="GoalLabelText" Color="#FFAEABA4" />
  <SolidColorBrush x:Key="GoalOverallBackground" Color="#FF141416" />
  <SolidColorBrush x:Key="GoalOverallBorder" Color="#FF38383C" />
  <SolidColorBrush x:Key="DestructiveBackground" Color="#FF321A1A" />
  <SolidColorBrush x:Key="DestructiveBorder" Color="#FF5A2E2E" />
  <SolidColorBrush x:Key="DestructiveForeground" Color="#FFECA5A5" />

  <Style TargetType="ToolTip">
    <Setter Property="Background" Value="{DynamicResource SurfaceRaisedBackground}" />
    <Setter Property="Foreground" Value="{DynamicResource HeaderText}" />
    <Setter Property="BorderBrush" Value="{DynamicResource SurfaceBorder}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Padding" Value="8,4" />
    <Setter Property="HasDropShadow" Value="False" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ToolTip">
          <Border Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}"
                  CornerRadius="6"
                  Padding="{TemplateBinding Padding}">
            <ContentPresenter />
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Syntax Reference panel brushes -->
  <SolidColorBrush x:Key="WorkspaceHierarchyIndentBrush" Color="#FFE8E5DF" />
  <SolidColorBrush x:Key="ReferencePanelBackgroundBrush" Color="#FF242428" />
  <SolidColorBrush x:Key="ReferenceCardBackgroundBrush" Color="#FF141416" />
  <SolidColorBrush x:Key="ReferenceBorderBrush" Color="#FF38383C" />
  <SolidColorBrush x:Key="ReferenceHeaderBrush" Color="#FFE8E5DF" />
  <SolidColorBrush x:Key="ReferenceBodyBrush" Color="#FFAEABA4" />
  <SolidColorBrush x:Key="ReferenceMutedBrush" Color="#FF8D8A83" />
  <!-- Syntax chip colors — original values from first commit -->
  <SolidColorBrush x:Key="SyntaxBlueBrush" Color="#FF569CD6" />
  <SolidColorBrush x:Key="SyntaxOrangeBrush" Color="#FFCE9178" />
  <SolidColorBrush x:Key="SyntaxGreenBrush" Color="#FF4EC9B0" />
  <SolidColorBrush x:Key="CopyButtonBackgroundBrush" Color="#FF242428" />
  <SolidColorBrush x:Key="CopyButtonBorderBrush" Color="#FF4A4A50" />
  <SolidColorBrush x:Key="CopyButtonHoverBrush" Color="#FF2C2C30" />
</ResourceDictionary>
