  <SolidColorBrush x:Key="BeatBoardDefaultCardBorder" Color="#FF404040" />
  <SolidColorBrush x:Key="BeatBoardOutlineDefaultCardBackground" Color="#FF262626" />
  <SolidColorBrush x:Key="BeatBoardOutlineDefaultCardBorder" Color="#FF404040" />
  <SolidColorBrush x:Key="BeatBoardDefaultCardAccentForeground" Color="#FFFFFFFF" />
  <SolidColorBrush x:Key="BeatBoardGhostLayerBackground" Color="#FF262626" />
  <SolidColorBrush x:Key="BeatBoardGhostCardBackground" Color="#FF121212" />
