  <SolidColorBrush x:Key="OutlineCardBorder" Color="#FF262626" />
  <SolidColorBrush x:Key="BeatBoardActCardBackground" Color="#FF121212" />
  <SolidColorBrush x:Key="BeatBoardOutlineActCardBackground" Color="#FF262626" />
