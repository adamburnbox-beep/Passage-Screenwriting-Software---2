<UserControl x:Class="Passage.App.Views.GoalPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:Passage.App.Converters"
             xmlns:local="clr-namespace:Passage.App.Views"
             x:Name="GoalRoot">
  <UserControl.Resources>
    <converters:GoalTypeLabelConverter x:Key="GoalTypeLabelConverter" />
    <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    <local:ProgressToArcConverter x:Key="ProgressToArcConverter" />

    <Style x:Key="GoalTypeComboBoxStyle" TargetType="ComboBox">
      <Setter Property="Background" Value="{DynamicResource ControlBackground}" />
      <Setter Property="Foreground" Value="{DynamicResource ControlForeground}" />
      <Setter Property="BorderBrush" Value="{DynamicResource ControlBorder}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Height" Value="36" />
      <Setter Property="Padding" Value="10,0,10,0" />
      <Setter Property="MinWidth" Value="140" />
      <Setter Property="OverridesDefaultStyle" Value="True" />
      <Setter Property="SnapsToDevicePixels" Value="True" />
      <Setter Property="HorizontalContentAlignment" Value="Left" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ComboBox">
            <Grid SnapsToDevicePixels="True">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="24" />
              </Grid.ColumnDefinitions>

              <ToggleButton x:Name="DropDownToggle"
                            Grid.ColumnSpan="2"
                            Focusable="False"
                            ClickMode="Press"
                            IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                            Background="Transparent"
                            BorderThickness="0"
                            OverridesDefaultStyle="True">
                <ToggleButton.Template>
                  <ControlTemplate TargetType="{x:Type ToggleButton}">
                    <Border Background="Transparent" />
                  </ControlTemplate>
                </ToggleButton.Template>
              </ToggleButton>

              <Border x:Name="ComboBorder"
                      Grid.ColumnSpan="2"
                      Background="{TemplateBinding Background}"
                      BorderBrush="{TemplateBinding BorderBrush}"
                      BorderThickness="{TemplateBinding BorderThickness}"
                      CornerRadius="6"
                      SnapsToDevicePixels="True"
                      IsHitTestVisible="False" />

              <ContentPresenter x:Name="ContentSite"
                                Grid.Column="0"
                                Margin="{TemplateBinding Padding}"
                                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                Content="{TemplateBinding SelectionBoxItem}"
                                ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}"
                                TextElement.Foreground="{TemplateBinding Foreground}"
                                IsHitTestVisible="False"
                                SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />

              <Border Grid.Column="1"
                      Background="{DynamicResource SurfaceMutedBackground}"
                      BorderBrush="{DynamicResource ControlBorder}"
                      BorderThickness="1,0,0,0"
                      CornerRadius="0,6,6,0"
                      IsHitTestVisible="False">
                <Path Data="M 0 0 L 5 5 L 10 0 Z"
                      Fill="{DynamicResource ControlForeground}"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center" />
              </Border>

              <Popup x:Name="PART_Popup"
                     AllowsTransparency="True"
                     Focusable="False"
                     IsOpen="{TemplateBinding IsDropDownOpen}"
                     Placement="Bottom"
                     PlacementTarget="{Binding ElementName=DropDownToggle}"
                     PopupAnimation="Fade"
                     StaysOpen="False">
                <Border Background="{DynamicResource SurfaceBackground}"
                        BorderBrush="{DynamicResource ControlBorder}"
                        BorderThickness="1"
                        CornerRadius="6"
                        Margin="0,2,0,0"
                        MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}">
                  <ScrollViewer CanContentScroll="True"
                                HorizontalScrollBarVisibility="Disabled"
                                VerticalScrollBarVisibility="Auto">
                    <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained" />
                  </ScrollViewer>
                </Border>
              </Popup>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="ComboBorder" Property="BorderBrush" Value="{DynamicResource ControlAccent}" />
              </Trigger>
              <Trigger Property="IsKeyboardFocusWithin" Value="True">
                <Setter TargetName="ComboBorder" Property="BorderBrush" Value="{DynamicResource ControlAccent}" />
              </Trigger>
              <Trigger Property="IsDropDownOpen" Value="True">
                <Setter TargetName="ComboBorder" Property="Background" Value="{DynamicResource SurfaceBackground}" />
                <Setter TargetName="ComboBorder" Property="BorderBrush" Value="{DynamicResource ControlAccent}" />
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.55" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </UserControl.Resources>

  <Grid MinHeight="360" Margin="4,8,4,4">
    <TabControl Background="Transparent"
                BorderThickness="0"
                SelectedIndex="0">
      
      <!-- SESSION TAB -->
      <TabItem Header="Session">
        <Grid Margin="0,16,0,0">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>

          <!-- Config inputs (spacious, heights adjusted to avoid layout clipping) -->
          <Grid Grid.Row="0" Margin="0,0,0,24">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="12" />
              <ColumnDefinition Width="100" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
              <TextBlock Text="GOAL TYPE" FontSize="9.5" FontWeight="Bold" Foreground="{DynamicResource MutedText}" Margin="0,0,0,4" />
              <ComboBox ItemsSource="{Binding SessionGoalTypes}"
                        SelectedItem="{Binding SessionSelectedGoalType, Mode=TwoWay}"
                        Style="{StaticResource GoalTypeComboBoxStyle}">
                <ComboBox.ItemTemplate>
                  <DataTemplate>
                    <TextBlock Text="{Binding Converter={StaticResource GoalTypeLabelConverter}}" />
                  </DataTemplate>
                </ComboBox.ItemTemplate>
              </ComboBox>
            </StackPanel>

            <StackPanel Grid.Column="2">
              <TextBlock Text="TARGET" FontSize="9.5" FontWeight="Bold" Foreground="{DynamicResource MutedText}" Margin="0,0,0,4" />
              <TextBox Text="{Binding SessionGoalTargetValue, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                       PreviewTextInput="GoalTargetValue_PreviewTextInput"
                       DataObject.Pasting="GoalTargetValue_Pasting"
                       Height="36"
                       Padding="10,0,10,0"
                       VerticalContentAlignment="Center"
                       Background="{DynamicResource ControlBackground}"
                       BorderBrush="{DynamicResource ControlBorder}"
                       BorderThickness="1"
                       Foreground="{DynamicResource GoalValueText}"
                       FontSize="12.5" />
            </StackPanel>
          </Grid>

          <!-- Dashboard Stats Grid -->
          <Grid Grid.Row="1" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Left: Circular Progress Bar (110x110 canvas size) -->
            <StackPanel Grid.Column="0" VerticalAlignment="Center" HorizontalAlignment="Center">
              <Grid Width="110" Height="110">
                <!-- Background track circle -->
                <Ellipse Width="100" Height="100"
                         Stroke="{DynamicResource SurfaceBorder}"
                         StrokeThickness="4" />
                
                <!-- Progress Arc -->
                <Path Stroke="{DynamicResource ControlAccent}"
                      StrokeThickness="6"
                      StrokeStartLineCap="Round"
                      StrokeEndLineCap="Round"
                      Data="{Binding SessionGoalProgressPercent, Converter={StaticResource ProgressToArcConverter}}" />

                <!-- Center text content based on goal type -->
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                  <!-- Timer display -->
                  <TextBlock Text="{Binding GoalTimerRemainingText}"
                             FontSize="20"
                             FontWeight="SemiBold"
                             HorizontalAlignment="Center"
                             Foreground="{DynamicResource HeaderText}"
                             Visibility="{Binding IsTimerGoal, Converter={StaticResource BooleanToVisibilityConverter}}" />
                  
                  <!-- Normal percentage display -->
                  <TextBlock Text="{Binding SessionGoalProgressPercent, StringFormat={}{0:0}%}"
                             FontSize="24"
                             FontWeight="SemiBold"
                             HorizontalAlignment="Center"
                             Foreground="{DynamicResource HeaderText}"
                             Visibility="{Binding IsTimerGoal, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=Inverse}" />
                </StackPanel>
              </Grid>
              
              <TextBlock Text="PROGRESS" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource MutedText}" HorizontalAlignment="Center" Margin="0,8,0,0" />
            </StackPanel>

            <!-- Right: Text Stats Block -->
            <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Center">
              <!-- Current Value -->
              <TextBlock Text="{Binding SessionGoalCurrentDisplayText}"
                         FontSize="24"
                         FontWeight="SemiBold"
                         HorizontalAlignment="Center"
                         Foreground="{DynamicResource HeaderText}" />
              <TextBlock Text="CURRENT" FontSize="8.5" FontWeight="Bold" Foreground="{DynamicResource MutedText}" HorizontalAlignment="Center" Margin="0,0,0,8" />
              
              <!-- Target Value -->
              <TextBlock Text="{Binding SessionGoalTargetDisplayText}"
                         FontSize="14"
                         FontWeight="SemiBold"
                         HorizontalAlignment="Center"
                         Foreground="{DynamicResource SecondaryText}" />
              <TextBlock Text="TARGET" FontSize="8.5" FontWeight="Bold" Foreground="{DynamicResource MutedText}" HorizontalAlignment="Center" />
            </StackPanel>
          </Grid>

          <!-- Actions & States -->
          <StackPanel Grid.Row="2" Margin="0,8,0,0">
            <WrapPanel HorizontalAlignment="Center" Margin="0,0,0,8">
              <Button Content="Reset Goal"
                      Click="GoalResetSession_Click"
                      Style="{StaticResource DarkChromeButtonStyle}"
                      Padding="12,5"
                      Margin="0,0,8,0" />
              
              <StackPanel Orientation="Horizontal" Visibility="{Binding IsTimerGoal, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Button Content="{Binding GoalTimerPrimaryButtonText}"
                        Click="GoalPrimaryTimerButton_Click"
                        Style="{StaticResource DarkChromeButtonStyle}"
                        Padding="12,5"
                        Margin="0,0,8,0" />
                <Button Content="{Binding GoalTimerSecondaryButtonText}"
                        Click="GoalSecondaryTimerButton_Click"
                        Style="{StaticResource DarkChromeButtonStyle}"
                        Padding="12,5" />
              </StackPanel>
            </WrapPanel>
            
            <TextBlock Text="{Binding SessionGoalStateText}"
                       Foreground="{DynamicResource SecondaryText}"
                       FontSize="11.5"
                       HorizontalAlignment="Center" />
          </StackPanel>
        </Grid>
      </TabItem>

      <!-- OVERALL TAB -->
      <TabItem Header="Overall">
        <Grid Margin="0,16,0,0">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>

          <!-- Config inputs (padding adjusted to fix clipping) -->
          <Grid Grid.Row="0" Margin="0,0,0,24">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="12" />
              <ColumnDefinition Width="100" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
              <TextBlock Text="GOAL TYPE" FontSize="9.5" FontWeight="Bold" Foreground="{DynamicResource MutedText}" Margin="0,0,0,4" />
              <ComboBox ItemsSource="{Binding GoalTypes}"
                        SelectedItem="{Binding SelectedGoalType, Mode=TwoWay}"
                        Style="{StaticResource GoalTypeComboBoxStyle}">
                <ComboBox.ItemTemplate>
                  <DataTemplate>
                    <TextBlock Text="{Binding Converter={StaticResource GoalTypeLabelConverter}}" />
                  </DataTemplate>
                </ComboBox.ItemTemplate>
              </ComboBox>
            </StackPanel>

            <StackPanel Grid.Column="2">
              <TextBlock Text="TARGET" FontSize="9.5" FontWeight="Bold" Foreground="{DynamicResource MutedText}" Margin="0,0,0,4" />
              <TextBox Text="{Binding GoalTargetValue, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                       PreviewTextInput="GoalTargetValue_PreviewTextInput"
                       DataObject.Pasting="GoalTargetValue_Pasting"
                       Height="36"
                       Padding="10,0,10,0"
                       VerticalContentAlignment="Center"
                       Background="{DynamicResource ControlBackground}"
                       BorderBrush="{DynamicResource ControlBorder}"
                       BorderThickness="1"
                       Foreground="{DynamicResource WindowForeground}"
                       FontSize="12.5" />
            </StackPanel>
          </Grid>

          <!-- Dashboard Stats Grid -->
          <Grid Grid.Row="1" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Left: Circular Progress Bar -->
            <StackPanel Grid.Column="0" VerticalAlignment="Center" HorizontalAlignment="Center">
              <Grid Width="110" Height="110">
                <!-- Background track circle -->
                <Ellipse Width="100" Height="100"
                         Stroke="{DynamicResource SurfaceBorder}"
                         StrokeThickness="4" />
                
                <!-- Progress Arc -->
                <Path Stroke="{DynamicResource ControlAccent}"
                      StrokeThickness="6"
                      StrokeStartLineCap="Round"
                      StrokeEndLineCap="Round"
                      Data="{Binding GoalProgressPercent, Converter={StaticResource ProgressToArcConverter}}" />

                <!-- Center text content -->
                <TextBlock Text="{Binding GoalProgressPercent, StringFormat={}{0:0}%}"
                           FontSize="24"
                           FontWeight="SemiBold"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource HeaderText}" />
              </Grid>
              
              <TextBlock Text="PROGRESS" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource MutedText}" HorizontalAlignment="Center" Margin="0,8,0,0" />
            </StackPanel>

            <!-- Right: Text Stats Block -->
            <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Center">
              <!-- Current Value -->
              <TextBlock Text="{Binding GoalCurrentDisplayText}"
                         FontSize="24"
                         FontWeight="SemiBold"
                         HorizontalAlignment="Center"
                         Foreground="{DynamicResource HeaderText}" />
              <TextBlock Text="CURRENT" FontSize="8.5" FontWeight="Bold" Foreground="{DynamicResource MutedText}" HorizontalAlignment="Center" Margin="0,0,0,8" />
              
              <!-- Target Value -->
              <TextBlock Text="{Binding GoalTargetDisplayText}"
                         FontSize="14"
                         FontWeight="SemiBold"
                         HorizontalAlignment="Center"
                         Foreground="{DynamicResource SecondaryText}" />
              <TextBlock Text="TARGET" FontSize="8.5" FontWeight="Bold" Foreground="{DynamicResource MutedText}" HorizontalAlignment="Center" />
            </StackPanel>
          </Grid>

          <!-- State Info -->
          <StackPanel Grid.Row="2" Margin="0,8,0,0">
            <TextBlock Text="{Binding GoalStateText}"
                       Foreground="{DynamicResource SecondaryText}"
                       FontSize="11.5"
                       HorizontalAlignment="Center" />
          </StackPanel>
        </Grid>
      </TabItem>
    </TabControl>
  </Grid>
</UserControl>
