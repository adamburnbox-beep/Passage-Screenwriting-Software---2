<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="300" d:DesignHeight="120"
        x:Class="Passage.App.Views.GoToLineDialog"
        Title="Go to Line"
        Width="320"
        Height="140"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        Background="{DynamicResource SurfaceBackground}">

    <DockPanel Margin="16">
        <StackPanel DockPanel.Dock="Top">
            <TextBlock Text="Line number:" Margin="0,0,0,4" Foreground="{DynamicResource ControlForeground}" />
            <TextBox x:Name="LineNumberTextBox" PlaceholderText="Enter line number..." MinWidth="200" />
        </StackPanel>

        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button x:Name="GoButton" Content="Go" Padding="24,6" Margin="0,0,8,0" Click="GoClick" IsDefault="True" />
            <Button x:Name="CancelButton" Content="Cancel" Padding="24,6" Click="CancelClick" IsCancel="True" />
        </StackPanel>
    </DockPanel>
</Window>
