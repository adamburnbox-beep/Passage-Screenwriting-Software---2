<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Passage.App.ViewModels"
        xmlns:views="using:Passage.App.Views"
        xmlns:export="using:Passage.Export"
        xmlns:ae="clr-namespace:AvaloniaEdit;assembly=AvaloniaEdit"
        xmlns:sys="clr-namespace:System;assembly=System.Runtime"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1320" d:DesignHeight="800"
        x:Class="Passage.App.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="Passage"
        Width="1320"
        Height="800"
        MinWidth="1100"
        MinHeight="720"
        Background="{DynamicResource ThemeBackground}">

    <Window.Styles>
        <Style Selector="Border.BeatBoardCard">
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="BorderBrush" Duration="0:0:0.2" />
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.2" />
                </Transitions>
            </Setter>
            <Setter Property="RenderTransform" Value="scale(1.0)" />
        </Style>
        <Style Selector="Border.BeatBoardCard:pointerover">
            <Setter Property="BorderBrush" Value="{DynamicResource CardAccent}" />
        </Style>
        <!-- Scene / Note index cards: fixed card size, soft shadow, subtle lift on hover. -->
        <Style Selector="Border.BeatBoardCard.leaf">
            <Setter Property="Width" Value="250" />
            <Setter Property="MinHeight" Value="150" />
            <Setter Property="Margin" Value="0,0,14,14" />
            <Setter Property="BoxShadow" Value="0 2 10 0 #17000000" />
        </Style>
        <Style Selector="Border.BeatBoardCard.leaf:pointerover">
            <Setter Property="RenderTransform" Value="scale(1.02)" />
        </Style>
        <!-- Act header: the solid-ink hero card that anchors its block
             (white-on-black in light theme, black-on-white in dark). -->
        <Style Selector="Border.BeatBoardCard.actHeader">
            <Setter Property="Background" Value="{DynamicResource ControlAccent}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ControlAccent}" />
            <Setter Property="CornerRadius" Value="16" />
            <Setter Property="Padding" Value="18,14" />
            <Setter Property="Margin" Value="0,0,0,14" />
            <Setter Property="BoxShadow" Value="0 4 14 0 #26000000" />
        </Style>
        <Style Selector="Border.BeatBoardCard.actHeader TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource ControlPressedForeground}" />
        </Style>
        <!-- Card type badge: ink pill with inverted text by default… -->
        <Style Selector="Border.BeatBoardCard Border.typeBadge">
            <Setter Property="Background" Value="{DynamicResource CardAccent}" />
        </Style>
        <Style Selector="Border.BeatBoardCard Border.typeBadge TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource ControlPressedForeground}" />
        </Style>
        <!-- …inverted again on the ink act card: white pill, ink text. -->
        <Style Selector="Border.BeatBoardCard.actHeader Border.typeBadge">
            <Setter Property="Background" Value="{DynamicResource ControlPressedForeground}" />
        </Style>
        <Style Selector="Border.BeatBoardCard.actHeader Border.typeBadge TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource ControlAccent}" />
        </Style>
        <!-- Card description: muted on white cards, dimmed-inverse on ink cards. -->
        <Style Selector="Border.BeatBoardCard TextBlock.desc">
            <Setter Property="Foreground" Value="{DynamicResource SecondaryText}" />
        </Style>
        <Style Selector="Border.BeatBoardCard.actHeader TextBlock.desc">
            <Setter Property="Foreground" Value="{DynamicResource ControlPressedForeground}" />
            <Setter Property="Opacity" Value="0.72" />
        </Style>
        <!-- Display-scale headings on the hero cards, reference-style. -->
        <Style Selector="Border.BeatBoardCard.actHeader TextBlock.cardHeading">
            <Setter Property="FontSize" Value="19" />
            <Setter Property="FontWeight" Value="Bold" />
        </Style>
        <Style Selector="Border.BeatBoardCard.seqHeader TextBlock.cardHeading">
            <Setter Property="FontSize" Value="16" />
        </Style>
        <!-- Sequence header: quiet full-width strip. -->
        <Style Selector="Border.BeatBoardCard.seqHeader">
            <Setter Property="Background" Value="{DynamicResource CardBackground}" />
            <Setter Property="Margin" Value="0,0,0,12" />
            <Setter Property="BoxShadow" Value="0 2 8 0 #12000000" />
        </Style>

        <!-- Act lane: no box of its own — the ink act card anchors the block
             and indentation carries the hierarchy, like the reference boards. -->
        <Style Selector="Border.BeatBoardLane">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0,0,0,26" />
        </Style>

        <!-- Groups indent beneath their act; sequences add a thin left rule. -->
        <Style Selector="Border.BeatBoardGroup">
            <Setter Property="Margin" Value="22,0,0,6" />
        </Style>
        <Style Selector="Border.BeatBoardGroup.hasSequence">
            <Setter Property="BorderBrush" Value="{DynamicResource SurfaceBorder}" />
            <Setter Property="BorderThickness" Value="2,0,0,0" />
            <Setter Property="Padding" Value="16,0,0,0" />
            <Setter Property="Margin" Value="22,0,0,14" />
        </Style>
    </Window.Styles>

    <Window.Resources>
        <!-- Shared Beat Board card. Used for the Act/Sequence header strips and the
             Scene/Note index cards alike — the leaf/actHeader/seqHeader classes
             (bound to the card's Type) restyle it per hierarchy level. -->
        <DataTemplate x:Key="BeatBoardCardTemplate" x:DataType="vm:BeatBoardCardViewModel">
            <Border Classes="BeatBoardCard"
                    Classes.leaf="{Binding IsLeaf}"
                    Classes.actHeader="{Binding IsActHeader}"
                    Classes.seqHeader="{Binding IsSequenceHeader}"
                    Padding="14,12"
                    Background="{DynamicResource CardBackground}"
                    BorderBrush="{DynamicResource CardBorder}"
                    BorderThickness="1"
                    CornerRadius="14"
                    DoubleTapped="BeatBoardCard_DoubleTapped"
                    DragDrop.AllowDrop="True"
                    PointerPressed="BeatBoardCard_PointerPressed"
                    DragDrop.DragOver="BeatBoardCard_DragOver"
                    DragDrop.Drop="BeatBoardCard_Drop">
                <Grid RowDefinitions="Auto,*">
                    <!-- Header: Type badge & edit/save controls -->
                    <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,8">
                        <!-- Normal Mode Header -->
                        <!-- Colors come from the Border.typeBadge styles so the
                             ink act card can invert them (styles lose to local
                             values, so none are set here). -->
                        <Border Grid.Column="0"
                                Classes="typeBadge"
                                IsVisible="{Binding !IsEditing}"
                                HorizontalAlignment="Left"
                                Padding="10,3"
                                CornerRadius="999">
                            <TextBlock Text="{Binding Type}"
                                       FontSize="9.5"
                                       FontWeight="Bold"
                                       LetterSpacing="1.2" />
                        </Border>

                        <Button Grid.Column="1"
                                Classes="inline"
                                IsVisible="{Binding !IsEditing}"
                                Content="Edit"
                                Padding="8,4"
                                FontSize="11"
                                Command="{Binding $parent[Window].DataContext.StartCardEditCommand}"
                                CommandParameter="{Binding}" />

                        <!-- Edit Mode Header -->
                        <ComboBox Grid.Column="0"
                                  IsVisible="{Binding IsEditing}"
                                  SelectedItem="{Binding EditingType, Mode=TwoWay}"
                                  HorizontalAlignment="Stretch"
                                  Height="28"
                                  Padding="6,2"
                                  FontSize="11">
                            <ComboBox.Items>
                                <sys:String>Act</sys:String>
                                <sys:String>Sequence</sys:String>
                                <sys:String>Scene</sys:String>
                                <sys:String>Note</sys:String>
                            </ComboBox.Items>
                        </ComboBox>

                        <StackPanel Grid.Column="1"
                                    IsVisible="{Binding IsEditing}"
                                    Orientation="Horizontal"
                                    Spacing="4"
                                    Margin="8,0,0,0">
                            <Button Content="Save"
                                    Classes="inline"
                                    Padding="8,4"
                                    FontSize="11"
                                    Background="{DynamicResource ControlPressedBackground}"
                                    Foreground="{DynamicResource ControlPressedForeground}"
                                    Command="{Binding $parent[Window].DataContext.SaveCardCommand}"
                                    CommandParameter="{Binding}" />
                            <Button Content="Cancel"
                                    Classes="inline"
                                    Padding="8,4"
                                    FontSize="11"
                                    Command="{Binding $parent[Window].DataContext.CancelCardEditCommand}"
                                    CommandParameter="{Binding}" />
                            <Button Content="Delete"
                                    Classes="inline"
                                    Padding="8,4"
                                    FontSize="11"
                                    Foreground="{DynamicResource SecondaryText}"
                                    ToolTip.Tip="Remove this card and its contents from the script"
                                    Command="{Binding $parent[Window].DataContext.DeleteCardCommand}"
                                    CommandParameter="{Binding}" />
                        </StackPanel>
                    </Grid>

                    <!-- Content: Displays text or edit textboxes -->
                    <StackPanel Grid.Row="1">
                        <!-- Normal Mode Content -->
                        <StackPanel IsVisible="{Binding !IsEditing}" Spacing="6">
                            <TextBlock Classes="cardHeading"
                                       Text="{Binding Heading}"
                                       FontWeight="SemiBold"
                                       FontSize="15"
                                       TextWrapping="Wrap"
                                       TextTrimming="CharacterEllipsis"
                                       MaxHeight="46" />
                            <TextBlock Classes="desc"
                                       Text="{Binding Description}"
                                       IsVisible="{Binding Description, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                       FontSize="11.5"
                                       TextWrapping="Wrap"
                                       MaxHeight="120"
                                       TextTrimming="CharacterEllipsis" />
                        </StackPanel>

                        <!-- Edit Mode Content -->
                        <StackPanel IsVisible="{Binding IsEditing}" Spacing="6">
                            <TextBox Text="{Binding EditingHeading, Mode=TwoWay}"
                                     PlaceholderText="Heading"
                                     FontSize="13"
                                     UseFloatingPlaceholder="False" />
                            <TextBox Text="{Binding EditingDescription, Mode=TwoWay}"
                                     PlaceholderText="Description"
                                     FontSize="11.5"
                                     Height="70"
                                     AcceptsReturn="True"
                                     TextWrapping="Wrap"
                                     UseFloatingPlaceholder="False" />
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <DockPanel>
        <!-- Menu Bar -->
        <Menu DockPanel.Dock="Top" Background="Transparent" Margin="10,6,10,4">
            <MenuItem Header="_File">
                <MenuItem Header="_New" Command="{Binding NewCommand}" InputGesture="Ctrl+N" />
                <MenuItem Header="_Open..." Command="{Binding OpenCommand}" InputGesture="Ctrl+O" />
                <MenuItem Header="Open _Recent"
                          ItemsSource="{Binding RecentFiles}"
                          IsEnabled="{Binding HasRecentFiles}">
                    <MenuItem.Styles>
                        <Style Selector="MenuItem" x:DataType="sys:String" x:CompileBindings="False">
                            <Setter Property="Header" Value="{Binding}" />
                            <Setter Property="Command" Value="{Binding $parent[Window].DataContext.OpenRecentCommand}" />
                            <Setter Property="CommandParameter" Value="{Binding}" />
                        </Style>
                    </MenuItem.Styles>
                </MenuItem>
                <MenuItem Header="_Save" Command="{Binding SaveCommand}" InputGesture="Ctrl+S" />
                <MenuItem Header="Save _As..." Command="{Binding SaveAsCommand}" InputGesture="Ctrl+Shift+S" />
                <MenuItem Header="_Close" Command="{Binding CloseCommand}" InputGesture="Ctrl+W" />
                <Separator />
                <MenuItem Header="_Title Page..." Command="{Binding EditTitlePageCommand}" />
                <MenuItem Header="_Export" ItemsSource="{Binding AvailableExporters}">
                    <MenuItem.Styles>
                        <Style Selector="MenuItem" x:DataType="export:IExporter" x:CompileBindings="False">
                            <Setter Property="Header" Value="{Binding DisplayName}" />
                            <Setter Property="Command" Value="{Binding $parent[Window].DataContext.ExportCommand}" />
                            <Setter Property="CommandParameter" Value="{Binding}" />
                        </Style>
                    </MenuItem.Styles>
                </MenuItem>
                <Separator />
                <MenuItem Header="E_xit" Command="{Binding ExitCommand}" InputGesture="Ctrl+Q" />
            </MenuItem>

            <MenuItem Header="_Edit">
                <MenuItem Header="_Undo" Command="{Binding UndoCommand}" InputGesture="Ctrl+Z" />
                <MenuItem Header="_Redo" Command="{Binding RedoCommand}" InputGesture="Ctrl+Y" />
                <Separator />
                <MenuItem Header="_Find / Replace..." Command="{Binding FindCommand}" InputGesture="Ctrl+F" />
            </MenuItem>

            <MenuItem Header="_View">
                <MenuItem Header="Zoom _In" Command="{Binding ZoomInCommand}" />
                <MenuItem Header="Zoom _Out" Command="{Binding ZoomOutCommand}" />
                <MenuItem Header="Reset _Zoom" Command="{Binding ResetZoomCommand}" />
                <Separator />
                <MenuItem Header="_Markdown Mode"
                          Command="{Binding ToggleWriteModeCommand}"
                          InputGesture="Ctrl+M"
                          ToggleType="CheckBox"
                          IsChecked="{Binding IsMarkdownMode, Mode=OneWay}" />
                <Separator />
                <MenuItem Header="Syntax _Reference" Command="{Binding ToggleSyntaxPanelCommand}" InputGesture="F1" />
                <Separator />
                <MenuItem Header="_Theme">
                    <MenuItem Header="_Dark" Command="{Binding SetDarkThemeCommand}" />
                    <MenuItem Header="_Light" Command="{Binding SetLightThemeCommand}" />
                </MenuItem>
            </MenuItem>

            <MenuItem Header="_Navigate">
                <MenuItem Header="Go to _Line..." Command="{Binding GoToLineCommand}" InputGesture="Ctrl+G" />
                <MenuItem Header="Go to _Scene..." Command="{Binding GoToSceneCommand}" InputGesture="Ctrl+Shift+G" />
            </MenuItem>
        </Menu>

        <!-- The old duplicate-button toolbar is gone: everything lives in the
             menus and shortcuts, leaving one slim header band like the
             reference designs. -->

        <!-- Status Bar -->
        <Border DockPanel.Dock="Bottom"
                Background="{DynamicResource SurfaceBackground}"
                BorderBrush="{DynamicResource SurfaceBorder}"
                BorderThickness="0,1,0,0"
                Padding="16,7">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="18" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Text="{Binding StatusMessage}"
                           Foreground="{DynamicResource MutedText}"
                           FontSize="12"
                           TextTrimming="CharacterEllipsis" />

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Line " Foreground="{DynamicResource SecondaryText}" FontSize="12" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding CurrentLineNumber}" Foreground="{DynamicResource WindowForeground}" FontSize="12" />
                    <TextBlock Text="  Type " Foreground="{DynamicResource SecondaryText}" FontSize="12" FontWeight="SemiBold" Margin="10,0,0,0" />
                    <TextBlock Text="{Binding CurrentElementType}" Foreground="{DynamicResource WindowForeground}" FontSize="12" />
                </StackPanel>

                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{Binding PageCountStatusText}"
                               IsVisible="{Binding IsScreenplayMode}"
                               Foreground="{DynamicResource WindowForeground}"
                               FontSize="12"
                               Margin="0,0,12,0" />
                    <TextBlock Text="Zoom " Foreground="{DynamicResource SecondaryText}" FontWeight="SemiBold" FontSize="12" Margin="0,0,4,0" />
                    <TextBlock Text="{Binding ActiveZoomDisplayText}" Foreground="{DynamicResource WindowForeground}" FontSize="12" Margin="0,0,12,0" />
                    <TextBlock Text="{Binding ModeStatusText}" Foreground="{DynamicResource WindowForeground}" FontWeight="SemiBold" FontSize="12" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main Workspace Layout Grid -->
        <Grid Name="MainLayoutGrid">
            <Grid.ColumnDefinitions>
                <!-- Column 0: Collapsible Sidebar -->
                <ColumnDefinition Width="310" MinWidth="65" />
                <!-- Column 1: Left Resizing GridSplitter -->
                <ColumnDefinition Width="Auto" />
                <!-- Column 2: Main Editors -->
                <ColumnDefinition Width="*" />
                <!-- Column 3: Right Resizing GridSplitter -->
                <ColumnDefinition Width="0" />
                <!-- Column 4: Syntax Quick Reference Panel -->
                <ColumnDefinition Width="0" />
            </Grid.ColumnDefinitions>

            <!-- Collapsible Sidebar Dock: a raised white panel on the gray canvas -->
            <Border Name="LeftDockBorder" Grid.Column="0"
                    Background="{DynamicResource SurfaceRaisedBackground}"
                    BoxShadow="2 0 12 0 #10000000">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Sidebar Header (Collapsible Panel Header) -->
                    <Border Grid.Row="0" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource SurfaceBorder}" Padding="14,14,10,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

            <!-- Centered ink pill header, matching the reference apps'
                 "HABIT TRACKING" / "MOOD TRACKER" headers. -->
                            <Border Name="LeftDockTitleText"
                                    Background="{DynamicResource ControlAccent}"
                                    CornerRadius="999"
                                    Padding="18,6"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center">
                                <TextBlock Text="WORKSPACE"
                                           FontSize="10.5"
                                           FontWeight="Bold"
                                           LetterSpacing="1.8"
                                           Foreground="{DynamicResource ControlPressedForeground}" />
                            </Border>

                            <Button Name="LeftDockToggleButton"
                                    Grid.Column="1"
                                    Click="ToggleLeftDock_Click"
                                    Content="&lt;"
                                    Width="44"
                                    Height="28"
                                    Padding="0"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    FontSize="20"
                                    Foreground="{DynamicResource HeaderText}"
                                    HorizontalContentAlignment="Center"
                                    VerticalContentAlignment="Center">
                                <Button.Styles>
                                    <Style Selector="Button#LeftDockToggleButton /template/ ContentPresenter#PART_ContentPresenter">
                                        <Setter Property="Background" Value="Transparent" />
                                        <Setter Property="BorderThickness" Value="0" />
                                    </Style>
                                    <Style Selector="Button#LeftDockToggleButton:pointerover /template/ ContentPresenter#PART_ContentPresenter">
                                        <Setter Property="Background" Value="Transparent" />
                                    </Style>
                                    <Style Selector="Button#LeftDockToggleButton:pressed /template/ ContentPresenter#PART_ContentPresenter">
                                        <Setter Property="Background" Value="Transparent" />
                                    </Style>
                                </Button.Styles>
                            </Button>
                        </Grid>
                    </Border>

                    <!-- Sidebar TabControl: icon-over-label navigation -->
                    <TabControl Name="LeftDockTabs" Grid.Row="1" Margin="10,8,10,8">
                        <!-- Outline Tab -->
                        <TabItem>
                            <TabItem.Header>
                                <StackPanel Spacing="3" HorizontalAlignment="Center">
                                    <PathIcon Data="{StaticResource IconOutline}" Width="16" Height="16" HorizontalAlignment="Center" />
                                    <TextBlock Text="Outline" FontSize="9.5" FontWeight="SemiBold" LetterSpacing="0.5" HorizontalAlignment="Center" />
                                </StackPanel>
                            </TabItem.Header>
                            <Grid RowDefinitions="Auto,*">
                                <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center" Margin="0,0,0,6">
                                    <Button Classes="inline"
                                            Content="Expand All"
                                            Padding="8,3"
                                            FontSize="12"
                                            Command="{Binding ExpandAllOutlineNodesCommand}" />
                                    <Button Classes="inline"
                                            Content="Collapse All"
                                            Padding="8,3"
                                            FontSize="12"
                                            Command="{Binding CollapseAllOutlineNodesCommand}" />
                                </StackPanel>
                                <TreeView Grid.Row="1" Name="OutlineTree" ItemsSource="{Binding OutlineRoots}" DragDrop.AllowDrop="True">
                                    <TreeView.Styles>
                                        <Style Selector="TreeViewItem" x:DataType="vm:OutlineNodeViewModel" x:CompileBindings="False">
                                            <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
                                        </Style>
                                    </TreeView.Styles>
                                    <TreeView.ItemTemplate>
                                        <TreeDataTemplate DataType="vm:OutlineNodeViewModel" ItemsSource="{Binding Children}">
                                            <!-- Quiet, unboxed row: hierarchy comes from indentation and
                                                 type weight; the single ink-filled row marks where the
                                                 caret is (like the selected day in the reference
                                                 calendar), so nothing else competes for attention. -->
                                            <Border CornerRadius="10"
                                                    Padding="10,7"
                                                    Margin="0,0,0,2"
                                                    ToolTip.Tip="{Binding ToolTipText}"
                                                    Classes="outlineRow"
                                                    Classes.dragover="{Binding IsDragOver}"
                                                    Classes.act="{Binding IsActLevel}"
                                                    Classes.current="{Binding IsCurrent}"
                                                    DragDrop.AllowDrop="True"
                                                    PointerPressed="OutlineNode_PointerPressed"
                                                    PointerMoved="OutlineNode_PointerMoved"
                                                    PointerReleased="OutlineNode_PointerReleased"
                                                    DragDrop.DragOver="OutlineNode_DragOver"
                                                    DragDrop.DragLeave="OutlineNode_DragLeave"
                                                    DragDrop.Drop="OutlineNode_Drop">
                                                <StackPanel Background="Transparent" DoubleTapped="OutlineNode_DoubleTapped">
                                                    <TextBlock Classes="rowKind"
                                                               Text="{Binding KindLabel}"
                                                               IsVisible="{Binding IsActLevel}"
                                                               FontSize="9"
                                                               FontWeight="Bold"
                                                               LetterSpacing="1.6"
                                                               Margin="0,0,0,1" />
                                                    <TextBlock Classes="rowTitle"
                                                               Text="{Binding Title}"
                                                               FontSize="13"
                                                               TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                            </Border>
                                        </TreeDataTemplate>
                                    </TreeView.ItemTemplate>
                                </TreeView>
                                <TextBlock Grid.Row="1"
                                           Text="{Binding OutlineEmptyMessage}"
                                           IsVisible="{Binding !HasOutlineItems}"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           TextAlignment="Center"
                                           Foreground="{DynamicResource MutedText}"
                                           FontStyle="Italic"
                                           TextWrapping="Wrap" />
                            </Grid>
                        </TabItem>

                        <!-- Notes Tab -->
                        <TabItem>
                            <TabItem.Header>
                                <StackPanel Spacing="3" HorizontalAlignment="Center">
                                    <PathIcon Data="{StaticResource IconNotes}" Width="16" Height="16" HorizontalAlignment="Center" />
                                    <TextBlock Text="Notes" FontSize="9.5" FontWeight="SemiBold" LetterSpacing="0.5" HorizontalAlignment="Center" />
                                </StackPanel>
                            </TabItem.Header>
                            <Grid RowDefinitions="Auto,*">
                                <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center" Margin="0,0,0,6">
                                    <Button Classes="inline"
                                            Content="Expand All"
                                            Padding="8,3"
                                            FontSize="12"
                                            Command="{Binding ExpandAllNotesNodesCommand}" />
                                    <Button Classes="inline"
                                            Content="Collapse All"
                                            Padding="8,3"
                                            FontSize="12"
                                            Command="{Binding CollapseAllNotesNodesCommand}" />
                                </StackPanel>
                                <TreeView Grid.Row="1" Name="NotesTree" ItemsSource="{Binding NotesRoots}" DragDrop.AllowDrop="True">
                                    <TreeView.Styles>
                                        <Style Selector="TreeViewItem" x:DataType="vm:OutlineNodeViewModel" x:CompileBindings="False">
                                            <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
                                        </Style>
                                    </TreeView.Styles>
                                    <TreeView.ItemTemplate>
                                        <TreeDataTemplate DataType="vm:OutlineNodeViewModel" ItemsSource="{Binding Children}">
                                            <Border CornerRadius="10"
                                                    Padding="10,7"
                                                    Margin="0,0,0,2"
                                                    ToolTip.Tip="{Binding ToolTipText}"
                                                    Classes="outlineRow"
                                                    Classes.dragover="{Binding IsDragOver}"
                                                    Classes.current="{Binding IsCurrent}"
                                                    DragDrop.AllowDrop="True"
                                                    PointerPressed="OutlineNode_PointerPressed"
                                                    PointerMoved="OutlineNode_PointerMoved"
                                                    PointerReleased="OutlineNode_PointerReleased"
                                                    DragDrop.DragOver="OutlineNode_DragOver"
                                                    DragDrop.DragLeave="OutlineNode_DragLeave"
                                                    DragDrop.Drop="OutlineNode_Drop">
                                                <StackPanel Background="Transparent" DoubleTapped="OutlineNode_DoubleTapped">
                                                    <TextBlock Classes="rowTitle"
                                                               Text="{Binding Title}"
                                                               FontSize="13"
                                                               TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                            </Border>
                                        </TreeDataTemplate>
                                    </TreeView.ItemTemplate>
                                </TreeView>
                                <TextBlock Grid.Row="1"
                                           Text="{Binding NotesEmptyMessage}"
                                           IsVisible="{Binding !HasNoteItems}"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           TextAlignment="Center"
                                           Foreground="{DynamicResource MutedText}"
                                           FontStyle="Italic"
                                           TextWrapping="Wrap" />
                            </Grid>
                        </TabItem>

                        <!-- Scratchpad Tab -->
                        <TabItem>
                            <TabItem.Header>
                                <StackPanel Spacing="3" HorizontalAlignment="Center">
                                    <PathIcon Data="{StaticResource IconScratchpad}" Width="16" Height="16" HorizontalAlignment="Center" />
                                    <TextBlock Text="Scratch" FontSize="9.5" FontWeight="SemiBold" LetterSpacing="0.5" HorizontalAlignment="Center" />
                                </StackPanel>
                            </TabItem.Header>
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <TextBox Grid.Row="0" PlaceholderText="Search..." Text="{Binding ScratchpadSearchText, Mode=TwoWay}" Margin="0,0,0,5" />

                                <ListBox Grid.Row="1" ItemsSource="{Binding ScratchpadElements}" SelectedItem="{Binding SelectedScratchpadElement, Mode=TwoWay}">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="Transparent" DoubleTapped="ScratchpadItem_DoubleTapped">
                                                <StackPanel Margin="5">
                                                    <TextBlock Text="{Binding Type}" FontSize="10.5" Foreground="{DynamicResource MutedText}" FontWeight="SemiBold" LetterSpacing="0.8"/>
                                                    <TextBlock Text="{Binding Text}" FontSize="12" TextWrapping="Wrap"/>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>

                                <TextBlock Grid.Row="1" Text="{Binding ScratchpadEmptyMessage}"
                                           IsVisible="{Binding !HasScratchpadItems}"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           TextAlignment="Center"
                                           Foreground="{DynamicResource MutedText}"
                                           FontStyle="Italic"
                                           TextWrapping="Wrap" />

                                <Button Grid.Row="2" Classes="inline" Padding="8,4" Command="{Binding DeleteScratchpadCardCommand}" Content="Delete Selected" HorizontalAlignment="Right" Margin="0,5,0,0" />
                            </Grid>
                        </TabItem>

                        <!-- Goal Tab -->
                        <TabItem>
                            <TabItem.Header>
                                <StackPanel Spacing="3" HorizontalAlignment="Center">
                                    <PathIcon Data="{StaticResource IconGoal}" Width="16" Height="16" HorizontalAlignment="Center" />
                                    <TextBlock Text="Goal" FontSize="9.5" FontWeight="SemiBold" LetterSpacing="0.5" HorizontalAlignment="Center" />
                                </StackPanel>
                            </TabItem.Header>
                            <views:GoalPanel />
                        </TabItem>
                    </TabControl>
                </Grid>
            </Border>

            <!-- Collapsible GridSplitter -->
            <GridSplitter Name="LeftSplitter" Grid.Column="1" Width="4" Background="{DynamicResource SurfaceBorder}" />

            <!-- Main Editor Content Area -->
            <TabControl Name="MainViewTabs" Grid.Column="2" SelectedIndex="{Binding MainViewIndex, Mode=TwoWay}">
                <TabItem Header="Script">
                    <Grid>
                        <!-- Editor Area -->
                        <Grid Background="{DynamicResource SurfaceBackground}">
                            <Border Name="EditorDocumentHost"
                                    Width="816"
                                    Margin="0,40"
                                    Background="{DynamicResource SurfaceRaisedBackground}"
                                    BorderBrush="{DynamicResource EditorPageBorder}"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    BoxShadow="0 10 34 0 #24000000"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Stretch">
                                <Border.RenderTransform>
                                    <ScaleTransform ScaleX="{Binding EditorZoomScale}"
                                                    ScaleY="{Binding EditorZoomScale}" />
                                </Border.RenderTransform>
                                <ae:TextEditor Name="EditorTextBox"
                                               WordWrap="True"
                                               ShowLineNumbers="False"
                                               FontFamily="avares://Passage.App.Linux/Assets/Fonts/#Courier Prime, Courier New, Courier"
                                               FontSize="16"
                                               Padding="144,96,96,96"
                                               Background="Transparent"
                                               BorderThickness="0"
                                               HorizontalScrollBarVisibility="Disabled"
                                               VerticalScrollBarVisibility="Auto"
                                               Foreground="{DynamicResource EditorForeground}">
                                    <ae:TextEditor.ContextFlyout>
                                        <MenuFlyout>
                                            <MenuItem Header="Cut" Click="OnCutClick" />
                                            <MenuItem Header="Copy" Click="OnCopyClick" />
                                            <MenuItem Header="Paste" Click="OnPasteClick" />
                                            <Separator />
                                            <MenuItem Header="Find / Replace..." Command="{Binding FindCommand}" />
                                            <Separator />
                                            <MenuItem Header="Classify As Action" Command="{Binding ClassifyAsActionCommand}" />
                                            <MenuItem Header="Classify As Scene Heading" Command="{Binding ClassifyAsSceneHeadingCommand}" />
                                            <MenuItem Header="Classify As Character" Command="{Binding ClassifyAsCharacterCommand}" />
                                            <MenuItem Header="Classify As Dialogue" Command="{Binding ClassifyAsDialogueCommand}" />
                                            <MenuItem Header="Classify As Parenthetical" Command="{Binding ClassifyAsParentheticalCommand}" />
                                            <MenuItem Header="Classify As Transition" Command="{Binding ClassifyAsTransitionCommand}" />
                                            <MenuItem Header="Classify As Note" Command="{Binding ClassifyAsNoteCommand}" />
                                        </MenuFlyout>
                                    </ae:TextEditor.ContextFlyout>
                                </ae:TextEditor>
                            </Border>
                        </Grid>

                        <!-- Autocomplete Suggestions Popup -->
                        <Popup Name="AutoCompletePopup"
                               Placement="Top"
                               PlacementTarget="{Binding ElementName=EditorTextBox}"
                               IsOpen="{Binding IsAutoCompleteOpen, Mode=TwoWay}">
                            <Border Background="{DynamicResource SurfaceRaisedBackground}"
                                    BorderBrush="{DynamicResource ControlAccent}"
                                    BorderThickness="1"
                                    CornerRadius="10"
                                    Padding="3"
                                    MinWidth="200"
                                    MaxHeight="200"
                                    BoxShadow="0 4 10 0 #30000000">
                                <ListBox Name="SuggestionsListBox"
                                         ItemsSource="{Binding AutoCompleteSuggestions}"
                                         SelectedIndex="{Binding SelectedSuggestionIndex, Mode=TwoWay}"
                                         Background="Transparent"
                                         BorderThickness="0"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                         Tapped="SuggestionsListBox_Tapped">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding}"
                                                       Padding="8,4"
                                                       FontSize="13"
                                                       FontFamily="avares://Passage.App.Linux/Assets/Fonts/#Courier Prime, Inter, Segoe UI" />
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Border>
                        </Popup>
                    </Grid>
                </TabItem>

                <TabItem Header="Beat Board">
                    <Grid Margin="28,10,28,20">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!-- Beat Board Toolbar -->
                        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,12">
                            <Button Classes="chrome primary"
                                    Command="{Binding CreateNewCardCommand}"
                                    Content="New Card"
                                    Margin="0,0,8,0" />
                            <Button Classes="chrome"
                                    Command="{Binding SyncBoardToScriptCommand}"
                                    Content="Sync to Script"
                                    Margin="0,0,8,0" />
                            <Button Classes="inline"
                                    Content="Expand All"
                                    Padding="12,5"
                                    FontSize="12"
                                    VerticalAlignment="Center"
                                    Margin="8,0,6,0"
                                    Command="{Binding ExpandAllBeatBoardCommand}" />
                            <Button Classes="inline"
                                    Content="Collapse All"
                                    Padding="12,5"
                                    FontSize="12"
                                    VerticalAlignment="Center"
                                    Command="{Binding CollapseAllBeatBoardCommand}" />
                        </StackPanel>

                        <!-- Beat Board: one lane per Act, sequence groups nested inside,
                             scene/note index cards wrapped within each group. -->
                        <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                            <LayoutTransformControl>
                            <LayoutTransformControl.LayoutTransform>
                                <ScaleTransform ScaleX="{Binding EditorZoomScale}" ScaleY="{Binding EditorZoomScale}" />
                            </LayoutTransformControl.LayoutTransform>
                            <ItemsControl ItemsSource="{Binding BeatBoardLanes}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:BeatBoardLaneViewModel">
                                        <Border Classes="BeatBoardLane" Classes.hasAct="{Binding HasActCard}">
                                            <StackPanel>
                                                <!-- Act header row: card + lane controls (+ Scene, collapse) -->
                                                <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding HasActCard}">
                                                    <ContentControl Content="{Binding ActCard}"
                                                                    ContentTemplate="{StaticResource BeatBoardCardTemplate}" />
                                                    <StackPanel Grid.Column="1"
                                                                Orientation="Horizontal"
                                                                Spacing="6"
                                                                VerticalAlignment="Top"
                                                                Margin="10,4,0,0">
                                                        <Button Classes="inline"
                                                                Content="+ Scene"
                                                                Padding="10,4"
                                                                FontSize="11"
                                                                Command="{Binding $parent[Window].DataContext.AddSceneToBlockCommand}"
                                                                CommandParameter="{Binding ActCard}" />
                                                        <ToggleButton Classes="laneChevron"
                                                                      IsChecked="{Binding IsExpanded, Mode=TwoWay}"
                                                                      Content="&#x25BE;"
                                                                      ToolTip.Tip="Collapse / expand this act" />
                                                    </StackPanel>
                                                </Grid>
                                                <ItemsControl ItemsSource="{Binding Groups}" IsVisible="{Binding IsExpanded}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate x:DataType="vm:BeatBoardGroupViewModel">
                                                            <Border Classes="BeatBoardGroup" Classes.hasSequence="{Binding HasSequenceCard}">
                                                                <StackPanel>
                                                                    <!-- Sequence header row: card + "+ Scene" + collapse -->
                                                                    <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding HasSequenceCard}">
                                                                        <ContentControl Content="{Binding SequenceCard}"
                                                                                        ContentTemplate="{StaticResource BeatBoardCardTemplate}" />
                                                                        <StackPanel Grid.Column="1"
                                                                                    Orientation="Horizontal"
                                                                                    Spacing="6"
                                                                                    VerticalAlignment="Top"
                                                                                    Margin="10,4,0,0">
                                                                            <Button Classes="inline"
                                                                                    Content="+ Scene"
                                                                                    Padding="10,4"
                                                                                    FontSize="11"
                                                                                    Command="{Binding $parent[Window].DataContext.AddSceneToBlockCommand}"
                                                                                    CommandParameter="{Binding SequenceCard}" />
                                                                            <ToggleButton Classes="laneChevron"
                                                                                          IsChecked="{Binding IsExpanded, Mode=TwoWay}"
                                                                                          Content="&#x25BE;"
                                                                                          ToolTip.Tip="Collapse / expand this sequence" />
                                                                        </StackPanel>
                                                                    </Grid>
                                                                    <ItemsControl ItemsSource="{Binding Cards}"
                                                                                  IsVisible="{Binding IsExpanded}"
                                                                                  ItemTemplate="{StaticResource BeatBoardCardTemplate}">
                                                                        <ItemsControl.ItemsPanel>
                                                                            <ItemsPanelTemplate>
                                                                                <WrapPanel Orientation="Horizontal" />
                                                                            </ItemsPanelTemplate>
                                                                        </ItemsControl.ItemsPanel>
                                                                    </ItemsControl>
                                                                </StackPanel>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            </LayoutTransformControl>
                        </ScrollViewer>

                        <TextBlock Grid.Row="1"
                                   Text="{Binding BeatBoardEmptyMessage}"
                                   IsVisible="{Binding !HasBeatBoardCards}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   TextAlignment="Center"
                                   Foreground="{DynamicResource MutedText}"
                                   FontStyle="Italic"
                                   TextWrapping="Wrap" />
                    </Grid>
                </TabItem>

                <TabItem Header="Page Preview">
                    <Grid>
                    <TextBlock Text="Page preview works in Screenplay mode.&#x0a;Press Ctrl+M to switch back to Fountain."
                               IsVisible="{Binding IsMarkdownMode}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               TextAlignment="Center"
                               Foreground="{DynamicResource MutedText}"
                               FontStyle="Italic"
                               TextWrapping="Wrap" />
                    <ScrollViewer HorizontalScrollBarVisibility="Auto"
                                  VerticalScrollBarVisibility="Auto"
                                  Background="Transparent">
                        <LayoutTransformControl HorizontalAlignment="Center">
                        <LayoutTransformControl.LayoutTransform>
                            <ScaleTransform ScaleX="{Binding EditorZoomScale}" ScaleY="{Binding EditorZoomScale}" />
                        </LayoutTransformControl.LayoutTransform>
                        <ItemsControl ItemsSource="{Binding PreviewPages}" Margin="0,20">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Vertical" Spacing="25" HorizontalAlignment="Center" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:PreviewPageViewModel">
                                    <Border Width="612"
                                            Height="792"
                                            Background="{DynamicResource SurfaceRaisedBackground}"
                                            BorderBrush="{DynamicResource EditorPageBorder}"
                                            BorderThickness="1"
                                            CornerRadius="4"
                                            BoxShadow="0 6 22 0 #22000000"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Top">
                                        <Canvas Width="612" Height="792">
                                            <ItemsControl Classes="page-lines" ItemsSource="{Binding Lines}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <Canvas Width="612" Height="792" Background="Transparent" />
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="vm:PreviewLineViewModel">
                                                        <TextBlock Text="{Binding Text}"
                                                                   FontFamily="avares://Passage.App.Linux/Assets/Fonts/#Courier Prime, Courier New, Courier, monospace"
                                                                   FontSize="12"
                                                                   FontWeight="{Binding Weight}"
                                                                   Foreground="{DynamicResource EditorForeground}" />
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                                <ItemsControl.Styles>
                                                    <Style Selector="ContentPresenter" x:DataType="vm:PreviewLineViewModel">
                                                        <Setter Property="Canvas.Left" Value="{Binding X}" />
                                                        <Setter Property="Canvas.Top" Value="{Binding Y}" />
                                                    </Style>
                                                </ItemsControl.Styles>
                                            </ItemsControl>
                                        </Canvas>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        </LayoutTransformControl>
                    </ScrollViewer>
                    </Grid>
                </TabItem>
            </TabControl>

            <!-- Right GridSplitter (for Syntax Panel) -->
            <GridSplitter Name="RightSplitter" Grid.Column="3" Width="4" Background="{DynamicResource SurfaceBorder}" IsVisible="False" />

            <!-- Syntax Quick Reference Panel -->
            <Border Name="RightDockBorder" Grid.Column="4" BorderThickness="1,0,0,0" BorderBrush="{DynamicResource SurfaceBorder}" IsVisible="False">
                <views:SyntaxQuickReferencePanel />
            </Border>
        </Grid>
    </DockPanel>

</Window>
