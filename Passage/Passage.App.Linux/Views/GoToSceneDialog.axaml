<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:views="clr-namespace:Passage.App.Views"
        mc:Ignorable="d" d:DesignWidth="440" d:DesignHeight="540"
        x:Class="Passage.App.Views.GoToSceneDialog"
        Title="Go To Scene"
        Width="440"
        Height="540"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        Background="{DynamicResource SurfaceBackground}">

    <Border Padding="24,20" Background="{DynamicResource SurfaceBackground}">
        <DockPanel LastChildFill="True">

            <!-- Dialog header -->
            <StackPanel DockPanel.Dock="Top" Margin="0,0,0,16">
                <TextBlock Text="Go To Scene"
                           FontSize="17"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource HeaderText}"
                           Margin="0,0,0,4" />
                <TextBlock Text="Select a scene heading to jump to."
                           Foreground="{DynamicResource MutedText}"
                           FontSize="12" />
            </StackPanel>

            <!-- Footer buttons -->
            <StackPanel DockPanel.Dock="Bottom"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Margin="0,14,0,0">
                <Button Content="Jump"
                        Width="88"
                        Margin="0,0,8,0"
                        CornerRadius="8"
                        IsDefault="True"
                        Click="JumpClick" />
                <Button Content="Close"
                        Width="88"
                        CornerRadius="8"
                        IsCancel="True"
                        Click="CloseClick" />
            </StackPanel>

            <!-- Divider above buttons -->
            <Border DockPanel.Dock="Bottom"
                    Height="1"
                    Background="{DynamicResource SurfaceBorder}"
                    Margin="0,14,0,0" />

            <!-- Scene list -->
            <ListBox x:Name="SceneListBox"
                     MinHeight="320"
                     Background="{DynamicResource SurfaceRaisedBackground}"
                     BorderBrush="{DynamicResource SurfaceBorder}"
                     BorderThickness="1"
                     CornerRadius="8"
                     DoubleTapped="SceneListBox_DoubleTapped"
                     KeyDown="SceneListBox_KeyDown">
                <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="views:SceneJumpItem">
                        <TextBlock Text="{Binding DisplayText}" 
                                   Foreground="{DynamicResource ControlForeground}" 
                                   Padding="4,2"/>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

        </DockPanel>
    </Border>
</Window>
