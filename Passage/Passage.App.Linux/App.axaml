<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Passage.App.App"
             xmlns:local="using:Passage.App"
             RequestedThemeVariant="Dark">

    <Application.DataTemplates>
        <local:ViewLocator/>
    </Application.DataTemplates>

    <Application.Styles>
        <FluentTheme />
        <StyleInclude Source="avares://AvaloniaEdit/Themes/Fluent/AvaloniaEdit.xaml" />
        <StyleInclude Source="avares://Passage.App.Linux/Styles/Controls.axaml" />
    </Application.Styles>

    <Application.Resources>
        <!-- Dark Theme Colors (modern e-ink monochrome; default before system detection).
             Mirrors App.axaml.cs LoadThemeResources — keep both in sync. -->
        <SolidColorBrush x:Key="ThemeBackground" Color="#0D0D0C" />
        <SolidColorBrush x:Key="WindowBackground" Color="#0D0D0C" />
        <SolidColorBrush x:Key="SurfaceBackground" Color="#141413" />
        <SolidColorBrush x:Key="SurfaceMutedBackground" Color="#232321" />
        <SolidColorBrush x:Key="SurfaceRaisedBackground" Color="#1B1B1A" />
        <SolidColorBrush x:Key="SurfaceBorder" Color="#262624" />
        <SolidColorBrush x:Key="ControlBackground" Color="#1B1B1A" />
        <SolidColorBrush x:Key="ControlForeground" Color="#F2F2F0" />
        <SolidColorBrush x:Key="ControlBorder" Color="#2E2E2C" />
        <SolidColorBrush x:Key="ControlAccent" Color="#F4F4F2" />
        <SolidColorBrush x:Key="ControlPressedBackground" Color="#F4F4F2" />
        <SolidColorBrush x:Key="ControlPressedForeground" Color="#0D0D0C" />
        <SolidColorBrush x:Key="HeaderText" Color="#FAFAF8" />
        <SolidColorBrush x:Key="SecondaryText" Color="#B2B2AD" />
        <SolidColorBrush x:Key="MutedText" Color="#6E6E69" />
        <SolidColorBrush x:Key="EditorForeground" Color="#EDEDEB" />
        <SolidColorBrush x:Key="EditorPageBorder" Color="#262624" />
        <SolidColorBrush x:Key="WindowForeground" Color="#EDEDEB" />
        <SolidColorBrush x:Key="HierarchyIndicatorBrush" Color="#F4F4F2" />
        <SolidColorBrush x:Key="DragOverBackground" Color="#25F4F4F2" />

        <!-- Card Colors -->
        <SolidColorBrush x:Key="CardBackground" Color="#1B1B1A" />
        <SolidColorBrush x:Key="CardBorder" Color="#2A2A28" />
        <SolidColorBrush x:Key="CardAccent" Color="#F4F4F2" />

        <!-- Editor syntax colours (dark defaults) -->
        <SolidColorBrush x:Key="SyntaxSceneHeading" Color="#6797FF" />
        <SolidColorBrush x:Key="SyntaxCharacter" Color="#C05587" />
        <SolidColorBrush x:Key="SyntaxDialogue" Color="#CEB2C9" />
        <SolidColorBrush x:Key="SyntaxParenthetical" Color="#8A8A85" />
        <SolidColorBrush x:Key="SyntaxTransition" Color="#8A6FC9" />
        <SolidColorBrush x:Key="SyntaxSection" Color="#4FC3F7" />
        <SolidColorBrush x:Key="SyntaxSynopsis" Color="#FFB74D" />
        <SolidColorBrush x:Key="SyntaxNote" Color="#81C784" />
    </Application.Resources>
</Application>
