<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Passage.App.App"
             xmlns:local="using:Passage.App"
             RequestedThemeVariant="Dark">

    <Application.DataTemplates>
        <local:ViewLocator/>
    </Application.DataTemplates>

    <Application.Styles>
        <FluentTheme />
        <StyleInclude Source="avares://AvaloniaEdit/Themes/Fluent/AvaloniaEdit.xaml" />
        <StyleInclude Source="avares://Passage.App.Linux/Styles/Controls.axaml" />
    </Application.Styles>

    <Application.Resources>
        <!-- Dark Theme Colors (modern e-ink monochrome; default before system detection).
             Mirrors App.axaml.cs LoadThemeResources — keep both in sync. -->
        <SolidColorBrush x:Key="ThemeBackground" Color="#0B0B0B" />
        <SolidColorBrush x:Key="WindowBackground" Color="#0B0B0B" />
        <SolidColorBrush x:Key="SurfaceBackground" Color="#111111" />
        <SolidColorBrush x:Key="SurfaceMutedBackground" Color="#1E1E1E" />
        <SolidColorBrush x:Key="SurfaceRaisedBackground" Color="#161616" />
        <SolidColorBrush x:Key="SurfaceBorder" Color="#242424" />
        <SolidColorBrush x:Key="ControlBackground" Color="#161616" />
        <SolidColorBrush x:Key="ControlForeground" Color="#F2F2F0" />
        <SolidColorBrush x:Key="ControlBorder" Color="#2E2E2E" />
        <SolidColorBrush x:Key="ControlAccent" Color="#F5F5F3" />
        <SolidColorBrush x:Key="ControlPressedBackground" Color="#F5F5F3" />
        <SolidColorBrush x:Key="ControlPressedForeground" Color="#0B0B0B" />
        <SolidColorBrush x:Key="HeaderText" Color="#FAFAF8" />
        <SolidColorBrush x:Key="SecondaryText" Color="#B4B4B0" />
        <SolidColorBrush x:Key="MutedText" Color="#70706C" />
        <SolidColorBrush x:Key="EditorForeground" Color="#EDEDEB" />
        <SolidColorBrush x:Key="EditorPageBorder" Color="#242424" />
        <SolidColorBrush x:Key="WindowForeground" Color="#EDEDEB" />
        <SolidColorBrush x:Key="HierarchyIndicatorBrush" Color="#F5F5F3" />
        <SolidColorBrush x:Key="DragOverBackground" Color="#25F5F5F3" />

        <!-- Card Colors -->
        <SolidColorBrush x:Key="CardBackground" Color="#161616" />
        <SolidColorBrush x:Key="CardBorder" Color="#262626" />
        <SolidColorBrush x:Key="CardAccent" Color="#F5F5F3" />

        <!-- Editor syntax colours (dark defaults) -->
        <SolidColorBrush x:Key="SyntaxSceneHeading" Color="#6797FF" />
        <SolidColorBrush x:Key="SyntaxCharacter" Color="#C05587" />
        <SolidColorBrush x:Key="SyntaxDialogue" Color="#CEB2C9" />
        <SolidColorBrush x:Key="SyntaxParenthetical" Color="#8A8A85" />
        <SolidColorBrush x:Key="SyntaxTransition" Color="#8A6FC9" />
        <SolidColorBrush x:Key="SyntaxSection" Color="#4FC3F7" />
        <SolidColorBrush x:Key="SyntaxSynopsis" Color="#FFB74D" />
        <SolidColorBrush x:Key="SyntaxNote" Color="#81C784" />
    </Application.Resources>
</Application>
