<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Passage.App.App"
             xmlns:local="using:Passage.App"
             RequestedThemeVariant="Dark">

    <Application.DataTemplates>
        <local:ViewLocator/>
    </Application.DataTemplates>

    <Application.Styles>
        <FluentTheme />
        <StyleInclude Source="avares://AvaloniaEdit/Themes/Fluent/AvaloniaEdit.xaml" />
    </Application.Styles>

    <Application.Resources>
        <!-- Dark Theme Colors -->
        <SolidColorBrush x:Key="ThemeBackground" Color="#1E1E1E" />
        <SolidColorBrush x:Key="WindowBackground" Color="#1E1E1E" />
        <SolidColorBrush x:Key="SurfaceBackground" Color="#252526" />
        <SolidColorBrush x:Key="SurfaceMutedBackground" Color="#2D2D30" />
        <SolidColorBrush x:Key="SurfaceRaisedBackground" Color="#333333" />
        <SolidColorBrush x:Key="SurfaceBorder" Color="#3F3F46" />
        <SolidColorBrush x:Key="ControlBackground" Color="#333337" />
        <SolidColorBrush x:Key="ControlForeground" Color="#CCCCCC" />
        <SolidColorBrush x:Key="ControlBorder" Color="#3F3F46" />
        <SolidColorBrush x:Key="ControlAccent" Color="#007ACC" />
        <SolidColorBrush x:Key="ControlPressedBackground" Color="#3A3A3D" />
        <SolidColorBrush x:Key="ControlPressedForeground" Color="#FFFFFF" />
        <SolidColorBrush x:Key="HeaderText" Color="#FFFFFF" />
        <SolidColorBrush x:Key="SecondaryText" Color="#9D9D9D" />
        <SolidColorBrush x:Key="MutedText" Color="#6D6D6D" />
        <SolidColorBrush x:Key="EditorForeground" Color="#CCCCCC" />
        <SolidColorBrush x:Key="EditorPageBorder" Color="#3F3F46" />
        <SolidColorBrush x:Key="WindowForeground" Color="#CCCCCC" />

        <!-- Card Colors -->
        <SolidColorBrush x:Key="CardBackground" Color="#2D2D30" />
        <SolidColorBrush x:Key="CardBorder" Color="#3F3F46" />
        <SolidColorBrush x:Key="CardAccent" Color="#007ACC" />
    </Application.Resources>
</Application>
