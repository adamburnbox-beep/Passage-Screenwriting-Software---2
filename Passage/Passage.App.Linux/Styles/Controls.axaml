<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="using:Avalonia.Controls.Converters">

    <!-- ============================================================ -->
    <!-- Chrome buttons (toolbar / workspace) — full pills, e-ink      -->
    <!-- style: white pill at rest, inverts to solid ink on press.     -->
    <!-- ============================================================ -->
    <Style Selector="Button.chrome">
        <Setter Property="Background" Value="{DynamicResource ControlBackground}" />
        <Setter Property="Foreground" Value="{DynamicResource ControlForeground}" />
        <Setter Property="BorderBrush" Value="{DynamicResource ControlBorder}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="999" />
        <Setter Property="Padding" Value="18,7" />
        <Setter Property="MinWidth" Value="86" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="Background" Duration="0:0:0.12" />
                <BrushTransition Property="BorderBrush" Duration="0:0:0.12" />
            </Transitions>
        </Setter>
    </Style>
    <Style Selector="Button.chrome /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource ControlBackground}" />
        <Setter Property="BorderBrush" Value="{DynamicResource ControlBorder}" />
    </Style>
    <Style Selector="Button.chrome:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource ControlBackground}" />
        <Setter Property="BorderBrush" Value="{DynamicResource ControlAccent}" />
        <Setter Property="TextElement.Foreground" Value="{DynamicResource HeaderText}" />
    </Style>
    <Style Selector="Button.chrome:pressed /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource ControlPressedBackground}" />
        <Setter Property="BorderBrush" Value="{DynamicResource ControlPressedBackground}" />
        <Setter Property="TextElement.Foreground" Value="{DynamicResource ControlPressedForeground}" />
    </Style>

    <!-- Small inline pill buttons (card Edit/Save/Cancel, toggles, delete) -->
    <Style Selector="Button.inline">
        <Setter Property="Background" Value="{DynamicResource ControlBackground}" />
        <Setter Property="Foreground" Value="{DynamicResource ControlForeground}" />
        <Setter Property="BorderBrush" Value="{DynamicResource ControlBorder}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="999" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Button.inline:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource ControlBackground}" />
        <Setter Property="BorderBrush" Value="{DynamicResource ControlAccent}" />
        <Setter Property="TextElement.Foreground" Value="{DynamicResource HeaderText}" />
    </Style>
    <Style Selector="Button.inline:pressed /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource ControlPressedBackground}" />
        <Setter Property="BorderBrush" Value="{DynamicResource ControlPressedBackground}" />
        <Setter Property="TextElement.Foreground" Value="{DynamicResource ControlPressedForeground}" />
    </Style>

    <!-- Quiet chevron toggle for Beat Board act lanes: points down when the
         lane is expanded (checked), rotates to point right when collapsed. -->
    <Style Selector="ToggleButton.laneChevron">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="9,3" />
        <Setter Property="CornerRadius" Value="999" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Foreground" Value="{DynamicResource SecondaryText}" />
        <Setter Property="Transitions">
            <Transitions>
                <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.12" />
            </Transitions>
        </Setter>
    </Style>
    <Style Selector="ToggleButton.laneChevron:not(:checked)">
        <Setter Property="RenderTransform" Value="rotate(-90deg)" />
    </Style>
    <Style Selector="ToggleButton.laneChevron /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="ToggleButton.laneChevron:checked /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="TextElement.Foreground" Value="{DynamicResource SecondaryText}" />
    </Style>
    <Style Selector="ToggleButton.laneChevron:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource SurfaceMutedBackground}" />
    </Style>

    <!-- ============================================================ -->
    <!-- Top menu (File / Edit / View / Navigate)                      -->
    <!-- ============================================================ -->
    <Style Selector="Menu">
        <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="Menu > MenuItem">
        <Setter Property="Foreground" Value="{DynamicResource ControlForeground}" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Padding" Value="9,5" />
    </Style>
    <Style Selector="Menu > MenuItem:pointerover /template/ Border#PART_LayoutRoot">
        <Setter Property="Background" Value="{DynamicResource SurfaceMutedBackground}" />
    </Style>
    <Style Selector="Menu > MenuItem:selected /template/ Border#PART_LayoutRoot">
        <Setter Property="Background" Value="{DynamicResource SurfaceMutedBackground}" />
    </Style>
    <Style Selector="MenuItem">
        <Setter Property="Foreground" Value="{DynamicResource ControlForeground}" />
    </Style>

    <!-- ============================================================ -->
    <!-- Tabs — segmented pill control: the active tab is a solid ink  -->
    <!-- pill with inverted text, inactive tabs are quiet labels.      -->
    <!-- ============================================================ -->
    <Style Selector="TabControl">
        <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="TabItem">
        <Setter Property="Foreground" Value="{DynamicResource MutedText}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Padding" Value="16,7" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="CornerRadius" Value="999" />
        <Setter Property="Margin" Value="0,0,6,0" />
        <Style.Resources>
            <x:Double x:Key="TabItemHeaderFontSize">14</x:Double>
        </Style.Resources>
    </Style>
    <Style Selector="TabItem /template/ Border#PART_LayoutRoot">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="CornerRadius" Value="999" />
    </Style>
    <Style Selector="TabItem:pointerover">
        <Setter Property="Foreground" Value="{DynamicResource HeaderText}" />
    </Style>
    <Style Selector="TabItem:pointerover /template/ Border#PART_LayoutRoot">
        <Setter Property="Background" Value="{DynamicResource SurfaceMutedBackground}" />
    </Style>
    <Style Selector="TabItem:selected">
        <Setter Property="Foreground" Value="{DynamicResource ControlPressedForeground}" />
    </Style>
    <Style Selector="TabItem:selected /template/ Border#PART_LayoutRoot">
        <Setter Property="Background" Value="{DynamicResource ControlAccent}" />
    </Style>
    <Style Selector="TabItem:selected /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="TextElement.Foreground" Value="{DynamicResource ControlPressedForeground}" />
    </Style>

    <!-- Main view tabs (Script / Beat Board / Page Preview): right-aligned in
         the empty space at the top of the editor area, clear of the toolbar
         above and the workspace splitter on the left. -->
    <Style Selector="TabControl#MainViewTabs /template/ ItemsPresenter#PART_ItemsPresenter">
        <Setter Property="HorizontalAlignment" Value="Right" />
        <Setter Property="Margin" Value="0,10,20,10" />
    </Style>

    <!-- The workspace sidebar hosts four tabs in ~350px — tighten its pills so
         they fit on one row. -->
    <Style Selector="TabControl#LeftDockTabs TabItem">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Padding" Value="12,6" />
        <Setter Property="Margin" Value="0,0,4,0" />
        <Style.Resources>
            <x:Double x:Key="TabItemHeaderFontSize">13</x:Double>
        </Style.Resources>
    </Style>

    <!-- Remove the Fluent accent pipe (green) from every tab. :is(Control) matches
         the pipe whatever its concrete type is (plain type selectors are exact-match). -->
    <Style Selector="TabItem /template/ :is(Control)#PART_SelectedPipe">
        <Setter Property="IsVisible" Value="False" />
        <Setter Property="Opacity" Value="0" />
        <Setter Property="Height" Value="0" />
        <Setter Property="Width" Value="0" />
    </Style>

    <!-- ============================================================ -->
    <!-- Workspace trees (Outline / Notes) selection                  -->
    <!-- ============================================================ -->
    <!-- Drop the Fluent accent (green) selection fill. The template part is
         named PART_LayoutRoot (TreeViewItemLayoutRoot is its class), so the
         name selector must match PART_LayoutRoot or the fill leaks through. -->
    <Style Selector="TreeViewItem:selected /template/ Border#PART_LayoutRoot">
        <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="TreeViewItem:selected:pointerover /template/ Border#PART_LayoutRoot">
        <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="TreeViewItem:pointerover /template/ Border#PART_LayoutRoot">
        <Setter Property="Background" Value="Transparent" />
    </Style>
    <!-- Move the built-in expand/collapse chevron from the left of each card to
         the right. This mirrors the Fluent TreeViewItem template but swaps the
         header columns: the card (PART_HeaderPresenter) takes the left Star
         column (flush left, closing the old chevron gap) and the native chevron
         takes the right Auto column. Part names are preserved so the other
         TreeViewItem styles (selection, :empty chevron hide, etc.) still apply.
         Indentation is the PART_Header Margin, unchanged. -->
    <Style Selector="TreeViewItem">
        <Setter Property="Template">
            <ControlTemplate>
                <StackPanel>
                    <Border Name="PART_LayoutRoot"
                            Classes="TreeViewItemLayoutRoot"
                            Focusable="True"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{TemplateBinding CornerRadius}"
                            MinHeight="{TemplateBinding MinHeight}"
                            TemplatedControl.IsTemplateFocusTarget="True">
                        <Grid Name="PART_Header" ColumnDefinitions="*,Auto">
                            <Grid.Margin>
                                <MultiBinding Converter="{x:Static conv:TreeViewItemIndentConverter.Instance}">
                                    <Binding Path="Level" RelativeSource="{RelativeSource TemplatedParent}" />
                                    <DynamicResource ResourceKey="TreeViewItemIndent" />
                                </MultiBinding>
                            </Grid.Margin>
                            <ContentPresenter Name="PART_HeaderPresenter"
                                              Grid.Column="0"
                                              Focusable="False"
                                              Background="Transparent"
                                              Content="{TemplateBinding Header}"
                                              ContentTemplate="{TemplateBinding HeaderTemplate}"
                                              HorizontalAlignment="{TemplateBinding HorizontalAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalAlignment}"
                                              Margin="{TemplateBinding Padding}" />
                            <Panel Name="PART_ExpandCollapseChevronContainer"
                                   Grid.Column="1"
                                   Margin="{DynamicResource TreeViewItemExpandCollapseChevronMargin}">
                                <ToggleButton Name="PART_ExpandCollapseChevron"
                                              Theme="{DynamicResource FluentTreeViewExpandCollapseChevron}"
                                              Focusable="False"
                                              IsChecked="{TemplateBinding IsExpanded, Mode=TwoWay}" />
                            </Panel>
                        </Grid>
                    </Border>
                    <ItemsPresenter Name="PART_ItemsPresenter"
                                    IsVisible="{TemplateBinding IsExpanded}"
                                    ItemsPanel="{TemplateBinding ItemsPanel}" />
                </StackPanel>
            </ControlTemplate>
        </Setter>
    </Style>
    <!-- The "current element" indicator is driven by the caret (the accent bar
         in the card templates), not by TreeView selection. -->

</Styles>
